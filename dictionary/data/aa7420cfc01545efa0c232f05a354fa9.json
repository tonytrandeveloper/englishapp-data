    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a situation in which there are so many cars in the streets of a town that the traffic cannot move at all",
                        "vi": "một tình huống trong đó có rất nhiều ô tô trên đường phố của một thị trấn mà giao thông không thể di chuyển được"
                    },
                    "examples": [
                        {
                            "en": "It’s gridlock between 6.30 and 9.00.",
                            "vi": "Nó bế tắc trong khoảng từ 6.30 đến 9.00."
                        },
                        {
                            "en": "The protest march created gridlock.",
                            "vi": "Cuộc tuần hành phản đối tạo ra sự bế tắc."
                        },
                        {
                            "en": "roads that are prone to gridlocks",
                            "vi": "những con đường dễ bị tắc nghẽn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a situation in which people with different opinions are not able to agree with each other and so no action can be taken",
                        "vi": "một tình huống trong đó những người có ý kiến khác nhau không thể đồng ý với nhau và do đó không thể thực hiện hành động"
                    },
                    "examples": [
                        {
                            "en": "Congress is in gridlock.",
                            "vi": "Quốc hội đang bế tắc."
                        }
                    ]
                }
            ]
        }
