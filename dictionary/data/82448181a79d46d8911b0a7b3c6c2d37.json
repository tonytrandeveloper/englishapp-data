            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "apparently, because something seems true at first although it may be proved false later",
                        "vi": "rõ ràng, bởi vì điều gì đó có vẻ đúng lúc đầu mặc dù nó có thể được chứng minh là sai sau đó"
                    },
                    "examples": [
                        {
                            "en": "Prima facie, there is a strong case against him.",
                            "vi": "Prima facie, có một trường hợp mạnh mẽ chống lại anh ta."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "based on what at first seems to be true, although it may be proved false later",
                        "vi": "dựa trên những gì thoạt đầu có vẻ là đúng, mặc dù điều đó có thể được chứng minh là sai sau đó"
                    },
                    "examples": [
                        {
                            "en": "prima facie evidence",
                            "vi": "bằng chứng prima facie"
                        }
