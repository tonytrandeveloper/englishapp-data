    "blocks": [
        {
            "pos": "phrasal verb",
            "means": [
                {
                    "define": {
                        "en": "to get rid of something that you no longer want",
                        "vi": "để loại bỏ một cái gì đó mà bạn không còn muốn"
                    },
                    "examples": [
                        {
                            "en": "I don't need that—you can throw it away.",
                            "vi": "Tôi không cần điều đó — bạn có thể vứt nó đi."
                        },
                        {
                            "en": "That old chair should be thrown away.",
                            "vi": "Cái ghế cũ đó nên vứt đi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to fail to make use of something; to waste something",
                        "vi": "không tận dụng được thứ gì đó; lãng phí một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "to throw away an opportunity",
                            "vi": "để bỏ đi một cơ hội"
                        },
                        {
                            "en": "You must take the exam—you can't throw away all that work!",
                            "vi": "Bạn phải tham gia kỳ thi — bạn không thể vứt bỏ tất cả công việc đó!"
                        }
                    ]
                }
            ]
        }
