                        "vi": "một chuyển động không chủ ý, v.v. được thực hiện đột ngột mà bạn không có ý định hoặc không thể kiểm soát được"
                    },
                    "examples": [
                        {
                            "en": "an involuntary cry of pain",
                            "vi": "một tiếng kêu đau đớn không tự chủ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "happening without the person involved wanting it to",
                        "vi": "xảy ra mà người liên quan không muốn"
                    },
                    "examples": [
                        {
                            "en": "The company announced involuntary redundancies.",
                            "vi": "Công ty đã thông báo về tình trạng dư thừa không tự nguyện."
                        },
                        {
                            "en": "involuntary childlessness",
