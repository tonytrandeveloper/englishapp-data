    "word": "silently",
    "phonetic": {
        "uk": "/ˈsaɪləntli/",
        "us": "/ˈsaɪləntli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "without speaking",
                        "vi": "không nói"
                    },
                    "examples": [
                        {
                            "en": "They marched silently through the streets.",
                            "vi": "Họ lặng lẽ diễu hành qua các con phố."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "without making any or much sound",
                        "vi": "mà không tạo ra bất kỳ hoặc nhiều âm thanh"
                    },
                    "examples": [
                        {
                            "en": "She crept silently out of the room.",
                            "vi": "Cô lặng lẽ rón rén ra khỏi phòng."
                        },
                        {
                            "en": "The car rolled silently downhill.",
                            "vi": "Xe lặng lẽ lăn bánh xuống dốc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "without using words or sounds to express something",
                        "vi": "mà không cần sử dụng từ ngữ hoặc âm thanh để diễn đạt điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "She prayed silently.",
                            "vi": "Cô thầm cầu nguyện."
                        },
                        {
                            "en": "He silently agreed with much of what she had said.",
                            "vi": "Anh im lặng đồng ý với phần lớn những gì cô đã nói."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to do or say nothing to help somebody or deal with a difficult situation",
                        "vi": "không làm hoặc không nói gì để giúp đỡ ai đó hoặc đối phó với một tình huống khó khăn"
                    },
                    "examples": [
                        {
                            "en": "We can’t sit silently by and let them arrest him!",
                            "vi": "Chúng ta không thể ngồi im và để họ bắt anh ta được!"
                        }
                    ]
                }
            ]
        }
