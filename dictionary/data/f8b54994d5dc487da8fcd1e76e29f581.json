{
    "id": "f8b54994d5dc487da8fcd1e76e29f581",
    "word": "squeal",
    "phonetic": {
        "uk": "/skwiːl/",
        "us": "/skwiːl/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make a long, high sound",
                        "vi": "để tạo ra âm thanh dài và cao"
                    },
                    "examples": [
                        {
                            "en": "The pigs were squealing.",
                            "vi": "Những con lợn kêu lên."
                        },
                        {
                            "en": "The car squealed to a halt.",
                            "vi": "Chiếc xe rú lên dừng lại."
                        },
                        {
                            "en": "Children were running around squealing with excitement.",
                            "vi": "Những đứa trẻ chạy xung quanh la hét đầy phấn khích."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to speak in a very high voice, especially when you are excited or nervous",
                        "vi": "nói với một giọng rất cao, đặc biệt là khi bạn đang phấn khích hoặc lo lắng"
                    },
                    "examples": [
                        {
                            "en": "‘Don't!’ she squealed.",
                            "vi": "'Đừng!' cô ấy kêu lên."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to give information, especially to the police, about something illegal that somebody has done",
                        "vi": "cung cấp thông tin, đặc biệt là cho cảnh sát, về điều gì đó bất hợp pháp mà ai đó đã làm"
                    },
                    "examples": [
                        {
                            "en": "Someone must have squealed on him.",
                            "vi": "Ai đó phải hét lên với anh ta."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a long high call or sound",
                        "vi": "một cuộc gọi hoặc âm thanh cao kéo dài"
                    },
                    "examples": [
                        {
                            "en": "a squeal of pain",
                            "vi": "một tiếng kêu đau đớn"
                        },
                        {
                            "en": "a squeal of delight",
                            "vi": "một tiếng ré lên của niềm vui"
                        },
                        {
                            "en": "He stopped with a squeal of brakes.",
                            "vi": "Anh ta dừng lại với một tiếng phanh rít."
                        }
                    ]
                }
            ]
        }
    ],
