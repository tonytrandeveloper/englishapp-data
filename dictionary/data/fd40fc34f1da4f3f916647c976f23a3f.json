    "word": "pyramidal",
    "phonetic": {
        "uk": "/ˈpɪrəmɪdl/",
        "us": "/ˈpɪrəmɪdl/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "having a square or triangular base and sloping sides that meet in a point at the top",
                        "vi": "có đáy là hình vuông hoặc hình tam giác và các mặt dốc gặp nhau tại một điểm ở trên cùng"
                    },
                    "examples": [
                        {
                            "en": "a pyramidal roof/tent",
                            "vi": "mái nhà / lều hình chóp"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "piled in the shape of a pyramid",
                        "vi": "chất đống trong hình kim tự tháp"
                    },
                    "examples": [
                        {
                            "en": "the familiar pyramidal arrangements seen in fruit markets",
                            "vi": "các sắp xếp hình chóp quen thuộc được thấy ở chợ trái cây"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in which there are fewer people at each level as you get near the top",
                        "vi": "trong đó có ít người hơn ở mỗi cấp khi bạn lên gần đầu"
                    },
                    "examples": [
                        {
                            "en": "a pyramidal authoritarian leadership structure",
                            "vi": "một cấu trúc lãnh đạo độc tài hình tháp"
                        }
                    ]
                }
            ]
        }
