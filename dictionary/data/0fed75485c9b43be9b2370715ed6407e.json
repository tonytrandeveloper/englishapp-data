    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the process of making a wild animal used to living with or working for humans",
                        "vi": "quá trình tạo ra một loài động vật hoang dã quen sống hoặc làm việc với con người"
                    },
                    "examples": [
                        {
                            "en": "the domestication of cattle",
                            "vi": "thuần hóa gia súc"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the process of making a plant or crop suitable to grow for human use",
                        "vi": "quá trình tạo ra một loại cây trồng hoặc cây trồng thích hợp để phát triển cho con người"
                    },
                    "examples": [
                        {
                            "en": "the domestication of rice",
                            "vi": "thuần hóa lúa gạo"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the process of making somebody good at cooking, caring for a house, etc. and of making them enjoy home life",
                        "vi": "quá trình giúp ai đó nấu ăn giỏi, chăm sóc nhà cửa, v.v. và khiến họ tận hưởng cuộc sống gia đình"
                    },
                    "examples": [
                        {
                            "en": "The prospect of marriage and domestication filled her with horror.",
                            "vi": "Viễn cảnh kết hôn và thuần hóa khiến cô kinh hãi."
                        }
                    ]
                }
            ]
