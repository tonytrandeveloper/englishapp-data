    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "(especially in the US) a formal dance, especially one that is held at a high school",
                        "vi": "(đặc biệt là ở Mỹ) một buổi khiêu vũ trang trọng, đặc biệt là một buổi khiêu vũ được tổ chức tại một trường trung học"
                    },
                    "examples": [
                        {
                            "en": "the senior prom",
                            "vi": "buổi dạ hội cấp cao"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a promenade (= a public place for walking, usually a wide path next to the sea)",
                        "vi": "một lối đi dạo (= một nơi công cộng để đi bộ, thường là một con đường rộng bên cạnh biển)"
                    },
                    "examples": [
                        {
                            "en": "to walk along the prom",
                            "vi": "đi bộ dọc theo vũ hội"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a concert at which many of the audience stand up or sit on the floor",
                        "vi": "một buổi hòa nhạc mà tại đó nhiều khán giả đứng lên hoặc ngồi trên sàn"
                    },
                    "examples": [
                        {
                            "en": "the last night of the proms",
                            "vi": "đêm cuối cùng của proms"
                        }
                    ]
                }
            ]
        }
