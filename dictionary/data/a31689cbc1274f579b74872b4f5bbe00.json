    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "relating to classical music",
                        "vi": "liên quan đến âm nhạc cổ điển"
                    },
                    "examples": [
                        {
                            "en": "a classical composer/musician/pianist",
                            "vi": "một nhà soạn nhạc / nhạc sĩ / nghệ sĩ dương cầm cổ điển"
                        },
                        {
                            "en": "a classical concert",
                            "vi": "một buổi hòa nhạc cổ điển"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "widely accepted and used for a long time; traditional in style or idea",
                        "vi": "được chấp nhận rộng rãi và sử dụng trong thời gian dài; truyền thống trong phong cách hoặc ý tưởng"
                    },
                    "examples": [
                        {
                            "en": "the classical economics of Smith and Ricardo",
                            "vi": "kinh tế học cổ điển của Smith và Ricardo"
                        },
                        {
                            "en": "the classical theory of unemployment",
                            "vi": "lý thuyết cổ điển về thất nghiệp"
                        },
                        {
                            "en": "classical and modern ballet/dance",
                            "vi": "múa ba lê / khiêu vũ cổ điển và hiện đại"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "connected with or influenced by the culture of ancient Greece and Rome",
                        "vi": "kết nối với hoặc chịu ảnh hưởng của văn hóa Hy Lạp và La Mã cổ đại"
                    },
                    "examples": [
                        {
                            "en": "classical studies",
                            "vi": "nghiên cứu cổ điển"
                        },
                        {
                            "en": "a classical scholar (= an expert in Latin and Greek)",
                            "vi": "một học giả cổ điển (= một chuyên gia về tiếng Latinh và tiếng Hy Lạp)"
                        },
                        {
                            "en": "classical architecture",
                            "vi": "kiến trúc cổ điển"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with all the features you would expect to find; very typical",
                        "vi": "với tất cả các tính năng bạn muốn tìm thấy; rất điển hình"
                    },
                    "examples": [
                        {
                            "en": "These are classical examples of food allergy.",
                            "vi": "Đây là những ví dụ điển hình về dị ứng thực phẩm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "ancient in its form and no longer used in a spoken form",
                        "vi": "ở dạng cổ xưa và không còn được sử dụng ở dạng nói"
                    },
                    "examples": [
                        {
                            "en": "classical Arabic",
                            "vi": "tiếng Ả Rập cổ điển"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "simple and attractive",
                        "vi": "đơn giản và hấp dẫn"
                    },
                    "examples": [
                        {
                            "en": "the classical elegance of the design",
                            "vi": "sự sang trọng cổ điển của thiết kế"
                        }
                    ]
                }
            ]
