    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a thing or an event that exists or comes before another, and may have influenced it",
                        "vi": "một sự vật hoặc một sự kiện tồn tại hoặc đến trước một sự vật khác và có thể đã ảnh hưởng đến nó"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "the people in somebody’s family who lived a long time ago",
                        "vi": "những người trong gia đình ai đó đã sống cách đây rất lâu"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a word or phrase to which the following word, especially a pronoun, refers",
                        "vi": "một từ hoặc cụm từ mà từ sau, đặc biệt là một đại từ, dùng để chỉ"
                    },
                    "examples": [
                        {
                            "en": "In ‘He grabbed the ball and threw it in the air’, ‘ball’ is the antecedent of ‘it’.",
                            "vi": "Trong 'Anh ta nắm lấy quả bóng và ném nó lên không trung', 'quả bóng' là tiền thân của 'nó'."
                        }
                    ]
                }
            ]
        },
