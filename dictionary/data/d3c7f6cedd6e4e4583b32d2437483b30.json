    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to move apart and go away in different directions; to make somebody/something do this",
                        "vi": "để di chuyển ra xa nhau và đi theo các hướng khác nhau; để khiến ai đó / điều gì đó làm điều này"
                    },
                    "examples": [
                        {
                            "en": "The fog began to disperse.",
                            "vi": "Sương mù bắt đầu tan."
                        },
                        {
                            "en": "The crowd dispersed quickly.",
                            "vi": "Đám đông giải tán nhanh chóng."
                        },
                        {
                            "en": "disperse somebody/something Police dispersed the protesters with tear gas.",
                            "vi": "giải tán ai đó / cái gì đó Cảnh sát giải tán những người biểu tình bằng hơi cay."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to spread or to make something spread over a wide area",
                        "vi": "để lan truyền hoặc để làm cho một cái gì đó lan rộng trên một khu vực rộng lớn"
                    },
                    "examples": [
                        {
                            "en": "The seeds are dispersed by the wind.",
                            "vi": "Hạt được phát tán nhờ gió."
                        }
                    ]
                }
            ]
        }
