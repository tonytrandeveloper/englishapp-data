            "means": [
                {
                    "define": {
                        "en": "used before adjectives to emphasize that a particular quality is greater than normal",
                        "vi": "được sử dụng trước các tính từ để nhấn mạnh rằng một chất lượng cụ thể lớn hơn bình thường"
                    },
                    "examples": [
                        {
                            "en": "unusually high levels of radiation",
                            "vi": "mức độ bức xạ cao bất thường"
                        },
                        {
                            "en": "an unusually cold winter",
                            "vi": "một mùa đông lạnh giá bất thường"
                        },
                        {
                            "en": "The turnout was unusually low.",
                            "vi": "Tỷ lệ cử tri đi bỏ phiếu thấp một cách bất thường."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to say that a particular situation is not normal or expected",
                        "vi": "được sử dụng để nói rằng một tình huống cụ thể không bình thường hoặc không được mong đợi"
                    },
                    "examples": [
                        {
                            "en": "Unusually for him, he wore a tie.",
                            "vi": "Không bình thường đối với anh ta, anh ta đeo một chiếc cà vạt."
                        }
                    ]
                }
