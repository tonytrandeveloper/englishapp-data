    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "making you feel unable to breathe, because it is too hot and/or there is no fresh air",
                        "vi": "khiến bạn cảm thấy không thở được vì quá nóng và / hoặc không có không khí trong lành"
                    },
                    "examples": [
                        {
                            "en": "a stifling room",
                            "vi": "một căn phòng ngột ngạt"
                        },
                        {
                            "en": "‘It's stifling in here—can we open a window?’",
                            "vi": "'Ở đây ngột ngạt quá - chúng ta có thể mở cửa sổ được không?'"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "making you feel trapped and unable to do or say what you want",
                        "vi": "khiến bạn cảm thấy bị mắc kẹt và không thể làm hoặc nói những gì bạn muốn"
                    },
                    "examples": [
                        {
                            "en": "At 25, she found family life stifling.",
                            "vi": "Ở tuổi 25, cô thấy cuộc sống gia đình thật ngột ngạt."
                        }
                    ]
                }
            ]
        }
