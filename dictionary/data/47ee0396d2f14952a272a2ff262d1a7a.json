                    "define": {
                        "en": "the ability to use language and express your opinions well, especially when you are speaking in public",
                        "vi": "khả năng sử dụng ngôn ngữ và diễn đạt tốt ý kiến của bạn, đặc biệt là khi bạn nói trước đám đông"
                    },
                    "examples": [
                        {
                            "en": "a speech of passionate eloquence",
                            "vi": "một bài diễn văn say mê hùng biện"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality, in a look or movement, of expressing a lot of feeling",
                        "vi": "chất lượng, trong một cái nhìn hoặc một chuyển động, thể hiện nhiều cảm giác"
                    },
                    "examples": [
                        {
                            "en": "the eloquence of his smile",
                            "vi": "nụ cười hùng hồn của anh ấy"
                        }
                    ]
                }
