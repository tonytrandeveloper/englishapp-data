    "word": "stern",
    "phonetic": {
        "uk": "/stɜːn/",
        "us": "/stɜːrn/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "serious and often showing that you do not approve of somebody/something; expecting somebody to obey you",
                        "vi": "nghiêm túc và thường thể hiện rằng bạn không tán thành ai đó / điều gì đó; mong đợi ai đó tuân theo bạn"
                    },
                    "examples": [
                        {
                            "en": "a stern face/expression/look",
                            "vi": "một khuôn mặt / biểu cảm / cái nhìn nghiêm khắc"
                        },
                        {
                            "en": "a stern warning",
                            "vi": "một lời cảnh báo nghiêm khắc"
                        },
                        {
                            "en": "Her voice was stern.",
                            "vi": "Giọng cô ấy nghiêm nghị."
                        },
                        {
                            "en": "The police are planning sterner measures to combat crime.",
                            "vi": "Cảnh sát đang lên kế hoạch các biện pháp nghiêm khắc hơn để chống lại tội phạm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "serious and difficult",
                        "vi": "nghiêm trọng và khó khăn"
                    },
                    "examples": [
                        {
                            "en": "a stern test of nerves",
                            "vi": "một bài kiểm tra nghiêm ngặt về thần kinh"
                        },
                        {
                            "en": "We face stern opposition.",
                            "vi": "Chúng tôi vấp phải sự phản đối gay gắt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to have a stronger character and to be more determined in dealing with problems than other people",
                        "vi": "có tính cách mạnh mẽ hơn và quyết tâm hơn trong việc giải quyết các vấn đề hơn những người khác"
                    },
                    "examples": [
                        {
                            "en": "Many would have given up, but Tim was made of sterner stuff.",
                            "vi": "Nhiều người đã bỏ cuộc, nhưng Tim được làm bằng chất liệu sterner."
                        }
                    ]
                }
            ]
        },
