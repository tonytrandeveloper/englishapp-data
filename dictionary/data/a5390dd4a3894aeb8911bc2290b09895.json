{
    "id": "a5390dd4a3894aeb8911bc2290b09895",
    "word": "painfully",
    "phonetic": {
        "uk": "/ˈpeɪnfəli/",
        "us": "/ˈpeɪnfəli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "extremely, and in a way that makes you feel annoyed, upset, etc.",
                        "vi": "cực kỳ, và theo cách khiến bạn cảm thấy bực mình, khó chịu, v.v."
                    },
                    "examples": [
                        {
                            "en": "Their son was painfully shy.",
                            "vi": "Con trai của họ vô cùng xấu hổ."
                        },
                        {
                            "en": "The dog was painfully thin.",
                            "vi": "Con chó gầy đi một cách đau đớn."
                        },
                        {
                            "en": "He was painfully aware of his lack of experience.",
                            "vi": "Anh đau đớn nhận ra sự thiếu kinh nghiệm của mình."
                        },
                        {
                            "en": "Progress has been painfully slow.",
                            "vi": "Tiến độ đã chậm một cách đáng kinh ngạc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that causes you physical or emotional pain",
                        "vi": "theo cách khiến bạn đau đớn về thể xác hoặc tinh thần"
                    },
                    "examples": [
                        {
                            "en": "He banged his knee painfully against the desk.",
                            "vi": "Anh đập đầu gối vào bàn một cách đau đớn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with a lot of effort and difficulty",
                        "vi": "với rất nhiều nỗ lực và khó khăn"
                    },
                    "examples": [
                        {
                            "en": "painfully acquired experience",
                            "vi": "kinh nghiệm có được một cách đau đớn"
                        }
                    ]
                }
            ]
        }
