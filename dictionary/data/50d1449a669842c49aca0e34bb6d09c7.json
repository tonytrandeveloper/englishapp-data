                        "vi": "uống nhanh một thứ gì đó, đặc biệt là rượu"
                    },
                    "examples": [
                        {
                            "en": "They sat around swigging beer from bottles.",
                            "vi": "Họ ngồi xung quanh khui bia từ chai."
                        },
                        {
                            "en": "He sat next to me, swigging at a bottle of cola.",
                            "vi": "Anh ấy ngồi cạnh tôi, tay cầm một chai cola."
                        }
                    ]
                }
