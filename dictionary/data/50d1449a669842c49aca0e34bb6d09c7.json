    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an amount of something, especially alcohol, that you swallow or drink quickly",
                        "vi": "một lượng thứ gì đó, đặc biệt là rượu, mà bạn nuốt hoặc uống một cách nhanh chóng"
                    },
                    "examples": [
                        {
                            "en": "She took a swig of wine.",
                            "vi": "Cô uống một ngụm rượu."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
