                        "en": "a person or thing that is unaccounted for cannot be found and people do not know what has happened to them or it",
                        "vi": "không thể tìm thấy một người hoặc một vật không được kể đến và mọi người không biết chuyện gì đã xảy ra với họ hoặc điều đó"
                    },
                    "examples": [
                        {
                            "en": "At least 300 civilians are unaccounted for after the bombing raids.",
                            "vi": "Ít nhất 300 thường dân mất tích sau các vụ đánh bom."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not explained",
                        "vi": "không giải thích"
                    },
                    "examples": [
                        {
                            "en": "In the story he gave the police, half an hour was left unaccounted for.",
                            "vi": "Trong câu chuyện mà anh ta đã cho cảnh sát, nửa giờ không được tính."
                        }
                    ]
                }
            ]
