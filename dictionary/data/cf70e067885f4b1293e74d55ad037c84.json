                        },
                        {
                            "en": "My feet are cold.",
                            "vi": "Chân của tôi lạnh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used in exclamations to express surprise, etc.",
                        "vi": "được sử dụng trong câu cảm thán để thể hiện sự ngạc nhiên, v.v."
                    },
                    "examples": [
                        {
                            "en": "My goodness! Look at the time.",
