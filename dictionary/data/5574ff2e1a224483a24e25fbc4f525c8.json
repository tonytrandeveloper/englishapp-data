                        "vi": "được kết nối với hoặc được tạo ra bằng từ tính"
                    },
                    "examples": [
                        {
                            "en": "magnetic properties/forces",
                            "vi": "tính chất / lực từ tính"
                        },
                        {
                            "en": "a magnetic disk (= one containing magnetic material that stores information to be used by a computer)",
                            "vi": "một đĩa từ tính (= một đĩa chứa vật liệu từ tính lưu trữ thông tin được sử dụng bởi máy tính)"
                        }
                    ]
                },
                {
                    "define": {
