            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a situation in which a lot of people are anxious or frightened about something",
                        "vi": "một tình huống trong đó nhiều người lo lắng hoặc sợ hãi về điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "a health scare",
                            "vi": "một nỗi sợ hãi về sức khỏe"
                        },
                        {
                            "en": "recent scares about pesticides in food",
                            "vi": "những lo sợ gần đây về thuốc trừ sâu trong thực phẩm"
                        },
                        {
                            "en": "a scare story (= a news report that spreads more anxiety or fear about something than is necessary)",
                            "vi": "một câu chuyện sợ hãi (= một bản tin lan truyền sự lo lắng hoặc sợ hãi về điều gì đó nhiều hơn mức cần thiết)"
                        },
                        {
                            "en": "to cause a major scare",
                            "vi": "gây ra một nỗi sợ hãi lớn"
                        },
                        {
                            "en": "scare tactics (= ways of persuading people to do something by frightening them)",
                            "vi": "chiến thuật hù dọa (= cách thuyết phục mọi người làm điều gì đó bằng cách làm họ sợ hãi)"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a sudden feeling of fear",
                        "vi": "một cảm giác sợ hãi đột ngột"
                    },
                    "examples": [
                        {
                            "en": "You gave me a scare!",
                            "vi": "Bạn đã cho tôi một nỗi sợ hãi!"
                        },
                        {
                            "en": "We've had quite a scare.",
                            "vi": "Chúng tôi đã có khá nhiều sợ hãi."
                        }
                    ]
                }
            ]
