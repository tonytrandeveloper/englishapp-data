    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "if somebody speaks drily, they are being humorous, but not in an obvious way",
                        "vi": "nếu ai đó nói một cách khô khan, họ đang hài hước, nhưng không phải theo cách rõ ràng"
                    },
                    "examples": [
                        {
                            "en": "‘That's a lovely purple suit you're wearing,’ she said drily.",
                            "vi": "\"Đó là một bộ đồ màu tím đáng yêu mà bạn đang mặc,\" cô nói một cách khô khan."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that shows no emotion",
                        "vi": "theo cách không biểu lộ cảm xúc"
                    },
                    "examples": [
                        {
                            "en": "He smiled drily and leaned back in his chair.",
                            "vi": "Anh cười nhạt và ngả người ra ghế."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that shows that there is no liquid present",
                        "vi": "theo cách cho thấy rằng không có chất lỏng hiện diện"
                    },
                    "examples": [
                        {
                            "en": "She coughed drily.",
                            "vi": "Cô ho khan."
                        },
                        {
                            "en": "He swallowed drily and nodded.",
                            "vi": "Anh nuốt khan và gật đầu."
                        }
                    ]
                }
            ]
        }
