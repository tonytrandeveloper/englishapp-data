    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a verb such as be, do and have used with main verbs to show tense, etc. and to form questions and negatives",
                        "vi": "một động từ như be, do và have được sử dụng với các động từ chính để thể hiện thì, v.v. và để tạo thành câu hỏi và phủ định"
                    },
                    "examples": [
                        {
                            "en": "In the question ‘Do you know where he has gone?’, ‘do’ and ‘has’ are auxiliaries.",
                            "vi": "Trong câu hỏi 'Bạn có biết anh ấy đã đi đâu không?', 'Do' và 'has' là các trợ từ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a worker who gives help or support to the main group of workers",
                        "vi": "một công nhân giúp đỡ hoặc hỗ trợ cho nhóm công nhân chính"
                    },
                    "examples": [
                        {
                            "en": "nursing auxiliaries",
                            "vi": "chất hỗ trợ điều dưỡng"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "giving help or support to the main group of workers",
                        "vi": "giúp đỡ hoặc hỗ trợ nhóm công nhân chính"
                    },
                    "examples": [
