            "means": [
                {
                    "define": {
                        "en": "if something goes awry, it does not happen in the way that was planned",
                        "vi": "nếu có điều gì đó tồi tệ xảy ra, nó không xảy ra theo cách đã được lên kế hoạch"
                    },
                    "examples": [
                        {
                            "en": "All my plans for the party had gone awry.",
                            "vi": "Tất cả các kế hoạch của tôi cho bữa tiệc đã thất bại."
                        },
                        {
                            "en": "All her carefully laid plans had gone awry.",
                            "vi": "Tất cả những kế hoạch được sắp đặt cẩn thận của cô đã trở nên thất bại."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not in the right position",
                        "vi": "không ở đúng vị trí"
                    },
                    "examples": [
                        {
                            "en": "She rushed out, her hair awry.",
                            "vi": "Cô lao ra, đầu tóc xơ xác."
                        }
                    ]
                }
            ]
        }
