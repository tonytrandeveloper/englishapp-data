{
    "id": "8b0475d76e5f449ca8740e889375a695",
    "word": "gush",
    "phonetic": {
        "uk": "/ɡʌʃ/",
        "us": "/ɡʌʃ/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a large amount of liquid suddenly and quickly flowing or pouring out of something",
                        "vi": "một lượng lớn chất lỏng chảy đột ngột và nhanh chóng hoặc đổ ra khỏi thứ gì đó"
                    },
                    "examples": [
                        {
                            "en": "a gush of blood",
                            "vi": "một dòng máu"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a sudden strong expression of feeling",
                        "vi": "một biểu hiện cảm giác mạnh mẽ đột ngột"
                    },
                    "examples": [
                        {
                            "en": "a gush of emotion",
                            "vi": "một luồng cảm xúc"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to flow or pour suddenly and quickly out of a hole in large amounts",
                        "vi": "chảy hoặc đổ đột ngột và nhanh chóng ra khỏi lỗ với một lượng lớn"
                    },
                    "examples": [
                        {
                            "en": "blood gushing from a wound",
                            "vi": "máu chảy ra từ vết thương"
                        },
                        {
                            "en": "Water gushed out of the pipe.",
                            "vi": "Nước phun ra từ đường ống."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to suddenly let out large amounts of a liquid",
                        "vi": "đột ngột thoát ra một lượng lớn chất lỏng"
                    },
                    "examples": [
                        {
                            "en": "The tanker was gushing oil.",
                            "vi": "Tàu chở dầu đang phun dầu."
                        },
                        {
                            "en": "(figurative) She absolutely gushed enthusiasm.",
                            "vi": "(nghĩa bóng) Cô ấy hoàn toàn phun ra sự nhiệt tình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to express so much praise or emotion about somebody/something that it does not seem sincere",
                        "vi": "để bày tỏ rất nhiều lời khen ngợi hoặc cảm xúc về ai đó / điều gì đó mà nó có vẻ không chân thành"
                    },
                    "examples": [
                        {
                            "en": "‘You are clever,’ she gushed.",
                            "vi": "\"Bạn thật thông minh,\" cô ấy nói."
                        }
                    ]
                }
            ]
        }
    ],
