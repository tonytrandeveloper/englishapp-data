    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a tune, especially the main tune in a piece of music written for several instruments or voices",
                        "vi": "một giai điệu, đặc biệt là giai điệu chính trong một bản nhạc được viết cho một số nhạc cụ hoặc giọng nói"
                    },
                    "examples": [
                        {
                            "en": "a haunting melody",
                            "vi": "một giai điệu ám ảnh"
                        },
                        {
                            "en": "The melody is then taken up by the flutes.",
                            "vi": "Giai điệu sau đó được cất lên bởi những chiếc sáo."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a piece of music or a song with a clear or simple tune",
                        "vi": "một bản nhạc hoặc một bài hát có giai điệu rõ ràng hoặc đơn giản"
                    },
                    "examples": [
                        {
                            "en": "old Irish melodies",
                            "vi": "giai điệu Ailen cũ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the arrangement of musical notes in a tune",
                        "vi": "sự sắp xếp của các nốt nhạc trong một giai điệu"
                    },
                    "examples": [
                        {
                            "en": "a few bars of melody drifted towards us",
                            "vi": "một vài thanh giai điệu trôi về phía chúng tôi"
                        }
                    ]
                }
            ]
        }
