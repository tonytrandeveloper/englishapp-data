    "word": "scholar",
    "phonetic": {
        "uk": "/ˈskɒlə(r)/",
        "us": "/ˈskɑːlər/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a person who knows a lot about a particular subject because they have studied it in detail",
                        "vi": "một người biết nhiều về một chủ đề cụ thể bởi vì họ đã nghiên cứu nó một cách chi tiết"
                    },
                    "examples": [
                        {
                            "en": "a classical scholar",
                            "vi": "một học giả cổ điển"
                        },
                        {
                            "en": "He was the most distinguished scholar in his field.",
                            "vi": "Ông là học giả xuất sắc nhất trong lĩnh vực của mình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a student who has been given a scholarship to study at a school, college or university",
                        "vi": "một sinh viên đã được nhận học bổng để học tại một trường học, cao đẳng hoặc đại học"
                    },
                    "examples": [
                        {
                            "en": "a Rhodes scholar",
                            "vi": "một học giả Rhodes"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a clever person who works hard at school",
                        "vi": "một người thông minh làm việc chăm chỉ ở trường"
                    },
                    "examples": [
                        {
                            "en": "I was never much of a scholar.",
                            "vi": "Tôi chưa bao giờ là một học giả."
                        }
                    ]
                }
            ]
        }
