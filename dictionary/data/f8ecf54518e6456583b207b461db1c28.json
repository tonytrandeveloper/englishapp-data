    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "having a lot of stones on it or in it",
                        "vi": "có rất nhiều đá trên đó hoặc trong đó"
                    },
                    "examples": [
                        {
                            "en": "stony soil",
                            "vi": "đất đá"
                        },
                        {
                            "en": "a stony beach",
                            "vi": "một bãi biển đá"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "showing a lack of feeling or sympathy",
                        "vi": "thể hiện sự thiếu cảm thông hoặc cảm thông"
                    },
                    "examples": [
                        {
                            "en": "They listened to him in stony silence.",
                            "vi": "Họ lắng nghe anh ta trong im lặng như đá."
                        },
                        {
                            "en": "She met Luke’s hard, stony eyes.",
                            "vi": "Cô bắt gặp đôi mắt cứng cỏi và cứng cỏi của Luke."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to fail to produce the result or the effect that you hope for; to have little success",
                        "vi": "không tạo ra kết quả hoặc hiệu quả mà bạn hy vọng; có một chút thành công"
                    },
                    "examples": [
                        {
                            "en": "His charming smile fell on stony ground with her.",
                            "vi": "Nụ cười quyến rũ của anh rơi trên nền đất đá với cô."
                        },
                        {
                            "en": "The peace initiatives have already fallen on stony ground.",
                            "vi": "Các sáng kiến hòa bình đã sụp đổ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "completely broke (= without money)",
                        "vi": "hoàn toàn bị phá vỡ (= không có tiền)"
                    },
                    "examples": []
                }
            ]
        }
