            "means": [
                {
                    "define": {
                        "en": "in a way that involves spending a lot more money or using a lot more of something than you can afford or than is necessary",
                        "vi": "theo cách liên quan đến việc tiêu nhiều tiền hơn hoặc sử dụng nhiều thứ hơn mức bạn có thể chi trả hoặc mức cần thiết"
                    },
                    "examples": [
                        {
                            "en": "They do not live extravagantly.",
                            "vi": "Họ không sống xa hoa."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that costs a lot more money than you can afford or is necessary",
                        "vi": "theo cách tốn nhiều tiền hơn bạn có thể chi trả hoặc cần thiết"
                    },
                    "examples": [
                        {
                            "en": "extravagantly expensive",
                            "vi": "đắt tiền"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is very extreme or impressive but not reasonable or practical",
                        "vi": "theo cách rất cực đoan hoặc ấn tượng nhưng không hợp lý hoặc không thực tế"
                    },
                    "examples": [
                        {
                            "en": "extravagantly high hopes",
                            "vi": "hy vọng cao tột độ"
                        },
                        {
                            "en": "She praised him extravagantly.",
                            "vi": "Cô khen ngợi anh ta một cách ngông cuồng."
