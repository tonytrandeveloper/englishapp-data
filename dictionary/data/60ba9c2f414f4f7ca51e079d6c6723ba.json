                        "vi": "trái để phát triển; không cắt ngắn"
                    },
                    "examples": [
                        {
                            "en": "The uncut grass came up to her waist.",
                            "vi": "Cỏ chưa cắt đã đến thắt lưng cô."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "left in its complete form; without any parts removed; not censored",
                        "vi": "còn lại ở dạng hoàn chỉnh; mà không có bất kỳ bộ phận nào bị loại bỏ; không bị kiểm duyệt"
                    },
                    "examples": [
                        {
                            "en": "the original uncut version",
                            "vi": "phiên bản gốc chưa cắt"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not given a shape by cutting",
                        "vi": "không cho một hình dạng bằng cách cắt"
                    },
                    "examples": [
