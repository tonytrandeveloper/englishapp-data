            "means": [
                {
                    "define": {
                        "en": "to go together badly or to be not suitable for each other",
                        "vi": "đi với nhau xấu hoặc không hợp với nhau"
                    },
                    "examples": [
                        {
                            "en": "They made a mismatched couple.",
                            "vi": "Họ đã tạo thành một cặp đôi không tương xứng."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a combination of things or people that do not go together well or are not suitable for each other",
                        "vi": "sự kết hợp của những thứ hoặc những người không đi cùng nhau hoặc không phù hợp với nhau"
                    },
                    "examples": [
                        {
                            "en": "a mismatch between people’s real needs and the available facilities",
                            "vi": "sự không phù hợp giữa nhu cầu thực sự của con người và các phương tiện sẵn có"
                        }
                    ]
                }
