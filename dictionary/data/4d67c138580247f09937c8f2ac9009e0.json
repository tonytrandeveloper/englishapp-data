                {
                    "define": {
                        "en": "a tall narrow building or part of a building, especially of a church or castle",
                        "vi": "một tòa nhà cao hẹp hoặc một phần của tòa nhà, đặc biệt là của một nhà thờ hoặc lâu đài"
                    },
                    "examples": [
                        {
                            "en": "a bell tower",
                            "vi": "tháp chuông"
                        },
                        {
                            "en": "the Eiffel Tower",
                            "vi": "Tháp Eiffel"
                        },
                        {
                            "en": "a 19-storey office tower",
                            "vi": "tòa tháp văn phòng 19 tầng"
                        },
                        {
                            "en": "The castle is rectangular in shape, with a tower at each corner.",
                            "vi": "Lâu đài có hình chữ nhật, với một tháp ở mỗi góc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a tall structure used for sending television or radio signals",
                        "vi": "một cấu trúc cao được sử dụng để gửi tín hiệu truyền hình hoặc radio"
                    },
                    "examples": [
                        {
                            "en": "a television tower",
                            "vi": "tháp truyền hình"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a tall piece of furniture used for storing things",
                        "vi": "một món đồ nội thất cao dùng để đựng đồ"
                    },
                    "examples": [
                        {
                            "en": "a CD tower",
                            "vi": "một tháp CD"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a person that you can rely on to help, protect and comfort you when you are in trouble",
                        "vi": "một người mà bạn có thể dựa vào để giúp đỡ, bảo vệ và an ủi bạn khi bạn gặp khó khăn"
                    },
                    "examples": [
                        {
                            "en": "He was a tower of strength to his sisters when their father died.",
                            "vi": "Anh ấy là ngọn tháp sức mạnh cho các chị gái của mình khi cha của họ qua đời."
                        }
