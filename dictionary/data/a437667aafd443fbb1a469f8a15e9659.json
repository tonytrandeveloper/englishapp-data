    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that shows fine personal qualities that people admire, such as courage, honesty and care for others",
                        "vi": "theo cách thể hiện những phẩm chất cá nhân tốt đẹp mà mọi người ngưỡng mộ, chẳng hạn như lòng dũng cảm, trung thực và quan tâm đến người khác"
                    },
                    "examples": [
                        {
                            "en": "She bore the disappointment nobly.",
                            "vi": "Cô ấy mang nỗi thất vọng vô cùng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to a family of high social rank; of the nobility",
                        "vi": "vào một gia đình có địa vị xã hội cao; của giới quý tộc"
                    },
                    "examples": [
                        {
                            "en": "to be nobly born",
                            "vi": "được sinh ra tuyệt vời"
                        }
                    ]
                }
            ]
