                    },
                    "examples": [
                        {
                            "en": "his unsteadiness when walking",
                            "vi": "anh ấy không vững khi bước đi"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of shaking and lacking control",
                        "vi": "thực tế là rung chuyển và thiếu kiểm soát"
                    },
                    "examples": [
