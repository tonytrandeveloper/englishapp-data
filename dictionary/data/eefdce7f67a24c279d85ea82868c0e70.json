            "means": [
                {
                    "define": {
                        "en": "to do something badly so that you fail to achieve what you wanted or hoped to achieve",
                        "vi": "làm điều gì đó tồi tệ để bạn không đạt được những gì bạn muốn hoặc hy vọng đạt được"
                    },
                    "examples": [
                        {
                            "en": "He completely mucked up his English exam.",
                            "vi": "Anh ấy đã hoàn toàn bỏ qua kỳ thi tiếng Anh của mình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to cause a plan or an arrangement to fail",
                        "vi": "khiến một kế hoạch hoặc một sự sắp xếp thất bại"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to make something dirty",
                        "vi": "để làm một cái gì đó bẩn"
                    },
                    "examples": [
                        {
                            "en": "I don't want you mucking up my nice clean floor.",
                            "vi": "Tôi không muốn bạn làm hỏng sàn nhà sạch đẹp của tôi."
                        }
                    ]
                }
            ]
