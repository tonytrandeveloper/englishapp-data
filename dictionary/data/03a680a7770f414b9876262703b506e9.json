    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "connected with, or near the North or South Pole",
                        "vi": "được kết nối với, hoặc gần cực Bắc hoặc cực Nam"
                    },
                    "examples": [
                        {
                            "en": "the polar regions",
                            "vi": "các vùng cực"
                        },
                        {
                            "en": "polar ice",
                            "vi": "băng cực"
                        },
                        {
                            "en": "polar explorers",
                            "vi": "thám hiểm địa cực"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "connected with the poles (= the positive and negative ends) of a magnet",
                        "vi": "được nối với các cực (= cực dương và cực âm) của một nam châm"
                    },
                    "examples": [
                        {
                            "en": "polar attraction",
                            "vi": "cực thu hút"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to describe something that is the complete opposite of something else",
                        "vi": "được sử dụng để mô tả một cái gì đó hoàn toàn trái ngược với một cái gì đó khác"
                    },
                    "examples": [
                        {
                            "en": "The parents' position is often the polar opposite of the child's.",
                            "vi": "Vị trí của cha mẹ thường đối nghịch với con cái."
                        }
                    ]
                }
            ]
