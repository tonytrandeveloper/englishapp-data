            "means": [
                {
                    "define": {
                        "en": "not doing anything; not active",
                        "vi": "đang không làm gì cả; không hoạt động"
                    },
                    "examples": [
                        {
                            "en": "Some animals are inactive during the daytime.",
                            "vi": "Một số động vật không hoạt động vào ban ngày."
                        },
                        {
                            "en": "politically inactive",
                            "vi": "không hoạt động chính trị"
                        },
                        {
                            "en": "The volcano has been inactive for 50 years.",
                            "vi": "Núi lửa đã ngừng hoạt động trong 50 năm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not in use; not working",
                        "vi": "không sử dụng; không làm việc"
                    },
                    "examples": [
                        {
