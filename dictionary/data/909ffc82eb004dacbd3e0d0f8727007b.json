{
    "id": "909ffc82eb004dacbd3e0d0f8727007b",
    "word": "confound",
    "phonetic": {
        "uk": "/kənˈfaʊnd/",
        "us": "/kənˈfaʊnd/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to confuse and surprise somebody",
                        "vi": "làm ai đó bối rối và ngạc nhiên"
                    },
                    "examples": [
                        {
                            "en": "The sudden rise in share prices has confounded economists.",
                            "vi": "Giá cổ phiếu tăng đột ngột đã khiến các nhà kinh tế bối rối."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to prove somebody/something wrong",
                        "vi": "để chứng minh ai đó / điều gì đó sai"
                    },
                    "examples": [
                        {
                            "en": "to confound expectations",
                            "vi": "để làm nhiễu kỳ vọng"
                        },
                        {
                            "en": "She confounded her critics and proved she could do the job.",
                            "vi": "Cô ấy đã khiến những người chỉ trích của mình bối rối và chứng minh rằng cô ấy có thể làm được việc."
                        },
                        {
                            "en": "The rise in share prices confounded expectations.",
                            "vi": "Việc tăng giá cổ phiếu đã làm xáo trộn kỳ vọng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to defeat an enemy",
                        "vi": "để đánh bại kẻ thù"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "used to show that you are angry about something/with somebody",
                        "vi": "được sử dụng để cho thấy rằng bạn đang tức giận về điều gì đó / với ai đó"
                    },
                    "examples": []
                }
            ]
        }
