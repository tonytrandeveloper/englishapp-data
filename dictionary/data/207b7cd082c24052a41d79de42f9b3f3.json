    "word": "next door",
    "phonetic": {
        "uk": "/ˌnekst ˈdɔː(r)/",
        "us": "/ˌnekst ˈdɔːr/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in the next room, house or building",
                        "vi": "trong căn phòng, ngôi nhà hoặc tòa nhà tiếp theo"
                    },
                    "examples": [
                        {
                            "en": "The cat is from the house next door.",
                            "vi": "Con mèo ở nhà bên cạnh."
                        },
                        {
                            "en": "The manager's office is just next door.",
                            "vi": "Văn phòng của người quản lý ở ngay bên cạnh."
                        },
                        {
                            "en": "We live next door to the bank.",
                            "vi": "Chúng tôi sống cạnh ngân hàng."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the people who live in the house or flat next to yours",
                        "vi": "những người sống trong ngôi nhà hoặc căn hộ cạnh bạn"
                    },
                    "examples": [
                        {
                            "en": "Is that next door's dog?",
                            "vi": "Có phải đó là con chó của nhà bên cạnh?"
                        },
                        {
                            "en": "The Volvo belongs to next door.",
                            "vi": "Chiếc Volvo thuộc về nhà bên cạnh."
                        }
                    ]
                }
            ]
        }
    ],
