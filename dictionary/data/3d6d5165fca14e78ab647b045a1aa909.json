{
    "id": "3d6d5165fca14e78ab647b045a1aa909",
    "word": "thinly",
    "phonetic": {
        "uk": "/ˈθɪnli/",
        "us": "/ˈθɪnli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that produces a thin piece or layer of something",
                        "vi": "theo cách tạo ra một miếng hoặc một lớp mỏng"
                    },
                    "examples": [
                        {
                            "en": "Slice the potatoes thinly.",
                            "vi": "Thái mỏng khoai tây."
                        },
                        {
                            "en": "The ointment should be spread thinly on the bruised areas.",
                            "vi": "Thuốc mỡ nên được thoa mỏng trên các khu vực bị bầm tím."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with only a few things or people spread over a place so that there is a lot of space between them",
                        "vi": "chỉ với một vài thứ hoặc mọi người rải rác ở một nơi để có nhiều khoảng trống giữa chúng"
                    },
                    "examples": [
                        {
                            "en": "a thinly populated area",
                            "vi": "một khu vực dân cư thưa thớt"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not sincere or enthusiastic",
                        "vi": "theo cách không chân thành hoặc không nhiệt tình"
                    },
                    "examples": [
                        {
                            "en": "She smiled thinly.",
                            "vi": "Cô cười nhạt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that does not hide the truth very well",
                        "vi": "theo một cách không che giấu sự thật rất tốt"
                    },
                    "examples": [
                        {
                            "en": "The novel is a thinly disguised autobiography.",
                            "vi": "Cuốn tiểu thuyết là một cuốn tự truyện được ngụy trang mỏng manh."
                        },
                        {
                            "en": "thinly veiled contempt",
                            "vi": "khinh miệt che kín mặt"
                        }
                    ]
                }
            ]
        }
    ],
