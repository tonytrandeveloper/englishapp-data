{
    "id": "f0453f1b6cbe4564b74dd5b2c4d0d29a",
    "word": "gargle",
    "phonetic": {
        "uk": "/ˈɡɑːɡl/",
        "us": "/ˈɡɑːrɡl/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to wash inside your mouth and throat by moving a liquid around at the back of your throat and then spitting it out",
                        "vi": "rửa bên trong miệng và cổ họng của bạn bằng cách di chuyển một chất lỏng xung quanh cổ họng của bạn và sau đó phun ra"
                    },
                    "examples": [
                        {
                            "en": "Gargle with salt water if your throat is sore.",
                            "vi": "Súc miệng bằng nước muối nếu cổ họng bị đau."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a liquid used for gargling",
                        "vi": "một chất lỏng dùng để súc miệng"
                    },
                    "examples": [
                        {
                            "en": "an antiseptic gargle",
                            "vi": "súc miệng sát trùng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "an act of gargling or a sound like that made when gargling",
                        "vi": "một hành động súc miệng hoặc một âm thanh tương tự như vậy được tạo ra khi súc miệng"
                    },
                    "examples": [
                        {
                            "en": "to have a gargle with salt water",
                            "vi": "súc miệng bằng nước muối"
                        },
                        {
                            "en": "a bellowing gargle of pain",
                            "vi": "một tiếng súc miệng đau đớn"
                        }
                    ]
                }
            ]
        }
    ],
