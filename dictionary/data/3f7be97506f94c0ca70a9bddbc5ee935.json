    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "allowing you to see through it",
                        "vi": "cho phép bạn nhìn xuyên qua nó"
                    },
                    "examples": [
                        {
                            "en": "The insect's wings are almost transparent.",
                            "vi": "Cánh của côn trùng gần như trong suốt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "that you can easily see is false; allowing you to see the truth easily",
                        "vi": "mà bạn có thể dễ dàng nhận thấy là sai; cho phép bạn nhìn thấy sự thật một cách dễ dàng"
                    },
                    "examples": [
                        {
                            "en": "a transparent attempt to buy votes",
                            "vi": "một nỗ lực minh bạch để mua phiếu bầu"
                        },
                        {
                            "en": "a transparent lie/ploy/ruse",
                            "vi": "một lời nói dối / mưu đồ / mưu mẹo minh bạch"
                        },
                        {
                            "en": "Am I that transparent? (= are my intentions that obvious?)",
                            "vi": "Tôi có minh bạch như vậy không? (= ý định của tôi có rõ ràng không?)"
                        },
                        {
                            "en": "a man of transparent honesty",
                            "vi": "một người trung thực minh bạch"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "easy to understand",
                        "vi": "dễ hiểu"
                    },
                    "examples": [
                        {
                            "en": "a campaign to make official documents more transparent",
                            "vi": "một chiến dịch để làm cho các tài liệu chính thức minh bạch hơn"
                        }
                    ]
                }
