            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "across fields or open country rather than on roads or a track",
                        "vi": "qua các cánh đồng hoặc đất nước rộng mở hơn là trên những con đường hoặc một con đường"
                    },
                    "examples": [
                        {
                            "en": "cross-country running",
                            "vi": "chạy xuyên quốc gia"
                        },
                        {
                            "en": "We rode cross-country.",
                            "vi": "Chúng tôi đạp xe xuyên quốc gia."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "from one part of a country to the other, especially not using main roads or routes",
                        "vi": "từ một phần của quốc gia này đến quốc gia khác, đặc biệt là không sử dụng đường chính hoặc các tuyến đường"
                    },
                    "examples": [
                        {
                            "en": "cross-country train journeys",
                            "vi": "những chuyến tàu xuyên quốc gia"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "involving two or more countries",
                        "vi": "liên quan đến hai hoặc nhiều quốc gia"
                    },
                    "examples": [
                        {
                            "en": "The report contains the findings of a cross-country comparison of crime statistics.",
                            "vi": "Báo cáo bao gồm các kết quả so sánh giữa các quốc gia về số liệu thống kê tội phạm."
                        }
                    ]
                }
            ]
        },
