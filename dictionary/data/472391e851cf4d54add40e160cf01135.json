                    },
                    "examples": [
                        {
                            "en": "food pellets for chickens",
                            "vi": "thức ăn viên cho gà"
                        },
                        {
                            "en": "owl pellets (= the dried waste material from owls)",
                            "vi": "viên cú (= phế liệu khô từ cú)"
                        },
                        {
                            "en": "slug pellets (= to kill slugs)",
                            "vi": "viên sên (= để giết sên)"
                        }
                    ]
                },
                {
                    "define": {
