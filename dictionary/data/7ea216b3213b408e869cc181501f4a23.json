                        "vi": "ngựa hoặc người tham gia cuộc đua bất hợp pháp, chẳng hạn bằng cách sử dụng tên giả"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to look very like somebody",
                        "vi": "trông rất giống ai đó"
                    },
                    "examples": [
                        {
                            "en": "She's a dead ringer for a girl I used to know.",
