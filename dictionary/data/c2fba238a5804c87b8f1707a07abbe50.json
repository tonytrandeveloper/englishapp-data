            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a verb such as be or become that connects a subject with the adjective or noun (called the complement) that describes it",
                        "vi": "một động từ chẳng hạn như be hoặc trở thành kết nối chủ ngữ với tính từ hoặc danh từ (được gọi là bổ ngữ) mô tả nó"
                    },
                    "examples": [
                        {
                            "en": "In ‘She became angry’, the verb ‘became’ is a linking verb.",
                            "vi": "Trong 'Cô ấy trở nên tức giận', động từ 'trở thành' là động từ nối."
                        }
                    ]
                }
            ]
