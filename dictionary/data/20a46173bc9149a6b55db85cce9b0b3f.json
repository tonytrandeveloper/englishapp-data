    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the feeling of needing or wanting a drink",
                        "vi": "cảm giác cần hoặc muốn uống một ly"
                    },
                    "examples": [
                        {
                            "en": "He quenched his thirst with a long drink of cold water.",
                            "vi": "Anh làm dịu cơn khát của mình bằng một ngụm nước lạnh dài."
                        },
                        {
                            "en": "She woke up with a raging thirst and a headache.",
                            "vi": "Cô thức dậy với cơn khát dữ dội và đau đầu."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the state of not having enough water to drink",
                        "vi": "tình trạng không có đủ nước để uống"
                    },
                    "examples": [
                        {
                            "en": "Thousands are dying of thirst.",
                            "vi": "Hàng ngàn người đang chết khát."
                        },
                        {
                            "en": "Many of the refugees were suffering badly from thirst.",
                            "vi": "Nhiều người trong số những người tị nạn đã phải chịu đựng một cách tồi tệ vì khát."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a strong desire for something",
                        "vi": "một mong muốn mạnh mẽ cho một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "a thirst for knowledge",
                            "vi": "khát khao kiến thức"
                        }
                    ]
                }
            ]
        },
