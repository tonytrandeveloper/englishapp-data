    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "going to happen, be published, etc. very soon",
                        "vi": "sẽ xảy ra, được xuất bản, v.v. rất sớm"
                    },
                    "examples": [
                        {
                            "en": "the forthcoming elections",
                            "vi": "cuộc bầu cử sắp tới"
                        },
                        {
                            "en": "a list of forthcoming books",
                            "vi": "danh sách những cuốn sách sắp ra mắt"
                        },
                        {
                            "en": "the band’s forthcoming UK tour",
                            "vi": "chuyến lưu diễn sắp tới của ban nhạc tại Vương quốc Anh"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "ready or made available when needed",
                        "vi": "sẵn sàng hoặc có sẵn khi cần thiết"
                    },
                    "examples": [
                        {
                            "en": "Financial support was not forthcoming.",
                            "vi": "Hỗ trợ tài chính không sắp tới."
                        },
                        {
                            "en": "Help was immediately forthcoming.",
                            "vi": "Sự giúp đỡ đã ngay lập tức đến."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "willing to give information about something",
                        "vi": "sẵn sàng cung cấp thông tin về một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "She's never very forthcoming about her plans.",
                            "vi": "Cô ấy không bao giờ chuẩn bị cho kế hoạch của mình."
                        }
                    ]
                }
            ]
