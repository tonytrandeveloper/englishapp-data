    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a very strict way that is difficult to change",
                        "vi": "theo một cách rất nghiêm ngặt khó thay đổi"
                    },
                    "examples": [
                        {
                            "en": "The speed limit must be rigidly enforced.",
                            "vi": "Giới hạn tốc độ phải được thực thi nghiêm ngặt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that shows that somebody is not willing to change their ideas or behaviour",
                        "vi": "theo cách cho thấy ai đó không sẵn sàng thay đổi ý tưởng hoặc hành vi của họ"
                    },
                    "examples": [
                        {
                            "en": "Jim was sticking rigidly to his point.",
                            "vi": "Jim đang kiên định với quan điểm của mình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "without bending or moving",
                        "vi": "không uốn cong hoặc di chuyển"
                    },
                    "examples": [
                        {
                            "en": "She stared rigidly ahead.",
                            "vi": "Cô nhìn chằm chằm vào phía trước một cách cứng nhắc."
                        }
                    ]
                }
            ]
