    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "carefully and using a lot of detail",
                        "vi": "cẩn thận và sử dụng nhiều chi tiết"
                    },
                    "examples": [
                        {
                            "en": "a delicately carved chair",
                            "vi": "một chiếc ghế được chạm khắc tinh xảo"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with care or skill",
                        "vi": "với sự cẩn thận hoặc kỹ năng"
                    },
                    "examples": [
                        {
                            "en": "He stepped delicately over the broken glass.",
                            "vi": "Anh tế nhị bước qua tấm kính vỡ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with careful or sensitive treatment, without hurting anyone's feelings",
                        "vi": "với sự đối xử cẩn thận hoặc nhạy cảm, không làm tổn thương cảm xúc của bất kỳ ai"
                    },
                    "examples": [
                        {
                            "en": "This matter needs to be delicately handled.",
                            "vi": "Vấn đề này cần được xử lý một cách tế nhị."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is light and pleasant; not strongly",
                        "vi": "một cách nhẹ nhàng và dễ chịu; không mạnh mẽ"
                    },
                    "examples": [
                        {
