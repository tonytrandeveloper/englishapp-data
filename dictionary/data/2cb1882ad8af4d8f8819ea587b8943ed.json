    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to fill with air and become rounder",
                        "vi": "để đầy không khí và trở nên tròn hơn"
                    },
                    "examples": [
                        {
                            "en": "The sails bellied out in the wind.",
                            "vi": "Cánh buồm căng ra trong gió."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the part of the body below the chest",
                        "vi": "phần cơ thể bên dưới ngực"
                    },
                    "examples": [
                        {
                            "en": "They crawled along on their bellies.",
                            "vi": "Họ bò dọc theo bụng của họ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the round or curved part of an object",
                        "vi": "phần tròn hoặc cong của một vật thể"
                    },
                    "examples": [
                        {
                            "en": "the belly of a ship",
                            "vi": "bụng của một con tàu"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having the type of belly mentioned",
                        "vi": "có kiểu bụng được đề cập"
                    },
                    "examples": [
                        {
                            "en": "swollen-bellied",
                            "vi": "sưng-bụng"
                        },
                        {
                            "en": "round-bellied",
                            "vi": "bụng tròn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a very strong desire to achieve something",
                        "vi": "một mong muốn rất mạnh mẽ để đạt được một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "You need fire in your belly if you want to make it in the music business.",
                            "vi": "Bạn cần có lửa trong bụng nếu bạn muốn thành công trong lĩnh vực kinh doanh âm nhạc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to fail completely",
                        "vi": "thất bại hoàn toàn"
                    },
                    "examples": [
                        {
                            "en": "Last year the business went belly up after one of the partners resigned.",
                            "vi": "Năm ngoái, công việc kinh doanh đi lên sau khi một trong những đối tác từ chức."
                        }
                    ]
                }
            ]
