                    "define": {
                        "en": "in a very serious and important way; in a way that gives you a reason to feel worried",
                        "vi": "một cách rất nghiêm túc và quan trọng; theo cách cho bạn lý do để cảm thấy lo lắng"
                    },
                    "examples": [
                        {
                            "en": "She is gravely ill.",
                            "vi": "Cô ấy bị ốm nặng."
                        },
                        {
                            "en": "Local people are gravely concerned.",
                            "vi": "Người dân địa phương rất quan tâm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is serious in manner, as if something sad or important has just happened",
                        "vi": "một cách nghiêm túc, như thể có chuyện buồn hoặc quan trọng vừa xảy ra"
                    },
                    "examples": [
                        {
                            "en": "He nodded gravely as I poured out my troubles.",
                            "vi": "Anh ấy gật đầu một cách nghiêm túc khi tôi trút bỏ mọi muộn phiền."
                        }
                    ]
                }
