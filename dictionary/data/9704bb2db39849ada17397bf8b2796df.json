            "means": [
                {
                    "define": {
                        "en": "to make a remark that interrupts a conversation",
                        "vi": "để đưa ra nhận xét làm gián đoạn cuộc trò chuyện"
                    },
                    "examples": [
                        {
                            "en": "‘But why?’ he interpolated.",
                            "vi": "'Nhưng tại sao?' anh ta nội suy."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to add something to a piece of writing",
                        "vi": "để thêm một cái gì đó vào một đoạn văn bản"
                    },
                    "examples": [
                        {
                            "en": "The lines were interpolated into the manuscript at a later date.",
                            "vi": "Các dòng đã được nội suy vào bản thảo vào một ngày sau đó."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to add a value into a series by calculating it from surrounding known values",
                        "vi": "để thêm một giá trị vào một chuỗi bằng cách tính toán nó từ các giá trị đã biết xung quanh"
