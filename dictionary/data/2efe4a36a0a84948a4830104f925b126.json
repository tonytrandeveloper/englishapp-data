    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a cup, usually made of plastic and often without a handle, used for drinking from",
                        "vi": "một chiếc cốc, thường được làm bằng nhựa và thường không có tay cầm, được sử dụng để uống từ"
                    },
                    "examples": [
                        {
                            "en": "She drank from a plastic beaker.",
                            "vi": "Cô ấy uống từ một cốc nhựa."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the amount contained in a beaker",
                        "vi": "số lượng chứa trong cốc"
                    },
                    "examples": [
                        {
                            "en": "a beaker of coffee",
                            "vi": "một cốc cà phê"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a glass cup with straight sides and a lip, used in chemistry, for example for measuring liquids",
                        "vi": "một cốc thủy tinh có các cạnh thẳng và một môi, được sử dụng trong hóa học, ví dụ như để đo chất lỏng"
                    },
                    "examples": [
                        {
                            "en": "a glass beaker containing copper sulphate solution",
                            "vi": "một cốc thủy tinh chứa dung dịch đồng sunfat"
                        }
                    ]
                }
            ]
        }
