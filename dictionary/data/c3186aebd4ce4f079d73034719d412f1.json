{
    "id": "c3186aebd4ce4f079d73034719d412f1",
    "word": "muddy",
    "phonetic": {
        "uk": "/ˈmʌdi/",
        "us": "/ˈmʌdi/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "full of or covered in mud",
                        "vi": "đầy hoặc phủ đầy bùn"
                    },
                    "examples": [
                        {
                            "en": "a muddy field/track",
                            "vi": "một cánh đồng lầy lội / đường mòn"
                        },
                        {
                            "en": "muddy boots/knees",
                            "vi": "ủng / đầu gối dính bùn"
                        },
                        {
                            "en": "Look, you’ve made the floor all muddy!",
                            "vi": "Nghe này, bạn đã làm cho sàn nhà trở nên lầy lội!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "containing mud; not clear",
                        "vi": "chứa bùn; không rõ ràng"
                    },
                    "examples": [
                        {
                            "en": "muddy water",
                            "vi": "nước bùn"
                        },
                        {
                            "en": "a muddy pond",
                            "vi": "một cái ao đầy bùn"
                        },
                        {
                            "en": "The water where the dolphins were kept was so muddy that they could not see anything.",
                            "vi": "Nước nơi nhốt cá heo rất bùn khiến chúng không thể nhìn thấy gì."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not clear or bright",
                        "vi": "không rõ ràng hoặc sáng"
                    },
                    "examples": [
                        {
                            "en": "muddy green/brown",
                            "vi": "màu xanh lá cây / nâu bùn"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make something muddy",
                        "vi": "để làm một cái gì đó lầy lội"
                    },
                    "examples": [
                        {
                            "en": "She had muddied her white dress.",
                            "vi": "Cô ấy đã làm ướt chiếc váy trắng của mình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to make a simple situation confused and more complicated than it really is",
                        "vi": "để làm cho một tình huống đơn giản trở nên bối rối và phức tạp hơn thực tế"
                    },
                    "examples": [
                        {
                            "en": "She deliberately muddied the waters by constantly referring to other irrelevant cases.",
                            "vi": "Cô ấy cố tình làm vẩn đục vùng nước bằng cách liên tục đề cập đến những trường hợp không liên quan khác."
                        }
                    ]
                }
            ]
        }
    ],
