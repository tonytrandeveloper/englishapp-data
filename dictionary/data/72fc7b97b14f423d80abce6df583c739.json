    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to kill somebody/something in a war or a fight",
                        "vi": "giết ai đó / cái gì đó trong một cuộc chiến hoặc một cuộc chiến"
                    },
                    "examples": [
                        {
                            "en": "St George slew the dragon.",
                            "vi": "St George đã giết con rồng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to murder somebody",
                        "vi": "giết ai đó"
                    },
                    "examples": [
                        {
                            "en": "Two passengers were slain by the hijackers.",
                            "vi": "Hai hành khách đã bị giết bởi những kẻ không tặc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to have a strong effect on somebody, especially to make them laugh",
                        "vi": "để có hiệu ứng mạnh mẽ đối với ai đó, đặc biệt là làm cho họ cười"
                    },
                    "examples": [
                        {
                            "en": "Those old movies still slay me!",
                            "vi": "Những bộ phim cũ vẫn giết tôi!"
                        }
                    ]
                }
            ]
        }
