    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a taste like that of a lemon or of fruit that is not ready to eat",
                        "vi": "hương vị như chanh hoặc trái cây chưa sẵn sàng để ăn"
                    },
                    "examples": [
                        {
                            "en": "the sourness of the fruit",
                            "vi": "vị chua của trái cây"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "an unpleasant taste or smell, especially of milk, because it is not fresh",
                        "vi": "mùi hoặc vị khó chịu, đặc biệt là của sữa, vì nó không tươi"
                    },
                    "examples": [
                        {
                            "en": "He sniffed the milk for a hint of sourness.",
                            "vi": "Anh ngửi sữa để tìm chút vị chua."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of not being cheerful; the fact of being unfriendly and unpleasant",
                        "vi": "thực tế là không vui vẻ; thực tế là không thân thiện và khó chịu"
                    },
                    "examples": [
                        {
                            "en": "his increasing sourness",
                            "vi": "vị chua ngày càng tăng của anh ấy"
                        }
                    ]
                }
            ]
        }
