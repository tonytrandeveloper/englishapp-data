                        "en": "to make a fire stop burning or a light stop shining",
                        "vi": "để làm cho ngọn lửa ngừng cháy hoặc một ngọn đèn ngừng sáng"
                    },
                    "examples": [
                        {
                            "en": "Firefighters tried to extinguish the flames.",
                            "vi": "Lực lượng cứu hỏa cố gắng dập tắt ngọn lửa."
                        },
                        {
                            "en": "All lights had been extinguished.",
                            "vi": "Tất cả đèn đã bị tắt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to destroy something",
                        "vi": "để phá hủy một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "News of the bombing extinguished all hope of peace.",
                            "vi": "Tin tức về vụ đánh bom đã dập tắt mọi hy vọng hòa bình."
                        }
                    ]
