            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a piece of paper, plastic, etc. that is wrapped around something, especially food, when you buy it in order to protect it and keep it clean",
                        "vi": "một mảnh giấy, nhựa, v.v. được bọc xung quanh thứ gì đó, đặc biệt là thực phẩm, khi bạn mua chúng để bảo vệ chúng và giữ cho chúng sạch sẽ"
                    },
                    "examples": [
                        {
                            "en": "(British English) sweet wrappers",
                            "vi": "(Anh Anh) giấy gói ngọt ngào"
                        },
                        {
                            "en": "(North American English) candy wrappers",
                            "vi": "Giấy gói kẹo (tiếng Anh Bắc Mỹ)"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a piece of cloth that is worn as an item of clothing around the lower body and legs",
                        "vi": "một mảnh vải được mặc như một loại quần áo xung quanh phần dưới cơ thể và chân"
                    },
