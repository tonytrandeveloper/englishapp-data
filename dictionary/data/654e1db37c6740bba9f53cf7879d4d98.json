    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a way of spelling ‘love’, when used as an informal way of addressing somebody",
                        "vi": "một cách đánh vần 'love', khi được sử dụng như một cách xưng hô thân mật với ai đó"
                    },
                    "examples": [
                        {
                            "en": "Never mind, luv.",
                            "vi": "Đừng bận tâm, luv."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "an informal way of spelling ‘love’, for example when ending a letter",
                        "vi": "một cách đánh vần không chính thức từ 'love', chẳng hạn như khi kết thúc một bức thư"
                    },
                    "examples": [
                        {
                            "en": "See you soon, lots of luv, Sue.",
                            "vi": "Hẹn gặp lại mọi người, rất nhiều luv, Sue."
                        }
                    ]
                }
            ]
        }
