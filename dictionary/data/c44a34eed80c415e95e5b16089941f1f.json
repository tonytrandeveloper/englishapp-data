            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that shows somebody is unwilling to work or be active",
                        "vi": "theo cách cho thấy ai đó không sẵn sàng làm việc hoặc hoạt động"
                    },
                    "examples": [
                        {
                            "en": "We sat around lazily.",
                            "vi": "Chúng tôi uể oải ngồi xung quanh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that does not show enough care",
                        "vi": "theo cách không thể hiện đủ sự quan tâm"
                    },
                    "examples": [
                        {
                            "en": "a lazily scripted, poorly constructed film",
                            "vi": "một bộ phim được dựng kịch bản, kém chất lượng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is slow and relaxed",
                        "vi": "một cách chậm rãi và thoải mái"
                    },
                    "examples": [
                        {
                            "en": "She woke up and stretched lazily.",
                            "vi": "Cô tỉnh dậy và vươn vai một cách uể oải."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with slow movements",
                        "vi": "với chuyển động chậm"
                    },
                    "examples": [
                        {
                            "en": "The birds circled lazily above our heads.",
                            "vi": "Những con chim uể oải bay lượn trên đầu chúng tôi."
