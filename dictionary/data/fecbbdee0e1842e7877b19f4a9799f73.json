    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a male member of a royal family who is not king, especially the son or grandson of the king or queen",
                        "vi": "một thành viên nam của gia đình hoàng gia không phải là vua, đặc biệt là con trai hoặc cháu trai của vua hoặc hoàng hậu"
                    },
                    "examples": [
                        {
                            "en": "the royal princes",
                            "vi": "các hoàng tử"
                        },
                        {
                            "en": "Prince Charles",
                            "vi": "hoàng tử Charles"
                        },
                        {
                            "en": "prince of… the Prince of Wales",
                            "vi": "hoàng tử của… hoàng tử xứ Wales"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the male ruler of a small country or state that has a royal family; a male member of this family, especially the son or grandson of the ruler",
                        "vi": "người cai trị nam giới của một quốc gia hoặc nhà nước nhỏ có hoàng gia; một thành viên nam của gia đình này, đặc biệt là con trai hoặc cháu trai của người cai trị"
                    },
                    "examples": [
                        {
                            "en": "prince of… the prince of Orange",
                            "vi": "hoàng tử của… hoàng tử của Orange"
                        },
                        {
                            "en": "Prince Albert of Monaco",
                            "vi": "Hoàng tử Albert của Monaco"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "(in some European countries) a nobleman",
                        "vi": "(ở một số nước Châu Âu) một nhà quý tộc"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a man who is thought to be one of the best in a particular field",
                        "vi": "một người đàn ông được cho là một trong những người giỏi nhất trong một lĩnh vực cụ thể"
                    },
                    "examples": [
                        {
                            "en": "the prince of comedy",
                            "vi": "hoàng tử hài"
                        }
                    ]
                }
            ]
        }
