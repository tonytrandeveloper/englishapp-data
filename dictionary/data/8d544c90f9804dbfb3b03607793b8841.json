    "word": "hermetically",
    "phonetic": {
        "uk": "/hɜːˈmetɪkli/",
        "us": "/hɜːrˈmetɪkli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that is tightly closed so that no air can escape or enter",
                        "vi": "theo một cách được đóng chặt để không có không khí có thể thoát ra ngoài hoặc đi vào"
                    },
                    "examples": [
                        {
                            "en": "a hermetically sealed container",
                            "vi": "một hộp đựng kín"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is closed and difficult to become a part of",
                        "vi": "theo cách khép kín và khó trở thành một phần của"
                    },
                    "examples": [
                        {
                            "en": "Washington should encourage the country to open up its almost hermetically closed society.",
                            "vi": "Washington nên khuyến khích đất nước mở cửa xã hội gần như khép kín."
                        }
                    ]
                }
            ]
        }
