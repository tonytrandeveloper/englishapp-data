    "word": "insensible",
    "phonetic": {
        "uk": "/ɪnˈsensəbl/",
        "us": "/ɪnˈsensəbl/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "unable to feel something or react to it",
                        "vi": "không thể cảm thấy điều gì đó hoặc phản ứng với nó"
                    },
                    "examples": [
                        {
                            "en": "insensible to pain/cold",
                            "vi": "không chịu được đau / lạnh"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not aware of a situation or of something that might happen",
                        "vi": "không nhận thức được một tình huống hoặc một cái gì đó có thể xảy ra"
                    },
                    "examples": [
                        {
                            "en": "They were not insensible of the risks.",
                            "vi": "Họ không vô cảm trước những rủi ro."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "unconscious as the result of injury, illness, etc.",
                        "vi": "bất tỉnh do chấn thương, bệnh tật, v.v."
                    },
                    "examples": [
                        {
                            "en": "He drank himself insensible.",
                            "vi": "Anh ta uống rượu vô độ."
                        }
                    ]
                }
            ]
        }
