                    "define": {
                        "en": "a word that has the same origin as another",
                        "vi": "một từ có cùng nguồn gốc với một từ khác"
                    },
                    "examples": [
                        {
                            "en": "‘Haus’ and ‘house’ are cognates.",
                            "vi": "'Haus' và 'house' là từ ghép."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "having the same origin as another word or language",
                        "vi": "có cùng nguồn gốc với một từ hoặc ngôn ngữ khác"
                    },
                    "examples": [
                        {
                            "en": "‘Haus’ in German is cognate with ‘house’ in English.",
                            "vi": "'Haus' trong tiếng Đức đồng âm với 'house' trong tiếng Anh."
                        },
                        {
                            "en": "German and Dutch are cognate languages.",
                            "vi": "Tiếng Đức và tiếng Hà Lan là hai ngôn ngữ chung."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "related in some way and therefore similar",
                        "vi": "liên quan theo một cách nào đó và do đó tương tự"
                    },
                    "examples": [
                        {
                            "en": "a cognate development",
                            "vi": "một sự phát triển cognate"
                        }
                    ]
                }
