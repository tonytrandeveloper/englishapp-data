{
    "id": "dd4bf8fd38284c50b4277b805f7aa668",
    "word": "softly",
    "phonetic": {
        "uk": "/ˈsɒftli/",
        "us": "/ˈsɔːftli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a pleasant and gentle way; in a way that is not loud or violent",
                        "vi": "một cách dễ chịu và nhẹ nhàng; theo cách không ồn ào hoặc bạo lực"
                    },
                    "examples": [
                        {
                            "en": "‘I missed you,’ he said softly.",
                            "vi": "“Anh nhớ em,” anh nói nhẹ nhàng."
                        },
                        {
                            "en": "She closed the door softly behind her.",
                            "vi": "Cô nhẹ nhàng đóng cửa lại sau lưng."
                        },
                        {
                            "en": "She whispered softly in his ear.",
                            "vi": "Cô khẽ thì thầm vào tai anh."
                        },
                        {
                            "en": "to laugh/chuckle softly",
                            "vi": "cười / cười khẽ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not too bright but is pleasant and relaxing to the eyes",
                        "vi": "theo cách không quá chói nhưng dễ chịu và thư giãn cho mắt"
                    },
                    "examples": [
                        {
                            "en": "The room was softly lit by a lamp.",
                            "vi": "Căn phòng được thắp sáng nhẹ nhàng bởi ngọn đèn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "without sharp angles or hard edges",
                        "vi": "không có góc nhọn hoặc cạnh cứng"
                    },
                    "examples": [
                        {
                            "en": "a softly tailored suit",
                            "vi": "một bộ đồ được may đo mềm mại"
                        }
                    ]
                }
            ]
        }
    ],
