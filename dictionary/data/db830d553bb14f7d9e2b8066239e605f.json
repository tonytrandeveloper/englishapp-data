{
    "id": "db830d553bb14f7d9e2b8066239e605f",
    "word": "blithely",
    "phonetic": {
        "uk": "/ˈblaɪðli/",
        "us": "/ˈblaɪðli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that shows you do not care or are not anxious about what you are doing",
                        "vi": "theo cách cho thấy bạn không quan tâm hoặc không lo lắng về những gì bạn đang làm"
                    },
                    "examples": [
                        {
                            "en": "He was blithely unaware of the trouble he'd caused.",
                            "vi": "Anh ta hoàn toàn không biết về những rắc rối mà anh ta đã gây ra."
                        },
                        {
                            "en": "‘It'll be easy,’ she said blithely.",
                            "vi": "\"Nó sẽ dễ dàng,\" cô nói một cách thẳng thừng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a happy way; without any worries",
                        "vi": "một cách hạnh phúc; không có bất kỳ lo lắng nào"
                    },
                    "examples": [
                        {
                            "en": "‘Hi, I'm Candy,’ she said blithely.",
                            "vi": "\"Xin chào, tôi là Candy,\" cô ấy nói thẳng thừng."
                        }
                    ]
                }
            ]
        }
