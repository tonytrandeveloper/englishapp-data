            "means": [
                {
                    "define": {
                        "en": "meant to be kept secret and not told to or shared with other people",
                        "vi": "có nghĩa là được giữ bí mật và không được tiết lộ hoặc chia sẻ với người khác"
                    },
                    "examples": [
                        {
                            "en": "confidential information/documents",
                            "vi": "thông tin / tài liệu bí mật"
                        },
                        {
                            "en": "Your medical records are strictly confidential (= completely secret).",
                            "vi": "Hồ sơ y tế của bạn được bảo mật nghiêm ngặt (= hoàn toàn bí mật)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "showing that what you are saying is private or secret",
                        "vi": "cho thấy rằng những gì bạn đang nói là riêng tư hoặc bí mật"
                    },
                    "examples": [
                        {
                            "en": "He spoke in a confidential tone, his voice low.",
                            "vi": "Anh ta nói với một giọng điệu kín đáo, giọng trầm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "trusted with private or secret information",
                        "vi": "đáng tin cậy với thông tin cá nhân hoặc bí mật"
                    },
                    "examples": [
                        {
                            "en": "a confidential secretary",
                            "vi": "một thư ký bí mật"
                        }
                    ]
                }
            ]
