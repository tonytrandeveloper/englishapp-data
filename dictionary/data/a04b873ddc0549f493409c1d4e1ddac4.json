                {
                    "define": {
                        "en": "given as an honour, without the person having to have the usual qualifications",
                        "vi": "được trao như một vinh dự, mà người đó không cần phải có các bằng cấp thông thường"
                    },
                    "examples": [
                        {
                            "en": "an honorary doctorate/degree",
                            "vi": "bằng tiến sĩ danh dự / bằng cấp"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not paid",
                        "vi": "không được trả tiền"
                    },
                    "examples": [
                        {
                            "en": "the honorary president",
                            "vi": "chủ tịch danh dự"
                        },
                        {
                            "en": "The post of treasurer is a purely honorary position.",
                            "vi": "Chức vụ thủ quỹ là một chức vụ hoàn toàn mang tính danh dự."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "treated like a member of a group without actually belonging to it",
                        "vi": "được đối xử như một thành viên của một nhóm mà không thực sự thuộc về nó"
                    },
                    "examples": [
                        {
                            "en": "She was treated as an honorary man.",
                            "vi": "Cô được coi như một người đàn ông danh dự."
                        },
                        {
                            "en": "Many people treat their pets almost as honorary humans.",
                            "vi": "Nhiều người coi vật nuôi của họ gần như là con người danh dự."
                        }
                    ]
                }
