            "means": [
                {
                    "define": {
                        "en": "usual for or typical of somebody/something",
                        "vi": "thông thường hoặc điển hình của ai đó / cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "They waited for his habitual response.",
