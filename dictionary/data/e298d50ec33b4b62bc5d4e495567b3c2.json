                            "vi": "(chính thức) nơi ở thường xuyên của một người"
                        },
                        {
                            "en": "She sat sipping her habitual cup of tea.",
                            "vi": "Cô ngồi nhâm nhi tách trà theo thói quen của mình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "done, often in a way that is annoying or difficult to stop",
                        "vi": "thực hiện, thường theo cách gây khó chịu hoặc khó dừng lại"
                    },
                    "examples": [
                        {
                            "en": "habitual complaining",
                            "vi": "thói quen phàn nàn"
                        },
                        {
