                            "vi": "thói quen sử dụng heroin"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "doing something that has become a habit and is therefore difficult to stop",
                        "vi": "làm điều gì đó đã trở thành thói quen và do đó rất khó để dừng lại"
                    },
                    "examples": [
