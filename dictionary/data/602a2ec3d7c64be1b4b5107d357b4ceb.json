    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to burn yourself or part of your body with very hot liquid or steam",
                        "vi": "đốt bản thân hoặc một phần cơ thể bằng chất lỏng hoặc hơi nước rất nóng"
                    },
                    "examples": [
                        {
                            "en": "Be careful not to scald yourself with the steam.",
                            "vi": "Hãy cẩn thận để không bị bỏng do hơi nước."
                        },
                        {
                            "en": "(figurative) Tears scalded her eyes.",
                            "vi": "(nghĩa bóng) Nước mắt cô ấy trào ra."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an injury to the skin from very hot liquid or steam",
                        "vi": "chấn thương da do chất lỏng hoặc hơi nước quá nóng"
                    },
                    "examples": [
                        {
                            "en": "For minor burns and scalds, cool the affected area under running water.",
                            "vi": "Đối với bỏng nhẹ và bỏng nước, hãy làm mát vùng bị bỏng dưới vòi nước."
                        }
                    ]
                }
            ]
        }
