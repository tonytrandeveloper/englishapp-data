                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality in a person or an animal of being small and strong",
                        "vi": "phẩm chất của một người hoặc một động vật nhỏ bé và mạnh mẽ"
                    },
                    "examples": [
