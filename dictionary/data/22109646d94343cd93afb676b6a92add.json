            "means": [
                {
                    "define": {
                        "en": "trained, or having a natural ability, to find the way home from a long distance away",
                        "vi": "được đào tạo hoặc có khả năng thiên bẩm để tìm đường về nhà từ một khoảng cách xa"
                    },
                    "examples": [
                        {
                            "en": "Many birds have a remarkable homing instinct.",
                            "vi": "Nhiều loài chim có bản năng bay lượn đáng chú ý."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "fitted with an electronic device that enables it to find and hit the place or object it is aimed at",
                        "vi": "được trang bị một thiết bị điện tử cho phép nó tìm và đánh vào địa điểm hoặc đối tượng mà nó nhắm đến"
                    },
                    "examples": [
                        {
