            "means": [
                {
                    "define": {
                        "en": "to cover or hide something completely",
                        "vi": "để che hoặc giấu một cái gì đó hoàn toàn"
                    },
                    "examples": [
                        {
                            "en": "Clouds blotted out the sun.",
                            "vi": "Mây che khuất nắng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to deliberately try to forget an unpleasant memory or thought",
                        "vi": "cố tình quên đi một ký ức hoặc suy nghĩ khó chịu"
                    },
                    "examples": [
                        {
                            "en": "He tried to blot out the image of Helen's sad face.",
                            "vi": "Anh cố gắng xóa mờ hình ảnh khuôn mặt buồn bã của Helen."
                        },
                        {
                            "en": "She just wanted to sleep and blot out the terrifying events of the day.",
                            "vi": "Cô chỉ muốn ngủ và xóa tan những sự kiện kinh hoàng trong ngày."
                        }
                    ]
                }
