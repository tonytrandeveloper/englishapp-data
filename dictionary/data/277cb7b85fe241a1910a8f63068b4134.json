                {
                    "define": {
                        "en": "a cold sweet transparent food, made from gelatin, sugar and fruit juice, that shakes when it is moved",
                        "vi": "một loại thực phẩm trong suốt ngọt lạnh, được làm từ gelatin, đường và nước ép trái cây, sẽ lắc khi di chuyển"
                    },
                    "examples": [
                        {
                            "en": "jelly and ice cream",
                            "vi": "thạch và kem"
                        },
                        {
                            "en": "a raspberry jelly",
                            "vi": "thạch mâm xôi"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a substance like jelly made from gelatin and meat juices, served around meat, fish, etc.",
                        "vi": "một chất như thạch được làm từ gelatin và nước ép thịt, phục vụ xung quanh thịt, cá, v.v."
                    },
                    "examples": [
