    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "covered in very soft fur or feathers",
                        "vi": "được bao phủ bởi lông rất mềm hoặc lông vũ"
                    },
                    "examples": [
                        {
                            "en": "a little fluffy kitten",
                            "vi": "một con mèo con lông tơ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "soft, light and containing air",
                        "vi": "mềm, nhẹ và chứa không khí"
                    },
                    "examples": [
                        {
                            "en": "Beat the butter and sugar until soft and fluffy.",
                            "vi": "Đánh bơ và đường cho đến khi mềm và bông."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "looking as if it is soft and light",
                        "vi": "trông như thể nó mềm và nhẹ"
                    },
                    "examples": [
                        {
                            "en": "fluffy white clouds",
                            "vi": "những đám mây trắng mịn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "light and not serious; having no substance, depth or power",
                        "vi": "nhẹ và không nghiêm trọng; không có thực chất, chiều sâu hoặc sức mạnh"
                    },
                    "examples": [
                        {
                            "en": "a fluffy film/movie",
                            "vi": "một bộ phim / bộ phim mịn màng"
                        },
                        {
                            "en": "a fluffy argument",
                            "vi": "một cuộc tranh cãi mượt mà"
                        },
                        {
                            "en": "fluffy legislation",
                            "vi": "luật mềm mại"
                        }
                    ]
                }
            ]
