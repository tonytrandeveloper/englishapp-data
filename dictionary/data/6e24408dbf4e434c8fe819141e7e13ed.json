    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to shake because you are very frightened or nervous",
                        "vi": "lắc vì bạn rất sợ hãi hoặc lo lắng"
                    },
                    "examples": [
                        {
                            "en": "Quaking with fear, Polly slowly opened the door.",
                            "vi": "Vừa sợ hãi, Polly vừa từ từ mở cửa."
                        },
                        {
                            "en": "They are quaking in their boots at the prospect of tomorrow’s game.",
                            "vi": "Họ đang run rẩy trước triển vọng của trận đấu ngày mai."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to move or shake violently",
                        "vi": "di chuyển hoặc rung lắc dữ dội"
                    },
                    "examples": [
                        {
                            "en": "The ground quaked as the bomb exploded.",
                            "vi": "Mặt đất rung chuyển khi quả bom phát nổ."
                        }
                    ]
                }
            ]
        },
