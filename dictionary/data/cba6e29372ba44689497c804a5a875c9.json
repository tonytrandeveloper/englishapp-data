    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in an attractive or acceptable way; well",
                        "vi": "một cách hấp dẫn hoặc có thể chấp nhận được; ổn"
                    },
                    "examples": [
                        {
                            "en": "The room was nicely furnished.",
                            "vi": "Căn phòng được trang bị đẹp đẽ."
                        },
                        {
                            "en": "The plants are coming along nicely (= growing well).",
                            "vi": "Cây cối đang phát triển tốt đẹp (= đang phát triển tốt)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a kind, friendly or polite way",
                        "vi": "một cách tử tế, thân thiện hoặc lịch sự"
                    },
                    "examples": [
                        {
                            "en": "If you ask her nicely she might say yes.",
                            "vi": "Nếu bạn hỏi cô ấy một cách khéo léo, cô ấy có thể nói có."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "carefully; exactly",
                        "vi": "cẩn thận; một cách chính xác"
                    },
                    "examples": [
                        {
                            "en": "His novels nicely describe life in Britain between the wars.",
                            "vi": "Tiểu thuyết của ông mô tả độc đáo cuộc sống ở Anh giữa các cuộc chiến tranh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to be making good progress",
                        "vi": "tiến bộ tốt"
                    },
                    "examples": [
                        {
                            "en": "Her new business is doing very nicely.",
                            "vi": "Công việc kinh doanh mới của cô ấy đang hoạt động rất tốt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to be acceptable",
                        "vi": "được chấp nhận"
                    },
                    "examples": [
                        {
                            "en": "Tomorrow at ten will do nicely (= will be a good time).",
                            "vi": "Ngày mai lúc mười giờ sẽ làm tốt (= sẽ là một thời điểm tốt)."
                        }
                    ]
                }
