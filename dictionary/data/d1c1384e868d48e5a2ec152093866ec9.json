                            "vi": "những nỗi buồn của cuộc sống trần gian này"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "possible",
                        "vi": "có thể được"
                    },
                    "examples": [
                        {
                            "en": "There's no earthly reason why you shouldn't go.",
                            "vi": "Không có lý do gì khiến bạn không nên đi."
                        },
                        {
