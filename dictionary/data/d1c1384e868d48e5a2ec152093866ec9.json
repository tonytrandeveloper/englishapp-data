            "means": [
                {
                    "define": {
                        "en": "connected with life on earth and not with any spiritual life",
                        "vi": "kết nối với cuộc sống trên trái đất chứ không phải với bất kỳ cuộc sống tâm linh nào"
                    },
                    "examples": [
