    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an act of making people unemployed because there is no more work left for them to do",
                        "vi": "một hành động khiến mọi người thất nghiệp vì không còn việc làm nữa"
                    },
                    "examples": [
                        {
                            "en": "lay-offs in the factory",
                            "vi": "sa thải trong nhà máy"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a period of time when somebody is not working or not doing something that they normally do regularly",
                        "vi": "một khoảng thời gian mà ai đó không làm việc hoặc không làm điều gì đó mà họ thường làm"
                    },
                    "examples": [
                        {
                            "en": "an eight-week lay-off with a broken leg",
                            "vi": "sa thải tám tuần với một cái chân bị gãy"
                        }
                    ]
                }
            ]
        }
