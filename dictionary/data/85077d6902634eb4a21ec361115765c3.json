    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not appearing to be affected by the process of time passing or by changes in fashion",
                        "vi": "dường như không bị ảnh hưởng bởi quá trình thời gian trôi qua hoặc bởi những thay đổi trong thời trang"
                    },
                    "examples": [
                        {
                            "en": "her timeless beauty",
                            "vi": "vẻ đẹp vượt thời gian của cô ấy"
                        },
                        {
                            "en": "His work has a timeless quality.",
                            "vi": "Tác phẩm của anh ấy có chất lượng vượt thời gian."
                        },
                        {
                            "en": "The whole valley seemed to be under a spell, in a timeless past unaffected by world events.",
                            "vi": "Toàn bộ thung lũng dường như đang ở trong một quá khứ vượt thời gian, không bị ảnh hưởng bởi các sự kiện thế giới."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "existing or continuing forever",
                        "vi": "tồn tại hoặc tiếp tục mãi mãi"
                    },
                    "examples": [
                        {
                            "en": "timeless eternity",
                            "vi": "vĩnh cửu vượt thời gian"
                        }
                    ]
                }
            ]
