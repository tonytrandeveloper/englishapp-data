            "means": [
                {
                    "define": {
                        "en": "to ask or tell somebody to come to you, especially in order to help you",
                        "vi": "để yêu cầu hoặc bảo ai đó đến gặp bạn, đặc biệt là để giúp bạn"
                    },
                    "examples": [
                        {
                            "en": "Send for a doctor, quickly!",
                            "vi": "Gửi cho một bác sĩ, nhanh chóng!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to ask somebody to bring or deliver something to you",
                        "vi": "yêu cầu ai đó mang hoặc giao thứ gì đó cho bạn"
                    },
                    "examples": [
                        {
                            "en": "His son found him and sent for help.",
                            "vi": "Con trai của ông đã tìm thấy ông và gửi để giúp đỡ."
                        },
                        {
                            "en": "She sent for the latest sales figures.",
                            "vi": "Cô ấy đã gửi cho các số liệu bán hàng mới nhất."
                        }
                    ]
                }
            ]
