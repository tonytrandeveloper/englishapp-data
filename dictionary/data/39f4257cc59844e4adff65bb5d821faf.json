                    ]
                },
                {
                    "define": {
                        "en": "not smooth or regular; not showing control or careful preparation",
                        "vi": "không mịn hoặc đều đặn; không cho thấy sự kiểm soát hoặc sự chuẩn bị kỹ lưỡng"
                    },
                    "examples": [
                        {
                            "en": "I could hear the sound of his ragged breathing.",
                            "vi": "Tôi có thể nghe thấy tiếng thở gấp gáp của anh ấy."
                        },
                        {
                            "en": "Their performance was still very ragged.",
                            "vi": "Màn trình diễn của họ vẫn rất tệ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "very tired, especially after physical effort",
                        "vi": "rất mệt mỏi, đặc biệt là sau khi gắng sức"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to make somebody do a lot of work or make a big effort so that they become tired",
                        "vi": "để khiến ai đó làm nhiều việc hoặc nỗ lực lớn để họ trở nên mệt mỏi"
                    },
                    "examples": [
                        {
