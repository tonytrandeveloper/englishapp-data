    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an amount of something such as liquid or dust that has been thrown, or blown into your eye",
                        "vi": "một lượng thứ gì đó chẳng hạn như chất lỏng hoặc bụi đã bị ném hoặc thổi vào mắt của bạn"
                    },
                    "examples": [
                        {
                            "en": "an eyeful of sand",
                            "vi": "một đống cát"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a person or thing that is beautiful or interesting to look at",
                        "vi": "một người hoặc một vật đẹp đẽ hoặc thú vị để nhìn vào"
                    },
                    "examples": [
                        {
                            "en": "I’ve been told that she was quite an eyeful in her youth.",
                            "vi": "Tôi được biết rằng thời trẻ cô ấy khá tinh mắt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to look carefully at something that is interesting or unusual",
                        "vi": "để xem xét cẩn thận một cái gì đó thú vị hoặc bất thường"
                    },
                    "examples": []
                }
