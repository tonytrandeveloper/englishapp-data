                    ]
                },
                {
                    "define": {
                        "en": "an offensive word for a person who is physically alive but not capable of much mental or physical activity, for example because of a serious accident or illness",
                        "vi": "một từ xúc phạm đối với một người còn sống về thể chất nhưng không có khả năng hoạt động trí óc hoặc thể chất nhiều, ví dụ như vì tai nạn hoặc bệnh tật nghiêm trọng"
