    "blocks": [
        {
            "pos": "prefix",
            "means": [
                {
                    "define": {
                        "en": "to make or treat somebody/something as",
                        "vi": "để làm cho hoặc đối xử với ai đó / cái gì đó như"
                    },
                    "examples": [
                        {
                            "en": "Don't belittle his achievements (= say they are not important).",
                            "vi": "Đừng coi thường thành tích của anh ấy (= nói rằng chúng không quan trọng)."
                        },
                        {
                            "en": "An older girl befriended me.",
                            "vi": "Một cô gái lớn tuổi kết bạn với tôi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "wearing or covered with",
                        "vi": "mặc hoặc phủ"
                    },
                    "examples": [
                        {
                            "en": "heavily bejewelled fingers",
                            "vi": "ngón tay được trang sức nhiều"
                        },
                        {
                            "en": "bespattered with mud",
                            "vi": "đầy bùn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to cause something to be",
                        "vi": "để gây ra một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "The ship was becalmed (= there was no wind so it could not move).",
                            "vi": "Con tàu đã bị nghiêng (= không có gió nên nó không thể di chuyển)."
                        },
                        {
                            "en": "The rebels besieged the fort.",
                            "vi": "Quân nổi dậy bao vây pháo đài."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to turn intransitive verbs (= without an object) into transitive verbs (= with an object)",
                        "vi": "được sử dụng để chuyển động từ nội động (= không có tân ngữ) thành động từ ngoại chuyển (= có tân ngữ)"
                    },
                    "examples": [
                        {
                            "en": "She is always bemoaning her lot.",
                            "vi": "Cô ấy luôn luôn la mắng cô ấy rất nhiều."
                        }
                    ]
                }
            ]
