            "means": [
                {
                    "define": {
                        "en": "caused by a parasite",
                        "vi": "do ký sinh trùng gây ra"
                    },
                    "examples": [
                        {
                            "en": "a parasitic disease/infection",
                            "vi": "một bệnh ký sinh trùng / nhiễm trùng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "living on another animal or plant and getting its food from it",
                        "vi": "sống trên động vật hoặc thực vật khác và lấy thức ăn từ nó"
                    },
                    "examples": [
                        {
                            "en": "a parasitic mite",
                            "vi": "một con ve ký sinh"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "always relying on or benefiting from other people and giving nothing back",
                        "vi": "luôn dựa dẫm hoặc hưởng lợi từ người khác và không cho lại gì"
                    },
                    "examples": [
                        {
                            "en": "She lives a parasitic existence, constantly borrowing money from her friends.",
                            "vi": "Cô ấy sống một cuộc sống ký sinh, liên tục vay tiền từ bạn bè của mình."
                        }
                    ]
                }
