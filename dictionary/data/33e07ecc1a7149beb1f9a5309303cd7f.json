                            "vi": "lò nung gốm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the clay that some dishes and pots are made of",
                        "vi": "đất sét mà một số bát đĩa và nồi được làm bằng"
                    },
                    "examples": [
                        {
