    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "without being in control of your movements so that you might fall",
                        "vi": "không kiểm soát được chuyển động của bạn để bạn có thể bị ngã"
                    },
                    "examples": [
                        {
                            "en": "She walked unsteadily towards me.",
                            "vi": "Cô ấy loạng choạng bước về phía tôi."
                        },
                        {
                            "en": "She swayed unsteadily as she got up from the bar.",
                            "vi": "Cô ấy loạng choạng lắc lư khi đứng dậy khỏi quầy bar."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that shakes and lacks control",
                        "vi": "theo cách run rẩy và thiếu kiểm soát"
                    },
                    "examples": [
                        {
                            "en": "‘I had to see you,’ he said unsteadily.",
                            "vi": "“Anh phải gặp em,” anh nói một cách lo lắng."
                        }
                    ]
                }
            ]
