    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "with walls, etc. all around",
                        "vi": "có tường, v.v. xung quanh"
                    },
                    "examples": [
                        {
                            "en": "Do not use this substance in an enclosed space.",
                            "vi": "Không sử dụng chất này trong không gian kín."
                        },
                        {
                            "en": "I can't stand being shut in a small enclosed space.",
                            "vi": "Tôi không thể chịu đựng được việc bị đóng cửa trong một không gian chật hẹp."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "sent with a letter, etc.",
                        "vi": "được gửi bằng một lá thư, v.v."
                    },
                    "examples": [
                        {
                            "en": "Please complete the enclosed application form.",
                            "vi": "Vui lòng điền vào mẫu đơn đăng ký kèm theo."
                        },
                        {
                            "en": "Please find enclosed a cheque for £100.",
                            "vi": "Vui lòng tìm một tấm séc trị giá £ 100 kèm theo."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having little contact with the outside world",
                        "vi": "ít tiếp xúc với thế giới bên ngoài"
                    },
                    "examples": [
                        {
                            "en": "an enclosed order of monks",
                            "vi": "một trật tự kèm theo của các nhà sư"
                        }
                    ]
                }
            ]
