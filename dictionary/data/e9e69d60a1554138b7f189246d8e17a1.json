        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "made or produced to copy something natural; not real",
                        "vi": "được tạo ra hoặc sản xuất để sao chép một cái gì đó tự nhiên; không thực sự"
                    },
                    "examples": [
                        {
                            "en": "an artificial limb/flower/sweetener/fertilizer",
                            "vi": "một chi nhân tạo / hoa / chất làm ngọt / phân bón"
                        },
                        {
                            "en": "artificial lighting/light",
                            "vi": "ánh sáng nhân tạo / ánh sáng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "created by people; not happening naturally",
                        "vi": "do con người tạo ra; không xảy ra tự nhiên"
                    },
                    "examples": [
                        {
                            "en": "A job interview is a very artificial situation.",
                            "vi": "Một cuộc phỏng vấn xin việc là một tình huống rất giả tạo."
                        },
                        {
                            "en": "the artificial barriers of race, class and gender",
                            "vi": "những rào cản nhân tạo về chủng tộc, giai cấp và giới tính"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not what it appears to be",
                        "vi": "không phải những gì nó xuất hiện"
                    },
                    "examples": [
                        {
                            "en": "artificial emotion",
                            "vi": "cảm xúc nhân tạo"
                        }
                    ]
                }
            ]
        }
