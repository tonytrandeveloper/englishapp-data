    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the main part of an old vehicle or large structure that is no longer used",
                        "vi": "phần chính của một chiếc xe cũ hoặc kết cấu lớn không còn được sử dụng"
                    },
                    "examples": [
                        {
                            "en": "the rusting hulks of cars",
                            "vi": "những chiếc xe ô tô rỉ sét"
                        },
                        {
                            "en": "the hulk of a wrecked ship",
                            "vi": "vỏ của một con tàu bị đắm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "an old ship kept in one place and used as a prison",
                        "vi": "một con tàu cũ được giữ ở một nơi và được sử dụng như một nhà tù"
                    },
                    "examples": [
                        {
                            "en": "prison hulks",
                            "vi": "nhà tù"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a large heavy person",
                        "vi": "một người nặng nề"
                    },
                    "examples": [
                        {
                            "en": "a great hulk of a man",
                            "vi": "một người đàn ông tuyệt vời"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a very large object, especially one that causes you to feel nervous or afraid",
                        "vi": "một vật thể rất lớn, đặc biệt là vật thể khiến bạn cảm thấy lo lắng hoặc sợ hãi"
                    },
                    "examples": []
                }
            ]
