    "word": "hamper",
    "phonetic": {
        "uk": "/ˈhæmpə(r)/",
        "us": "/ˈhæmpər/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to prevent somebody from easily doing or achieving something",
                        "vi": "để ngăn ai đó dễ dàng làm hoặc đạt được điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "High winds hampered the rescue attempt.",
                            "vi": "Gió lớn đã cản trở nỗ lực cứu hộ."
                        },
                        {
                            "en": "Our efforts were severely hampered by a lack of money.",
                            "vi": "Những nỗ lực của chúng tôi đã bị cản trở nghiêm trọng do thiếu tiền."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a large basket with a lid (= cover), especially one used to carry food in",
                        "vi": "một cái giỏ lớn có nắp (= nắp), đặc biệt là cái dùng để đựng thực phẩm"
                    },
                    "examples": [
                        {
                            "en": "a picnic hamper",
                            "vi": "một trở ngại dã ngoại"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a box or package containing food, sent as a gift",
                        "vi": "một hộp hoặc gói chứa thực phẩm, được gửi như một món quà"
                    },
                    "examples": [
                        {
                            "en": "a Christmas hamper",
                            "vi": "một cản trở Giáng sinh"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a large basket that you keep your dirty clothes in until they are washed",
                        "vi": "một cái giỏ lớn để bạn đựng quần áo bẩn của mình cho đến khi chúng được giặt sạch"
                    },
                    "examples": []
                }
            ]
        }
