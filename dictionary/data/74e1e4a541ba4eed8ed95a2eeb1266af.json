                    },
                    "examples": [
                        {
                            "en": "Cholera reduces heartbeat and causes muscle spasms.",
                            "vi": "Dịch tả làm giảm nhịp tim và gây co thắt cơ."
                        },
                        {
                            "en": "The injection sent his leg into spasm.",
                            "vi": "Mũi tiêm khiến chân anh bị co cứng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a sudden strong feeling or reaction that lasts for a short time",
                        "vi": "cảm giác mạnh đột ngột hoặc phản ứng kéo dài trong một thời gian ngắn"
                    },
                    "examples": [
                        {
