    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the hairs on the back of the neck of a dog, cat, etc. that rise when the animal is afraid or angry",
                        "vi": "lông sau gáy của chó, mèo, v.v ... mọc lên khi con vật sợ hãi, tức giận"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to become angry",
                        "vi": "Trở nên tức giận"
                    },
                    "examples": [
                        {
                            "en": "Ben felt his hackles rise as the speaker continued.",
                            "vi": "Ben cảm thấy tiếng hack của mình tăng lên khi người nói tiếp tục."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to make somebody angry",
                        "vi": "làm cho ai đó tức giận"
                    },
                    "examples": [
                        {
                            "en": "Her controversial article is bound to raise hackles.",
                            "vi": "Bài báo gây tranh cãi của cô ấy chắc chắn sẽ làm dấy lên những lời dị nghị."
                        }
                    ]
                }
            ]
