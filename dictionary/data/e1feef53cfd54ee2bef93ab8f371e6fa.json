            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the parts of a theatre that are used by the audience",
                        "vi": "các bộ phận của nhà hát được khán giả sử dụng"
                    },
                    "examples": [
                        {
                            "en": "New seating will be installed and the front of house will be improved.",
                            "vi": "Chỗ ngồi mới sẽ được lắp đặt và mặt tiền của ngôi nhà sẽ được cải thiện."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the business of dealing with an audience at a theatre, for example selling tickets and programmes",
                        "vi": "kinh doanh giao dịch với khán giả tại rạp hát, ví dụ như bán vé và chương trình"
                    },
                    "examples": [
                        {
                            "en": "a front-of-house manager",
                            "vi": "một người quản lý trước nhà"
                        },
                        {
                            "en": "the front-of-house staff",
                            "vi": "nhân viên trước nhà"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in the parts of a theatre that are used by the audience",
                        "vi": "trong các bộ phận của nhà hát được khán giả sử dụng"
                    },
                    "examples": [
                        {
                            "en": "There was an expectant atmosphere front of house.",
                            "vi": "Có một bầu không khí mong đợi trước nhà."
                        },
                        {
                            "en": "I work front of house.",
                            "vi": "Tôi làm việc trước nhà."
