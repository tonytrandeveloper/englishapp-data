            "means": [
                {
                    "define": {
                        "en": "interesting and unusual enough to attract attention",
                        "vi": "đủ thú vị và bất thường để thu hút sự chú ý"
                    },
                    "examples": [
                        {
                            "en": "a striking feature",
                            "vi": "một tính năng nổi bật"
                        },
                        {
                            "en": "She bears a striking resemblance to her older sister.",
                            "vi": "Cô ấy có một nét giống với chị gái của mình."
                        },
                        {
                            "en": "In striking contrast to their brothers, the girls were both intelligent and charming.",
                            "vi": "Trái ngược hoàn toàn với những người anh em của họ, các cô gái đều thông minh và quyến rũ."
                        },
                        {
                            "en": "The similarities between the two cases are striking.",
                            "vi": "Điểm tương đồng giữa hai trường hợp là rất nổi bật."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "very attractive, often in an unusual way",
                        "vi": "rất hấp dẫn, thường theo một cách khác thường"
                    },
                    "examples": [
                        {
                            "en": "striking good looks",
                            "vi": "ngoại hình đẹp nổi bật"
                        },
                        {
                            "en": "She was undoubtedly a very striking young woman.",
                            "vi": "Cô ấy chắc chắn là một phụ nữ trẻ rất nổi bật."
                        },
                        {
                            "en": "That hat looks very striking.",
                            "vi": "Chiếc mũ đó trông rất nổi bật."
                        }
                    ]
                }
            ]
