    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that is wet and unpleasant because something is full of liquid, especially water",
                        "vi": "theo cách ẩm ướt và khó chịu vì thứ gì đó chứa đầy chất lỏng, đặc biệt là nước"
                    },
                    "examples": [
                        {
                            "en": "Her clothes were clinging wetly to her body.",
                            "vi": "Quần áo ướt đẫm dính vào người cô."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that shows somebody has a weak character or lacks strength of mind",
                        "vi": "theo cách cho thấy ai đó có tính cách yếu đuối hoặc thiếu sức mạnh của trí óc"
                    },
                    "examples": [
                        {
                            "en": "‘I can’t!’ he said wetly.",
                            "vi": "'Tôi không thể!' anh nói một cách ướt át."
                        }
                    ]
                }
            ]
        }
