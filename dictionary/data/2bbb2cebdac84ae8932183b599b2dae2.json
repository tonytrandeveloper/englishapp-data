            "means": [
                {
                    "define": {
                        "en": "to go against or refuse to obey a law, an agreement, etc.",
                        "vi": "đi ngược lại hoặc từ chối tuân theo luật, thỏa thuận, v.v."
                    },
                    "examples": [
                        {
                            "en": "to violate international law",
                            "vi": "vi phạm luật pháp quốc tế"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to upset or not respect somebody’s peace, privacy, etc.",
                        "vi": "làm khó chịu hoặc không tôn trọng hòa bình, quyền riêng tư của ai đó, v.v."
                    },
                    "examples": [
                        {
                            "en": "She accused the press photographers of violating her privacy.",
                            "vi": "Cô cáo buộc các nhiếp ảnh gia báo chí đã xâm phạm quyền riêng tư của cô."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to damage or destroy a holy or special place",
                        "vi": "làm hỏng hoặc phá hủy một thánh địa hoặc một địa điểm đặc biệt"
                    },
                    "examples": [
                        {
                            "en": "to violate a grave",
                            "vi": "xâm phạm một ngôi mộ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to force somebody to have sex",
                        "vi": "ép ai đó quan hệ tình dục"
                    },
                    "examples": [
                        {
                            "en": "He had drugged her and then violated her.",
                            "vi": "Anh ta đã đánh thuốc mê cô và sau đó xâm phạm cô."
                        }
                    ]
                }
            ]
