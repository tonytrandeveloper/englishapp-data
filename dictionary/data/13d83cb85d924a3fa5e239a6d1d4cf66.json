{
    "id": "13d83cb85d924a3fa5e239a6d1d4cf66",
    "word": "princess",
    "phonetic": {
        "uk": "/ˌprɪnˈses/",
        "us": "/ˈprɪnses/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a female member of a royal family who is not a queen, especially the daughter or granddaughter of the king or queen",
                        "vi": "một thành viên nữ của gia đình hoàng gia không phải là hoàng hậu, đặc biệt là con gái hoặc cháu gái của vua hoặc hoàng hậu"
                    },
                    "examples": [
                        {
                            "en": "the royal princesses",
                            "vi": "công chúa hoàng gia"
                        },
                        {
                            "en": "Princess Anne",
                            "vi": "Công chúa Anne"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the wife of a prince",
                        "vi": "vợ của hoàng tử"
                    },
                    "examples": [
                        {
                            "en": "princess of… the Princess of Wales",
                            "vi": "công chúa của… công chúa xứ Wales"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a young woman who has always been given everything that she wants, and who thinks that she is better than other people",
                        "vi": "một phụ nữ trẻ luôn được cung cấp mọi thứ mà cô ấy muốn, và người nghĩ rằng cô ấy giỏi hơn những người khác"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "used by some men as a form of address to a girl or young woman",
                        "vi": "được một số đàn ông sử dụng như một hình thức xưng hô với một cô gái hoặc phụ nữ trẻ"
                    },
                    "examples": [
                        {
                            "en": "Is something the matter, princess?",
                            "vi": "Có chuyện gì không, công chúa?"
                        }
                    ]
                }
            ]
        }
    ],
