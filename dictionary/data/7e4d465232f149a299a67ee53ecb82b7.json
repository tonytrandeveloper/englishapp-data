{
    "id": "7e4d465232f149a299a67ee53ecb82b7",
    "word": "elective",
    "phonetic": {
        "uk": "/ɪˈlektɪv/",
        "us": "/ɪˈlektɪv/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "using or chosen by election",
                        "vi": "sử dụng hoặc được lựa chọn bởi bầu cử"
                    },
                    "examples": [
                        {
                            "en": "an elective democracy",
                            "vi": "một nền dân chủ tự chọn"
                        },
                        {
                            "en": "an elective assembly",
                            "vi": "một hội đồng tự chọn"
                        },
                        {
                            "en": "an elective member",
                            "vi": "một thành viên tự chọn"
                        },
                        {
                            "en": "He had never held elective office (= a position that is filled by election).",
                            "vi": "Anh ta chưa bao giờ giữ chức vụ bầu cử (= một vị trí được bầu cử)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having the power to elect",
                        "vi": "có quyền bầu cử"
                    },
                    "examples": [
                        {
                            "en": "an elective body",
                            "vi": "một cơ quan tự chọn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "that you choose to have; that does not require immediate attention",
                        "vi": "mà bạn chọn để có; điều đó không đòi hỏi sự chú ý ngay lập tức"
                    },
                    "examples": [
                        {
                            "en": "elective surgery",
                            "vi": "Lựa chọn phẫu thuật"
                        },
                        {
                            "en": "an elective operation",
                            "vi": "một hoạt động tự chọn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "that a student can choose",
                        "vi": "mà một sinh viên có thể chọn"
                    },
                    "examples": []
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a course or subject at a college or school that a student can choose to do",
                        "vi": "một khóa học hoặc môn học tại một trường đại học hoặc trường học mà học sinh có thể chọn để làm"
                    },
                    "examples": [
                        {
                            "en": "Students can choose from a range of electives offered by the science department.",
                            "vi": "Học sinh có thể chọn từ một loạt các môn tự chọn do khoa khoa học cung cấp."
                        }
                    ]
                }
            ]
        }
