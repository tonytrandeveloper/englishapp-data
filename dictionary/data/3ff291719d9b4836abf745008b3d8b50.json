    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the quality of being large and round",
                        "vi": "chất lượng của lớn và tròn"
                    },
                    "examples": [
                        {
                            "en": "the fullness of her lips",
                            "vi": "đôi môi căng mọng của cô ấy"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality of being deep and rich",
                        "vi": "chất lượng sâu sắc và phong phú"
                    },
                    "examples": [
                        {
                            "en": "This recording has a fullness and warmth that brings out the orchestration.",
                            "vi": "Bản thu âm này có một sự đầy đủ và ấm áp mang lại sự hòa quyện."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality of being complete and giving pleasure",
                        "vi": "chất lượng của sự hoàn chỉnh và mang lại niềm vui"
                    },
                    "examples": [
                        {
                            "en": "the fullness of life",
                            "vi": "cuộc sống viên mãn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "when the time is appropriate, usually after a long period",
