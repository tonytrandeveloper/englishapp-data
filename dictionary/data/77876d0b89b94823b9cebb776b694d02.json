    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to feed a baby or young animal with milk from the breast or udder",
                        "vi": "cho trẻ nhỏ hoặc động vật non bú sữa từ vú hoặc vú mẹ"
                    },
                    "examples": [
                        {
                            "en": "a cow suckling her calves",
                            "vi": "một con bò đang bú con của cô ấy"
                        },
                        {
                            "en": "(old-fashioned) a mother suckling a baby",
                            "vi": "(cổ điển) một bà mẹ đang cho con bú"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to drink milk from its mother’s breast or udder",
                        "vi": "uống sữa từ vú mẹ hoặc bầu vú của nó"
                    },
                    "examples": [
                        {
                            "en": "The young of some mammals continue to suckle for years.",
                            "vi": "Con non của một số loài động vật có vú tiếp tục bú trong nhiều năm."
                        }
                    ]
                }
            ]
