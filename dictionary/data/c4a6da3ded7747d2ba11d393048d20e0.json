{
    "id": "c4a6da3ded7747d2ba11d393048d20e0",
    "word": "shroud",
    "phonetic": {
        "uk": "/ʃraʊd/",
        "us": "/ʃraʊd/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to cover or hide something",
                        "vi": "để che hoặc giấu một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "The city was shrouded in mist.",
                            "vi": "Thành phố được bao phủ trong sương mù."
                        },
                        {
                            "en": "furniture shrouded in dust sheets",
                            "vi": "đồ đạc được bao phủ trong tấm phủ bụi"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to hide information or keep it secret and mysterious",
                        "vi": "để ẩn thông tin hoặc giữ bí mật và bí ẩn"
                    },
                    "examples": [
                        {
                            "en": "His family background is shrouded in mystery.",
                            "vi": "Nền tảng gia đình của anh ấy được bao phủ trong bí ẩn."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a piece of cloth that a dead person’s body is wrapped in before it is buried",
                        "vi": "mảnh vải quấn xác người chết trước khi chôn cất"
                    },
                    "examples": [
                        {
                            "en": "a burial shroud",
                            "vi": "một tấm vải liệm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a thing that covers, surrounds or hides something",
                        "vi": "một thứ bao phủ, bao quanh hoặc che giấu một thứ gì đó"
                    },
                    "examples": [
                        {
                            "en": "The organization is cloaked in a shroud of secrecy.",
                            "vi": "Tổ chức được che đậy trong một tấm vải bí mật."
                        },
                        {
                            "en": "a shroud of smoke",
                            "vi": "một làn khói"
                        },
                        {
                            "en": "a shroud of darkness/mist",
                            "vi": "một tấm màn che của bóng tối / sương mù"
                        }
                    ]
                }
            ]
        }
