    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "when you say that something is spanking new, etc. you are emphasizing that it is very new, etc.",
                        "vi": "khi bạn nói rằng một thứ gì đó mới xuất hiện, v.v. bạn đang nhấn mạnh rằng nó rất mới, v.v."
                    },
                    "examples": [
                        {
                            "en": "a brand spanking new Rolls-Royce",
                            "vi": "một thương hiệu đánh bại Rolls-Royce mới"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a series of hits on the bottom, given to somebody, especially a child, as a punishment",
                        "vi": "một loạt các cú đánh ở phía dưới, được trao cho ai đó, đặc biệt là một đứa trẻ, như một hình phạt"
                    },
                    "examples": [
                        {
                            "en": "to give somebody a spanking",
                            "vi": "đánh đòn ai đó"
                        },
                        {
                            "en": "I don't agree with spanking.",
                            "vi": "Tôi không đồng ý với việc đánh đòn."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "very fast, good or impressive",
                        "vi": "rất nhanh, tốt hoặc ấn tượng"
                    },
                    "examples": [
                        {
                            "en": "The horse set off at a spanking pace.",
                            "vi": "Con ngựa khởi hành với tốc độ chóng mặt."
                        },
                        {
                            "en": "We had a spanking time last night.",
                            "vi": "Chúng tôi đã có một khoảng thời gian đánh đòn vào đêm qua."
                        }
                    ]
                }
            ]
        }
