    "blocks": [
        {
            "pos": "phrasal verb",
            "means": [
                {
                    "define": {
                        "en": "used in orders to tell somebody to hurry or to try harder",
                        "vi": "được sử dụng để nói với ai đó hãy nhanh lên hoặc cố gắng hơn nữa"
                    },
                    "examples": [
                        {
                            "en": "Come on! We don't have much time.",
                            "vi": "Nào! Chúng tôi không có nhiều thời gian."
                        },
                        {
                            "en": "Come on! Try once more.",
                            "vi": "Nào! Thử lại một lần nữa."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to walk onto the stage",
                        "vi": "bước lên sân khấu"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to join a team during a game",
                        "vi": "tham gia một đội trong một trò chơi"
                    },
                    "examples": [
                        {
                            "en": "Wilson came on for Kane ten minutes before the end of the game.",
                            "vi": "Wilson vào sân thay Kane mười phút trước khi trận đấu kết thúc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to improve or develop in the way you want",
                        "vi": "để cải thiện hoặc phát triển theo cách bạn muốn"
                    },
                    "examples": [
                        {
                            "en": "The project is coming on fine.",
                            "vi": "Dự án đang diễn ra tốt đẹp."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to show that you know what somebody has said is not correct",
                        "vi": "được sử dụng để cho thấy rằng bạn biết những gì ai đó đã nói là không đúng"
                    },
                    "examples": [
                        {
                            "en": "Oh, come on—you know that isn't true!",
                            "vi": "Ồ, thôi nào — bạn biết điều đó không đúng!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to begin",
                        "vi": "để bắt đầu"
                    },
                    "examples": [
                        {
                            "en": "I can feel a cold coming on.",
                            "vi": "Tôi có thể cảm thấy lạnh đang ập đến."
                        },
                        {
                            "en": "I think there's rain coming on.",
                            "vi": "Tôi nghĩ sắp có mưa."
                        },
                        {
                            "en": "come on to do something It came on to rain.",
                            "vi": "đi làm gì đó Trời đổ mưa."
