                        "vi": "để khuyến khích một cái gì đó phát triển"
                    },
                    "examples": [
                        {
                            "en": "The club's aim is to foster better relations within the community.",
                            "vi": "Mục đích của câu lạc bộ là thúc đẩy các mối quan hệ tốt hơn trong cộng đồng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to take another person’s child into your home for a period of time, without becoming his or her legal parents",
                        "vi": "đưa con của người khác vào nhà bạn trong một khoảng thời gian, mà không trở thành cha mẹ hợp pháp của nó"
                    },
                    "examples": [
                        {
                            "en": "They have fostered over 60 children during the past ten years.",
