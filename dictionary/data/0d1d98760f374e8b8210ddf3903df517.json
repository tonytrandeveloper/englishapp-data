                        },
                        {
                            "en": "to crave alcohol/drugs/sweet food/carbohydrates/cigarettes/coffee",
                            "vi": "thèm rượu / ma túy / đồ ăn ngọt / carbohydrate / thuốc lá / cà phê"
                        },
                        {
                            "en": "crave to do something They craved to return to their homeland.",
                            "vi": "khao khát làm điều gì đó Họ khao khát được trở về quê hương của họ."
                        }
                    ]
                },
