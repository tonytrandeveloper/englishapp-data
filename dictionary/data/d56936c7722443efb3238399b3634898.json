            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to hang or bend down in the middle, especially because of weight or pressure",
                        "vi": "treo hoặc cúi xuống ở giữa, đặc biệt là do trọng lượng hoặc áp lực"
                    },
                    "examples": [
                        {
                            "en": "a sagging roof",
                            "vi": "mái nhà võng"
                        },
                        {
                            "en": "The tent began to sag under the weight of the rain.",
                            "vi": "Căn lều bắt đầu chùng xuống dưới sức nặng của cơn mưa."
                        },
                        {
                            "en": "Your skin starts to sag as you get older.",
                            "vi": "Da của bạn bắt đầu chảy xệ khi bạn già đi."
                        },
                        {
                            "en": "Her shoulders sagged in defeat.",
                            "vi": "Đôi vai cô chùng xuống vì thất bại."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to become weaker or fewer",
                        "vi": "trở nên yếu hơn hoặc ít hơn"
                    },
                    "examples": [
                        {
                            "en": "Their share of the vote sagged badly at the last election.",
                            "vi": "Tỷ lệ phiếu bầu của họ sụt giảm nghiêm trọng trong cuộc bầu cử vừa qua."
                        },
                        {
                            "en": "We tried to revive her sagging spirits.",
                            "vi": "Chúng tôi đã cố gắng vực dậy tinh thần đang chùng xuống của cô ấy."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
