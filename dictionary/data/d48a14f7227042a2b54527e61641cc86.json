{
    "id": "d48a14f7227042a2b54527e61641cc86",
    "word": "faintly",
    "phonetic": {
        "uk": "/ˈfeɪntli/",
        "us": "/ˈfeɪntli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that cannot be clearly seen, heard or smelt",
                        "vi": "theo cách không thể nhìn, nghe hoặc ngửi thấy rõ ràng"
                    },
                    "examples": [
                        {
                            "en": "She could faintly hear music playing.",
                            "vi": "Cô có thể nghe thấy tiếng nhạc đang phát một cách yếu ớt."
                        },
                        {
                            "en": "It smelled faintly of smoke.",
                            "vi": "Nó thoang thoảng mùi khói."
                        },
                        {
                            "en": "a faintly glowing fire",
                            "vi": "ngọn lửa sáng mờ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "slightly; to a small degree",
                        "vi": "không đáng kể; ở một mức độ nhỏ"
                    },
                    "examples": [
                        {
                            "en": "He looked faintly embarrassed.",
                            "vi": "Trông anh hơi xấu hổ."
                        },
                        {
                            "en": "The whole thing was faintly ridiculous.",
                            "vi": "Toàn bộ sự việc mờ nhạt vô lý."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not enthusiastic",
                        "vi": "theo cách không nhiệt tình"
                    },
                    "examples": [
                        {
                            "en": "She smiled faintly.",
                            "vi": "Cô cười nhạt."
                        }
                    ]
                }
            ]
        }
    ],
