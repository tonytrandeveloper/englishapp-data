                    "define": {
                        "en": "in a way that shows you are unable to stay still or be happy where you are, because you are bored or need a change",
                        "vi": "theo cách cho thấy bạn không thể ở yên hoặc hạnh phúc ở nơi bạn đang ở, bởi vì bạn đang buồn chán hoặc cần thay đổi"
                    },
                    "examples": [
                        {
                            "en": "He moved restlessly from one foot to the other.",
                            "vi": "Anh không ngừng di chuyển từ chân này sang chân kia."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "without resting or sleeping properly",
                        "vi": "không nghỉ ngơi hoặc ngủ đúng cách"
                    },
                    "examples": [
                        {
                            "en": "She tossed restlessly until she finally fell asleep.",
                            "vi": "Cô trằn trọc mãi cho đến khi chìm vào giấc ngủ."
                        }
                    ]
                }
