    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to focus your mind, usually in silence, especially for religious reasons or in order to make your mind calm",
                        "vi": "để tập trung tâm trí của bạn, thường là trong im lặng, đặc biệt là vì lý do tôn giáo hoặc để làm cho tâm trí của bạn bình tĩnh"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to think deeply about something",
                        "vi": "suy nghĩ sâu sắc về điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "He went off to meditate on the new idea.",
                            "vi": "Anh ấy bắt đầu suy ngẫm về ý tưởng mới."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to plan something in your mind; to consider doing something",
                        "vi": "lập kế hoạch cho một cái gì đó trong tâm trí của bạn; cân nhắc làm điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "They were meditating revenge.",
                            "vi": "Họ đang thiền để trả thù."
                        }
                    ]
                }
            ]
        }
