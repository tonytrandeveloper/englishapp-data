            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a powerful illegal drug that affects the mind in a harmful way. Heroin and cocaine are narcotics.",
                        "vi": "một loại thuốc bất hợp pháp mạnh ảnh hưởng đến tâm trí một cách có hại. Heroin và cocaine là chất ma tuý."
                    },
                    "examples": [
                        {
                            "en": "a narcotics agent (= a police officer investigating the illegal trade in drugs)",
                            "vi": "một đại lý ma tuý (= một cảnh sát điều tra việc buôn bán bất hợp pháp ma tuý)"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a substance that relaxes you, reduces pain or makes you sleep",
                        "vi": "một chất giúp bạn thư giãn, giảm đau hoặc làm cho bạn ngủ"
                    },
                    "examples": [
                        {
                            "en": "a mild narcotic",
                            "vi": "một chất ma tuý nhẹ"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
