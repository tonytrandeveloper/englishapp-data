    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a light box or pot made of thick card or plastic for holding goods, especially food or liquid; the contents of a carton",
                        "vi": "hộp quẹt hoặc nồi làm bằng thẻ hoặc nhựa dày để đựng hàng hóa, đặc biệt là thực phẩm hoặc chất lỏng; nội dung của một thùng carton"
                    },
                    "examples": [
                        {
                            "en": "a milk carton/a carton of milk",
                            "vi": "hộp sữa / hộp sữa"
                        },
                        {
                            "en": "a carton of fruit juice/ice cream",
                            "vi": "một hộp nước trái cây / kem"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a large container in which goods are packed in smaller containers",
                        "vi": "một container lớn trong đó hàng hóa được đóng gói trong các container nhỏ hơn"
                    },
                    "examples": [
                        {
                            "en": "a carton of cigarettes",
                            "vi": "một thùng thuốc lá"
                        }
                    ]
                }
            ]
        }
