            "pos": "phrasal verb",
            "means": [
                {
                    "define": {
                        "en": "to make an effort to be aware of what is happening, so that you will notice if anything bad or unusual happens",
                        "vi": "cố gắng nhận thức về những gì đang xảy ra, để bạn sẽ nhận thấy nếu có bất kỳ điều gì xấu hoặc bất thường xảy ra"
                    },
                    "examples": [
                        {
                            "en": "The cashiers were asked to watch out for forged banknotes.",
                            "vi": "Các nhân viên thu ngân được yêu cầu đề phòng những tờ tiền giả."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to be careful of something",
                        "vi": "cẩn thận một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "Watch out for the stairs—they're steep.",
                            "vi": "Hãy để ý cầu thang — chúng rất dốc."
                        }
                    ]
                }
            ]
