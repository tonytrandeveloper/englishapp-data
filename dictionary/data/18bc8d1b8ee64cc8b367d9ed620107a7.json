                        "vi": "được thực hiện hoặc sắp xếp một cách rất cẩn thận"
                    },
                    "examples": [
                        {
                            "en": "a controlled explosion",
                            "vi": "một vụ nổ có kiểm soát"
                        },
                        {
                            "en": "a controlled environment",
                            "vi": "một môi trường được kiểm soát"
                        },
                        {
                            "en": "He played very controlled football.",
                            "vi": "Anh ấy chơi thứ bóng đá rất kiểm soát."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "limited, or managed by law or by rules",
                        "vi": "giới hạn, hoặc được quản lý bởi luật pháp hoặc các quy tắc"
                    },
                    "examples": [
                        {
                            "en": "controlled airspace",
                            "vi": "vùng trời được kiểm soát"
                        },
                        {
                            "en": "He was charged with possessing a controlled drug.",
                            "vi": "Anh ta bị buộc tội sở hữu một loại thuốc có kiểm soát."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "managed by a particular group, or in a particular way",
                        "vi": "được quản lý bởi một nhóm cụ thể hoặc theo một cách cụ thể"
                    },
                    "examples": [
                        {
                            "en": "a British-controlled company",
                            "vi": "một công ty do Anh kiểm soát"
                        },
                        {
                            "en": "computer-controlled systems",
                            "vi": "hệ thống điều khiển bằng máy tính"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "remaining calm and not getting angry or upset",
                        "vi": "giữ bình tĩnh và không tức giận hoặc khó chịu"
                    },
                    "examples": [
                        {
                            "en": "She remained quiet and controlled.",
