                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality of not being steep",
                        "vi": "chất lượng không bị dốc"
                    },
                    "examples": [
                        {
                            "en": "the gentleness of the slope",
                            "vi": "sự dịu dàng của con dốc"
