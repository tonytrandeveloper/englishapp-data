            "means": [
                {
                    "define": {
                        "en": "the fact of tending to break into small, thin pieces",
                        "vi": "thực tế là có xu hướng vỡ thành các mảnh nhỏ, mỏng"
                    },
                    "examples": [
                        {
                            "en": "the flakiness of dry skin",
                            "vi": "da khô bong tróc"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of tending to behave in a strange or unusual way or to forget things",
                        "vi": "thực tế là có xu hướng cư xử theo cách kỳ lạ hoặc bất thường hoặc để quên mọi thứ"
                    },
                    "examples": [
                        {
                            "en": "emotional flakiness",
                            "vi": "cảm xúc rung động"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of tending to not work well or to often stop working",
                        "vi": "thực tế là có xu hướng hoạt động không tốt hoặc thường xuyên ngừng hoạt động"
                    },
                    "examples": [
                        {
                            "en": "the flakiness of the hard drive",
                            "vi": "sự bong tróc của ổ cứng"
                        }
                    ]
                }
            ]
