{
    "id": "c8fb7008e7624e0a928f9421dfbb5b0b",
    "word": "pavement",
    "phonetic": {
        "uk": "/ˈpeɪvmənt/",
        "us": "/ˈpeɪvmənt/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a flat part at the side of a road for people to walk on",
                        "vi": "một phần bằng phẳng ở bên đường cho mọi người đi bộ"
                    },
                    "examples": [
                        {
                            "en": "a pavement cafe",
                            "vi": "một quán cà phê vỉa hè"
                        },
                        {
                            "en": "Don’t ride your bike on the pavement!",
                            "vi": "Đừng đạp xe trên vỉa hè!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "any area of flat stones on the ground",
                        "vi": "bất kỳ khu vực nào của đá phẳng trên mặt đất"
                    },
                    "examples": [
                        {
                            "en": "a mosaic pavement",
                            "vi": "một vỉa hè khảm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the surface of a road",
                        "vi": "bề mặt của một con đường"
                    },
                    "examples": [
                        {
                            "en": "Two cars skidded on the icy pavement.",
                            "vi": "Hai chiếc xe trượt trên mặt đường băng giá."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a large flat area of rock with nothing growing on it",
                        "vi": "một vùng đá rộng lớn bằng phẳng không có gì mọc trên đó"
                    },
                    "examples": [
                        {
                            "en": "a limestone pavement",
                            "vi": "vỉa hè lát đá vôi"
                        }
                    ]
                }
            ]
        }
    ],
