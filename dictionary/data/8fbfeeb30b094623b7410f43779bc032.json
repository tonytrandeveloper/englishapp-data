            "means": [
                {
                    "define": {
                        "en": "done or acting without thought and for no particular reason or purpose",
                        "vi": "thực hiện hoặc hành động mà không suy nghĩ và không vì lý do hoặc mục đích cụ thể"
                    },
                    "examples": [
                        {
                            "en": "mindless violence",
                            "vi": "bạo lực vô tâm"
                        },
                        {
                            "en": "mindless vandals",
                            "vi": "kẻ phá hoại vô tâm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not needing thought or intelligence",
                        "vi": "không cần suy nghĩ hay thông minh"
                    },
                    "examples": [
                        {
                            "en": "a mindless and repetitive task",
                            "vi": "một nhiệm vụ không cần đầu óc và lặp đi lặp lại"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not remembering somebody/something and not considering them or it when you do something",
                        "vi": "không nhớ ai đó / điều gì đó và không xem xét họ hoặc điều đó khi bạn làm điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "We explored the whole town, mindless of the cold and rain.",
                            "vi": "Chúng tôi khám phá toàn bộ thị trấn, không màng đến cái lạnh và mưa."
                        }
                    ]
                }
