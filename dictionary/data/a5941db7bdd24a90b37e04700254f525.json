            "means": [
                {
                    "define": {
                        "en": "in a way that is not definite or certain because you may want to change it later",
                        "vi": "theo một cách không xác định hoặc chắc chắn vì bạn có thể muốn thay đổi nó sau này"
                    },
                    "examples": [
                        {
                            "en": "They have tentatively agreed to our proposal.",
                            "vi": "Họ đã tạm thời đồng ý với đề xuất của chúng tôi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not done with confidence",
                        "vi": "theo một cách không được thực hiện một cách tự tin"
                    },
                    "examples": [
                        {
                            "en": "She smiled tentatively.",
                            "vi": "Cô mỉm cười ngập ngừng."
                        }
                    ]
                }
            ]
