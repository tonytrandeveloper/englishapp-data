            "means": [
                {
                    "define": {
                        "en": "yes; all right",
                        "vi": "Vâng; được rồi"
                    },
                    "examples": [
                        {
                            "en": "‘Shall we go for a walk?’ ‘OK.’",
                            "vi": "'Chúng ta đi dạo một chút nhé?' 'ĐƯỢC RỒI.'"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to attract somebody’s attention or to introduce a comment",
                        "vi": "được sử dụng để thu hút sự chú ý của ai đó hoặc giới thiệu một nhận xét"
                    },
                    "examples": [
                        {
                            "en": "Okay, let's go.",
                            "vi": "Được rồi đi thôi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to check that somebody agrees with you or understands you",
                        "vi": "được sử dụng để kiểm tra xem ai đó đồng ý với bạn hoặc hiểu bạn"
                    },
                    "examples": [
                        {
                            "en": "The meeting's at 2, OK?",
                            "vi": "Cuộc họp diễn ra lúc 2 giờ, được chứ?"
                        },
                        {
                            "en": "I'll do it my way, OK?",
                            "vi": "Tôi sẽ làm theo cách của tôi, OK?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to stop people arguing with you or criticizing you",
                        "vi": "dùng để ngăn mọi người tranh luận với bạn hoặc chỉ trích bạn"
                    },
                    "examples": [
                        {
                            "en": "OK, so I was wrong. I'm sorry.",
                            "vi": "OK, vì vậy tôi đã sai. Tôi xin lỗi."
                        }
                    ]
                }
            ]
