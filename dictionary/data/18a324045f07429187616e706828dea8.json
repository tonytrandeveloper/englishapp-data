    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to officially agree to something or allow it to happen",
                        "vi": "để chính thức đồng ý với điều gì đó hoặc cho phép nó xảy ra"
                    },
                    "examples": [
                        {
                            "en": "She filled in an expenses claim and her manager OK'd it.",
                            "vi": "Cô ấy điền vào một yêu cầu chi phí và người quản lý của cô ấy OK."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective, adverb",
            "means": [
                {
                    "define": {
                        "en": "safe and well; in a calm or happy state",
                        "vi": "an toàn và tốt; ở trạng thái bình tĩnh hoặc hạnh phúc"
                    },
                    "examples": [
                        {
                            "en": "Are you OK?",
                            "vi": "Bạn ổn chứ?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "all right; acceptable; in an acceptable way",
                        "vi": "được rồi; có thể chấp nhận được; theo một cách có thể chấp nhận được"
                    },
                    "examples": [
                        {
                            "en": "Is it OK if I leave now?",
                            "vi": "Có ổn không nếu tôi rời đi bây giờ?"
                        },
                        {
                            "en": "Is it OK for me to come too?",
                            "vi": "Tôi đến cũng được chứ?"
                        },
                        {
                            "en": "Does my hair look okay?",
                            "vi": "Tóc của tôi trông ổn chứ?"
                        },
                        {
                            "en": "I think I did OK in the exam.",
                            "vi": "Tôi nghĩ rằng tôi đã làm OK trong kỳ thi."
                        },
                        {
                            "en": "Whatever you decide, it's okay by me.",
                            "vi": "Dù bạn quyết định thế nào, không sao cả bởi tôi."
                        },
                        {
                            "en": "an okay movie",
                            "vi": "một bộ phim ổn"
