                            "vi": "Khi họ rời đi, trời bắt đầu mưa phùn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to pour a small amount of liquid over the surface of something",
                        "vi": "đổ một lượng nhỏ chất lỏng lên bề mặt của vật gì đó"
                    },
                    "examples": [
                        {
                            "en": "Drizzle the lemon juice over the fish.",
                            "vi": "Rưới nước chanh lên cá."
                        }
                    ]
                }
            ]
        },
