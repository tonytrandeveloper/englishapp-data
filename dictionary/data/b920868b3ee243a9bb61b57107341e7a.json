            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "when it is drizzling, it is raining lightly",
                        "vi": "khi trời mưa phùn, trời mưa nhẹ."
                    },
                    "examples": [
                        {
                            "en": "It was drizzling outside.",
                            "vi": "Bên ngoài trời đang mưa phùn."
                        },
                        {
