                        "vi": "theo cách hoàn toàn không hợp lý, đặc biệt là khi nó gây sốc hoặc làm phiền bạn"
                    },
                    "examples": [
                        {
                            "en": "a preposterously expensive bottle of wine",
                            "vi": "một chai rượu đắt tiền"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is greater than what seems reasonable or appropriate",
                        "vi": "theo cách lớn hơn những gì có vẻ hợp lý hoặc phù hợp"
                    },
                    "examples": [
                        {
                            "en": "She was relatively poor and he was preposterously rich.",
                            "vi": "Cô ấy tương đối nghèo còn anh thì giàu có một cách phi lý."
                        }
                    ]
