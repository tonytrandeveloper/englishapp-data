            "means": [
                {
                    "define": {
                        "en": "the fact of somebody/something being in or from a country that is not your own",
                        "vi": "thực tế là ai đó / cái gì đó đang ở hoặc đến từ một quốc gia không phải của riêng bạn"
                    },
                    "examples": [
                        {
                            "en": "Lee's mistakes accentuate his foreignness.",
                            "vi": "Những sai lầm của Lee làm nổi bật tính ngoại lai của anh ấy."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of being not known to somebody/something and therefore seeming strange",
                        "vi": "thực tế là không được ai đó / cái gì đó biết đến và do đó có vẻ kỳ lạ"
                    },
                    "examples": [
                        {
                            "en": "the foreignness of the past",
                            "vi": "sự xa lạ của quá khứ"
                        }
                    ]
                }
