    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a unit for measuring liquids and some dry goods, equal to 0.568 of a litre in the UK and some other countries, and 0.473 of a litre in the US. There are 8 pints in a gallon",
                        "vi": "đơn vị đo lường chất lỏng và một số mặt hàng khô, bằng 0,568 lít ở Anh và một số nước khác, và 0,473 lít ở Mỹ. Có 8 panh trong một gallon"
                    },
                    "examples": [
                        {
                            "en": "a pint of beer/milk",
                            "vi": "một vại bia / sữa"
                        },
                        {
                            "en": "We'd better get a couple of extra pints (= of milk) tomorrow.",
                            "vi": "Tốt hơn chúng ta nên mua thêm vài panh (= sữa) vào ngày mai."
                        },
                        {
                            "en": "Add half a pint of cream.",
                            "vi": "Thêm nửa lít kem."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a pint of beer (especially in a pub)",
                        "vi": "một vại bia (đặc biệt là trong quán rượu)"
                    },
                    "examples": [
                        {
                            "en": "Do you want to go for a pint later?",
                            "vi": "Bạn có muốn đi uống một chút sau không?"
                        },
                        {
                            "en": "a pint/half-pint glass",
                            "vi": "một ly pint / nửa panh"
                        }
                    ]
                }
            ]
        }
