    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to walk or move with weak, unsteady steps, especially because you are drunk or ill",
                        "vi": "đi bộ hoặc di chuyển với các bước yếu, không vững, đặc biệt là do bạn say rượu hoặc ốm"
                    },
                    "examples": [
                        {
                            "en": "She managed to totter back to her seat.",
                            "vi": "Cô xoay sở để quay trở lại chỗ ngồi của mình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to be weak and seem likely to fall",
                        "vi": "yếu ớt và có vẻ như có thể gục ngã"
                    },
                    "examples": [
                        {
                            "en": "the tottering walls of the castle",
                            "vi": "những bức tường lung lay của lâu đài"
                        },
                        {
                            "en": "(figurative) a tottering dictatorship",
                            "vi": "(nghĩa bóng) một chế độ độc tài đang lung lay"
                        }
                    ]
                }
            ]
        }
