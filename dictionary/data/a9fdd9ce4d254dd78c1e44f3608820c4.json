    "word": "rifle",
    "phonetic": {
        "uk": "/ˈraɪfl/",
        "us": "/ˈraɪfl/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a gun with a long barrel which you hold to your shoulder to fire",
                        "vi": "một khẩu súng có nòng dài mà bạn giữ trên vai để bắn"
                    },
                    "examples": [
                        {
                            "en": "a hunting rifle",
                            "vi": "một khẩu súng săn"
                        },
                        {
                            "en": "an assault rifle",
                            "vi": "một khẩu súng trường tấn công"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to search quickly through something in order to find or steal something",
                        "vi": "tìm kiếm một cách nhanh chóng thông qua một cái gì đó để tìm hoặc lấy cắp một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "She rifled through her clothes for something suitable to wear.",
                            "vi": "Cô lục tung quần áo của mình để tìm thứ gì đó phù hợp để mặc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to steal something from somewhere",
                        "vi": "ăn cắp một cái gì đó từ một nơi nào đó"
                    },
                    "examples": [
                        {
                            "en": "His wallet had been rifled.",
                            "vi": "Ví của anh ta đã bị xé toạc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to kick a ball very hard and straight in a game of football (soccer)",
                        "vi": "đá bóng rất mạnh và thẳng trong một trò chơi bóng đá (bóng đá)"
                    },
                    "examples": [
                        {
                            "en": "She rifled the ball into the roof of the net.",
                            "vi": "Cô ấy sút bóng vào nóc lưới."
                        }
                    ]
                }
            ]
        }
    ],
