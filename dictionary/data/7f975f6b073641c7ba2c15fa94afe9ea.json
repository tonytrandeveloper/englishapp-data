{
    "id": "7f975f6b073641c7ba2c15fa94afe9ea",
    "word": "eruption",
    "phonetic": {
        "uk": "/ɪˈrʌpʃn/",
        "us": "/ɪˈrʌpʃn/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an occasion when a volcano suddenly throws out burning rocks, smoke, etc.",
                        "vi": "một dịp khi núi lửa đột ngột ném ra đá cháy, khói, v.v."
                    },
                    "examples": [
                        {
                            "en": "a major volcanic eruption",
                            "vi": "một vụ phun trào núi lửa lớn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "an occasion when something starts happening, suddenly and violently",
                        "vi": "một dịp khi điều gì đó bắt đầu xảy ra, đột ngột và dữ dội"
                    },
                    "examples": [
                        {
                            "en": "an eruption of violent protest",
                            "vi": "một cuộc phản đối bạo lực bùng nổ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a sudden expression of very strong feelings, especially by shouting loudly",
                        "vi": "một biểu hiện đột ngột của cảm xúc rất mạnh, đặc biệt là bằng cách hét lớn"
                    },
                    "examples": [
                        {
                            "en": "eruptions of explosive rage",
                            "vi": "sự bùng nổ của cơn thịnh nộ bùng nổ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the sudden appearance of spots, etc. on your skin",
                        "vi": "sự xuất hiện đột ngột của các đốm, v.v. trên da của bạn"
                    },
                    "examples": [
                        {
                            "en": "skin rashes and eruptions",
                            "vi": "phát ban và phun trào da"
                        }
                    ]
                }
            ]
        }
    ],
