    "word": "she",
    "phonetic": {
        "uk": "/ʃi/",
        "us": "/ʃi/"
    },
    "blocks": [
        {
            "pos": "pronoun",
            "means": [
                {
                    "define": {
                        "en": "a female person or animal that has already been mentioned or is easily identified",
                        "vi": "một người hoặc động vật nữ đã được đề cập đến hoặc dễ dàng được xác định"
                    },
                    "examples": [
                        {
                            "en": "‘What does your sister do?’ ‘She's a dentist.’",
                            "vi": "'Chị gái của bạn làm nghề gì vậy?' 'Cô ấy là nha sĩ.'"
                        },
                        {
                            "en": "Doesn't she (= the woman we are looking at) look like Sue?",
                            "vi": "Cô ấy (= người phụ nữ chúng ta đang nhìn) có giống Sue không?"
                        },
                        {
                            "en": "Think about a friend or family member. What kind of person is he or she?",
                            "vi": "Nghĩ về một người bạn hoặc thành viên trong gia đình. Anh ấy hoặc cô ấy là người như thế nào?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "it (used to refer to something not usually thought of as female)",
                        "vi": "nó (được sử dụng để chỉ một cái gì đó thường không được coi là giống cái)"
                    },
                    "examples": [
                        {
                            "en": "She's a big country.",
                            "vi": "Cô ấy là một đất nước lớn."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a female",
                        "vi": "một người phụ nữ"
                    },
                    "examples": [
                        {
                            "en": "What a sweet little dog. Is it a he or a she?",
                            "vi": "Thật là một con chó nhỏ ngọt ngào. Đó là anh ấy hay cô ấy?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a female animal",
                        "vi": "một con vật giống cái"
                    },
                    "examples": [
                        {
                            "en": "a she-wolf",
                            "vi": "một con sói"
                        }
                    ]
                }
            ]
        }
