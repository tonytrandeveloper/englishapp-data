{
    "id": "295218cd5ed7465e9fc660301cf51e7a",
    "word": "pro",
    "phonetic": {
        "uk": "/prəʊ/",
        "us": "/prəʊ/"
    },
    "blocks": [
        {
            "pos": "preposition",
            "means": [
                {
                    "define": {
                        "en": "if somebody is pro somebody/something, they are in favour of or support that person or thing",
                        "vi": "nếu ai đó ủng hộ ai đó / cái gì đó, họ ủng hộ hoặc ủng hộ người đó hoặc vật đó"
                    },
                    "examples": [
                        {
                            "en": "He has always been pro the environment.",
                            "vi": "Anh ấy luôn là người ủng hộ môi trường."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a person who works as a professional, especially in a sport",
                        "vi": "một người làm việc chuyên nghiệp, đặc biệt là trong một môn thể thao"
                    },
                    "examples": [
                        {
                            "en": "a golf pro",
                            "vi": "một chuyên gia chơi gôn"
                        },
                        {
                            "en": "He handled the situation like an old pro (= somebody who has a lot of experience).",
                            "vi": "Anh ấy đã xử lý tình huống như một chuyên gia cũ (= một người có nhiều kinh nghiệm)."
                        },
                        {
                            "en": "She’s a real pro.",
                            "vi": "Cô ấy là một chuyên gia thực sự."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the advantages and disadvantages of something",
                        "vi": "những lợi thế và bất lợi của một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "We weighed up the pros and cons.",
                            "vi": "Chúng tôi đã cân nhắc những ưu và khuyết điểm."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "professional",
                        "vi": "chuyên nghiệp"
                    },
                    "examples": [
                        {
                            "en": "a pro wrestler",
                            "vi": "một đô vật chuyên nghiệp"
                        },
                        {
                            "en": "pro football",
                            "vi": "Bóng đá chuyên nghiệp"
                        },
                        {
                            "en": "a young boxer who’s just turned pro",
                            "vi": "một võ sĩ trẻ mới trở thành chuyên nghiệp"
                        }
                    ]
                }
            ]
        }
    ],
