                    "define": {
                        "en": "unable to do something because you are ill, or for a reason you do not want to give",
                        "vi": "không thể làm điều gì đó vì bạn bị ốm, hoặc vì một lý do bạn không muốn đưa ra"
                    },
                    "examples": [
                        {
                            "en": "She cannot perform tonight as she is indisposed.",
                            "vi": "Cô ấy không thể biểu diễn tối nay vì cô ấy không thể thiếu được."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not willing to do something",
                        "vi": "không sẵn sàng làm điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "Large sections of the potential audience seemed indisposed to attend.",
                            "vi": "Phần lớn khán giả tiềm năng dường như không thể tham dự."
                        }
                    ]
                }
            ]
