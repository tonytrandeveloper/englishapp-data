    "word": "gloomy",
    "phonetic": {
        "uk": "/ˈɡluːmi/",
        "us": "/ˈɡluːmi/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "nearly dark, or badly lit in a way that makes you feel sad",
                        "vi": "gần như tối, hoặc ánh sáng kém theo cách khiến bạn cảm thấy buồn"
                    },
                    "examples": [
                        {
                            "en": "a gloomy room/atmosphere",
                            "vi": "một căn phòng / bầu không khí u ám"
                        },
                        {
                            "en": "It was a wet and gloomy day.",
                            "vi": "Đó là một ngày ẩm ướt và u ám."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "sad and without hope",
                        "vi": "buồn và không có hy vọng"
                    },
                    "examples": [
                        {
                            "en": "a gloomy expression",
                            "vi": "một biểu hiện u ám"
                        },
                        {
                            "en": "We sat in gloomy silence.",
                            "vi": "Chúng tôi ngồi trong im lặng ảm đạm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "without much hope of success or happiness in the future",
                        "vi": "không có nhiều hy vọng thành công hoặc hạnh phúc trong tương lai"
                    },
                    "examples": [
                        {
                            "en": "a gloomy picture of the country’s economic future",
                            "vi": "một bức tranh ảm đạm về tương lai kinh tế đất nước"
                        },
                        {
                            "en": "Suddenly, the future didn't look so gloomy after all.",
                            "vi": "Đột nhiên, tương lai rốt cuộc không có vẻ u ám như vậy."
                        }
                    ]
                }
            ]
        }
