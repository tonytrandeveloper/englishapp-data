                            "vi": "luật áp bức"
                        },
                        {
                            "en": "an oppressive regime",
                            "vi": "một chế độ áp bức"
                        },
                        {
                            "en": "The political situation has grown increasingly oppressive.",
                            "vi": "Tình hình chính trị ngày càng trở nên ngột ngạt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "extremely hot and unpleasant and not having enough fresh air",
                        "vi": "cực kỳ nóng và khó chịu và không có đủ không khí trong lành"
                    },
                    "examples": [
                        {
                            "en": "oppressive heat",
                            "vi": "cái nóng ngột ngạt"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "making you feel unhappy and anxious",
                        "vi": "khiến bạn cảm thấy không vui và lo lắng"
