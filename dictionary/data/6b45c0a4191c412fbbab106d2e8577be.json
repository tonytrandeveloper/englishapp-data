    "blocks": [
        {
            "pos": "exclamation",
            "means": [
                {
                    "define": {
                        "en": "the sound that people make when they want somebody to repeat something",
                        "vi": "âm thanh mà mọi người tạo ra khi họ muốn ai đó lặp lại điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "‘I'm not hungry.’ ‘Eh?’ ‘I said I'm not hungry.’",
                            "vi": "'Tôi không đói.' 'Hở?' 'Tôi đã nói là tôi không đói.'"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the sound that people make when they want somebody to agree or reply",
                        "vi": "âm thanh mà mọi người tạo ra khi họ muốn ai đó đồng ý hoặc trả lời"
                    },
                    "examples": [
                        {
                            "en": "So what do you think, eh?",
                            "vi": "Vậy bạn nghĩ sao, hả?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the sound people make when they are surprised",
                        "vi": "âm thanh mọi người tạo ra khi họ ngạc nhiên"
                    },
                    "examples": [
                        {
                            "en": "Another new dress, eh!",
                            "vi": "Một chiếc váy mới khác, eh!"
                        }
                    ]
                }
            ]
        }
