            "means": [
                {
                    "define": {
                        "en": "a part of the sea or a river where fish are caught in large quantities",
                        "vi": "một phần của biển hoặc sông nơi đánh bắt cá với số lượng lớn"
                    },
                    "examples": [
                        {
                            "en": "a herring fishery",
                            "vi": "đánh bắt cá trích"
                        },
                        {
                            "en": "coastal/freshwater fisheries",
                            "vi": "nghề cá ven biển / nước ngọt"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a place where fish are bred (= kept in order to produce young) as a business",
                        "vi": "một nơi mà cá được nuôi (= nuôi để sản xuất con non) như một doanh nghiệp"
                    },
                    "examples": [
                        {
                            "en": "a trout fishery",
                            "vi": "đánh bắt cá hồi"
                        }
                    ]
                }
            ]
