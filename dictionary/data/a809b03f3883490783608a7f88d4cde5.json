{
    "id": "a809b03f3883490783608a7f88d4cde5",
    "word": "glimmer",
    "phonetic": {
        "uk": "/ˈɡlɪmə(r)/",
        "us": "/ˈɡlɪmər/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a small unsteady light",
                        "vi": "một ánh sáng nhỏ không ổn định"
                    },
                    "examples": [
                        {
                            "en": "We could see a glimmer of light on the far shore.",
                            "vi": "Chúng tôi có thể nhìn thấy một tia sáng le lói ở phía xa bờ."
                        },
                        {
                            "en": "We saw the glimmer of a distant torch.",
                            "vi": "Chúng tôi nhìn thấy ánh sáng lấp lánh của một ngọn đuốc xa."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a small sign of something",
                        "vi": "một dấu hiệu nhỏ của một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "a glimmer of hope",
                            "vi": "một tia hy vọng"
                        },
                        {
                            "en": "I caught the glimmer of a smile in his eyes.",
                            "vi": "Tôi bắt gặp một tia cười trong mắt anh."
                        },
                        {
                            "en": "the glimmering of an idea",
                            "vi": "sự lóe sáng của một ý tưởng"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to shine with a small unsteady light",
                        "vi": "tỏa sáng với một ánh sáng nhỏ không ổn định"
                    },
                    "examples": [
                        {
                            "en": "The candles glimmered in the corner.",
                            "vi": "Những ngọn nến le lói trong góc."
                        },
                        {
                            "en": "(figurative) Amusement glimmered in his eyes.",
                            "vi": "(nghĩa bóng) Niềm vui thoáng qua trong mắt anh."
                        }
                    ]
                }
            ]
        }
    ],
