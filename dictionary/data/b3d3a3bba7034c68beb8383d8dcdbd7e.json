    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "far away in space or time",
                        "vi": "xa trong không gian hoặc thời gian"
                    },
                    "examples": [
                        {
                            "en": "Somewhere, distantly, he could hear the sound of the sea.",
                            "vi": "Ở đâu đó, xa xăm, anh có thể nghe thấy tiếng biển."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not closely",
                        "vi": "không chặt chẽ"
                    },
                    "examples": [
                        {
                            "en": "We're distantly related.",
                            "vi": "Chúng tôi có quan hệ họ hàng xa."
                        },
                        {
                            "en": "The way I speak only distantly resembles the way I write.",
                            "vi": "Cách tôi nói chỉ giống với cách tôi viết."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that does not show real emotion because you are thinking about something else",
                        "vi": "theo cách không thể hiện cảm xúc thực sự bởi vì bạn đang nghĩ về điều gì đó khác"
                    },
                    "examples": [
                        {
                            "en": "Holly smiled distantly.",
                            "vi": "Holly mỉm cười xa cách."
                        }
                    ]
                }
            ]
