{
    "id": "94617ee50bc442d8af00f2dc8b38ea95",
    "word": "maternal",
    "phonetic": {
        "uk": "/məˈtɜːnl/",
        "us": "/məˈtɜːrnl/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "having feelings that are typical of a caring mother towards a child",
                        "vi": "có những cảm xúc điển hình của một người mẹ quan tâm đối với một đứa trẻ"
                    },
                    "examples": [
                        {
                            "en": "maternal love",
                            "vi": "tình mẫu tử"
                        },
                        {
                            "en": "I'm not very maternal.",
                            "vi": "Tôi không giống mẹ lắm."
                        },
                        {
                            "en": "She didn't have any maternal instincts.",
                            "vi": "Cô ấy không có bất kỳ bản năng làm mẹ nào."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "connected with being a mother",
                        "vi": "kết nối với việc làm mẹ"
                    },
                    "examples": [
                        {
                            "en": "Maternal age affects the baby's survival rate.",
                            "vi": "Tuổi của mẹ ảnh hưởng đến tỷ lệ sống sót của em bé."
                        },
                        {
                            "en": "the effects of maternal smoking during pregnancy",
                            "vi": "ảnh hưởng của việc mẹ hút thuốc khi mang thai"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "related through the mother’s side of the family",
                        "vi": "liên quan thông qua phía mẹ của gia đình"
                    },
                    "examples": [
                        {
                            "en": "my maternal grandfather (= my mother’s father)",
                            "vi": "ông ngoại của tôi (= bố của mẹ tôi)"
                        }
                    ]
                }
            ]
        }
    ],
