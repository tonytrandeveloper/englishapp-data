    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that shows you are not confident about yourself or your relationships with other people",
                        "vi": "theo cách cho thấy bạn không tự tin về bản thân hoặc các mối quan hệ của bạn với người khác"
                    },
                    "examples": [
                        {
                            "en": "insecurely attached children",
                            "vi": "những đứa trẻ gắn bó không an toàn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not safe or protected",
                        "vi": "theo cách không an toàn hoặc không được bảo vệ"
                    },
                    "examples": [
                        {
                            "en": "insecurely stored passwords",
                            "vi": "mật khẩu được lưu trữ không an toàn"
                        },
                        {
                            "en": "people who are insecurely housed",
                            "vi": "những người ở trong nhà không an toàn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is likely to move, fall down, etc.",
                        "vi": "theo cách có thể di chuyển, rơi xuống, v.v."
                    },
                    "examples": [
                        {
                            "en": "The unit was insecurely mounted.",
                            "vi": "Thiết bị đã được gắn kết không an toàn."
                        }
                    ]
                }
            ]
        }
