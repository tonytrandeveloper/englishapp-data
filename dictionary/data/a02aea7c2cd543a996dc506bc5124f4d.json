            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "that somebody cannot control or stop",
                        "vi": "rằng ai đó không thể kiểm soát hoặc dừng lại"
                    },
                    "examples": [
                        {
                            "en": "uncontrolled anger",
                            "vi": "tức giận không kiểm soát được"
                        },
                        {
                            "en": "The thoughts rushed into my mind uncontrolled.",
                            "vi": "Những suy nghĩ ùa về trong đầu tôi không kiểm soát được."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "that is not limited or managed by law or rules",
                        "vi": "không bị giới hạn hoặc quản lý bởi luật pháp hoặc các quy tắc"
                    },
                    "examples": [
                        {
                            "en": "the uncontrolled growth of cities",
                            "vi": "sự phát triển không kiểm soát của các thành phố"
                        },
                        {
                            "en": "uncontrolled dumping of toxic waste",
                            "vi": "đổ chất thải độc hại không kiểm soát"
                        }
                    ]
                }
            ]
        }
