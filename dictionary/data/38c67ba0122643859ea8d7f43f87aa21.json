    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "that has become very famous, like somebody/something in a myth",
                        "vi": "điều đó đã trở nên rất nổi tiếng, giống như ai đó / điều gì đó trong thần thoại"
                    },
                    "examples": [
                        {
                            "en": "Scott of the Antarctic was a national hero of mythic proportions.",
                            "vi": "Scott của Nam Cực là một anh hùng dân tộc của các tỷ lệ thần thoại."
                        },
                        {
                            "en": "a mythic figure",
                            "vi": "một nhân vật thần thoại"
                        },
                        {
                            "en": "to achieve mythic status",
                            "vi": "để đạt được trạng thái thần thoại"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "existing only in ancient myths",
                        "vi": "chỉ tồn tại trong thần thoại cổ đại"
                    },
                    "examples": [
                        {
                            "en": "mythic beasts/heroes",
                            "vi": "thú / anh hùng thần thoại"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "that does not exist or is not true",
                        "vi": "điều đó không tồn tại hoặc không đúng sự thật"
                    },
                    "examples": [
                        {
                            "en": "a mythic land of plenty",
                            "vi": "một vùng đất thần thoại có nhiều"
                        }
                    ]
                }
            ]
        }
