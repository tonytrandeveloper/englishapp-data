{
    "id": "b88725347654442fbcc23eb6f5f4c352",
    "word": "neutrally",
    "phonetic": {
        "uk": "/ˈnjuːtrəli/",
        "us": "/ˈnuːtrəli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that does not support or help either side in a disagreement, competition, etc.",
                        "vi": "theo cách không hỗ trợ hoặc giúp đỡ một trong hai bên trong bất đồng, cạnh tranh, v.v."
                    },
                    "examples": [
                        {
                            "en": "The facts must be presented neutrally and objectively.",
                            "vi": "Các sự kiện phải được trình bày một cách trung lập và khách quan."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that deliberately does not express any strong feeling",
                        "vi": "theo cách cố tình không thể hiện bất kỳ cảm giác mạnh nào"
                    },
                    "examples": [
                        {
                            "en": "‘Thank you,’ he replied neutrally.",
                            "vi": "\"Cảm ơn,\" anh ta trả lời một cách trung lập."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with neither a positive nor a negative electrical charge",
                        "vi": "không mang điện tích dương hay điện tích âm"
                    },
                    "examples": [
                        {
                            "en": "neutrally charged particles",
                            "vi": "hạt mang điện trung tính"
                        }
                    ]
                }
            ]
        }
    ],
