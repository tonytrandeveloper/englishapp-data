    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not very good or original, and without style, in a way that is embarrassing but funny",
                        "vi": "không hay hoặc nguyên bản, và không có phong cách, theo một cách đáng xấu hổ nhưng hài hước"
                    },
                    "examples": [
                        {
                            "en": "a cheesy horror movie",
                            "vi": "một bộ phim kinh dị sến"
                        },
                        {
                            "en": "That’s the cheesiest chat-up line I’ve ever heard.",
                            "vi": "Đó là dòng trò chuyện vui nhộn nhất mà tôi từng nghe."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "too emotional or romantic, in a way that is embarrassing",
                        "vi": "quá xúc động hoặc lãng mạn, theo một cách nào đó thật đáng xấu hổ"
                    },
                    "examples": [
                        {
                            "en": "a cheesy love song",
                            "vi": "một bản tình ca sến"
                        },
                        {
                            "en": "a cheesy romance novel",
                            "vi": "một cuốn tiểu thuyết lãng mạn sến súa"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "done in an exaggerated and probably not sincere way",
                        "vi": "được thực hiện một cách phóng đại và có lẽ không chân thành"
                    },
                    "examples": [
                        {
                            "en": "She had a cheesy grin on her face.",
                            "vi": "Cô ấy có một nụ cười sến súa trên khuôn mặt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "smelling or tasting of cheese",
                        "vi": "ngửi hoặc nếm pho mát"
                    },
