    "word": "post-date",
    "phonetic": {
        "uk": "/ˌpəʊst ˈdeɪt/",
        "us": "/ˌpəʊst ˈdeɪt/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to write a date on a cheque that is later than the actual date so that the cheque cannot be cashed (= exchanged for money) until that date",
                        "vi": "ghi ngày trên séc muộn hơn ngày thực tế để séc không thể được chuyển thành tiền mặt (= đổi thành tiền) cho đến ngày đó"
                    },
                    "examples": [
                        {
                            "en": "a post-dated cheque",
                            "vi": "kiểm tra sau ngày"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to happen, exist or be made at a later date than something else in the past",
                        "vi": "sẽ xảy ra, tồn tại hoặc được tạo ra vào một ngày muộn hơn so với một cái gì đó khác trong quá khứ"
                    },
                    "examples": []
                }
            ]
        }
