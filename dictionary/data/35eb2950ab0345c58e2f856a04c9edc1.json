            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "if an engine, a lamp or a fire sputters, it makes a series of short explosive sounds",
                        "vi": "nếu động cơ, đèn hoặc ngọn lửa phụt, nó sẽ tạo ra một loạt tiếng nổ ngắn"
                    },
                    "examples": [
                        {
                            "en": "Suddenly the car sputtered and stopped.",
                            "vi": "Bỗng chiếc xe lao vun vút rồi dừng lại."
                        },
                        {
                            "en": "sputtering fireworks",
                            "vi": "pháo hoa bắn tung tóe"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to speak quickly and with difficulty, making soft spitting sounds, because you are angry or shocked",
                        "vi": "nói nhanh và khó, phát ra âm thanh khạc nhổ nhẹ vì bạn đang tức giận hoặc bị sốc"
                    },
                    "examples": [
                        {
                            "en": "‘W-What?’ sputtered Anna.",
                            "vi": "'C-Cái gì?' Anna nói."
                        }
                    ]
                }
            ]
        }
