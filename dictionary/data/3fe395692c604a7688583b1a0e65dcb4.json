                        "vi": "cảm thấy khó chịu và mất kiên nhẫn vì bạn không thể làm hoặc đạt được những gì bạn muốn"
                    },
                    "examples": [
                        {
                            "en": "It's very easy to get frustrated in this job.",
                            "vi": "Bạn rất dễ nản lòng trong công việc này."
                        },
                        {
                            "en": "His apathy just made her even more frustrated.",
                            "vi": "Sự thờ ơ của anh chỉ khiến cô càng thêm bực bội."
                        },
                        {
                            "en": "frustrated at/with something They felt frustrated at the lack of progress.",
                            "vi": "thất vọng về / với điều gì đó Họ cảm thấy thất vọng vì thiếu tiến bộ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having no effect; not being satisfied",
                        "vi": "không có hiệu lực; không hài lòng"
                    },
                    "examples": [
                        {
