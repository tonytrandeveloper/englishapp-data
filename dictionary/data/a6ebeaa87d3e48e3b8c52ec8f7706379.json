            "means": [
                {
                    "define": {
                        "en": "to hold somebody in your arms in a way that shows love",
                        "vi": "ôm ai đó trong vòng tay của bạn theo cách thể hiện tình yêu"
                    },
                    "examples": [
                        {
                            "en": "She lay quietly, enfolded in his arms.",
                            "vi": "Cô nằm lặng lẽ, ôm gọn trong vòng tay anh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to surround or cover somebody/something completely",
                        "vi": "bao quanh hoặc bao phủ hoàn toàn ai đó / cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "Darkness spread and enfolded him.",
                            "vi": "Bóng tối bao trùm và bao trùm lấy anh."
                        },
                        {
                            "en": "The summit was enfolded in a circle of white cloud.",
                            "vi": "Đỉnh núi được bao bọc trong một vòng tròn của đám mây trắng."
                        }
                    ]
                }
            ]
