            "means": [
                {
                    "define": {
                        "en": "to wash something with water, especially a part of your body",
                        "vi": "rửa một thứ gì đó bằng nước, đặc biệt là một phần cơ thể của bạn"
                    },
                    "examples": [
                        {
                            "en": "Bathe the wound and apply a clean dressing.",
                            "vi": "Tắm vết thương và băng sạch."
                        },
                        {
                            "en": "His arm was bathed and the wound was lanced.",
                            "vi": "Cánh tay của anh đã được tắm rửa và vết thương đã được múa may."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to give a bath to somebody",
                        "vi": "tắm cho ai đó"
                    },
                    "examples": [
                        {
                            "en": "Have you bathed the baby yet?",
                            "vi": "Bạn đã tắm cho em bé chưa?"
                        },
                        {
                            "en": "I bathe every day.",
                            "vi": "Tôi tắm mỗi ngày."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to go swimming in the sea, a river, etc. for pleasure",
                        "vi": "đi bơi ở biển, sông, v.v. cho thỏa thích"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to fill or cover something with light",
                        "vi": "để lấp đầy hoặc che một thứ gì đó bằng ánh sáng"
                    },
                    "examples": [
                        {
                            "en": "The moon bathed the countryside in a silver light.",
                            "vi": "Vầng trăng tắm ánh bạc vùng quê."
                        }
                    ]
                }
            ]
