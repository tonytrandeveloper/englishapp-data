                    },
                    "examples": [
                        {
                            "en": "What's for pud?",
                            "vi": "Bánh pud là gì?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a hot sweet dish, often like a cake, made from flour, fat and eggs with fruit, jam, etc. in or on it",
                        "vi": "một món ngọt nóng, thường như bánh ngọt, được làm từ bột mì, chất béo và trứng với trái cây, mứt, v.v. ở trong hoặc trên đó"
                    },
                    "examples": [
                        {
                            "en": "Christmas pud",
                            "vi": "Bánh giáng sinh"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a hot dish like a pie with soft pastry made from flour, fat and eggs and usually filled with meat",
                        "vi": "một món ăn nóng như một chiếc bánh với bánh mềm làm từ bột mì, mỡ và trứng và thường là nhân thịt"
                    },
                    "examples": [
                        {
                            "en": "steak and kidney pud",
                            "vi": "bít tết và bánh thận"
