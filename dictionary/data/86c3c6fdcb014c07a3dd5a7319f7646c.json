    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "cheap wine that is not of good quality",
                        "vi": "rượu rẻ mà chất lượng không tốt"
                    },
                    "examples": [
                        {
                            "en": "a bottle of the local plonk",
                            "vi": "một chai plonk địa phương"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a low sound like that of something heavy falling and hitting a surface",
                        "vi": "một âm thanh nhỏ giống như một thứ gì đó nặng rơi xuống và va vào bề mặt"
                    },
                    "examples": [
                        {
                            "en": "She sat down with a plonk.",
                            "vi": "Cô ấy ngồi xuống với một chiếc plonk."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to put something down on something, especially noisily or carelessly",
                        "vi": "đặt một cái gì đó xuống một cái gì đó, đặc biệt là ồn ào hoặc bất cẩn"
                    },
                    "examples": [
                        {
                            "en": "He plonked the books down on the table.",
                            "vi": "Anh trút đống sách xuống bàn."
                        },
                        {
                            "en": "Just plonk your bag anywhere.",
                            "vi": "Chỉ cần đeo túi của bạn ở bất cứ đâu."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to sit down heavily or carelessly",
                        "vi": "ngồi xuống một cách nặng nề hoặc bất cẩn"
                    },
                    "examples": [
                        {
                            "en": "He just plonked himself down and turned on the TV.",
                            "vi": "Anh chỉ ngồi xuống và bật TV lên."
                        }
                    ]
                }
            ]
        }
    ],
