    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a beautiful and expensive manner",
                        "vi": "một cách đẹp đẽ và đắt tiền"
                    },
                    "examples": [
                        {
                            "en": "a richly decorated room",
                            "vi": "một căn phòng được trang trí lộng lẫy"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to express the fact that something has a pleasant strong colour, taste or smell",
                        "vi": "được sử dụng để diễn tả thực tế rằng một cái gì đó có màu sắc, mùi vị hoặc mùi mạnh dễ chịu"
                    },
                    "examples": [
                        {
                            "en": "a richly flavoured sauce",
                            "vi": "nước sốt có hương vị đậm đà"
                        },
                        {
                            "en": "The polished floor glowed richly.",
                            "vi": "Sàn nhà được đánh bóng sáng rực rỡ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a generous way",
                        "vi": "một cách hào phóng"
                    },
                    "examples": [
                        {
                            "en": "She was richly rewarded for all her hard work.",
                            "vi": "Cô ấy đã được đền đáp xứng đáng cho tất cả những gì cô ấy làm việc chăm chỉ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that people think is right and good",
                        "vi": "theo cách mà mọi người nghĩ là đúng và tốt"
                    },
                    "examples": [
                        {
                            "en": "richly deserved success",
                            "vi": "thành công xứng đáng"
                        },
                        {
                            "en": "richly earned respect",
                            "vi": "sự tôn trọng phong phú"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to express the fact that the quality or thing mentioned is present in large amounts",
                        "vi": "được sử dụng để thể hiện thực tế rằng chất lượng hoặc thứ được đề cập có mặt với số lượng lớn"
                    },
                    "examples": [
                        {
                            "en": "richly varied countryside",
                            "vi": "vùng quê phong phú đa dạng"
                        },
                        {
                            "en": "a richly atmospheric novel",
