    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to cook meat, vegetables, etc. slowly in liquid in an oven",
                        "vi": "để nấu từ từ thịt, rau, v.v. ở dạng lỏng trong lò nướng"
                    },
                    "examples": [
                        {
                            "en": "lamb casseroled with mushrooms, garlic and rosemary",
                            "vi": "thịt cừu hầm với nấm, tỏi và hương thảo"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a hot dish made with meat, vegetables, etc. that are cooked slowly in liquid in an oven",
                        "vi": "một món ăn nóng làm từ thịt, rau, v.v. được nấu từ từ ở dạng lỏng trong lò nướng"
                    },
                    "examples": [
                        {
                            "en": "a chicken casserole",
                            "vi": "thịt gà hầm"
                        },
                        {
                            "en": "Is there any casserole left?",
                            "vi": "Còn thịt hầm không?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a container with a lid (= cover) used for cooking meat, etc. in liquid in an oven",
                        "vi": "hộp có nắp (= nắp) dùng để nấu thịt, v.v. ở dạng lỏng trong lò nướng"
                    },
                    "examples": [
                        {
                            "en": "Place the chicken pieces in the bottom of a large casserole.",
                            "vi": "Đặt các miếng gà vào đáy của một soong lớn."
                        }
                    ]
                }
            ]
        }
