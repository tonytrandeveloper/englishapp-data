            "means": [
                {
                    "define": {
                        "en": "happening during the night; for a night",
                        "vi": "xảy ra trong đêm; cho một đêm"
                    },
                    "examples": [
                        {
                            "en": "an overnight flight",
                            "vi": "một chuyến bay qua đêm"
                        },
                        {
                            "en": "overnight accommodation",
                            "vi": "chỗ ở qua đêm"
                        },
                        {
                            "en": "She took only an overnight bag (= containing the things needed for a night spent away from home).",
                            "vi": "Cô ấy chỉ lấy một chiếc túi qua đêm (= đựng những thứ cần thiết cho một đêm xa nhà)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "happening suddenly or quickly",
                        "vi": "xảy ra đột ngột hoặc nhanh chóng"
                    },
                    "examples": [
                        {
                            "en": "The play was an overnight success.",
                            "vi": "Vở kịch đã thành công chỉ sau một đêm."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "means": [
