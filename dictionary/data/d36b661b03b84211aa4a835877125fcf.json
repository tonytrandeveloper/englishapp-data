            "means": [
                {
                    "define": {
                        "en": "a person who trains and controls animals, especially dogs",
                        "vi": "một người huấn luyện và điều khiển động vật, đặc biệt là chó"
                    },
                    "examples": [
                        {
                            "en": "The police brought in dog handlers to join the hunt for the attacker.",
                            "vi": "Cảnh sát đã đưa những người xử lý chó đến tham gia truy lùng kẻ tấn công."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a person who carries or deals with something as part of their job",
                        "vi": "một người mang hoặc giải quyết một cái gì đó như một phần công việc của họ"
                    },
                    "examples": [
                        {
                            "en": "airport baggage handlers",
                            "vi": "nhân viên xử lý hành lý sân bay"
                        },
                        {
                            "en": "food handlers",
                            "vi": "người xử lý thực phẩm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a person who organizes something or advises somebody",
                        "vi": "một người tổ chức một cái gì đó hoặc tư vấn cho ai đó"
                    },
                    "examples": [
                        {
                            "en": "the president’s campaign handlers",
                            "vi": "những người xử lý chiến dịch của tổng thống"
                        }
                    ]
