    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "choosing not to take action",
                        "vi": "chọn không hành động"
                    },
                    "examples": [
                        {
                            "en": "The agenda was stymied by the do-nothing Senate.",
                            "vi": "Chương trình nghị sự đã bị cản trở bởi Thượng viện."
                        },
                        {
                            "en": "Their do-nothing policies have only made things worse.",
                            "vi": "Chính sách không làm gì của họ chỉ khiến mọi thứ trở nên tồi tệ hơn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "lazy or not effective",
                        "vi": "lười biếng hoặc không hiệu quả"
                    },
                    "examples": [
                        {
                            "en": "He’s just a no-good, do-nothing loafer.",
                            "vi": "Anh ta chỉ là một kẻ lười biếng, không biết làm gì."
                        },
                        {
                            "en": "a cushy, do-nothing job",
                            "vi": "một công việc tồi tàn, không làm gì cả"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a person who is lazy or lacks ambition",
                        "vi": "một người lười biếng hoặc thiếu tham vọng"
                    },
                    "examples": [
                        {
                            "en": "If you keep hanging out with those do-nothings, you’ll never amount to anything.",
                            "vi": "Nếu bạn tiếp tục chơi với những việc không nên làm đó, bạn sẽ chẳng bao giờ thành công."
                        }
                    ]
                }
            ]
        }
