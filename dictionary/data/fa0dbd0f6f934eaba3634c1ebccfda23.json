                    "define": {
                        "en": "sympathy that you feel for somebody when a person in their family or that they know well has died; an expression of this sympathy",
                        "vi": "sự cảm thông mà bạn cảm thấy dành cho ai đó khi một người trong gia đình họ hoặc họ biết rõ đã qua đời; một biểu hiện của sự đồng cảm này"
                    },
                    "examples": [
                        {
                            "en": "to give/offer/express your condolences",
                            "vi": "để cung cấp cho / đề nghị / bày tỏ sự chia buồn của bạn"
                        },
                        {
                            "en": "Our condolences go to his wife and family.",
                            "vi": "Xin gửi lời chia buồn sâu sắc nhất tới vợ và gia đình anh ấy."
                        },
                        {
                            "en": "a letter of condolence",
                            "vi": "một lá thư chia buồn"
                        }
                    ]
                }
            ]
