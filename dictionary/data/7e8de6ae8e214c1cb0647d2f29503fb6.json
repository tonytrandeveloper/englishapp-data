                        "vi": "hiểu sai lời nói hoặc hành động của ai đó"
                    },
                    "examples": [
                        {
                            "en": "He deliberately misconstrued everything I said.",
                            "vi": "Anh ấy cố tình hiểu sai tất cả những gì tôi nói."
                        },
                        {
                            "en": "It is easy to misconstrue confidence as arrogance.",
                            "vi": "Nó rất dễ hiểu sai sự tự tin là kiêu ngạo."
                        },
                        {
                            "en": "It’s easy to misconstrue shyness as unfriendliness.",
                            "vi": "Thật dễ hiểu nhầm sự nhút nhát là không thân thiện."
