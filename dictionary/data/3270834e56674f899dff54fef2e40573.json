{
    "id": "3270834e56674f899dff54fef2e40573",
    "word": "two-way",
    "phonetic": {
        "uk": "/ˌtuː ˈweɪ/",
        "us": "/ˌtuː ˈweɪ/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "moving in two different directions; allowing something to move in two different directions",
                        "vi": "di chuyển theo hai hướng khác nhau; cho phép một cái gì đó di chuyển theo hai hướng khác nhau"
                    },
                    "examples": [
                        {
                            "en": "two-way traffic",
                            "vi": "Đường hai chiều"
                        },
                        {
                            "en": "two-way trade",
                            "vi": "thương mại hai chiều"
                        },
                        {
                            "en": "a two-way switch (= that allows electric current to be turned on or off from either of two points)",
                            "vi": "công tắc hai chiều (= cho phép bật hoặc tắt dòng điện từ một trong hai điểm)"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "needing equal effort from both people or groups involved",
                        "vi": "cần nỗ lực như nhau của cả người hoặc nhóm có liên quan"
                    },
                    "examples": [
                        {
                            "en": "Friendship is a two-way process.",
                            "vi": "Tình bạn là một quá trình hai chiều."
                        },
                        {
                            "en": "a two-way exchange of information",
                            "vi": "trao đổi thông tin hai chiều"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used both for sending and receiving signals",
                        "vi": "được sử dụng cả để gửi và nhận tín hiệu"
                    },
                    "examples": [
                        {
                            "en": "a two-way radio",
                            "vi": "một đài phát thanh hai chiều"
                        }
                    ]
                }
            ]
        }
    ],
