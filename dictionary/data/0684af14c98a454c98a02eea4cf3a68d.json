{
    "id": "0684af14c98a454c98a02eea4cf3a68d",
    "word": "drape",
    "phonetic": {
        "uk": "/dreɪp/",
        "us": "/dreɪp/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to hang clothes, materials, etc. loosely on somebody/something",
                        "vi": "để treo quần áo, tài liệu, v.v. một cách lỏng lẻo trên ai đó / cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "She had a shawl draped around her shoulders.",
                            "vi": "Cô ấy có một chiếc khăn choàng choàng qua vai."
                        },
                        {
                            "en": "He draped his coat over the back of the chair.",
                            "vi": "Anh khoác áo khoác lên lưng ghế."
                        },
                        {
                            "en": "She draped a cover over the old sofa.",
                            "vi": "Cô phủ một tấm phủ lên chiếc ghế sofa cũ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to hang loosely",
                        "vi": "treo lỏng lẻo"
                    },
                    "examples": [
                        {
                            "en": "Some silk fabrics will drape beautifully.",
                            "vi": "Một số loại vải lụa sẽ xếp nếp rất đẹp."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to cover or decorate somebody/something with material",
                        "vi": "để che hoặc trang trí ai đó / cái gì đó bằng vật liệu"
                    },
                    "examples": [
                        {
                            "en": "walls draped in ivy",
                            "vi": "tường phủ cây thường xuân"
                        },
                        {
                            "en": "The body was draped in a blanket.",
                            "vi": "Cơ thể được trùm trong một chiếc chăn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to allow part of your body to rest on something in a relaxed way",
                        "vi": "để cho phép một phần cơ thể của bạn nghỉ ngơi trên một thứ gì đó một cách thoải mái"
                    },
                    "examples": [
                        {
                            "en": "His arm was draped casually around her shoulders.",
                            "vi": "Cánh tay anh khoác hờ hững trên vai cô."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a long thick curtain",
                        "vi": "một tấm rèm dài dày"
                    },
                    "examples": [
                        {
                            "en": "blue velvet drapes",
                            "vi": "màn nhung xanh"
                        }
                    ]
                }
            ]
        }
