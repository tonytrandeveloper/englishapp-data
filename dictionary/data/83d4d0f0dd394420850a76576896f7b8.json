{
    "id": "83d4d0f0dd394420850a76576896f7b8",
    "word": "giddy",
    "phonetic": {
        "uk": "/ˈɡɪdi/",
        "us": "/ˈɡɪdi/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "feeling that everything is moving and that you are going to fall",
                        "vi": "cảm thấy rằng mọi thứ đang chuyển động và bạn sắp ngã"
                    },
                    "examples": [
                        {
                            "en": "When I looked down from the top floor, I felt giddy.",
                            "vi": "Khi tôi nhìn xuống từ tầng cao nhất, tôi cảm thấy mình thật thích thú."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "so happy and excited that you cannot behave normally",
                        "vi": "hạnh phúc và vui mừng đến mức bạn không thể cư xử bình thường"
                    },
                    "examples": [
                        {
                            "en": "She was giddy with happiness.",
                            "vi": "Cô ấy đã được vui vẻ vì hạnh phúc."
                        },
                        {
                            "en": "She was giddy with anticipation about spending two months with her father.",
                            "vi": "Cô thích thú với dự đoán về việc dành hai tháng với cha mình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "making you feel as if you are about to fall",
                        "vi": "khiến bạn cảm thấy như thể bạn sắp ngã"
                    },
                    "examples": [
                        {
                            "en": "The kids were pushing the roundabout at a giddy speed.",
                            "vi": "Những đứa trẻ đang đẩy vòng xuyến với tốc độ chóng mặt."
                        },
                        {
                            "en": "(figurative) the giddy heights of success",
                            "vi": "(nghĩa bóng) đỉnh cao của sự thành công"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not serious",
                        "vi": "không nghiêm trọng"
                    },
                    "examples": [
                        {
                            "en": "Isabel’s giddy young sister",
                            "vi": "Cô em gái ham chơi của Isabel"
                        }
                    ]
                }
            ]
        }
    ],
