    "word": "tangle",
    "phonetic": {
        "uk": "/ˈtæŋɡl/",
        "us": "/ˈtæŋɡl/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to twist something into an untidy mass; to become twisted in this way",
                        "vi": "để xoắn một cái gì đó thành một khối không gọn gàng; trở nên xoắn theo cách này"
                    },
                    "examples": [
                        {
                            "en": "She had tangled up the sheets on the bed as she lay tossing and turning.",
                            "vi": "Cô ấy đã làm rối tung tấm trải giường trên giường khi cô ấy nằm lật đi lật lại."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a twisted mass of threads, hair, etc. that cannot be easily separated",
                        "vi": "một khối xoắn ốc, sợi tóc, v.v. không thể tách rời dễ dàng"
                    },
                    "examples": [
                        {
                            "en": "a tangle of branches",
                            "vi": "một mớ cành"
                        },
                        {
                            "en": "Her hair was a mass of tangles.",
                            "vi": "Tóc cô rối bời."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a lack of order; a confused state",
                        "vi": "thiếu trật tự; một trạng thái bối rối"
                    },
                    "examples": [
                        {
                            "en": "His financial affairs are in a tangle.",
                            "vi": "Vấn đề tài chính của anh ấy đang rối ren."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a disagreement or fight",
                        "vi": "bất đồng hoặc chiến đấu"
                    },
                    "examples": []
                }
            ]
        }
    ],
