                            "vi": "một thanh niên giận dữ vô ơn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not pleasant or attractive to look at",
                        "vi": "không dễ chịu hoặc hấp dẫn khi nhìn vào"
                    },
                    "examples": [
                        {
                            "en": "the graceless architecture of the 1960s",
                            "vi": "kiến trúc vô cùng quyến rũ của những năm 1960"
                        }
                    ]
                },
                {
                    "define": {
