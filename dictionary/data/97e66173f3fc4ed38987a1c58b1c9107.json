            "means": [
                {
                    "define": {
                        "en": "you use unadulterated to emphasize that something is complete or total",
                        "vi": "bạn sử dụng không sai lầm để nhấn mạnh rằng một cái gì đó đã hoàn thành hoặc toàn bộ"
                    },
                    "examples": [
                        {
                            "en": "For me, the holiday was sheer unadulterated pleasure.",
                            "vi": "Đối với tôi, kỳ nghỉ là một niềm vui tuyệt đối."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not mixed with other substances; not adulterated",
                        "vi": "không trộn lẫn với các chất khác; không bị pha tạp"
                    },
                    "examples": [
                        {
                            "en": "unadulterated foods",
                            "vi": "thực phẩm không pha tạp"
                        }
                    ]
                }
