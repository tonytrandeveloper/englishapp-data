            "means": [
                {
                    "define": {
                        "en": "to make an animal or a plant become a fossil; to become a fossil",
                        "vi": "để biến động vật hoặc thực vật trở thành hóa thạch; trở thành một hóa thạch"
                    },
                    "examples": [
                        {
                            "en": "The bones have been fossilized and beautifully preserved.",
                            "vi": "Các bộ xương đã được hóa thạch và được bảo quản rất đẹp."
                        },
                        {
                            "en": "Flowers do not readily fossilize.",
                            "vi": "Hoa không dễ hóa thạch."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to become, or make somebody/something become, fixed and unable to change or develop",
                        "vi": "trở thành, hoặc làm cho ai đó / cái gì đó trở thành, cố định và không thể thay đổi hoặc phát triển"
