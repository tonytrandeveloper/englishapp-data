{
    "id": "267ff5929d3848a2ba719d050d17105a",
    "word": "unhealthily",
    "phonetic": {
        "uk": "/ʌnˈhelθɪli/",
        "us": "/ʌnˈhelθɪli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that shows or suggests that somebody does not have good health",
                        "vi": "theo cách cho thấy hoặc gợi ý rằng ai đó không có sức khỏe tốt"
                    },
                    "examples": [
                        {
                            "en": "Some models are unhealthily thin.",
                            "vi": "Một số kiểu máy mỏng có hại cho sức khỏe."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is harmful to your health or is likely to make you ill",
                        "vi": "theo cách có hại cho sức khỏe của bạn hoặc có thể khiến bạn bị ốm"
                    },
                    "examples": [
                        {
                            "en": "She eats too unhealthily.",
                            "vi": "Cô ấy ăn quá không lành mạnh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not normal and is likely to be harmful",
                        "vi": "theo cách không bình thường và có khả năng gây hại"
                    },
                    "examples": [
                        {
                            "en": "He was unhealthily obsessed with past events.",
                            "vi": "Anh ta bị ám ảnh một cách khôn ngoan với những sự kiện trong quá khứ."
                        }
                    ]
                }
            ]
        }
    ],
