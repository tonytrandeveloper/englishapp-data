{
    "id": "0a33277979844240883851f0f30c7354",
    "word": "tactical",
    "phonetic": {
        "uk": "/ˈtæktɪkl/",
        "us": "/ˈtæktɪkl/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "connected with the particular method you use to achieve something",
                        "vi": "được kết nối với phương pháp cụ thể mà bạn sử dụng để đạt được điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "tactical planning",
                            "vi": "lập kế hoạch chiến thuật"
                        },
                        {
                            "en": "to have a tactical advantage",
                            "vi": "để có một lợi thế chiến thuật"
                        },
                        {
                            "en": "Telling your boss you were looking for a new job was a tactical error (= it was the wrong thing to do at that time).",
                            "vi": "Nói với sếp rằng bạn đang tìm một công việc mới là một lỗi chiến thuật (= đó là điều sai lầm khi làm vào thời điểm đó)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "carefully planned in order to achieve a particular aim",
                        "vi": "lên kế hoạch cẩn thận để đạt được một mục tiêu cụ thể"
                    },
                    "examples": [
                        {
                            "en": "a tactical decision",
                            "vi": "một quyết định chiến thuật"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used or having an effect over short distances or for a short time",
                        "vi": "được sử dụng hoặc có tác dụng trong khoảng cách ngắn hoặc trong thời gian ngắn"
                    },
                    "examples": [
                        {
                            "en": "tactical weapons/missiles",
                            "vi": "vũ khí chiến thuật / tên lửa"
                        },
                        {
                            "en": "tactical nuclear weapons",
                            "vi": "vũ khí hạt nhân chiến thuật"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "connected with military tactics",
                        "vi": "kết nối với các chiến thuật quân sự"
                    },
                    "examples": [
                        {
                            "en": "He was given tactical command of the operation.",
                            "vi": "Anh ta được trao quyền chỉ huy chiến thuật của cuộc hành quân."
                        }
                    ]
                }
            ]
        }
