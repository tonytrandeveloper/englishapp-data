            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the natural features of an area, such as mountains, valleys, rivers and forests, when you are thinking about them being attractive to look at",
                        "vi": "các đặc điểm tự nhiên của một khu vực, chẳng hạn như núi, thung lũng, sông và rừng, khi bạn nghĩ về chúng sẽ hấp dẫn khi nhìn vào"
                    },
                    "examples": [
                        {
                            "en": "The scenery is magnificent.",
                            "vi": "Phong cảnh thật tráng lệ."
                        },
                        {
                            "en": "to enjoy the scenery",
                            "vi": "để thưởng thức phong cảnh"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the painted background that is used to represent natural features or buildings on a theatre stage",
                        "vi": "nền sơn được sử dụng để thể hiện các đặc điểm tự nhiên hoặc các tòa nhà trên sân khấu nhà hát"
                    },
                    "examples": [
                        {
                            "en": "That table is part of the scenery for Act 2.",
                            "vi": "Chiếc bàn đó là một phần của khung cảnh cho Màn 2."
                        }
                    ]
                }
            ]
        }
