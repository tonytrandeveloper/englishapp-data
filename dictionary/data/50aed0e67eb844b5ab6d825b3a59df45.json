{
    "id": "50aed0e67eb844b5ab6d825b3a59df45",
    "word": "contaminate",
    "phonetic": {
        "uk": "/kənˈtæmɪneɪt/",
        "us": "/kənˈtæmɪneɪt/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make a substance or place dirty or no longer pure by adding a substance that is dangerous or carries disease",
                        "vi": "để làm cho một chất hoặc một nơi bẩn thỉu hoặc không còn tinh khiết bằng cách thêm một chất gây nguy hiểm hoặc mang mầm bệnh"
                    },
                    "examples": [
                        {
                            "en": "The drinking water has become contaminated with lead.",
                            "vi": "Nước uống bị nhiễm chì."
                        },
                        {
                            "en": "contaminated blood/food/soil",
                            "vi": "máu / thực phẩm / đất bị ô nhiễm"
                        },
                        {
                            "en": "a river contaminated by pollution",
                            "vi": "một dòng sông bị ô nhiễm"
                        },
                        {
                            "en": "These substances can contaminate groundwater.",
                            "vi": "Những chất này có thể làm ô nhiễm nguồn nước ngầm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to influence people’s ideas or attitudes in a bad way",
                        "vi": "ảnh hưởng đến ý tưởng hoặc thái độ của mọi người theo cách xấu"
                    },
                    "examples": [
                        {
                            "en": "They were accused of contaminating the minds of our young people.",
                            "vi": "Họ đã bị buộc tội làm ô nhiễm tâm trí của những người trẻ tuổi của chúng tôi."
                        }
                    ]
                }
            ]
        }
    ],
