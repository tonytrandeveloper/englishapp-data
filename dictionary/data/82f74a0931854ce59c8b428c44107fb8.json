{
    "id": "82f74a0931854ce59c8b428c44107fb8",
    "word": "generously",
    "phonetic": {
        "uk": "/ˈdʒenərəsli/",
        "us": "/ˈdʒenərəsli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that shows that somebody is willing to give freely",
                        "vi": "theo cách cho thấy ai đó sẵn sàng cho một cách tự do"
                    },
                    "examples": [
                        {
                            "en": "Please give generously.",
                            "vi": "Hãy rộng lượng cho đi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "using or providing more of something than is necessary",
                        "vi": "sử dụng hoặc cung cấp nhiều thứ hơn mức cần thiết"
                    },
                    "examples": [
                        {
                            "en": "a dress that is generously cut (= uses plenty of material)",
                            "vi": "một chiếc váy được cắt may rộng rãi (= sử dụng nhiều chất liệu)"
                        },
                        {
                            "en": "Season generously with salt and pepper.",
                            "vi": "Nêm muối và tiêu."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "kindly; in a way that shows that somebody is willing to see what is good about somebody/something",
                        "vi": "tử tế; theo cách thể hiện rằng ai đó sẵn sàng xem điều gì tốt về ai đó / điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "She speaks generously about everyone.",
                            "vi": "Cô ấy nói một cách hào phóng về tất cả mọi người."
                        }
                    ]
                }
            ]
        }
