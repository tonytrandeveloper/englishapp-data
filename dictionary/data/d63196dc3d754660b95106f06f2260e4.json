                    },
                    "examples": [
                        {
                            "en": "He hated untidiness and dirt.",
                            "vi": "Anh ghét sự bừa bộn và bẩn thỉu."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of tending not to keep things neat or well organized",
                        "vi": "thực tế là có xu hướng không giữ mọi thứ gọn gàng hoặc ngăn nắp"
                    },
                    "examples": [
                        {
                            "en": "He teased her for her untidiness.",
                            "vi": "Anh trêu chọc cô vì sự không khéo léo của cô."
