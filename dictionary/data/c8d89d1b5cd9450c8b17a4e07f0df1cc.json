    "word": "watery",
    "phonetic": {
        "uk": "/ˈwɔːtəri/",
        "us": "/ˈwɔːtəri/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "of or like water; containing a lot of water",
                        "vi": "của hoặc giống như nước; chứa nhiều nước"
                    },
                    "examples": [
                        {
                            "en": "a watery fluid",
                            "vi": "một chất lỏng"
                        },
                        {
                            "en": "His eyes were red and watery.",
                            "vi": "Đôi mắt anh đỏ hoe và ngấn nước."
                        },
                        {
                            "en": "(literary) She was rescued from a watery grave (= saved from drowning).",
                            "vi": "(văn học) Cô ấy đã được cứu khỏi một nấm mồ đầy nước (= được cứu khỏi chết đuối)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "weak and/or pale",
                        "vi": "yếu và / hoặc xanh xao"
                    },
                    "examples": [
                        {
                            "en": "a watery sun",
                            "vi": "mặt trời nhiều nước"
                        },
                        {
                            "en": "His eyes were a watery blue.",
                            "vi": "Đôi mắt anh ta có một màu xanh nước."
                        },
                        {
                            "en": "a watery smile (= weak and without much feeling)",
                            "vi": "một nụ cười chảy nước (= yếu ớt và không có nhiều cảm xúc)"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "containing too much water; thin and having no taste",
                        "vi": "chứa quá nhiều nước; mỏng và không có mùi vị"
                    },
                    "examples": [
                        {
                            "en": "The vegetables were watery and tasteless.",
                            "vi": "Rau bị chảy nước và không có vị."
                        },
                        {
                            "en": "watery soup",
                            "vi": "nước súp"
                        }
                    ]
                }
            ]
        }
