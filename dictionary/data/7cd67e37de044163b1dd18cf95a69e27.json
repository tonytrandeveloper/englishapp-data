    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "that may change; making people uncertain about what might happen",
                        "vi": "điều đó có thể thay đổi; khiến mọi người không chắc chắn về những gì có thể xảy ra"
                    },
                    "examples": [
                        {
                            "en": "These were difficult and unsettled times.",
                            "vi": "Đây là những thời điểm khó khăn và bất ổn."
                        },
                        {
                            "en": "The weather has been very unsettled (= it has changed a lot).",
                            "vi": "Thời tiết rất bất ổn (= nó đã thay đổi rất nhiều)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not calm or relaxed",
                        "vi": "không bình tĩnh hoặc thoải mái"
                    },
                    "examples": [
                        {
                            "en": "They all felt restless and unsettled.",
                            "vi": "Tất cả đều cảm thấy bồn chồn và bất an."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "that continues without any agreement being reached",
                        "vi": "điều đó tiếp tục mà không đạt được bất kỳ thỏa thuận nào"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "not yet paid",
                        "vi": "chưa trả"
                    },
                    "examples": []
                }
            ]
        }
