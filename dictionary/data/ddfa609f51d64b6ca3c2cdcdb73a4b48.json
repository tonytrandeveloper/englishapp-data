    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "affecting or connected with the whole of something, especially the human body or a society",
                        "vi": "ảnh hưởng hoặc kết nối với toàn bộ điều gì đó, đặc biệt là cơ thể con người hoặc xã hội"
                    },
                    "examples": [
                        {
                            "en": "a systemic disease",
                            "vi": "một bệnh toàn thân"
                        },
                        {
                            "en": "systemic racism in society",
                            "vi": "phân biệt chủng tộc có hệ thống trong xã hội"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "systemic chemicals or drugs that are used to treat diseases in plants or animals enter the body of the plant or animal and spread to all parts of it",
                        "vi": "hóa chất toàn thân hoặc thuốc được sử dụng để điều trị bệnh cho thực vật hoặc động vật xâm nhập vào cơ thể của thực vật hoặc động vật và lây lan đến tất cả các bộ phận của nó"
                    },
                    "examples": [
                        {
                            "en": "systemic weedkillers",
                            "vi": "thuốc diệt cỏ toàn thân"
                        }
                    ]
                }
            ]
        }
