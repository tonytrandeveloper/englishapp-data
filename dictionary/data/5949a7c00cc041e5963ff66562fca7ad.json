                {
                    "define": {
                        "en": "soft and intended to please, but often not sincere",
                        "vi": "mềm mỏng và có ý định làm hài lòng, nhưng thường không chân thành"
                    },
                    "examples": [
                        {
                            "en": "She spoke in honeyed tones.",
                            "vi": "Cô ấy nói với giọng ngọt ngào."
                        },
                        {
                            "en": "‘Of course I love you, darling,’ she said in honeyed tones.",
                            "vi": "“Tất nhiên là em yêu anh rồi, anh yêu,” cô ấy nói với giọng ngọt ngào."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "tasting or smelling like honey, or having the colour of honey",
                        "vi": "nếm hoặc có mùi như mật ong, hoặc có màu của mật ong"
                    },
                    "examples": [
                        {
                            "en": "We sniffed the honeyed air.",
                            "vi": "Chúng tôi đánh hơi không khí ngọt ngào."
                        },
                        {
                            "en": "The walls are made of a honeyed stone.",
                            "vi": "Các bức tường được làm bằng đá mật ong."
                        }
                    ]
                }
            ]
