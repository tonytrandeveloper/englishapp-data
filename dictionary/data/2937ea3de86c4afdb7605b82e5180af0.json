    "blocks": [
        {
            "pos": "phrasal verb",
            "means": [
                {
                    "define": {
                        "en": "to phone a place, especially the place where you work",
                        "vi": "điện thoại cho một nơi, đặc biệt là nơi bạn làm việc"
                    },
                    "examples": [
                        {
                            "en": "Several people have called in sick today.",
                            "vi": "Một số người đã bị ốm hôm nay."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to ask for the services of somebody",
                        "vi": "để yêu cầu các dịch vụ của ai đó"
                    },
                    "examples": [
                        {
                            "en": "to call in a doctor/the police",
                            "vi": "gọi bác sĩ / cảnh sát"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to order or ask for the return of something",
                        "vi": "để đặt hàng hoặc yêu cầu trả lại một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "Cars with serious faults have been called in by the manufacturers.",
                            "vi": "Những chiếc xe bị lỗi nghiêm trọng đã được các nhà sản xuất gọi đến."
                        }
                    ]
                }
            ]
