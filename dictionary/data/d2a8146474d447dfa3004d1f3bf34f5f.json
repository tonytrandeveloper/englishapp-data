{
    "id": "d2a8146474d447dfa3004d1f3bf34f5f",
    "word": "congenital",
    "phonetic": {
        "uk": "/kənˈdʒenɪtl/",
        "us": "/kənˈdʒenɪtl/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "existing since or before birth",
                        "vi": "tồn tại từ trước hoặc trước khi sinh"
                    },
                    "examples": [
                        {
                            "en": "congenital abnormalities",
                            "vi": "bất thường bẩm sinh"
                        },
                        {
                            "en": "Children born to mothers who smoked were at risk of congenital heart disease.",
                            "vi": "Những đứa trẻ sinh ra từ những bà mẹ hút thuốc có nguy cơ mắc bệnh tim bẩm sinh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "existing as part of a person’s character and not likely to change",
                        "vi": "tồn tại như một phần tính cách của một người và không có khả năng thay đổi"
                    },
                    "examples": [
                        {
                            "en": "She seems to have a congenital inability to tell the truth.",
                            "vi": "Cô ấy dường như bị bẩm sinh không có khả năng nói ra sự thật."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "born with a particular illness",
                        "vi": "sinh ra với một căn bệnh đặc biệt"
                    },
                    "examples": [
                        {
                            "en": "(figurative) a congenital liar (= one who will not change)",
                            "vi": "(nghĩa bóng) một kẻ nói dối bẩm sinh (= một người không chịu thay đổi)"
                        },
                        {
                            "en": "He's a congenital liar!",
                            "vi": "Anh ta là một kẻ nói dối bẩm sinh!"
                        }
                    ]
                }
            ]
        }
