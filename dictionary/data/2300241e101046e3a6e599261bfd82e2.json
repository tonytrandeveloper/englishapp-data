    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "made to be thrown away after use",
                        "vi": "được làm để vứt bỏ sau khi sử dụng"
                    },
                    "examples": [
                        {
                            "en": "disposable gloves/razors",
                            "vi": "găng tay / dao cạo râu dùng một lần"
                        },
                        {
                            "en": "(British English) disposable nappies",
                            "vi": "(Tiếng Anh Anh) tã lót dùng một lần"
                        },
                        {
                            "en": "(North American English) disposable diapers",
                            "vi": "(Tiếng Anh Bắc Mỹ) tã dùng một lần"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "(of people or ideas) that you can easily stop employing or thinking about",
                        "vi": "(về những người hoặc ý tưởng) mà bạn có thể dễ dàng ngừng sử dụng hoặc suy nghĩ về"
                    },
                    "examples": [
                        {
                            "en": "It is completely wrong for corporations to view workers as disposable.",
                            "vi": "Việc các tập đoàn coi công nhân là đồ dùng một lần là hoàn toàn sai lầm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "available for use",
                        "vi": "có sẵn để sử dụng"
                    },
                    "examples": [
                        {
                            "en": "disposable assets/capital/resources",
                            "vi": "tài sản dùng một lần / vốn / tài nguyên"
                        },
                        {
                            "en": "a person’s disposable income (= money they are free to spend after paying taxes, etc.)",
                            "vi": "thu nhập khả dụng của một người (= số tiền họ được tự do chi tiêu sau khi trả thuế, v.v.)"
                        }
                    ]
                }
            ]
        }
