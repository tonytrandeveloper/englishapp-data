            "means": [
                {
                    "define": {
                        "en": "to change your opinion about something, especially when you then hold the opposite opinion",
                        "vi": "để thay đổi quan điểm của bạn về điều gì đó, đặc biệt là khi bạn giữ ý kiến ngược lại"
                    },
                    "examples": [
                        {
                            "en": "The vice-president was accused of flip-flopping on several major issues.",
                            "vi": "Phó tổng thống bị cáo buộc đã lật tẩy một số vấn đề lớn."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a type of sandal (= open shoe), typically made of plastic or rubber, that has a piece that goes between the big toe and the toe next to it",
                        "vi": "một loại sandal (= giày hở), thường được làm bằng nhựa hoặc cao su, có một miếng đi giữa ngón chân cái và ngón chân bên cạnh"
                    },
                    "examples": [
                        {
                            "en": "a pair of flip-flops",
