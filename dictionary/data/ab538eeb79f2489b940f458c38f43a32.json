                    ]
                },
                {
                    "define": {
                        "en": "not clear because of a lack of memory, understanding or detail",
                        "vi": "không rõ ràng vì thiếu trí nhớ, sự hiểu biết hoặc chi tiết"
                    },
                    "examples": [
                        {
                            "en": "a hazy memory/idea",
                            "vi": "một ký ức / ý tưởng mơ hồ"
                        },
                        {
                            "en": "The dividing line is somewhat hazy.",
                            "vi": "Đường phân cách có phần hơi mơ hồ."
                        },
                        {
                            "en": "What happened next is all very hazy.",
                            "vi": "Những gì xảy ra tiếp theo đều rất mơ hồ."
                        },
                        {
                            "en": "I have only a very hazy idea about how the economy works.",
                            "vi": "Tôi chỉ có một ý tưởng rất mơ hồ về cách thức hoạt động của nền kinh tế."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "uncertain or confused about something",
                        "vi": "không chắc chắn hoặc nhầm lẫn về điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "I'm a little hazy about what to do next.",
                            "vi": "Tôi hơi mơ hồ không biết phải làm gì tiếp theo."
