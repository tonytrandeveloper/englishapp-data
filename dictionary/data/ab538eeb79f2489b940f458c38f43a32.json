                    },
                    "examples": [
                        {
                            "en": "a hazy afternoon/sky",
                            "vi": "một buổi chiều mơ hồ / bầu trời"
                        },
                        {
                            "en": "hazy light/sunshine",
                            "vi": "ánh sáng mờ / nắng"
                        },
                        {
                            "en": "The mountains were hazy in the distance.",
                            "vi": "Những ngọn núi mờ ảo phía xa."
                        },
                        {
                            "en": "The room was hazy with smoke.",
                            "vi": "Căn phòng mịt mờ khói thuốc."
