            "means": [
                {
                    "define": {
                        "en": "based on, or holding, the belief that everyone is equal and should have the same rights and opportunities",
                        "vi": "dựa trên, hoặc giữ vững niềm tin rằng mọi người đều bình đẳng và cần có các quyền và cơ hội như nhau"
                    },
                    "examples": [
                        {
                            "en": "an egalitarian society",
                            "vi": "một xã hội bình đẳng"
                        },
                        {
                            "en": "a highly egalitarian system of taxation",
                            "vi": "một hệ thống thuế rất bình đẳng"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a person who believes that everyone is equal and should have the same rights and opportunities",
                        "vi": "một người tin rằng mọi người đều bình đẳng và có quyền và cơ hội như nhau"
                    },
                    "examples": [
                        {
                            "en": "He described himself as ‘an egalitarian’.",
                            "vi": "Anh ta tự mô tả mình là 'một người theo chủ nghĩa quân bình'."
                        }
                    ]
                }
            ]
