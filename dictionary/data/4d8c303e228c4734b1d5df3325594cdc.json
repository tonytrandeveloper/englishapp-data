    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to talk in an aggressive or threatening way, but with little effect",
                        "vi": "nói chuyện theo cách hung hăng hoặc đe dọa, nhưng ít có tác dụng"
                    },
                    "examples": [
                        {
                            "en": "‘I don't know what you're talking about,’ he blustered.",
                            "vi": "\"Tôi không biết bạn đang nói về cái gì,\" anh ta đỏ mặt."
                        },
                        {
                            "en": "a blustering bully",
                            "vi": "một kẻ bắt nạt đỏ mặt"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to blow violently",
                        "vi": "thổi dữ dội"
                    },
                    "examples": [
                        {
                            "en": "Outside the wind was blustering.",
                            "vi": "Ngoài trời gió lồng lộng."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "talk that is aggressive and threatening , but has little effect",
                        "vi": "nói chuyện hung hăng và đe dọa, nhưng ít có tác dụng"
                    },
                    "examples": [
                        {
                            "en": "I wasn't frightened by what he said—it was all bluster.",
                            "vi": "Tôi không sợ hãi với những gì anh ta nói - tất cả đều rất bối rối."
                        }
                    ]
