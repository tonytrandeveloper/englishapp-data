    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not receiving the thanks or praise that is deserved",
                        "vi": "không nhận được lời cảm ơn hoặc lời khen ngợi xứng đáng"
                    },
                    "examples": [
                        {
                            "en": "Her contribution to the research went largely unacknowledged.",
                            "vi": "Đóng góp của cô ấy cho nghiên cứu hầu như không được công nhận."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "that people do not admit as existing or true; that people are not aware of",
                        "vi": "mà mọi người không thừa nhận là tồn tại hoặc đúng; mà mọi người không nhận thức được"
                    },
                    "examples": [
                        {
                            "en": "unacknowledged feelings",
                            "vi": "cảm xúc chưa được thừa nhận"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not publicly or officially recognized",
                        "vi": "không được công nhận công khai hoặc chính thức"
                    },
                    "examples": [
                        {
                            "en": "the unacknowledged leader of the group",
                            "vi": "thủ lĩnh chưa được công nhận của nhóm"
                        }
                    ]
                }
            ]
        }
