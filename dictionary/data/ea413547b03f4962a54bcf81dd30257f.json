    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a message congratulating somebody (= saying that you are happy about their good luck or success)",
                        "vi": "một tin nhắn chúc mừng ai đó (= nói rằng bạn rất vui về sự may mắn hoặc thành công của họ)"
                    },
                    "examples": [
                        {
                            "en": "to offer/send your congratulations to somebody",
                            "vi": "để cung cấp / gửi lời chúc mừng của bạn đến ai đó"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used when you want to congratulate somebody",
                        "vi": "được sử dụng khi bạn muốn chúc mừng ai đó"
                    },
                    "examples": [
                        {
                            "en": "‘We're getting married!’ ‘Congratulations!’",
                            "vi": "'Chúng tôi sẽ làm đám cưới!' 'Xin chúc mừng!'"
                        },
                        {
                            "en": "Congratulations on your exam results!",
                            "vi": "Xin chúc mừng kết quả kỳ thi của bạn!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the act of congratulating somebody",
                        "vi": "hành động chúc mừng ai đó"
                    },
                    "examples": [
                        {
                            "en": "a letter of congratulation",
                            "vi": "một lá thư chúc mừng"
                        }
                    ]
                }
            ]
