                    "define": {
                        "en": "in a way that shows that you are unable to think clearly or to understand what is happening or what somebody is saying",
                        "vi": "theo cách cho thấy rằng bạn không thể suy nghĩ rõ ràng hoặc không thể hiểu những gì đang xảy ra hoặc những gì ai đó đang nói"
                    },
                    "examples": [
                        {
                            "en": "‘What? I'm lost,’ Eric said confusedly.",
                            "vi": "'Gì? Tôi bị lạc, 'Eric bối rối nói."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not clear or easy to understand",
                        "vi": "theo một cách không rõ ràng hoặc dễ hiểu"
                    },
                    "examples": [
                        {
                            "en": "The film ends confusedly.",
                            "vi": "Bộ phim kết thúc một cách bối rối."
                        }
                    ]
                }
            ]
