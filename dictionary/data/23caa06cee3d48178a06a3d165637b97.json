                        "vi": "một chuyển động thể chất nhanh, trong đó bạn xoay người sang một bên bằng cách chống tay xuống đất và đưa chân lần lượt qua đầu"
                    },
                    "examples": [
                        {
                            "en": "to do/turn cartwheels",
                            "vi": "để làm / quay bánh xe"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the wheel of a cart",
                        "vi": "bánh xe đẩy"
                    },
                    "examples": []
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to do a cartwheel or cartwheels",
                        "vi": "để làm một bánh xe đẩy hoặc bánh xe đẩy"
                    },
                    "examples": [
                        {
                            "en": "He cartwheeled across the room.",
                            "vi": "Anh ta quay vòng quanh phòng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to turn over in the air, often after hitting something",
                        "vi": "để lật người trong không khí, thường là sau khi va phải một thứ gì đó"
                    },
                    "examples": [
                        {
                            "en": "The car struck the embankment and cartwheeled several times.",
                            "vi": "Chiếc xe tông vào bờ kè và lật bánh xe nhiều lần."
