{
    "id": "8e0e3e9b811542708a114a48fdf4d64b",
    "word": "reek",
    "phonetic": {
        "uk": "/riːk/",
        "us": "/riːk/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to smell very strongly of something unpleasant",
                        "vi": "ngửi thấy mùi rất khó chịu"
                    },
                    "examples": [
                        {
                            "en": "His breath reeked of tobacco.",
                            "vi": "Hơi thở anh nồng nặc mùi thuốc lá."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to make you think that something unpleasant, wrong or dishonest is involved in a situation",
                        "vi": "khiến bạn nghĩ rằng điều gì đó khó chịu, sai trái hoặc không trung thực có liên quan đến một tình huống"
                    },
                    "examples": [
                        {
                            "en": "Her denials reeked of hypocrisy.",
                            "vi": "Những lời phủ nhận của cô ấy mang đầy tính đạo đức giả."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a strong unpleasant smell",
                        "vi": "một mùi khó chịu mạnh"
                    },
                    "examples": [
                        {
                            "en": "the reek of cigarettes and beer",
                            "vi": "mùi thuốc lá và bia"
                        },
                        {
                            "en": "The reek of gunpowder and smoke grew stronger.",
                            "vi": "Mùi thuốc súng và khói càng nồng nặc."
                        },
                        {
                            "en": "There was a permanent reek of decaying food in the cupboards.",
                            "vi": "Luôn có một mùi thức ăn thối rữa trong tủ."
                        }
                    ]
                }
            ]
        }
    ],
