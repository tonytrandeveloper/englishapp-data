    "word": "firmness",
    "phonetic": {
        "uk": "/ˈfɜːmnəs/",
        "us": "/ˈfɜːrmnəs/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the quality of being fairly hard; the quality of being not easy to press into a different shape",
                        "vi": "phẩm chất khá cứng; chất lượng không dễ ép thành hình dạng khác"
                    },
                    "examples": [
                        {
                            "en": "the firmness of the fruit",
                            "vi": "độ chắc của trái cây"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality of being not likely to change",
                        "vi": "chất lượng không có khả năng thay đổi"
                    },
                    "examples": [
                        {
                            "en": "her firmness of conviction",
                            "vi": "sự vững tin của cô ấy"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality of being strongly fixed in place",
                        "vi": "chất lượng được cố định chặt chẽ tại chỗ"
                    },
                    "examples": [
                        {
                            "en": "the firmness of the foundations",
                            "vi": "sự vững chắc của nền móng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality of being strong and steady",
                        "vi": "chất lượng của sự mạnh mẽ và ổn định"
                    },
                    "examples": [
                        {
                            "en": "the firmness of her grip",
                            "vi": "sự vững chắc của tay cầm của cô ấy"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the quality of being strong and in control",
                        "vi": "chất lượng của sự mạnh mẽ và trong tầm kiểm soát"
                    },
                    "examples": [
                        {
                            "en": "His handling of the situation lacked firmness.",
                            "vi": "Cách xử lý tình huống của anh ấy thiếu chắc chắn."
                        }
                    ]
                }
            ]
        }
