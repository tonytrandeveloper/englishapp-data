            "means": [
                {
                    "define": {
                        "en": "in a way that makes somebody who is anxious, upset, etc. feel calmer",
                        "vi": "theo cách khiến ai đó đang lo lắng, buồn phiền, v.v. cảm thấy bình tĩnh hơn"
                    },
                    "examples": [
                        {
                            "en": "‘There's no need to worry,’ he said soothingly.",
                            "vi": "\"Không cần phải lo lắng,\" anh nói một cách nhẹ nhàng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that makes a tense or painful part of your body feel more comfortable",
                        "vi": "theo cách làm cho một phần cơ thể bị căng thẳng hoặc đau đớn của bạn cảm thấy thoải mái hơn"
                    },
                    "examples": [
                        {
                            "en": "She rubbed his back soothingly.",
                            "vi": "Cô xoa lưng anh thật dịu dàng."
                        }
                    ]
                }
            ]
