{
    "id": "c0e528aefc7c40fb9cc25fa3b6f52c9b",
    "word": "crisply",
    "phonetic": {
        "uk": "/ˈkrɪspli/",
        "us": "/ˈkrɪspli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that makes something pleasantly hard and dry",
                        "vi": "theo cách làm cho một thứ gì đó khô cứng một cách dễ chịu"
                    },
                    "examples": [
                        {
                            "en": "crisply fried potatoes",
                            "vi": "khoai tây chiên giòn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is pleasantly clear and sharp",
                        "vi": "theo cách rõ ràng và sắc nét một cách dễ chịu"
                    },
                    "examples": [
                        {
                            "en": "bright, crisply defined pictures",
                            "vi": "hình ảnh sáng, rõ nét"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that looks fresh and clean, or new and slightly stiff",
                        "vi": "theo cách trông mới và sạch sẽ hoặc mới và hơi cứng"
                    },
                    "examples": [
                        {
                            "en": "a crisply ironed shirt",
                            "vi": "một chiếc áo sơ mi được ủi phẳng phiu"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is pleasantly dry and cold",
                        "vi": "theo một cách dễ chịu khô và lạnh"
                    },
                    "examples": [
                        {
                            "en": "a crisply cold morning",
                            "vi": "một buổi sáng lạnh lẽo"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a quick, confident and not very friendly way",
                        "vi": "một cách nhanh chóng, tự tin và không thân thiện lắm"
                    },
                    "examples": [
                        {
                            "en": "‘Take a seat,’ she said crisply.",
                            "vi": "“Ngồi đi,” cô nói dứt khoát."
                        }
                    ]
                }
            ]
        }
