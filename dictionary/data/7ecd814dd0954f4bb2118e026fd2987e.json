            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a part of a magazine, newspaper, etc. that can be taken out easily and kept separately",
                        "vi": "một phần của tạp chí, báo, v.v. có thể lấy ra dễ dàng và cất riêng"
                    },
                    "examples": [
                        {
                            "en": "an eight-page pull-out on health",
                            "vi": "một tập tám trang về sức khỏe"
                        },
                        {
                            "en": "a pull-out guide",
                            "vi": "một hướng dẫn kéo ra"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "an act of taking an army away from a particular place; an act of taking an organization out of a system",
                        "vi": "một hành động đưa một đội quân đi khỏi một địa điểm cụ thể; một hành động đưa một tổ chức ra khỏi hệ thống"
                    },
                    "examples": [
                        {
                            "en": "The general ordered a pull-out from the area.",
                            "vi": "Vị tướng đã ra lệnh rút khỏi khu vực."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
