    "word": "cop",
    "phonetic": {
        "uk": "/kɒp/",
        "us": "/kɑːp/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to receive or suffer something unpleasant",
                        "vi": "nhận hoặc phải chịu đựng điều gì đó khó chịu"
                    },
                    "examples": [
                        {
                            "en": "He copped all the hassle after the accident.",
                            "vi": "Anh ấy đã đối mặt với mọi rắc rối sau vụ tai nạn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to notice something",
                        "vi": "để ý một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "Cop a load of this! (= Listen to this)",
                            "vi": "Cảnh sát một tải này! (= Nghe này)"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to take hold of something",
                        "vi": "để nắm giữ một cái gì đó"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to be punished",
                        "vi": "bị trừng phạt"
                    },
                    "examples": [
                        {
                            "en": "Will you cop it from your dad if you're late?",
                            "vi": "Bạn sẽ sao chép nó từ cha của bạn nếu bạn đến muộn?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to be killed",
                        "vi": "bị giết"
                    },
                    "examples": [
                        {
                            "en": "He almost copped it in a horrific accident.",
                            "vi": "Anh ấy suýt nữa đã phải đối mặt với nó trong một vụ tai nạn kinh hoàng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to admit in court to being guilty of a small crime in the hope of receiving less severe punishment for a more serious crime",
                        "vi": "thừa nhận trước tòa là phạm một tội nhỏ với hy vọng nhận được hình phạt nhẹ hơn cho một tội nặng hơn"
                    },
                    "examples": [
                        {
                            "en": "The Feds said if I didn't cop a plea I would get 15 years.",
                            "vi": "Feds nói nếu tôi không bắt một lời cầu xin, tôi sẽ nhận được 15 năm."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a police officer",
                        "vi": "một sĩ quan cảnh sát"
                    },
                    "examples": [
                        {
                            "en": "Somebody call the cops!",
                            "vi": "Ai đó gọi cảnh sát!"
                        },
                        {
                            "en": "children playing cops and robbers",
                            "vi": "trẻ em chơi cảnh sát và cướp"
                        },
                        {
                            "en": "a TV cop show",
                            "vi": "một chương trình truyền hình cảnh sát"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used by somebody who is caught doing something wrong, to say that they admit that they are wrong",
                        "vi": "được sử dụng bởi một người nào đó bị bắt làm điều gì đó sai, để nói rằng họ thừa nhận rằng họ đã sai"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "not very good",
