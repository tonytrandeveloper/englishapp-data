{
    "id": "06fc5cf929064a7290f5eaa8d11ba0fe",
    "word": "unhealthy",
    "phonetic": {
        "uk": "/ʌnˈhelθi/",
        "us": "/ʌnˈhelθi/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not having good health; showing a lack of good health",
                        "vi": "sức khỏe không tốt; cho thấy tình trạng thiếu sức khỏe tốt"
                    },
                    "examples": [
                        {
                            "en": "They looked poor and unhealthy.",
                            "vi": "Họ trông thật tội nghiệp và không khỏe mạnh."
                        },
                        {
                            "en": "unhealthy skin",
                            "vi": "làn da không khỏe mạnh"
                        },
                        {
                            "en": "His eyeballs were an unhealthy yellow.",
                            "vi": "Nhãn cầu của anh ta có màu vàng không lành mạnh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "harmful to your health; likely to make you ill",
                        "vi": "có hại cho sức khỏe của bạn; có khả năng làm cho bạn bị ốm"
                    },
                    "examples": [
                        {
                            "en": "unhealthy living conditions",
                            "vi": "điều kiện sống không lành mạnh"
                        },
                        {
                            "en": "an unhealthy diet/lifestyle",
                            "vi": "một chế độ ăn uống / lối sống không lành mạnh"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not normal and likely to be harmful",
                        "vi": "không bình thường và có thể gây hại"
                    },
                    "examples": [
                        {
                            "en": "He had an unhealthy interest in disease and death.",
                            "vi": "Ông có một mối quan tâm không lành mạnh đến bệnh tật và cái chết."
                        }
                    ]
                }
            ]
        }
    ],
