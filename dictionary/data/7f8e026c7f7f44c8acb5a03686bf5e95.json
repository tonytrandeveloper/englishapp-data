    "word": "one-way",
    "phonetic": {
        "uk": "/ˌwʌn ˈweɪ/",
        "us": "/ˌwʌn ˈweɪ/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "moving or allowing movement in only one direction",
                        "vi": "di chuyển hoặc chỉ cho phép chuyển động theo một hướng"
                    },
                    "examples": [
                        {
                            "en": "one-way traffic",
                            "vi": "giao thông một chiều"
                        },
                        {
                            "en": "a one-way street",
                            "vi": "đường một chiều"
                        },
                        {
                            "en": "a one-way valve",
                            "vi": "van một chiều"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a one-way ticket, etc. can be used for travelling to a place but not back again",
                        "vi": "vé một chiều, v.v. có thể được sử dụng để đi đến một nơi nhưng không quay lại lần nữa"
                    },
                    "examples": [
                        {
                            "en": "a one-way trip",
                            "vi": "một chuyến đi một chiều"
                        },
                        {
                            "en": "I took the car on a one-way trip to the wrecker's yard (= it did not come back because it was not worth fixing).",
                            "vi": "Tôi đã lấy xe trong một chuyến đi một chiều đến bãi của xác tàu (= nó không quay lại vì nó không đáng để sửa)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "operating in only one direction",
                        "vi": "chỉ hoạt động theo một hướng"
                    },
                    "examples": [
                        {
                            "en": "Theirs was a one-way relationship (= one person made all the effort).",
                            "vi": "Mối quan hệ của họ là mối quan hệ một chiều (= một người đã cố gắng hết sức)."
                        }
                    ]
                }
            ]
        }
