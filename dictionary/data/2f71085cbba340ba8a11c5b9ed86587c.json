                        "vi": "một quả bóng, viên đạn hoặc viên đá"
                    },
                    "examples": [
                        {
                            "en": "A woman protester was killed by a ricochet.",
                            "vi": "Một phụ nữ biểu tình đã bị giết bởi một con ricochet."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the action of ricocheting",
                        "vi": "hành động ricocheting"
                    },
                    "examples": [
                        {
                            "en": "the ricochet of bricks and bottles off police riot shields",
                            "vi": "gạch và chai xé lá chắn chống bạo động của cảnh sát"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to hit a surface and come off it fast at a different angle",
                        "vi": "chạm vào một bề mặt và bay nhanh ở một góc độ khác"
                    },
                    "examples": [
                        {
                            "en": "The bullet ricocheted off a nearby wall.",
                            "vi": "Viên đạn bắn ra một bức tường gần đó."
                        },
                        {
                            "en": "The van hit the side of the bridge and ricocheted across the road.",
                            "vi": "Chiếc xe tải tông vào thành cầu và lao qua đường."
                        }
                    ]
                }
            ]
