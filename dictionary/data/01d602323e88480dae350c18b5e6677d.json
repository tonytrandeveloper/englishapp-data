    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "a supporting actor in a play or film has an important part but not the leading one",
                        "vi": "một diễn viên phụ trong một vở kịch, một bộ phim có vai trò quan trọng nhưng không phải là vai chính"
                    },
                    "examples": [
                        {
                            "en": "The movie featured Robert Lindsay in a supporting role.",
                            "vi": "Phim có sự góp mặt của Robert Lindsay trong một vai phụ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "helping to show that something is true",
                        "vi": "giúp chứng tỏ rằng điều gì đó là đúng"
                    },
                    "examples": [
                        {
                            "en": "There was a wealth of supporting evidence.",
                            "vi": "Có rất nhiều bằng chứng hỗ trợ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "carrying the weight of something",
                        "vi": "mang trọng lượng của một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "a supporting wall",
                            "vi": "một bức tường hỗ trợ"
                        }
                    ]
                }
            ]
        }
