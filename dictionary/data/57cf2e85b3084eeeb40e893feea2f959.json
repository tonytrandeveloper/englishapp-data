            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "showing a strong interest in sad or unpleasant things, especially disease or death",
                        "vi": "thể hiện sự quan tâm mạnh mẽ đến những điều buồn hoặc khó chịu, đặc biệt là bệnh tật hoặc cái chết"
                    },
                    "examples": [
                        {
                            "en": "He was morbidly fascinated with the dead.",
                            "vi": "Anh ta bị mê hoặc một cách bệnh hoạn với người chết."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that increases your risk of getting a serious illness",
                        "vi": "theo cách làm tăng nguy cơ mắc bệnh nghiêm trọng"
                    },
                    "examples": [
                        {
                            "en": "patients classed as morbidly obese",
                            "vi": "bệnh nhân được phân loại là béo phì bệnh lý"
                        }
                    ]
                }
            ]
        }
