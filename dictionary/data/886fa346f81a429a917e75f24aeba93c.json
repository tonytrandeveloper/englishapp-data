            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a piece of old, often torn, cloth used especially for cleaning things",
                        "vi": "một mảnh vải cũ, thường bị rách, được sử dụng đặc biệt để lau đồ đạc"
                    },
                    "examples": [
                        {
                            "en": "I wiped the window with a damp rag.",
                            "vi": "Tôi lau cửa sổ bằng giẻ ẩm."
                        },
                        {
                            "en": "Use a piece of old rag.",
                            "vi": "Sử dụng một mảnh giẻ cũ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a newspaper that you believe to be of low quality",
                        "vi": "một tờ báo mà bạn cho là có chất lượng thấp"
                    },
                    "examples": [
                        {
                            "en": "the local rag",
                            "vi": "giẻ rách địa phương"
                        },
                        {
                            "en": "I don't know how you can bear to read that awful rag!",
                            "vi": "Tôi không biết làm thế nào bạn có thể chịu được khi đọc cái giẻ rách khủng khiếp đó!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a piece of ragtime music",
                        "vi": "một bản nhạc ragtime"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "an event or a series of events organized by students each year to raise money for charity",
                        "vi": "một sự kiện hoặc một chuỗi các sự kiện do sinh viên tổ chức hàng năm để gây quỹ từ thiện"
                    },
                    "examples": [
                        {
                            "en": "rag week",
                            "vi": "tuần lễ giẻ rách"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "wearing very old torn clothes",
                        "vi": "mặc quần áo rách rất cũ"
                    },
                    "examples": [
                        {
                            "en": "The children were dressed in rags.",
                            "vi": "Những đứa trẻ ăn mặc rách rưới."
                        },
                        {
                            "en": "I saw people dressed in rags begging on the street.",
                            "vi": "Tôi nhìn thấy những người ăn mặc rách rưới ăn xin trên đường phố."
