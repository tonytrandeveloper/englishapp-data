        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "able to see things clearly only if they are very close to you",
                        "vi": "chỉ có thể nhìn rõ mọi thứ nếu chúng ở rất gần bạn"
                    },
                    "examples": [
                        {
                            "en": "She wears glasses because she’s very short-sighted.",
                            "vi": "Cô ấy đeo kính vì cô ấy bị cận rất nặng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not thinking carefully about the possible effects of something or what might happen in the future",
                        "vi": "không suy nghĩ cẩn thận về những tác động có thể xảy ra của một cái gì đó hoặc những gì có thể xảy ra trong tương lai"
                    },
                    "examples": [
                        {
                            "en": "a short-sighted policy",
                            "vi": "một chính sách thiển cận"
                        },
                        {
                            "en": "an attitude which is likely to prove short-sighted",
                            "vi": "một thái độ có vẻ thiển cận"
                        }
                    ]
                }
            ]
