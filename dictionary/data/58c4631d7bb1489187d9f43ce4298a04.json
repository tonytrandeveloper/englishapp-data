    "word": "snuffle",
    "phonetic": {
        "uk": "/ˈsnʌfl/",
        "us": "/ˈsnʌfl/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an act or the sound of snuffling",
                        "vi": "một hành động hoặc âm thanh của việc hít thở"
                    },
                    "examples": [
                        {
                            "en": "The silence was broken only by the snuffles of the dogs.",
                            "vi": "Sự im lặng chỉ bị phá vỡ bởi tiếng rít của lũ chó."
                        },
                        {
                            "en": "His breath came in snuffles.",
                            "vi": "Hơi thở anh dồn dập."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to get/have a cold",
                        "vi": "bị / cảm lạnh"
                    },
                    "examples": []
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to breathe noisily because you have a cold or you are crying",
                        "vi": "thở ồn ào vì bạn bị cảm hoặc bạn đang khóc"
                    },
                    "examples": [
                        {
                            "en": "I could hear the child snuffling in her sleep.",
                            "vi": "Tôi có thể nghe thấy tiếng đứa trẻ đang líu ríu trong giấc ngủ của cô ấy."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "if an animal snuffles, it breathes noisily through its nose, especially while it is smelling something",
                        "vi": "Nếu một con vật hít phải, nó sẽ thở ồn ào bằng mũi, đặc biệt là khi nó đang ngửi thứ gì đó"
                    },
                    "examples": [
                        {
                            "en": "The dog was snuffling around in the bushes.",
                            "vi": "Con chó đang rình mò trong bụi cây."
                        }
                    ]
                }
            ]
        }
