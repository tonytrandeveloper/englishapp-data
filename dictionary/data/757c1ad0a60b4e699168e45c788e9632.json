            "means": [
                {
                    "define": {
                        "en": "the large nut of a tropical tree called a coconut palm. It grows inside a hard shell and contains a soft white substance that can be eaten and juice that can be drunk.",
                        "vi": "quả hạch lớn của một loại cây nhiệt đới được gọi là cọ dừa. Nó phát triển bên trong một lớp vỏ cứng và chứa một chất màu trắng mềm, có thể ăn được và nước trái cây có thể uống được."
                    },
                    "examples": [
                        {
                            "en": "She broke open the coconut and drank its sweet milk.",
                            "vi": "Cô bẻ trái dừa và uống sữa ngọt ngào của nó."
                        },
                        {
                            "en": "a bay fringed with swaying coconut palms",
                            "vi": "vịnh với những rặng dừa đung đưa"
                        },
                        {
                            "en": "huge bunches of fresh coconuts",
                            "vi": "những chùm dừa tươi lớn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the soft white substance inside a coconut, used in cooking, making soap, etc.",
                        "vi": "chất màu trắng mềm bên trong quả dừa, được sử dụng trong nấu ăn, làm xà phòng, v.v."
                    },
                    "examples": [
                        {
                            "en": "desiccated coconut",
                            "vi": "cơm dừa nạo sấy"
                        },
                        {
