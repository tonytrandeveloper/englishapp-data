            "means": [
                {
                    "define": {
                        "en": "in a way that is very steep, high and often dangerous",
                        "vi": "ở một con đường rất dốc, cao và thường nguy hiểm"
                    },
                    "examples": [
                        {
                            "en": "The land dropped precipitously down to the rocky shore.",
                            "vi": "Đất lởm chởm xuống bờ đá."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "suddenly and to a very great extent",
                        "vi": "đột ngột và ở một mức độ rất lớn"
                    },
                    "examples": [
                        {
                            "en": "The dollar plunged precipitously.",
                            "vi": "Đồng đô la giảm mạnh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "very quickly, and without enough thought or care",
                        "vi": "rất nhanh chóng, và không có đủ suy nghĩ hoặc quan tâm"
                    },
                    "examples": [
