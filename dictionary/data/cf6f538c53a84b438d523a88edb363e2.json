    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a place on the stem of a plant from which a branch or leaf grows",
                        "vi": "một vị trí trên thân cây mà từ đó cành hoặc lá mọc lên"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a small swelling (= an area that is larger and rounder than normal) on a root or branch",
                        "vi": "một vết sưng nhỏ (= một vùng lớn hơn và tròn hơn bình thường) trên rễ hoặc cành"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a point at which two lines or systems meet or cross",
                        "vi": "một điểm mà tại đó hai dòng hoặc hệ thống gặp nhau hoặc giao nhau"
                    },
                    "examples": [
                        {
                            "en": "a network node",
                            "vi": "một nút mạng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a piece of equipment such as a computer, that is attached to a network",
                        "vi": "một phần của thiết bị chẳng hạn như máy tính, được gắn vào mạng"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a small hard mass of tissue, especially near a joint in the human body",
                        "vi": "một khối mô cứng nhỏ, đặc biệt là gần khớp trong cơ thể người"
                    },
                    "examples": [
                        {
                            "en": "a lymph node",
                            "vi": "một hạch bạch huyết"
                        }
                    ]
                }
            ]
