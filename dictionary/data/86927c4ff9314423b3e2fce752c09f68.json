    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the fact of being simple in a way that is not very accurate but gives a general idea of something",
                        "vi": "thực tế là đơn giản theo cách không chính xác lắm nhưng lại đưa ra một ý tưởng chung về một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "the crudeness of his argument",
                            "vi": "sự thô thiển trong lập luận của anh ấy"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of being simple and without much skill or attention to detail",
                        "vi": "thực tế là đơn giản và không có nhiều kỹ năng hoặc chú ý đến chi tiết"
                    },
                    "examples": [
                        {
                            "en": "the charming crudeness of folk art",
                            "vi": "sự thô sơ quyến rũ của nghệ thuật dân gian"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of being offensive or rude",
                        "vi": "thực tế là xúc phạm hoặc thô lỗ"
                    },
                    "examples": [
                        {
                            "en": "the crudeness of the language",
                            "vi": "sự thô thiển của ngôn ngữ"
                        }
                    ]
                }
            ]
        }
