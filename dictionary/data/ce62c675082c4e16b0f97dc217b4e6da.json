    "blocks": [
        {
            "pos": "exclamation, noun",
            "means": [
                {
                    "define": {
                        "en": "used as the written or spoken way of showing the sound that people make when they think something is bad",
                        "vi": "được sử dụng như cách viết hoặc cách nói để thể hiện âm thanh mà mọi người tạo ra khi họ nghĩ điều gì đó tồi tệ"
                    },
                    "examples": [
                        {
                            "en": "Tut-tut, I expected better of you.",
                            "vi": "Tut-tut, tôi mong đợi tốt hơn ở bạn."
                        },
                        {
                            "en": "tuts of disapproval",
                            "vi": "sự phản đối"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make one or more short sounds that show that you think something is bad",
                        "vi": "để tạo ra một hoặc nhiều âm thanh ngắn thể hiện rằng bạn nghĩ rằng có điều gì đó tồi tệ"
                    },
                    "examples": [
                        {
                            "en": "He tut-tutted under his breath.",
                            "vi": "Anh ấy đã dạy kèm trong hơi thở của mình."
                        }
                    ]
                }
            ]
        }
    ],
