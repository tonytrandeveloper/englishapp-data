{
    "id": "df628c90d56c4a649841e4b7f9834a7a",
    "word": "exceed",
    "phonetic": {
        "uk": "/ɪkˈsiːd/",
        "us": "/ɪkˈsiːd/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to be greater than a particular number or amount",
                        "vi": "lớn hơn một số hoặc số tiền cụ thể"
                    },
                    "examples": [
                        {
                            "en": "The price will not exceed £100.",
                            "vi": "Giá sẽ không vượt quá £ 100."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to do more than the law or an order, etc. allows you to do",
                        "vi": "làm nhiều hơn luật hoặc lệnh, v.v. cho phép bạn làm"
                    },
                    "examples": [
                        {
                            "en": "She was exceeding the speed limit (= driving faster than is allowed).",
                            "vi": "Cô ấy đã vượt quá tốc độ cho phép (= lái xe nhanh hơn mức cho phép)."
                        },
                        {
                            "en": "The officers had exceeded their authority.",
                            "vi": "Các sĩ quan đã vượt quá quyền hạn của họ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to be better than expected",
                        "vi": "tốt hơn mong đợi"
                    },
                    "examples": [
                        {
                            "en": "His achievements have exceeded expectations.",
                            "vi": "Thành tích của anh ấy đã vượt quá sự mong đợi."
                        },
                        {
                            "en": "The amount raised has far exceeded our wildest expectations.",
                            "vi": "Số tiền quyên góp được đã vượt xa sự mong đợi nhất của chúng tôi."
                        }
                    ]
                }
            ]
        }
