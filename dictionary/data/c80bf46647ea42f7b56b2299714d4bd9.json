    "word": "snuff",
    "phonetic": {
        "uk": "/snʌf/",
        "us": "/snʌf/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to stop a small flame from burning, especially by pressing it between your fingers or covering it with something",
                        "vi": "để ngăn ngọn lửa nhỏ bùng cháy, đặc biệt là bằng cách ấn vào giữa các ngón tay của bạn hoặc phủ lên ngọn lửa bằng vật gì đó"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to smell something by breathing in noisily through the nose",
                        "vi": "ngửi cái gì đó bằng cách hít thở ồn ào bằng mũi"
                    },
                    "examples": [
                        {
                            "en": "The dogs were snuffing gently at my feet.",
                            "vi": "Những con chó đang nhẹ nhàng húc vào chân tôi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to die",
                        "vi": "chết"
                    },
                    "examples": []
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "tobacco in the form of a powder that people take by breathing it into their noses",
                        "vi": "thuốc lá ở dạng bột mà mọi người hít vào mũi"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "as good as it/they should be",
                        "vi": "tốt như nó / họ nên"
                    },
                    "examples": [
                        {
                            "en": "Your work isn't really up to snuff.",
                            "vi": "Công việc của bạn không thực sự phù hợp."
                        }
                    ]
                }
            ]
        }
