    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "strong and healthy",
                        "vi": "mạnh mẽ và khỏe mạnh"
                    },
                    "examples": [
                        {
                            "en": "She was almost 90, but still very robust.",
                            "vi": "Bà đã gần 90 nhưng vẫn còn rất tráng kiện."
                        },
                        {
                            "en": "He seems to be in robust (good) health.",
                            "vi": "Anh ta dường như có một sức khỏe dồi dào (tốt)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "strong; able to survive being used a lot and not likely to break",
                        "vi": "mạnh; có thể tồn tại được sử dụng nhiều và không có khả năng bị hỏng"
                    },
                    "examples": [
                        {
                            "en": "a robust piece of equipment",
                            "vi": "một thiết bị mạnh mẽ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "strong and not likely to fail or become weak",
                        "vi": "mạnh mẽ và không có khả năng thất bại hoặc trở nên yếu ớt"
                    },
                    "examples": [
                        {
                            "en": "robust economic growth",
                            "vi": "tăng trưởng kinh tế mạnh mẽ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "strong and determined; showing that you are sure about what you are doing or saying",
                        "vi": "mạnh mẽ và quyết tâm; cho thấy rằng bạn chắc chắn về những gì bạn đang làm hoặc nói"
                    },
                    "examples": [
                        {
                            "en": "The company is taking a more robust approach to management.",
                            "vi": "Công ty đang áp dụng một cách tiếp cận mạnh mẽ hơn để quản lý."
                        }
                    ]
                }
            ]
        }
