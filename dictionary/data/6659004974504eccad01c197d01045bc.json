    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that is not reasonable or sensible; in a way that is impossible to control",
                        "vi": "theo cách không hợp lý hoặc hợp lý; theo cách không thể kiểm soát"
                    },
                    "examples": [
                        {
                            "en": "pathologically jealous",
                            "vi": "ghen tuông bệnh hoạn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is caused by, or connected with, disease or illness",
                        "vi": "theo cách gây ra, hoặc liên quan đến bệnh tật hoặc bệnh tật"
                    },
                    "examples": [
                        {
                            "en": "pathologically weakened bone",
                            "vi": "xương suy yếu bệnh lý"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is connected with pathology",
                        "vi": "theo cách có liên quan đến bệnh lý"
                    },
                    "examples": [
                        {
                            "en": "The condition cannot be diagnosed clinically or pathologically as any specific disease.",
                            "vi": "Tình trạng bệnh không thể được chẩn đoán lâm sàng hoặc bệnh lý như bất kỳ bệnh cụ thể nào."
                        }
                    ]
                }
            ]
        }
