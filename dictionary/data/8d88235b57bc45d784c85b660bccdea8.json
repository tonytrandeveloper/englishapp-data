            "means": [
                {
                    "define": {
                        "en": "to impress somebody very much, especially with a performance",
                        "vi": "để gây ấn tượng với ai đó rất nhiều, đặc biệt là với một buổi biểu diễn"
                    },
                    "examples": [
                        {
                            "en": "He wowed audiences around the country with his new show.",
                            "vi": "Anh ấy đã khiến khán giả khắp cả nước thán phục với chương trình mới của mình."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a great success",
                        "vi": "một thành công lớn"
                    },
                    "examples": [
                        {
                            "en": "Don't worry. You'll be a wow.",
                            "vi": "Đừng lo. Bạn sẽ rất ngạc nhiên."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "slow changes in the pitch of sound played in a sound recording",
                        "vi": "thay đổi chậm về cao độ của âm thanh được phát trong bản ghi âm"
                    },
                    "examples": []
                }
            ]
        },
        {
            "pos": "exclamation",
            "means": [
                {
                    "define": {
                        "en": "used to show that you are very surprised or impressed by somebody/something",
                        "vi": "được sử dụng để thể hiện rằng bạn rất ngạc nhiên hoặc ấn tượng bởi ai đó / điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "Wow! You look terrific!",
                            "vi": "Ồ! Bạn trông tuyệt vời!"
                        }
                    ]
                }
            ]
        }
