                        },
                        {
                            "en": "She had seen the warning signs but she had misread them.",
                            "vi": "Cô đã nhìn thấy những dấu hiệu cảnh báo nhưng cô đã đọc nhầm."
                        },
                        {
                            "en": "misread something as something His confidence was misread as arrogance.",
                            "vi": "hiểu sai điều gì đó như một điều gì đó Sự tự tin của Ngài đã bị đọc nhầm thành sự kiêu ngạo."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to read something wrongly",
                        "vi": "đọc sai một cái gì đó"
