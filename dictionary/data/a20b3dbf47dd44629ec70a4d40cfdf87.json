    "blocks": [
        {
            "pos": "phrasal verb",
            "means": [
                {
                    "define": {
                        "en": "to stay close to somebody so that they can help you",
                        "vi": "ở gần ai đó để họ có thể giúp bạn"
                    },
                    "examples": [
                        {
                            "en": "Stick with me and I’ll make you a millionaire!",
                            "vi": "Hãy gắn bó với tôi và tôi sẽ biến bạn thành triệu phú!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to continue with something or continue doing something",
                        "vi": "để tiếp tục với một cái gì đó hoặc tiếp tục làm một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "They decided to stick with their original plan.",
                            "vi": "Họ quyết định gắn bó với kế hoạch ban đầu của họ."
                        }
                    ]
                }
            ]
        }
