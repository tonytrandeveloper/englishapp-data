            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a piece of clothing for the upper part of the body, made of wool or cotton, with long sleeves (= arms) and no buttons",
                        "vi": "một bộ quần áo cho phần trên của cơ thể, bằng len hoặc bông, có tay áo dài (= tay) và không có cúc"
                    },
                    "examples": [
                        {
                            "en": "a woolly jumper",
                            "vi": "một chiếc áo len"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a loose dress without sleeves (= arms), usually worn over a blouse or sweater",
                        "vi": "một chiếc váy rộng không có tay áo (= tay), thường được mặc bên ngoài áo sơ mi hoặc áo len"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a person, an animal or an insect that jumps",
                        "vi": "người, động vật hoặc côn trùng nhảy"
                    },
                    "examples": [
                        {
                            "en": "He's a good jumper.",
                            "vi": "Anh ấy là một vận động viên nhảy giỏi."
                        }
                    ]
                }
            ]
        }
