{
    "id": "ffe2891f5b5d4161bedcb6aab6523e73",
    "word": "unevenly",
    "phonetic": {
        "uk": "/ʌnˈiːvnli/",
        "us": "/ʌnˈiːvnli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "with different amounts for each person or in each place",
                        "vi": "với số tiền khác nhau cho mỗi người hoặc mỗi nơi"
                    },
                    "examples": [
                        {
                            "en": "The population is unevenly distributed.",
                            "vi": "Dân cư phân bố không đều."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not to the same standard in all parts",
                        "vi": "không theo cùng một tiêu chuẩn trong tất cả các bộ phận"
                    },
                    "examples": [
                        {
                            "en": "The economy has been performing unevenly.",
                            "vi": "Nền kinh tế hoạt động không đồng đều."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with one group, team or player being much better than the other",
                        "vi": "với một nhóm, đội hoặc người chơi tốt hơn nhiều so với nhóm kia"
                    },
                    "examples": [
                        {
                            "en": "The teams are unevenly matched.",
                            "vi": "Các đội thi đấu không đồng đều."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that does not follow a regular pattern or have a regular size and shape",
                        "vi": "theo cách không theo một khuôn mẫu thông thường hoặc có kích thước và hình dạng thông thường"
                    },
                    "examples": [
                        {
                            "en": "His hair was cut unevenly.",
                            "vi": "Tóc anh cắt không đều."
                        },
                        {
                            "en": "unevenly spaced stripes",
                            "vi": "các sọc không đều nhau"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not level, smooth or flat",
                        "vi": "theo cách không bằng phẳng, mịn hoặc bằng phẳng"
                    },
                    "examples": [
                        {
                            "en": "The passage was narrow and unevenly floored.",
                            "vi": "Lối đi hẹp và lát sàn không đều."
                        }
                    ]
                }
            ]
        }
