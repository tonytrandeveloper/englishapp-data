    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "used in questions to mean ‘where’, expressing surprise",
                        "vi": "được sử dụng trong câu hỏi có nghĩa là 'ở đâu', thể hiện sự ngạc nhiên"
                    },
                    "examples": [
                        {
                            "en": "Wherever can he have gone to?",
                            "vi": "Bất cứ nơi nào anh ta có thể đã đi đến?"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "means": [
                {
                    "define": {
                        "en": "in any place",
                        "vi": "ở bất kỳ nơi nào"
                    },
                    "examples": [
                        {
                            "en": "Sit wherever you like.",
                            "vi": "Ngồi bất cứ nơi nào bạn thích."
                        },
                        {
                            "en": "He comes from Boula, wherever that may be (= I don't know where it is).",
                            "vi": "Anh ấy đến từ Boula, bất cứ nơi nào có thể (= Tôi không biết nó ở đâu)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in all places that",
                        "vi": "ở tất cả những nơi mà"
                    },
                    "examples": [
                        {
                            "en": "Wherever she goes, there are crowds of people waiting to see her.",
                            "vi": "Bất cứ nơi nào cô ấy đi, có rất đông người chờ đợi để được gặp cô ấy."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in all cases that",
                        "vi": "trong mọi trường hợp"
                    },
                    "examples": [
                        {
                            "en": "Use wholegrain breakfast cereals wherever possible.",
                            "vi": "Sử dụng ngũ cốc ăn sáng nguyên hạt bất cứ khi nào có thể."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "or any other place",
                        "vi": "hoặc bất kỳ nơi nào khác"
                    },
                    "examples": [
                        {
                            "en": "tourists from Spain, France or wherever",
                            "vi": "khách du lịch từ Tây Ban Nha, Pháp hoặc bất cứ nơi nào"
                        }
                    ]
                }
