    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "in a state of extreme excitement, and crying, laughing, etc. without any control",
                        "vi": "trong trạng thái phấn khích tột độ và khóc, cười, v.v. mà không kiểm soát được"
                    },
                    "examples": [
                        {
                            "en": "hysterical screams",
                            "vi": "tiếng la hét cuồng loạn"
                        },
                        {
                            "en": "a hysterical giggle",
                            "vi": "một tiếng cười khúc khích"
                        },
                        {
                            "en": "He became almost hysterical when I told him.",
                            "vi": "Anh ấy gần như trở nên cuồng loạn khi tôi nói với anh ấy."
                        },
                        {
                            "en": "Let's not get hysterical.",
                            "vi": "Đừng kích động."
                        },
                        {
                            "en": "(disapproving) He thought I was being a hysterical female.",
                            "vi": "(không đồng ý) Anh ấy nghĩ tôi là một phụ nữ cuồng loạn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "extremely funny",
                        "vi": "cực kỳ hài hước"
                    },
                    "examples": [
                        {
                            "en": "She seemed to find my situation absolutely hysterical.",
                            "vi": "Cô ấy dường như thấy hoàn cảnh của tôi hoàn toàn náo loạn."
                        },
                        {
                            "en": "This book is hysterical.",
                            "vi": "Cuốn sách này là cuồng loạn."
                        },
                        {
                            "en": "The whole episode was absolutely hysterical!",
                            "vi": "Toàn bộ tập phim hoàn toàn náo loạn!"
                        }
                    ]
                }
            ]
        }
