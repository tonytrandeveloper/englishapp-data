{
    "id": "f2f90a3b961d44c6a7e582804cfefba4",
    "word": "lightweight",
    "phonetic": {
        "uk": "/ˈlaɪtweɪt/",
        "us": "/ˈlaɪtweɪt/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a weight in boxing and other sports, between featherweight and welterweight, in boxing usually between 57 and 60 kilograms; a boxer or other competitor in this class",
                        "vi": "trọng lượng trong quyền anh và các môn thể thao khác, giữa hạng lông và hạng cân, trong quyền anh thường từ 57 đến 60 kilôgam; một võ sĩ quyền anh hoặc đối thủ khác trong lớp này"
                    },
                    "examples": [
                        {
                            "en": "a lightweight champion",
                            "vi": "một nhà vô địch hạng nhẹ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a person or thing that weighs less than is usual",
                        "vi": "một người hoặc vật nặng hơn bình thường"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a person or thing of little importance or influence",
                        "vi": "một người hoặc một thứ có tầm quan trọng hoặc ít ảnh hưởng"
                    },
                    "examples": [
                        {
                            "en": "a political lightweight",
                            "vi": "một trọng lượng nhẹ"
                        },
                        {
                            "en": "He's an intellectual lightweight (= he does not think very deeply or seriously).",
                            "vi": "Anh ấy là một người nhẹ nhàng trí tuệ (= anh ấy không suy nghĩ sâu sắc hay nghiêm túc)."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "made of thinner material and less heavy than usual",
                        "vi": "làm bằng vật liệu mỏng hơn và ít nặng hơn bình thường"
                    },
                    "examples": [
                        {
                            "en": "a lightweight jacket",
                            "vi": "một chiếc áo khoác nhẹ"
                        },
                        {
                            "en": "a lightweight aluminium engine",
                            "vi": "một động cơ nhôm nhẹ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not very serious or impressive",
                        "vi": "không nghiêm túc hoặc ấn tượng"
                    },
                    "examples": [
                        {
                            "en": "a lightweight book",
                            "vi": "một cuốn sách nhẹ"
                        },
                        {
                            "en": "He was considered too lightweight for the job.",
                            "vi": "Anh ta được coi là quá nhẹ so với công việc."
                        }
                    ]
                }
            ]
        }
    ],
