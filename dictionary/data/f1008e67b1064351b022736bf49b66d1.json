            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an opinion, based on medical experience, of the likely development of a disease or an illness",
                        "vi": "một ý kiến, dựa trên kinh nghiệm y tế, về khả năng phát triển của một căn bệnh hoặc một căn bệnh"
                    },
                    "examples": [
                        {
                            "en": "to make a prognosis",
                            "vi": "để đưa ra một tiên lượng"
                        },
                        {
                            "en": "The prognosis is not good.",
                            "vi": "Tiên lượng không tốt."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a judgement about how something is likely to develop in the future",
                        "vi": "phán đoán về cách một thứ gì đó có khả năng phát triển trong tương lai"
                    },
                    "examples": [
                        {
                            "en": "The prognosis is for more people to work part-time in the future.",
                            "vi": "Tiên lượng là sẽ có nhiều người làm việc bán thời gian hơn trong tương lai."
                        }
                    ]
                }
            ]
        }
