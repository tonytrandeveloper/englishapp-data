                    "define": {
                        "en": "unable to hear anything or unable to hear very well",
                        "vi": "không thể nghe thấy bất cứ điều gì hoặc không thể nghe rất rõ"
                    },
                    "examples": [
                        {
                            "en": "to become/go deaf",
                            "vi": "trở thành / bị điếc"
                        },
                        {
                            "en": "She was born deaf.",
                            "vi": "Cô ấy bị điếc bẩm sinh."
                        },
                        {
                            "en": "partially deaf",
                            "vi": "điếc một phần"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "people who cannot hear",
                        "vi": "những người không thể nghe"
                    },
                    "examples": [
                        {
                            "en": "television subtitles for the deaf",
                            "vi": "phụ đề truyền hình cho người khiếm thính"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not willing to listen or pay attention to something",
                        "vi": "không sẵn sàng lắng nghe hoặc chú ý đến điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "He was deaf to my requests for help.",
                            "vi": "Anh ấy đã bị điếc trước những yêu cầu giúp đỡ của tôi."
                        },
                        {
                            "en": "The committee remained deaf to our suggestions.",
                            "vi": "Ủy ban vẫn không nghe lời đề nghị của chúng tôi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "very deaf",
