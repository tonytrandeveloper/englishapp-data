                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to be ignored or not noticed by other people",
                        "vi": "bị người khác phớt lờ hoặc không chú ý"
                    },
                    "examples": [
                        {
                            "en": "Her advice fell on deaf ears.",
                            "vi": "Lời khuyên của cô rơi vào tai điếc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to ignore or refuse to listen to somebody/something",
                        "vi": "phớt lờ hoặc từ chối lắng nghe ai đó / điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "He turned a deaf ear to the rumours.",
                            "vi": "Anh ta bỏ ngoài tai trước những tin đồn."
                        }
                    ]
