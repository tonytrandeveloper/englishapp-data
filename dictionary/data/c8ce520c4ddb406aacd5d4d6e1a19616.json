            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an informal way of referring to a champion, often used in newspapers",
                        "vi": "một cách gọi thân mật để chỉ một nhà vô địch, thường được sử dụng trên báo chí"
                    },
                    "examples": [
                        {
                            "en": "Scottish champs celebrate victory!",
                            "vi": "Nhà vô địch Scotland ăn mừng chiến thắng!"
                        },
                        {
                            "en": "The former heavyweight boxing champ has finally thrown in the towel.",
                            "vi": "Nhà cựu vô địch quyền anh hạng nặng cuối cùng đã phải chào thua."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to bite or eat something noisily",
                        "vi": "cắn hoặc ăn một cái gì đó ồn ào"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "impatient to do or start doing something",
                        "vi": "thiếu kiên nhẫn để làm hoặc bắt đầu làm điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "Gerry’s champing at the bit to go to college.",
                            "vi": "Gerry đang vô địch một chút để vào đại học."
                        }
                    ]
                }
            ]
