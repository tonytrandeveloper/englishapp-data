{
    "id": "8dc8086788a84f7a818e904ad281928c",
    "word": "covered",
    "phonetic": {
        "uk": "/ˈkʌvəd/",
        "us": "/ˈkʌvərd/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "having a layer or amount of something on it",
                        "vi": "có một lớp hoặc một lượng thứ gì đó trên đó"
                    },
                    "examples": [
                        {
                            "en": "His face was covered in blood.",
                            "vi": "Mặt anh bê bết máu."
                        },
                        {
                            "en": "I was completely covered in mud.",
                            "vi": "Tôi hoàn toàn bị bao phủ bởi bùn."
                        },
                        {
                            "en": "The walls were covered with pictures.",
                            "vi": "Các bức tường được bao phủ bởi các bức tranh."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having a roof over it",
                        "vi": "có một mái nhà trên nó"
                    },
                    "examples": [
                        {
                            "en": "a covered walkway/bridge",
                            "vi": "một lối đi / cầu có mái che"
                        },
                        {
                            "en": "a covered area of the stadium with seats",
                            "vi": "một khu vực có mái che của sân vận động với chỗ ngồi"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having a layer of the thing mentioned on or around something",
                        "vi": "có một lớp của điều được đề cập trên hoặc xung quanh một thứ gì đó"
                    },
                    "examples": [
                        {
                            "en": "chocolate-covered banana slices",
                            "vi": "lát chuối phủ sô cô la"
                        }
                    ]
                }
            ]
        }
