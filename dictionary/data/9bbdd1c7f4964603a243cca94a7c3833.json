{
    "id": "9bbdd1c7f4964603a243cca94a7c3833",
    "word": "dully",
    "phonetic": {
        "uk": "/ˈdʌlli/",
        "us": "/ˈdʌlli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that shows no feeling, understanding or interest",
                        "vi": "theo cách không cho thấy cảm giác, sự hiểu biết hoặc sự quan tâm"
                    },
                    "examples": [
                        {
                            "en": "‘I suppose so,’ she said dully.",
                            "vi": "“Tôi cũng cho là vậy,” cô ấy nói với vẻ đần độn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is slightly dark, and not at all bright",
                        "vi": "theo cách hơi tối và không hề sáng"
                    },
                    "examples": [
                        {
                            "en": "The moonlight shone dully on the surface of the lake.",
                            "vi": "Ánh trăng mờ ảo soi bóng xuống mặt hồ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to cause you pain in a continuous but not very severe way",
                        "vi": "khiến bạn đau liên tục nhưng không nghiêm trọng"
                    },
                    "examples": [
                        {
                            "en": "His leg ached dully.",
                            "vi": "Chân anh đau ê ẩm."
                        }
                    ]
                }
            ]
        }
    ],
