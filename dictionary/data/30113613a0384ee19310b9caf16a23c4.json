            "means": [
                {
                    "define": {
                        "en": "in a way that shows a lack of respect for other people and their feelings",
                        "vi": "theo cách thể hiện sự thiếu tôn trọng đối với người khác và cảm xúc của họ"
                    },
                    "examples": [
                        {
                            "en": "They brushed rudely past us.",
                            "vi": "Họ lướt qua chúng tôi một cách thô lỗ."
                        },
                        {
