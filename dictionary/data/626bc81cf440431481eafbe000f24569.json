    "word": "woe",
    "phonetic": {
        "uk": "/wəʊ/",
        "us": "/wəʊ/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the troubles and problems that somebody has",
                        "vi": "những rắc rối và vấn đề mà ai đó có"
                    },
                    "examples": [
                        {
                            "en": "financial woes",
                            "vi": "tai ương tài chính"
                        },
                        {
                            "en": "Thanks for listening to my woes.",
                            "vi": "Cảm ơn vì đã lắng nghe tai ương của tôi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "great unhappiness",
                        "vi": "bất hạnh lớn"
                    },
                    "examples": [
                        {
                            "en": "a tale of woe",
                            "vi": "một câu chuyện khốn khổ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a phrase that is used to warn somebody that there will be trouble for them if they do something or do not do something",
                        "vi": "một cụm từ được sử dụng để cảnh báo ai đó rằng sẽ có rắc rối cho họ nếu họ làm điều gì đó hoặc không làm điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "Woe betide anyone who gets in her way!",
                            "vi": "Khốn nạn cho bất cứ ai cản đường cô ấy!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a phrase that is used to say that you are very unhappy",
                        "vi": "một cụm từ được sử dụng để nói rằng bạn rất không hạnh phúc"
                    },
                    "examples": []
                }
            ]
        }
