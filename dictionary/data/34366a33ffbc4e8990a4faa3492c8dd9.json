    "word": "come along",
    "phonetic": {
        "uk": "",
        "us": ""
    },
    "blocks": [
        {
            "pos": "phrasal verb",
            "means": [
                {
                    "define": {
                        "en": "to arrive; to appear",
                        "vi": "đến; xuất hiện"
                    },
                    "examples": [
                        {
                            "en": "When the right opportunity comes along, she'll take it.",
                            "vi": "Khi có cơ hội thích hợp, cô ấy sẽ nắm lấy nó."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to go somewhere with somebody",
                        "vi": "đi đâu đó với ai đó"
                    },
                    "examples": [
                        {
                            "en": "I'm glad you came along.",
                            "vi": "Tôi rất vui vì bạn đã đến cùng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to improve or develop in the way that you want",
                        "vi": "để cải thiện hoặc phát triển theo cách bạn muốn"
                    },
                    "examples": [
                        {
                            "en": "Your French has come along a lot recently.",
                            "vi": "Tiếng Pháp của bạn gần đây đã xuất hiện rất nhiều."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used in orders to tell somebody to hurry, or to try harder",
                        "vi": "được sử dụng để nói với ai đó hãy nhanh lên hoặc cố gắng hơn nữa"
                    },
                    "examples": [
                        {
                            "en": "Come along! We're late.",
                            "vi": "Đi cùng! Chúng ta muộn rồi."
                        },
                        {
                            "en": "Come along! It's easy!",
                            "vi": "Đi cùng! Dễ thôi!"
                        }
                    ]
                }
            ]
        }
