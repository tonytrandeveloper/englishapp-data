                        "vi": "thực tế là ai đó chỉ quan tâm đến đất nước của họ, ý tưởng, v.v. chứ không phải những người từ bên ngoài"
                    },
                    "examples": [
                        {
                            "en": "the insularity of village life",
                            "vi": "sự vô nghĩa của cuộc sống làng quê"
                        },
                        {
                            "en": "cultural insularity",
                            "vi": "vô văn hóa"
                        }
                    ]
                },
                {
                    "define": {
