    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "done in an angry or excited way or with a lot of strong feeling",
                        "vi": "được thực hiện một cách tức giận hoặc phấn khích hoặc với nhiều cảm giác mạnh"
                    },
                    "examples": [
                        {
                            "en": "a hotly debated topic",
                            "vi": "một chủ đề tranh luận sôi nổi"
                        },
                        {
                            "en": "Recent reports in the press have been hotly denied.",
                            "vi": "Những thông tin gần đây trên báo chí đều bị phủ nhận một cách nóng bỏng."
                        },
                        {
                            "en": "‘Nonsense!’ he said hotly.",
                            "vi": "'Vô lý!' anh nóng nảy nói."
                        },
                        {
                            "en": "The results were hotly disputed.",
                            "vi": "Các kết quả đã được tranh cãi sôi nổi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "done with a lot of energy and determination",
                        "vi": "được thực hiện với rất nhiều năng lượng và quyết tâm"
                    },
                    "examples": [
                        {
                            "en": "hotly contested elections",
                            "vi": "các cuộc bầu cử tranh cãi sôi nổi"
                        },
                        {
                            "en": "She ran out of the shop, hotly pursued by the store detective.",
                            "vi": "Cô chạy ra khỏi cửa hàng, bị thám tử của cửa hàng truy đuổi gắt gao."
                        }
                    ]
                }
            ]
        }
