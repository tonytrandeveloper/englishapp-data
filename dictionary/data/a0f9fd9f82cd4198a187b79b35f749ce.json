    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "thin, in a way that is attractive",
                        "vi": "mỏng, theo một cách hấp dẫn"
                    },
                    "examples": [
                        {
                            "en": "a slim figure/body/waist",
                            "vi": "dáng người / thân hình / eo thon"
                        },
                        {
                            "en": "She was tall and slim.",
                            "vi": "Cô ấy cao và mảnh khảnh."
                        },
                        {
                            "en": "How do you manage to stay so slim?",
                            "vi": "Làm cách nào để bạn giữ được vóc dáng thon thả như vậy?"
                        },
                        {
                            "en": "(figurative) Many companies are a lot slimmer than they used to be (= have fewer workers).",
                            "vi": "(nghĩa bóng) Nhiều công ty mỏng hơn rất nhiều so với trước đây (= có ít công nhân hơn)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "thinner than usual",
                        "vi": "mỏng hơn bình thường"
                    },
                    "examples": [
                        {
                            "en": "a slim volume of poetry",
                            "vi": "một tập thơ mỏng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not as big as you would like or expect",
                        "vi": "không lớn như bạn muốn hoặc mong đợi"
                    },
                    "examples": [
                        {
                            "en": "a slim chance of success",
                            "vi": "cơ hội thành công mong manh"
                        },
                        {
                            "en": "The party was returned to power with a slim majority.",
                            "vi": "Đảng đã trở lại nắm quyền với đa số mỏng."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to try to become thinner, for example by eating less",
                        "vi": "để cố gắng trở nên gầy hơn, chẳng hạn như bằng cách ăn ít hơn"
                    },
                    "examples": [
                        {
