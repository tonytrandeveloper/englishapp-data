            "means": [
                {
                    "define": {
                        "en": "if a person or their voice is hoarse, their voice sounds rough and unpleasant, especially because of a sore throat (= a painful throat because of an infection)",
                        "vi": "nếu một người hoặc giọng nói của họ bị khàn, giọng nói của họ nghe thô và khó chịu, đặc biệt là do đau họng (= cổ họng đau do nhiễm trùng)"
                    },
                    "examples": [
                        {
                            "en": "He shouted himself hoarse.",
                            "vi": "Anh tự hét lên đến khản cả cổ."
                        },
                        {
                            "en": "a hoarse cough/cry/scream",
                            "vi": "ho khan / khóc / la hét"
                        },
                        {
                            "en": "His voice was hoarse with exhaustion.",
                            "vi": "Giọng anh khàn đi vì kiệt sức."
                        }
                    ]
                }
            ]
        }
