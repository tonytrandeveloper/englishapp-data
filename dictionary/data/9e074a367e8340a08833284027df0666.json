    "word": "mite",
    "phonetic": {
        "uk": "/maɪt/",
        "us": "/maɪt/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a very small creature like a spider that lives in soil, on plants or animals, or inside houses in carpets, etc.",
                        "vi": "một sinh vật rất nhỏ như nhện sống trong đất, trên thực vật hoặc động vật, hoặc trong nhà trải thảm, v.v."
                    },
                    "examples": [
                        {
                            "en": "house dust mites",
                            "vi": "mạt bụi nhà"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a small child or animal, especially one that you feel sorry for",
                        "vi": "một đứa trẻ nhỏ hoặc động vật, đặc biệt là một đứa trẻ mà bạn cảm thấy tiếc nuối"
                    },
                    "examples": [
                        {
                            "en": "Poor little mite!",
                            "vi": "Con ve nhỏ tội nghiệp!"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a little; rather",
                        "vi": "một chút; hơn là"
                    },
                    "examples": [
                        {
                            "en": "The place looked a mite expensive.",
                            "vi": "Nơi này trông đắt tiền."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a small amount of something",
                        "vi": "một số lượng nhỏ của một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "Show a mite of respect.",
                            "vi": "Thể hiện sự tôn trọng."
                        }
                    ]
                }
            ]
        }
