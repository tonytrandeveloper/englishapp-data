    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the edge of something in the shape of a circle",
                        "vi": "cạnh của một cái gì đó có dạng hình tròn"
                    },
                    "examples": [
                        {
                            "en": "He looked at them over the rim of his glass.",
                            "vi": "Anh nhìn chúng qua vành kính của mình."
                        },
                        {
                            "en": "The rims of her eyes were red with crying.",
                            "vi": "Vành mắt cô đỏ hoe vì khóc."
                        },
                        {
                            "en": "spectacles with gold rims",
                            "vi": "kính có vành vàng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the metal edge of a wheel onto which the tyre is fixed",
                        "vi": "gờ kim loại của bánh xe để cố định lốp xe"
                    },
                    "examples": [
                        {
                            "en": "metal wheel rims",
                            "vi": "vành bánh xe kim loại"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having a particular type of rim",
                        "vi": "có một loại vành cụ thể"
                    },
                    "examples": [
                        {
                            "en": "gold-rimmed spectacles",
                            "vi": "kính gọng vàng"
                        },
                        {
                            "en": "red-rimmed eyes (= for example, from crying)",
                            "vi": "mắt có viền đỏ (= ví dụ: vì khóc)"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
