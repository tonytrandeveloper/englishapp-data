                    "define": {
                        "en": "a person whose job is to clean other people’s houses or offices, etc.",
                        "vi": "một người có công việc là dọn dẹp nhà cửa hoặc văn phòng của người khác, v.v."
                    },
                    "examples": [
                        {
                            "en": "an office cleaner",
                            "vi": "người dọn dẹp văn phòng"
                        },
                        {
                            "en": "I met him while I was working as a cleaner in a hospital.",
                            "vi": "Tôi gặp anh ấy khi tôi đang làm công việc quét dọn trong một bệnh viện."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a machine or substance that is used for cleaning",
                        "vi": "một máy hoặc chất được sử dụng để làm sạch"
                    },
                    "examples": [
                        {
                            "en": "a vacuum cleaner",
                            "vi": "máy hút bụi"
                        },
                        {
                            "en": "a bottle of kitchen cleaner",
                            "vi": "một chai nước lau bếp"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a shop where clothes, curtains, etc. are cleaned, especially with chemicals",
                        "vi": "một cửa hàng nơi quần áo, rèm cửa, vv được làm sạch, đặc biệt là bằng hóa chất"
                    },
                    "examples": [
                        {
                            "en": "Can you pick up my suit from the cleaner's?",
                            "vi": "Bạn có thể lấy bộ đồ của tôi từ người dọn dẹp không?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to steal all of somebody’s money, etc., or to get it using a trick",
                        "vi": "để ăn cắp tất cả tiền của ai đó, v.v. hoặc lấy nó bằng cách sử dụng mánh khóe"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to defeat somebody completely",
                        "vi": "để đánh bại ai đó hoàn toàn"
                    },
