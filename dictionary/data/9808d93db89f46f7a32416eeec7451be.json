{
    "id": "9808d93db89f46f7a32416eeec7451be",
    "word": "freshen",
    "phonetic": {
        "uk": "/ˈfreʃn/",
        "us": "/ˈfreʃn/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make something cleaner, cooler, newer or more pleasant",
                        "vi": "để làm cho thứ gì đó sạch hơn, mát hơn, mới hơn hoặc dễ chịu hơn"
                    },
                    "examples": [
                        {
                            "en": "The walls need freshening up with white paint.",
                            "vi": "Các bức tường cần được làm mới bằng sơn trắng."
                        },
                        {
                            "en": "The rain had freshened the air.",
                            "vi": "Mưa đã làm không khí trong lành."
                        },
                        {
                            "en": "Using a mouthwash freshens the breath.",
                            "vi": "Sử dụng nước súc miệng giúp hơi thở thơm tho."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to add more liquid to a drink, especially an alcoholic one",
                        "vi": "để thêm chất lỏng vào đồ uống, đặc biệt là đồ uống có cồn"
                    },
                    "examples": [
                        {
                            "en": "Can I freshen your drink, sir?",
                            "vi": "Tôi có thể làm mới đồ uống của ông không, thưa ông?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to become stronger and colder",
                        "vi": "trở nên mạnh mẽ hơn và lạnh lùng hơn"
                    },
                    "examples": [
                        {
                            "en": "The wind will freshen tonight.",
                            "vi": "Đêm nay gió sẽ lành."
                        },
                        {
                            "en": "a freshening onshore breeze",
                            "vi": "một làn gió trong lành trên bờ"
                        }
                    ]
                }
            ]
        }
    ],
