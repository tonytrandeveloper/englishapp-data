    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the fact of land or soil not being good enough for plants to grow on it",
                        "vi": "thực tế là đất hoặc đất không đủ tốt để thực vật có thể phát triển trên đó"
                    },
                    "examples": [
                        {
                            "en": "the stony barrenness of the land",
                            "vi": "đất cằn cỗi khô cằn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of plants or trees being unable to produce fruit or seeds",
                        "vi": "thực tế là cây hoặc cây không thể tạo ra quả hoặc hạt"
                    },
                    "examples": [
                        {
                            "en": "corn hybrids resistant to barrenness",
                            "vi": "ngô lai chịu được cằn cỗi"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact that a woman is unable to have babies",
                        "vi": "thực tế là một người phụ nữ không thể sinh con"
                    },
                    "examples": [
                        {
                            "en": "his wife's barrenness",
                            "vi": "vợ hiếm muộn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact that a female animal is unable to produce young animals",
                        "vi": "thực tế là một con cái không thể sinh ra con non"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a lack of anything useful or valuable in something",
                        "vi": "thiếu bất cứ thứ gì hữu ích hoặc có giá trị trong một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "the barrenness of urban life",
                            "vi": "sự cằn cỗi của cuộc sống đô thị"
                        }
                    ]
                }
