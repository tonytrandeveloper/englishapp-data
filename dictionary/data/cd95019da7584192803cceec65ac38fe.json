    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to talk about somebody/something in a way that makes it clear that you think they are stupid or silly",
                        "vi": "để nói về ai đó / điều gì đó theo cách làm rõ rằng bạn nghĩ họ ngu ngốc hoặc ngớ ngẩn"
                    },
                    "examples": [
                        {
                            "en": "Don't scoff—she's absolutely right.",
                            "vi": "Đừng chế giễu — cô ấy hoàn toàn đúng."
                        },
                        {
                            "en": "scoff at somebody/something He scoffed at our amateurish attempts.",
                            "vi": "chế giễu ai đó / cái gì đó Anh ta chế giễu những nỗ lực nghiệp dư của chúng ta."
                        },
                        {
                            "en": "+ speech ‘Don't be ridiculous,’ she scoffed.",
                            "vi": "+ Bài phát biểu 'Đừng có lố bịch,' cô ấy chế giễu."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to eat a lot of something quickly",
                        "vi": "ăn nhiều thứ gì đó một cách nhanh chóng"
                    },
                    "examples": [
                        {
                            "en": "Who scoffed all the grapes?",
                            "vi": "Ai đã chế giễu tất cả các nho?"
                        }
                    ]
                }
            ]
        }
