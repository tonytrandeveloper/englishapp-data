    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "over the side of a boat or a ship into the water",
                        "vi": "qua mạn thuyền hoặc tàu xuống nước"
                    },
                    "examples": [
                        {
                            "en": "to fall/jump overboard",
                            "vi": "rơi / nhảy qua"
                        },
                        {
                            "en": "Huge waves washed him overboard.",
                            "vi": "Những con sóng lớn đã cuốn trôi anh ta."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to be too excited or enthusiastic about something or about doing something",
                        "vi": "quá phấn khích hoặc nhiệt tình về điều gì đó hoặc về việc làm điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "Don't go overboard on fitness.",
                            "vi": "Đừng tập thể dục quá đà."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to get rid of somebody/something that you think is not useful",
                        "vi": "để loại bỏ ai đó / thứ gì đó mà bạn nghĩ là không hữu ích"
                    },
                    "examples": [
                        {
                            "en": "He threw all his old friends overboard once he was promoted.",
                            "vi": "Anh ấy đã ném tất cả những người bạn cũ của mình vào bờ biển khi anh ấy được thăng chức."
                        }
                    ]
                }
