            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "causing great surprise, excitement, or interest",
                        "vi": "gây ngạc nhiên, phấn khích hoặc quan tâm"
                    },
                    "examples": [
                        {
                            "en": "The result was a sensational 4–1 victory.",
                            "vi": "Kết quả là một chiến thắng 4–1 đầy giật gân."
                        },
                        {
                            "en": "The affair was the most sensational political sex scandal of the century.",
                            "vi": "Vụ này là vụ bê bối tình dục chính trị giật gân nhất thế kỷ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "trying to get your interest by presenting facts or events as worse or more shocking than they really are",
                        "vi": "cố gắng thu hút sự quan tâm của bạn bằng cách trình bày các sự kiện hoặc sự kiện tồi tệ hơn hoặc gây sốc hơn thực tế"
                    },
                    "examples": [
                        {
                            "en": "sensational news stories",
                            "vi": "tin tức giật gân"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "extremely good; wonderful",
                        "vi": "cực kỳ tốt; tuyệt vời"
                    },
                    "examples": [
                        {
                            "en": "You look sensational in that dress!",
                            "vi": "Bạn trông thật giật gân trong chiếc váy đó!"
