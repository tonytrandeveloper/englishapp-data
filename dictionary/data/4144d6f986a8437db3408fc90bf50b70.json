                    ]
                },
                {
                    "define": {
                        "en": "based on the principle that all members of society are equal rather than divided by money or social class",
                        "vi": "dựa trên nguyên tắc mọi thành viên trong xã hội đều bình đẳng, không bị phân chia theo tiền bạc hay giai cấp xã hội"
                    },
                    "examples": [
