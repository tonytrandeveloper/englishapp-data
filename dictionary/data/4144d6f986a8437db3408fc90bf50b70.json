            "means": [
                {
                    "define": {
                        "en": "controlled by representatives who are elected by the people of a country; connected with this system",
                        "vi": "kiểm soát bởi các đại diện được bầu bởi người dân của một quốc gia; kết nối với hệ thống này"
                    },
                    "examples": [
