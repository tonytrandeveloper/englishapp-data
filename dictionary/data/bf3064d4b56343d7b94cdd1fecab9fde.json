                        }
                    ]
                },
                {
                    "define": {
                        "en": "a natural development or result of something",
                        "vi": "một sự phát triển tự nhiên hoặc kết quả của một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "The law was an outgrowth of the 2008 presidential election.",
                            "vi": "Luật này đã phát triển vượt bậc so với cuộc bầu cử tổng thống năm 2008."
                        }
