                        "vi": "có dấu vết trên chúng nơi chúng đã bị hư hỏng"
                    },
                    "examples": [
                        {
                            "en": "a tray of slightly bruised apples",
                            "vi": "một khay táo hơi thâm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "badly affected by something and feeling unhappy and less confident because of it",
                        "vi": "bị ảnh hưởng xấu bởi điều gì đó và cảm thấy không vui và kém tự tin vì điều đó"
                    },
                    "examples": [
