                    },
                    "examples": [
                        {
                            "en": "He suffered badly bruised ribs in the crash.",
                            "vi": "Anh ta bị bầm tím nặng xương sườn trong vụ va chạm."
                        }
                    ]
                },
                {
                    "define": {
