        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a thing, a place or a group that has all the features and qualities of something much larger",
                        "vi": "một sự vật, một địa điểm hoặc một nhóm có tất cả các tính năng và phẩm chất của một thứ gì đó lớn hơn nhiều"
                    },
                    "examples": [
                        {
                            "en": "The family is a microcosm of society.",
                            "vi": "Gia đình là một mô hình thu nhỏ của xã hội."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "on a small scale",
                        "vi": "trên một cái cân nhỏ"
                    },
                    "examples": [
                        {
                            "en": "The developments in this town represent in microcosm what is happening in the country as a whole.",
                            "vi": "Những phát triển ở thị trấn này thể hiện trong mô hình thu nhỏ những gì đang xảy ra trên toàn quốc."
                        }
                    ]
                }
            ]
