    "word": "alloy",
    "phonetic": {
        "uk": "/əˈlɔɪ/",
        "us": "/əˈlɔɪ/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to mix one metal with another, especially one of lower value",
                        "vi": "để trộn một kim loại này với một kim loại khác, đặc biệt là một kim loại có giá trị thấp hơn"
                    },
                    "examples": [
                        {
                            "en": "The copper was alloyed with tin to make bronze.",
                            "vi": "Đồng được hợp kim với thiếc để tạo ra đồ đồng."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a metal that is formed by mixing two types of metal together, or by mixing metal with another substance",
                        "vi": "kim loại được tạo thành bằng cách trộn hai loại kim loại với nhau hoặc bằng cách trộn kim loại với một chất khác"
                    },
                    "examples": [
                        {
                            "en": "Brass is an alloy of copper and zinc.",
                            "vi": "Đồng thau là hợp kim của đồng và kẽm."
                        },
                        {
                            "en": "alloy steel",
                            "vi": "thép hợp kim"
                        }
                    ]
                }
            ]
        }
