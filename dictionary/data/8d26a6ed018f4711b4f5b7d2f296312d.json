                    },
                    "examples": [
                        {
                            "en": "The book is intelligently written and compellingly argued.",
                            "vi": "Cuốn sách được viết một cách thông minh và lập luận hấp dẫn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is so strong that you cannot resist it",
                        "vi": "theo một cách mạnh mẽ đến mức bạn không thể chống lại nó"
                    },
                    "examples": [
