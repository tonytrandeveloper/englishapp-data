                {
                    "define": {
                        "en": "a fraction (= a number less than one) that is shown as a point followed by the number of tenths, hundredths, etc.",
                        "vi": "một phân số (= một số nhỏ hơn một) được hiển thị dưới dạng một điểm theo sau là số phần mười, phần trăm, v.v."
                    },
                    "examples": [
                        {
                            "en": "The decimal 0.61 stands for 61 hundredths.",
                            "vi": "Số thập phân 0,61 là viết tắt của 61 phần trăm."
                        }
                    ]
                },
                {
