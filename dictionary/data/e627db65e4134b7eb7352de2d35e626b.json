    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that shows power or force; in a way that is very effective",
                        "vi": "theo cách thể hiện quyền lực hoặc vũ lực; theo một cách rất hiệu quả"
                    },
                    "examples": [
                        {
                            "en": "She argued powerfully for reform.",
                            "vi": "Cô lập luận mạnh mẽ để cải cách."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that has a strong effect on your mind or body",
                        "vi": "theo cách có ảnh hưởng mạnh mẽ đến tâm trí hoặc cơ thể của bạn"
                    },
                    "examples": [
                        {
                            "en": "a powerfully emotive song",
                            "vi": "một bài hát giàu cảm xúc"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a physically strong way",
                        "vi": "một cách mạnh mẽ về thể chất"
                    },
                    "examples": [
                        {
                            "en": "He is powerfully built (= he has a large strong body).",
                            "vi": "Anh ta được xây dựng một cách mạnh mẽ (= anh ta có một cơ thể to lớn mạnh mẽ)."
                        }
                    ]
                }
            ]
        }
