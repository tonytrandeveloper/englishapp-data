{
    "id": "0837199f34b3463d87449e0f1c0657c4",
    "word": "unequally",
    "phonetic": {
        "uk": "/ʌnˈiːkwəli/",
        "us": "/ʌnˈiːkwəli/"
    },
    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "with different people, things, etc. given different amounts",
                        "vi": "với những người, sự vật khác nhau, v.v. với số tiền khác nhau"
                    },
                    "examples": [
                        {
                            "en": "The budget was unequally distributed between the departments.",
                            "vi": "Ngân sách được phân bổ không đồng đều giữa các bộ phận."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with people being treated in different ways or with different advantages, in a way that seems unfair",
                        "vi": "với việc mọi người bị đối xử theo những cách khác nhau hoặc với những ưu điểm khác nhau, theo cách có vẻ không công bằng"
                    },
                    "examples": [
                        {
                            "en": "Women were often treated unequally.",
                            "vi": "Phụ nữ thường bị đối xử bất bình đẳng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is not equal in size, amount, etc.",
                        "vi": "theo cách không bằng nhau về kích thước, số lượng, v.v."
                    },
                    "examples": [
                        {
                            "en": "unequally spaced columns",
                            "vi": "các cột cách đều nhau"
                        }
                    ]
                }
            ]
        }
    ],
