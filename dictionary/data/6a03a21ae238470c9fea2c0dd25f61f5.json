    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to trick somebody into doing something, especially by being nice to them",
                        "vi": "lừa ai đó làm điều gì đó, đặc biệt là bằng cách đối xử tốt với họ"
                    },
                    "examples": [
                        {
                            "en": "She beguiled them into believing her version of events.",
                            "vi": "Cô khiến họ tin vào phiên bản sự kiện của cô."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to attract or interest somebody",
                        "vi": "để thu hút hoặc quan tâm ai đó"
                    },
                    "examples": [
                        {
                            "en": "He was beguiled by her beauty.",
                            "vi": "Anh bị mê hoặc bởi vẻ đẹp của cô."
                        },
                        {
                            "en": "The tapestries continue to beguile all those who visit the cathedral.",
                            "vi": "Những tấm thảm tiếp tục làm say lòng tất cả những ai đến thăm nhà thờ."
                        }
                    ]
                }
            ]
        }
