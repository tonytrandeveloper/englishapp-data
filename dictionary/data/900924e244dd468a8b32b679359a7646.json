{
    "id": "900924e244dd468a8b32b679359a7646",
    "word": "repulse",
    "phonetic": {
        "uk": "/rɪˈpʌls/",
        "us": "/rɪˈpʌls/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make somebody feel strong dislike",
                        "vi": "làm cho ai đó cảm thấy không thích"
                    },
                    "examples": [
                        {
                            "en": "I was repulsed by the horrible smell.",
                            "vi": "Tôi đã bị đẩy lùi bởi mùi kinh khủng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to fight somebody who is attacking you and drive them away",
                        "vi": "để chống lại ai đó đang tấn công bạn và xua đuổi họ"
                    },
                    "examples": [
                        {
                            "en": "to repulse an attack/invasion/offensive",
                            "vi": "để đẩy lùi một cuộc tấn công / xâm lược / tấn công"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to refuse to accept somebody’s help, attempts to be friendly, etc.",
                        "vi": "từ chối nhận sự giúp đỡ của ai đó, cố gắng tỏ ra thân thiện, v.v."
                    },
                    "examples": [
                        {
                            "en": "Each time I tried to help I was repulsed.",
                            "vi": "Mỗi lần tôi cố gắng giúp tôi đều bị đẩy lùi."
                        },
                        {
                            "en": "She repulsed his advances.",
                            "vi": "Cô đẩy lùi những bước tiến của anh ta."
                        }
                    ]
                }
            ]
        }
    ],
