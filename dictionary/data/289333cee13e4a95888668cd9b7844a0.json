                        "vi": "theo cách cho thấy bạn nghĩ có điều gì đó vui nhộn"
                    },
                    "examples": [
                        {
                            "en": "He laughingly agreed.",
                            "vi": "Anh cười đồng ý."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to show that you think a particular word is not at all a suitable way of describing something and therefore seems silly",
                        "vi": "được sử dụng để cho thấy rằng bạn nghĩ một từ cụ thể hoàn toàn không phải là cách thích hợp để mô tả điều gì đó và do đó có vẻ ngớ ngẩn"
                    },
                    "examples": [
                        {
                            "en": "I finally reached what we laughingly call civilization.",
                            "vi": "Cuối cùng tôi đã đạt đến cái mà chúng ta hay gọi là nền văn minh."
                        }
                    ]
                }
