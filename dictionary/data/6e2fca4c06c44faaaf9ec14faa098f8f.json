            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "a person who is right-handed uses their right hand for writing, using tools, etc.",
                        "vi": "một người thuận tay phải sử dụng tay phải của họ để viết, sử dụng các công cụ, v.v."
                    },
                    "examples": [
                        {
                            "en": "Everyone in our family is right-handed except Pauline.",
                            "vi": "Mọi người trong gia đình chúng tôi đều thuận tay phải ngoại trừ Pauline."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a right-handed tool is designed to be used with the right hand",
                        "vi": "một công cụ thuận tay phải được thiết kế để sử dụng bằng tay phải"
                    },
                    "examples": [
                        {
                            "en": "right-handed scissors",
                            "vi": "kéo tay phải"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "using the right hand",
                        "vi": "sử dụng tay phải"
                    },
                    "examples": [
                        {
                            "en": "I play tennis right-handed but I write left-handed.",
                            "vi": "Tôi chơi quần vợt thuận tay phải nhưng tôi viết thuận tay trái."
                        }
                    ]
                }
            ]
