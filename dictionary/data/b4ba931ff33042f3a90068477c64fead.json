{
    "id": "b4ba931ff33042f3a90068477c64fead",
    "word": "lather",
    "phonetic": {
        "uk": "/ˈlɑːðə(r)/",
        "us": "/ˈlæðər/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to cover something with lather",
                        "vi": "phủ một thứ gì đó bằng bọt"
                    },
                    "examples": [
                        {
                            "en": "I lathered my face and started to shave.",
                            "vi": "Tôi cúi gằm mặt và bắt đầu cạo râu."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to produce lather",
                        "vi": "để tạo bọt"
                    },
                    "examples": [
                        {
                            "en": "Soap does not lather well in hard water.",
                            "vi": "Xà phòng không tạo bọt tốt trong nước cứng."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a white mass of small bubbles that is produced by mixing soap with water",
                        "vi": "một khối bong bóng nhỏ màu trắng được tạo ra bằng cách trộn xà phòng với nước"
                    },
                    "examples": [
                        {
                            "en": "to work up a good lather",
                            "vi": "để làm việc tốt hơn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to get anxious or angry about something, especially when it is not necessary",
                        "vi": "lo lắng hoặc tức giận về điều gì đó, đặc biệt là khi nó không cần thiết"
                    },
                    "examples": [
                        {
                            "en": "Calm down—don’t work yourself into a lather about it.",
                            "vi": "Bình tĩnh — đừng làm bản thân say mê về điều đó."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a nervous, angry or excited state",
                        "vi": "trong trạng thái lo lắng, tức giận hoặc phấn khích"
                    },
                    "examples": [
                        {
                            "en": "Dad was in a right lather about something.",
                            "vi": "Bố đã đúng khi nói về điều gì đó."
                        }
                    ]
                }
            ]
        }
    ],
