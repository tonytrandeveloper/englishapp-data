            "means": [
                {
                    "define": {
                        "en": "a large formal meeting or series of meetings where representatives from different groups discuss ideas, make decisions, etc.",
                        "vi": "một cuộc họp chính thức lớn hoặc một loạt các cuộc họp trong đó đại diện từ các nhóm khác nhau thảo luận về ý tưởng, đưa ra quyết định, v.v."
                    },
                    "examples": [
                        {
                            "en": "an international congress of trades unions",
                            "vi": "đại hội công đoàn quốc tế"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "(in the US and some other countries) the name of the group of people who are elected to make laws, in the US consisting of the Senate and the House of Representatives",
                        "vi": "(ở Mỹ và một số quốc gia khác) tên của nhóm người được bầu để làm luật, ở Mỹ bao gồm Thượng viện và Hạ viện."
                    },
                    "examples": [
                        {
                            "en": "Congress will vote on the proposals tomorrow.",
                            "vi": "Quốc hội sẽ biểu quyết các đề xuất vào ngày mai."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a political organization or society",
                        "vi": "một tổ chức chính trị hoặc xã hội"
                    },
                    "examples": [
                        {
                            "en": "the African National Congress",
                            "vi": "Đại hội dân tộc châu Phi"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the action of coming together",
                        "vi": "hành động đến với nhau"
                    },
                    "examples": [
                        {
                            "en": "sexual congress",
                            "vi": "đại hội tình dục"
                        }
                    ]
                }
            ]
