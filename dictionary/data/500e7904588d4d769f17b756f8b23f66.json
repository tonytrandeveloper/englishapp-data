            "means": [
                {
                    "define": {
                        "en": "the fact of being done by or involving all the people in the world or in a particular group",
                        "vi": "thực tế được thực hiện bởi hoặc liên quan đến tất cả mọi người trên thế giới hoặc trong một nhóm cụ thể"
                    },
                    "examples": [
                        {
                            "en": "the universality of religious experience",
                            "vi": "tính phổ quát của kinh nghiệm tôn giáo"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the fact of being true or right at all times and in all places",
                        "vi": "thực tế là đúng hoặc đúng mọi lúc và mọi nơi"
                    },
                    "examples": [
                        {
                            "en": "I believe in the universality of freedom.",
                            "vi": "Tôi tin vào tính phổ quát của tự do."
                        }
                    ]
                }
