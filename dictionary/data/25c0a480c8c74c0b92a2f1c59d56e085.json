    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "an increase in how fast something happens",
                        "vi": "sự gia tăng về tốc độ một cái gì đó xảy ra"
                    },
                    "examples": [
                        {
                            "en": "an acceleration in the rate of economic growth",
                            "vi": "tăng tốc độ tăng trưởng kinh tế"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the rate at which a vehicle increases speed",
                        "vi": "tốc độ một chiếc xe tăng tốc độ"
                    },
                    "examples": [
                        {
                            "en": "a car with good acceleration",
                            "vi": "một chiếc xe có khả năng tăng tốc tốt"
                        },
                        {
                            "en": "acceleration from 0–60 mph in 11.2 seconds",
                            "vi": "tăng tốc từ 0–60 dặm / giờ trong 11,2 giây"
                        },
                        {
                            "en": "This model has the best acceleration of any available sports car.",
                            "vi": "Mẫu xe này có khả năng tăng tốc tốt nhất trong số các mẫu xe thể thao hiện có."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the rate at which the velocity (= speed in a particular direction) of an object changes",
                        "vi": "tốc độ thay đổi vận tốc (= tốc độ theo một hướng cụ thể) của một vật"
                    },
                    "examples": [
                        {
                            "en": "acceleration caused by gravity",
                            "vi": "gia tốc gây ra bởi trọng lực"
                        }
                    ]
                }
            ]
        }
