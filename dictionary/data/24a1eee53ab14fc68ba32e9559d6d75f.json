            "means": [
                {
                    "define": {
                        "en": "a piece of clothing made from material that does not let water through",
                        "vi": "một bộ quần áo làm từ chất liệu không để nước lọt qua"
                    },
                    "examples": [
                        {
                            "en": "You’ll need waterproofs (= a waterproof jacket and trousers).",
                            "vi": "Bạn sẽ cần áo chống thấm (= áo khoác và quần chống thấm nước)."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make something waterproof",
                        "vi": "để làm một cái gì đó không thấm nước"
                    },
                    "examples": []
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "that does not let water through or that cannot be damaged by water",
                        "vi": "không để nước lọt qua hoặc không thể bị nước làm hỏng"
                    },
                    "examples": [
                        {
                            "en": "waterproof clothing",
                            "vi": "Vải chống thấm nước"
                        },
                        {
                            "en": "a waterproof camera",
                            "vi": "một máy ảnh chống nước"
                        },
                        {
                            "en": "Treat them with oil to make them waterproof.",
                            "vi": "Xử lý chúng bằng dầu để làm cho chúng không thấm nước."
                        },
                        {
                            "en": "a waterproof jacket",
                            "vi": "áo khoác không thấm nước"
                        }
                    ]
                }
            ]
