    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a hidden store of things such as weapons",
                        "vi": "một cửa hàng ẩn chứa những thứ như vũ khí"
                    },
                    "examples": [
                        {
                            "en": "an arms cache",
                            "vi": "một bộ nhớ cache"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a part of a computer’s memory that stores copies of data that is often needed while a program is running. This data can be accessed very quickly.",
                        "vi": "một phần của bộ nhớ máy tính lưu trữ các bản sao dữ liệu thường cần thiết trong khi chương trình đang chạy. Dữ liệu này có thể được truy cập rất nhanh chóng."
                    },
                    "examples": []
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to store things in a secret place, especially weapons",
                        "vi": "cất giữ mọi thứ ở một nơi bí mật, đặc biệt là vũ khí"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to store data in a cache",
                        "vi": "để lưu trữ dữ liệu trong bộ nhớ cache"
                    },
                    "examples": [
                        {
                            "en": "This page is cached.",
                            "vi": "Trang này được lưu trong bộ nhớ cache."
                        }
                    ]
                }
            ]
        }
