            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "pleasant to spend time with because their interests and character are similar to your own",
                        "vi": "thoải mái dành thời gian vì sở thích và tính cách của họ giống với sở thích của bạn"
                    },
                    "examples": [
                        {
                            "en": "a congenial colleague",
                            "vi": "một đồng nghiệp tốt"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "pleasant because it suits your character",
                        "vi": "dễ chịu vì nó phù hợp với tính cách của bạn"
                    },
                    "examples": [
                        {
                            "en": "a congenial working environment",
                            "vi": "một môi trường làm việc hòa hợp"
                        },
                        {
                            "en": "His studies in Leiden proved congenial to him.",
                            "vi": "Việc học của anh ấy ở Leiden đã chứng tỏ sự đồng tình với anh ấy."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "suitable for something",
                        "vi": "thích hợp cho một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "a situation that was congenial to the expression of nationalist opinions",
                            "vi": "một tình huống đồng nghĩa với việc bày tỏ các quan điểm dân tộc chủ nghĩa"
