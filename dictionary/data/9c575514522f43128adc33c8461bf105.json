    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "very large in size or amount and seeming to have no end",
                        "vi": "kích thước hoặc số lượng rất lớn và dường như không có kết thúc"
                    },
                    "examples": [
                        {
                            "en": "endless patience",
                            "vi": "kiên nhẫn vô tận"
                        },
                        {
                            "en": "endless opportunities for making money",
                            "vi": "cơ hội kiếm tiền vô tận"
                        },
                        {
                            "en": "The possibilities are endless.",
                            "vi": "Khả năng là vô tận."
                        },
                        {
                            "en": "an endless list of things to do",
                            "vi": "một danh sách vô tận những việc cần làm"
                        },
                        {
                            "en": "We don't have an endless supply of money, you know.",
                            "vi": "Bạn biết đấy, chúng tôi không có nguồn cung tiền vô tận."
                        },
                        {
                            "en": "I've had enough of their endless arguing.",
                            "vi": "Tôi đã có đủ cuộc tranh cãi bất tận của họ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "continuing for a long time and seeming to have no end",
                        "vi": "tiếp tục trong một thời gian dài và dường như không có hồi kết"
                    },
                    "examples": [
                        {
                            "en": "an endless round of parties and visits",
                            "vi": "một vòng vô tận của các bữa tiệc và chuyến thăm"
                        },
                        {
                            "en": "The journey seemed endless.",
                            "vi": "Cuộc hành trình dường như vô tận."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having the ends joined together so it forms one piece",
                        "vi": "có các đầu nối với nhau để nó tạo thành một mảnh"
                    },
                    "examples": [
                        {
                            "en": "an endless loop of tape",
                            "vi": "một vòng băng vô tận"
                        }
                    ]
                }
            ]
        }
