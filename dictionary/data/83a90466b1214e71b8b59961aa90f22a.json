            "means": [
                {
                    "define": {
                        "en": "made to seem larger, better, worse or more important than it really is or needs to be",
                        "vi": "được tạo ra để có vẻ lớn hơn, tốt hơn, tồi tệ hơn hoặc quan trọng hơn so với thực tế hoặc cần phải"
                    },
                    "examples": [
                        {
                            "en": "to make greatly/grossly/wildly exaggerated claims",
                            "vi": "đưa ra tuyên bố quá mức / thô thiển / phóng đại quá mức"
                        },
                        {
                            "en": "She has an exaggerated sense of her own importance.",
                            "vi": "Cô ấy có ý thức quá mức về tầm quan trọng của bản thân."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "done in a way that makes people notice it",
                        "vi": "được thực hiện theo cách khiến mọi người chú ý"
                    },
                    "examples": [
                        {
                            "en": "an exaggerated laugh",
                            "vi": "một điệu cười cường điệu"
                        },
                        {
                            "en": "He looked at me with exaggerated surprise.",
                            "vi": "Anh ta nhìn tôi với vẻ ngạc nhiên tột độ."
                        }
                    ]
                }
            ]
