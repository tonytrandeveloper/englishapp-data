{
    "id": "faf92572cea74ca38bcf66802caea581",
    "word": "dabble",
    "phonetic": {
        "uk": "/ˈdæbl/",
        "us": "/ˈdæbl/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to take part in a sport, an activity, etc. but not very seriously",
                        "vi": "tham gia một môn thể thao, một hoạt động, v.v. nhưng không nghiêm túc lắm"
                    },
                    "examples": [
                        {
                            "en": "She is a talented musician but is content to just dabble.",
                            "vi": "Cô ấy là một nhạc sĩ tài năng nhưng chỉ bằng lòng với những gì đã qua."
                        },
                        {
                            "en": "He dabbles in local politics.",
                            "vi": "Anh ta nghiên cứu về chính trị địa phương."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to move your hands, feet, etc. around in water",
                        "vi": "di chuyển bàn tay, bàn chân, v.v. của bạn trong nước"
                    },
                    "examples": [
                        {
                            "en": "She dabbled her toes in the stream.",
                            "vi": "Cô ấy vọc ngón chân của mình xuống dòng suối."
                        }
                    ]
                }
            ]
        }
    ],
