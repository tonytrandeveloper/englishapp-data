{
    "id": "f790676a9de74248b36768d03725e09c",
    "word": "next to",
    "phonetic": {
        "uk": "/ˈnekst tə/",
        "us": "/ˈnekst tə/"
    },
    "blocks": [
        {
            "pos": "preposition",
            "means": [
                {
                    "define": {
                        "en": "in or into a position right by somebody/something",
                        "vi": "ở hoặc vào một vị trí đúng bởi ai đó / cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "We sat next to each other.",
                            "vi": "Chúng tôi ngồi cạnh nhau."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "following in order or importance after somebody/something",
                        "vi": "theo thứ tự hoặc tầm quan trọng sau ai đó / cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "Next to skiing my favourite sport is skating.",
                            "vi": "Bên cạnh trượt tuyết môn thể thao yêu thích của tôi là trượt băng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "almost",
                        "vi": "gần như"
                    },
                    "examples": [
                        {
                            "en": "Charles knew next to nothing about farming.",
                            "vi": "Charles không biết gì về nông nghiệp."
                        },
                        {
                            "en": "The horse came next to last (= the one before the last one) in the race.",
                            "vi": "Con ngựa đến sau cùng (= con trước con cuối cùng) trong cuộc đua."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in comparison with somebody/something",
                        "vi": "so với ai đó / cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "Next to her I felt like a fraud.",
                            "vi": "Ở cạnh cô ấy, tôi cảm thấy mình giống như một kẻ lừa đảo."
                        }
                    ]
                }
            ]
        }
    ],
