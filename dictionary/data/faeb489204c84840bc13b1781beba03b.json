{
    "id": "faeb489204c84840bc13b1781beba03b",
    "word": "convulse",
    "phonetic": {
        "uk": "/kənˈvʌls/",
        "us": "/kənˈvʌls/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to cause a sudden shaking movement in somebody’s body; to make this movement",
                        "vi": "để gây ra chuyển động rung lắc đột ngột trong cơ thể của ai đó; để thực hiện chuyển động này"
                    },
                    "examples": [
                        {
                            "en": "A violent shiver convulsed him.",
                            "vi": "Một cơn rùng mình dữ dội làm anh ta co giật."
                        },
                        {
                            "en": "His whole body convulsed.",
                            "vi": "Toàn thân anh co giật."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to be laughing so much, so angry, etc. that you cannot control your movements",
                        "vi": "cười quá nhiều, tức giận, v.v. đến mức bạn không thể kiểm soát được cử động của mình"
                    },
                    "examples": [
                        {
                            "en": "She was convulsed by a bout of sneezing.",
                            "vi": "Cô ấy đã bị co giật bởi một cơn hắt hơi."
                        }
                    ]
                }
            ]
        }
    ],
