            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not seeming to be based on a reason, system or plan and sometimes seeming unfair",
                        "vi": "dường như không dựa trên một lý do, hệ thống hoặc kế hoạch và đôi khi có vẻ không công bằng"
                    },
                    "examples": [
                        {
                            "en": "The choice of players for the team seemed completely arbitrary.",
                            "vi": "Việc lựa chọn cầu thủ cho đội dường như hoàn toàn tùy tiện."
                        },
                        {
                            "en": "He makes unpredictable, arbitrary decisions.",
                            "vi": "Anh ta đưa ra những quyết định không thể đoán trước, độc đoán."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "using power without limits and without considering other people",
                        "vi": "sử dụng quyền lực không có giới hạn và không xem xét người khác"
                    },
                    "examples": [
                        {
                            "en": "the arbitrary powers of officials",
                            "vi": "quyền hạn độc đoán của các quan chức"
                        }
                    ]
                }
