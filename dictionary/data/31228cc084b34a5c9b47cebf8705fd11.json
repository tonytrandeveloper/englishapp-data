{
    "id": "31228cc084b34a5c9b47cebf8705fd11",
    "word": "chorus",
    "phonetic": {
        "uk": "/ˈkɔːrəs/",
        "us": "/ˈkɔːrəs/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "part of a song that is sung after each verse",
                        "vi": "một phần của bài hát được hát sau mỗi câu"
                    },
                    "examples": [
                        {
                            "en": "Everyone joined in the chorus.",
                            "vi": "Mọi người cùng hòa mình vào dàn đồng ca."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a piece of music, usually part of a larger work, that is written for a choir (= a group of singers)",
                        "vi": "một bản nhạc, thường là một phần của tác phẩm lớn hơn, được viết cho một dàn hợp xướng (= một nhóm ca sĩ)"
                    },
                    "examples": [
                        {
                            "en": "the Hallelujah Chorus",
                            "vi": "hợp xướng Hallelujah"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a large group of singers",
                        "vi": "một nhóm lớn các ca sĩ"
                    },
                    "examples": [
                        {
                            "en": "the Bath Festival Chorus",
                            "vi": "Hợp xướng Lễ hội Tắm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a group of performers who sing and dance in a musical show",
                        "vi": "một nhóm biểu diễn hát và nhảy trong một chương trình âm nhạc"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "the sound of a lot of people expressing approval or disapproval at the same time",
                        "vi": "âm thanh của nhiều người bày tỏ sự tán thành hoặc không tán thành cùng một lúc"
                    },
                    "examples": [
                        {
                            "en": "a chorus of praise/complaint",
                            "vi": "một điệp khúc khen ngợi / phàn nàn"
                        },
                        {
                            "en": "a chorus of voices calling for her resignation",
                            "vi": "một điệp khúc kêu gọi cô ấy từ chức"
                        },
                        {
                            "en": "A chorus of laughter greeted his remark.",
                            "vi": "Một tràng cười chào đón nhận xét của anh ta."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a group of performers who comment together on the events of the play",
                        "vi": "một nhóm các nghệ sĩ biểu diễn cùng nhau bình luận về các sự kiện của vở kịch"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "an actor who speaks the opening and closing words of the play",
                        "vi": "một diễn viên nói lời mở đầu và kết thúc vở kịch"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "all together",
                        "vi": "tất cả cùng nhau"
                    },
                    "examples": [
                        {
                            "en": "‘Thank you,’ they said in chorus.",
                            "vi": "\"Cảm ơn\", họ nói trong điệp khúc."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to sing or say something all together",
                        "vi": "hát hoặc nói điều gì đó cùng nhau"
                    },
                    "examples": [
                        {
                            "en": "‘Hello, Paul,’ they chorused.",
                            "vi": "“Xin chào, Paul,” họ đồng thanh."
                        }
                    ]
                }
            ]
        }
    ],
