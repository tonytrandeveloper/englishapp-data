            "means": [
                {
                    "define": {
                        "en": "in the middle of the period that a government, a council, etc. is elected for",
                        "vi": "ở giữa thời kỳ mà chính phủ, hội đồng, v.v. được bầu chọn"
                    },
                    "examples": [
                        {
                            "en": "midterm elections",
                            "vi": "bầu cử giữa kỳ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "for or connected with a period of time that is neither long nor short; in the middle of a particular period",
                        "vi": "cho hoặc kết nối với một khoảng thời gian không dài cũng không ngắn; ở giữa một khoảng thời gian cụ thể"
                    },
                    "examples": [
                        {
                            "en": "a midterm solution",
                            "vi": "một giải pháp giữa kỳ"
                        },
                        {
                            "en": "midterm losses",
                            "vi": "lỗ giữa kỳ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in the middle of one of the main periods of the academic year",
                        "vi": "ở giữa một trong những giai đoạn chính của năm học"
                    },
                    "examples": [
                        {
                            "en": "a midterm examination/break",
                            "vi": "kiểm tra / nghỉ giữa kỳ"
