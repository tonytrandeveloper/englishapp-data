    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make a sound quieter or less clear",
                        "vi": "để tạo ra âm thanh nhỏ hơn hoặc ít rõ ràng hơn"
                    },
                    "examples": [
                        {
                            "en": "He tried to muffle the alarm clock by putting it under his pillow.",
                            "vi": "Anh cố gắng bóp nghẹt đồng hồ báo thức bằng cách đặt nó dưới gối."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to wrap or cover somebody/something in order to keep them/it warm",
                        "vi": "quấn hoặc che cho ai đó / cái gì đó để giữ ấm cho họ / nó"
                    },
                    "examples": [
                        {
                            "en": "She muffled the child up in a blanket.",
                            "vi": "Cô nhét đứa trẻ vào trong chăn."
                        }
                    ]
                }
            ]
        }
