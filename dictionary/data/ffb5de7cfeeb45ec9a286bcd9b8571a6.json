            "means": [
                {
                    "define": {
                        "en": "to develop into an adult",
                        "vi": "để phát triển thành một người lớn"
                    },
                    "examples": [
                        {
                            "en": "She grew up in Boston (= lived there as a child).",
                            "vi": "Cô ấy lớn lên ở Boston (= sống ở đó khi còn nhỏ)."
                        },
                        {
                            "en": "Their children have all grown up and left home now.",
                            "vi": "Con cái của họ đều đã lớn và bỏ nhà ra đi."
                        },
                        {
                            "en": "grow up to do something He grew up to become a famous pianist.",
                            "vi": "lớn lên để làm một cái gì đó Ông lớn lên để trở thành một nghệ sĩ piano nổi tiếng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to tell somebody to stop behaving in a silly way",
                        "vi": "được sử dụng để nói với ai đó ngừng cư xử một cách ngớ ngẩn"
                    },
                    "examples": [
                        {
                            "en": "Why don't you grow up?",
                            "vi": "Tại sao bạn không lớn lên?"
                        },
                        {
                            "en": "It's time you grew up.",
                            "vi": "Đã đến lúc bạn trưởng thành."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to develop gradually",
                        "vi": "để phát triển dần dần"
                    },
                    "examples": [
                        {
                            "en": "A closeness grew up between the two girls.",
                            "vi": "Một sự thân thiết lớn lên giữa hai cô gái."
                        }
                    ]
                }
            ]
