    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "having left without telling anyone",
                        "vi": "đã rời đi mà không nói với ai"
                    },
                    "examples": [
                        {
                            "en": "runaway children",
                            "vi": "trẻ em bỏ trốn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not under the control of its owner, rider or driver",
                        "vi": "không nằm dưới sự kiểm soát của chủ sở hữu, người lái hoặc người lái xe"
                    },
                    "examples": [
                        {
                            "en": "a runaway horse/car",
                            "vi": "một con ngựa / ô tô đang chạy trốn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "happening very easily or quickly, and not able to be controlled",
                        "vi": "xảy ra rất dễ dàng hoặc nhanh chóng, và không thể kiểm soát được"
                    },
                    "examples": [
                        {
                            "en": "a runaway winner/victory",
                            "vi": "một người chiến thắng / chiến thắng chạy trốn"
                        },
                        {
                            "en": "the runaway success of her first play",
                            "vi": "sự thành công trong vở kịch đầu tiên của cô ấy"
                        },
                        {
                            "en": "runaway inflation",
                            "vi": "lạm phát bỏ trốn"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a person who has suddenly left or escaped from somebody/something, especially a child who has left home without telling anyone",
                        "vi": "một người đột ngột bỏ đi hoặc trốn khỏi ai đó / điều gì đó, đặc biệt là một đứa trẻ đã bỏ nhà đi mà không nói cho ai biết"
                    },
                    "examples": [
                        {
                            "en": "teenage runaways living on the streets",
                            "vi": "thanh thiếu niên chạy trốn trên đường phố"
                        }
                    ]
                }
            ]
        }
