    "word": "fitted",
    "phonetic": {
        "uk": "/ˈfɪtɪd/",
        "us": "/ˈfɪtɪd/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "built to be fixed into a particular space",
                        "vi": "được xây dựng để cố định vào một không gian cụ thể"
                    },
                    "examples": [
                        {
                            "en": "fitted wardrobes/cupboards",
                            "vi": "tủ / tủ vừa vặn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with matching cupboards and other furniture built for the space and fixed in place",
                        "vi": "với tủ phù hợp và đồ nội thất khác được xây dựng cho không gian và cố định tại chỗ"
                    },
                    "examples": [
                        {
                            "en": "a fitted kitchen/bedroom",
                            "vi": "nhà bếp / phòng ngủ được trang bị"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "made to follow the shape of the body",
                        "vi": "làm theo hình dạng của cơ thể"
                    },
                    "examples": [
                        {
                            "en": "a fitted jacket",
                            "vi": "một chiếc áo khoác vừa vặn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "suitable; with the right qualities and skills",
                        "vi": "thích hợp; với những phẩm chất và kỹ năng phù hợp"
                    },
                    "examples": [
                        {
                            "en": "She was well fitted to the role of tragic heroine.",
                            "vi": "Cô ấy rất hợp với vai nữ chính bi kịch."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "having something as equipment",
                        "vi": "có một cái gì đó như thiết bị"
                    },
                    "examples": [
                        {
                            "en": "Insurance costs will be reduced for houses fitted with window locks.",
                            "vi": "Chi phí bảo hiểm sẽ được giảm bớt đối với những ngôi nhà được lắp khóa cửa sổ."
                        }
                    ]
                }
            ]
        }
