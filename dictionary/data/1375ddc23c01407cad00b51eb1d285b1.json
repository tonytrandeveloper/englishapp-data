    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to work well together; to form a successful group",
                        "vi": "để làm việc tốt với nhau; để tạo thành một nhóm thành công"
                    },
                    "examples": [
                        {
                            "en": "We just didn't gel as a group.",
                            "vi": "Chúng tôi không phải là một nhóm."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to become clearer and more definite; to work well",
                        "vi": "để trở nên rõ ràng và xác định hơn; làm việc tốt"
                    },
                    "examples": [
                        {
                            "en": "Ideas were beginning to gel in my mind.",
                            "vi": "Những ý tưởng bắt đầu hình thành trong đầu tôi."
                        },
                        {
                            "en": "That day, everything gelled.",
                            "vi": "Ngày hôm đó, mọi thứ trở nên sôi động."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to become thicker and more solid; to form a gel",
                        "vi": "để trở nên dày hơn và chắc chắn hơn; để tạo thành một loại gel"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "to put gel on your hair",
                        "vi": "bôi gel lên tóc"
                    },
                    "examples": []
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
