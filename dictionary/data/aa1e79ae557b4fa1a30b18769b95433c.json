            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not in the habit of doing something; not used to something",
                        "vi": "không có thói quen làm một việc gì đó; không quen với một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "He was unaccustomed to hard work.",
                            "vi": "Anh không quen với công việc khó khăn."
                        },
                        {
                            "en": "I am unaccustomed to being told what to do.",
                            "vi": "Tôi không quen với việc bị bảo phải làm gì."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not usual, normal or familiar",
                        "vi": "không bình thường, bình thường hoặc quen thuộc"
                    },
                    "examples": [
                        {
                            "en": "The unaccustomed heat made him weary.",
                            "vi": "Cái nóng không quen khiến anh mệt mỏi."
                        },
                        {
                            "en": "I was surprised by her unaccustomed silence.",
                            "vi": "Tôi ngạc nhiên trước sự im lặng không quen của cô ấy."
                        }
                    ]
                }
            ]
        }
