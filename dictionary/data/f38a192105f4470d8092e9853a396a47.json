    "blocks": [
        {
            "pos": "phrasal verb",
            "means": [
                {
                    "define": {
                        "en": "to leave a place quickly",
                        "vi": "rời khỏi một nơi nhanh chóng"
                    },
                    "examples": [
                        {
                            "en": "He cleared out with all the money and left her with the kids.",
                            "vi": "Anh ta tiêu sạch hết tiền và bỏ mặc cô với những đứa trẻ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to make something empty and clean by removing things or throwing things away",
                        "vi": "để làm cho thứ gì đó trống rỗng và sạch sẽ bằng cách loại bỏ mọi thứ hoặc vứt bỏ mọi thứ"
                    },
                    "examples": [
                        {
                            "en": "to clear out a drawer/room",
                            "vi": "dọn ngăn kéo / phòng"
                        },
                        {
                            "en": "We cleared out all our old clothes.",
                            "vi": "Chúng tôi đã dọn hết quần áo cũ của mình."
                        },
                        {
                            "en": "I found the letters when I was clearing out after my father died.",
                            "vi": "Tôi đã tìm thấy những lá thư khi tôi đang dọn dẹp sau khi cha tôi qua đời."
                        }
                    ]
                }
            ]
        }
