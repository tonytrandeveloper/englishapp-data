    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a hard black hat with a curved brim and round top, worn, for example, in the past by men in business in England",
                        "vi": "Ví dụ, một chiếc mũ đen cứng có vành cong và đỉnh tròn, được những người đàn ông kinh doanh ở Anh đội trước đây"
                    },
                    "examples": []
                },
                {
                    "define": {
                        "en": "a sports competition between teams from the same area or town",
                        "vi": "một cuộc thi thể thao giữa các đội từ cùng một khu vực hoặc thị trấn"
                    },
                    "examples": [
                        {
                            "en": "a local derby between the two North London sides",
                            "vi": "một trận derby địa phương giữa hai bên Bắc Luân Đôn"
                        },
                        {
                            "en": "a derby match",
                            "vi": "một trận derby"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a race or sports competition",
                        "vi": "một cuộc đua hoặc cuộc thi thể thao"
                    },
                    "examples": [
                        {
                            "en": "a motorcycle derby",
                            "vi": "một trận derby xe máy"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used in the name of several horse races that happen every year",
                        "vi": "được sử dụng trong tên của một số cuộc đua ngựa diễn ra hàng năm"
                    },
                    "examples": [
                        {
                            "en": "the Epsom Derby",
                            "vi": "trận Derby Epsom"
                        },
                        {
                            "en": "the Kentucky Derby",
                            "vi": "trận Derby Kentucky"
                        }
                    ]
                }
            ]
