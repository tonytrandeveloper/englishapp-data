                        "vi": "buộc hoặc đánh bật thứ gì đó ra khỏi vị trí của nó"
                    },
                    "examples": [
                        {
                            "en": "The wind dislodged one or two tiles from the roof.",
                            "vi": "Gió làm bật tung một hoặc hai viên ngói khỏi mái nhà."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to force somebody to leave a place, position or job",
                        "vi": "buộc ai đó rời khỏi một vị trí, chức vụ hoặc công việc"
                    },
                    "examples": [
                        {
                            "en": "The rebels have so far failed to dislodge the President.",
                            "vi": "Các phiến quân cho đến nay vẫn không thể lật đổ Tổng thống."
                        }
                    ]
                }
