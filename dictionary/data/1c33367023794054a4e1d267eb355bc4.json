{
    "id": "1c33367023794054a4e1d267eb355bc4",
    "word": "shrill",
    "phonetic": {
        "uk": "/ʃrɪl/",
        "us": "/ʃrɪl/"
    },
    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to make an unpleasant high loud sound",
                        "vi": "tạo ra âm thanh lớn khó chịu"
                    },
                    "examples": [
                        {
                            "en": "Behind him, the telephone shrilled.",
                            "vi": "Sau lưng anh, điện thoại chói tai."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to say something in a loud, high voice",
                        "vi": "nói điều gì đó với giọng lớn và cao"
                    },
                    "examples": [
                        {
                            "en": "‘Wait for me!’ she shrilled.",
                            "vi": "'Chờ tôi!' cô ấy thét lên."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "very high and loud, in an unpleasant way",
                        "vi": "rất cao và lớn, theo một cách khó chịu"
                    },
                    "examples": [
                        {
                            "en": "The PE teacher’s shrill voice rang out across the school fields.",
                            "vi": "Giọng nói lanh lảnh của cô giáo Thể dục vang lên khắp sân trường."
                        },
                        {
                            "en": "The shrill cries of children broke the silence.",
                            "vi": "Tiếng khóc thét chói tai của lũ trẻ phá tan bầu không khí im lặng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "loud and determined but often unreasonable",
                        "vi": "lớn tiếng và kiên quyết nhưng thường không hợp lý"
                    },
                    "examples": [
                        {
                            "en": "shrill demands/protests",
                            "vi": "yêu cầu / phản đối chói tai"
                        }
                    ]
                }
            ]
        }
    ],
