                        },
                        {
                            "en": "What a dreadful thing to say!",
                            "vi": "Thật là một điều đáng sợ để nói!"
                        },
                        {
                            "en": "It's dreadful the way they treat their staff.",
                            "vi": "Thật kinh khủng khi họ đối xử với nhân viên của mình."
                        },
                        {
                            "en": "How dreadful!",
                            "vi": "Thật oái oăm!"
                        },
                        {
                            "en": "Jane looked dreadful (= looked ill or tired).",
                            "vi": "Jane trông thật đáng sợ (= trông ốm yếu hoặc mệt mỏi)."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to emphasize how bad something is",
                        "vi": "được sử dụng để nhấn mạnh điều gì đó tồi tệ như thế nào"
                    },
                    "examples": [
                        {
                            "en": "He’s a dreadful snob.",
                            "vi": "Anh ta là một kẻ hợm hĩnh đáng sợ."
                        },
                        {
                            "en": "She's making a dreadful mess of things.",
                            "vi": "Cô ấy đang tạo ra một mớ hỗn độn khủng khiếp."
                        },
                        {
                            "en": "I'm afraid there's been a dreadful mistake.",
                            "vi": "Tôi e rằng đã có một sai lầm khủng khiếp."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "causing fear, pain or difficulty",
                        "vi": "gây ra sợ hãi, đau đớn hoặc khó khăn"
