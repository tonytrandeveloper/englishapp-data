            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "determined not to change your opinion or attitude",
                        "vi": "quyết tâm không thay đổi quan điểm hoặc thái độ của bạn"
                    },
                    "examples": [
                        {
                            "en": "He was too stubborn to admit that he was wrong.",
                            "vi": "Anh đã quá cứng đầu để thừa nhận rằng mình đã sai."
                        },
                        {
                            "en": "She can be as stubborn as a mule (= extremely stubborn).",
                            "vi": "Cô ấy có thể cứng đầu như một con la (= cực kỳ cứng đầu)."
                        },
                        {
                            "en": "stubborn pride",
                            "vi": "niềm kiêu hãnh bướng bỉnh"
                        },
                        {
                            "en": "a stubborn resistance to change",
                            "vi": "một sự phản kháng ngoan cố để thay đổi"
                        },
                        {
                            "en": "a stubborn refusal to listen",
                            "vi": "một sự ngoan cố không chịu lắng nghe"
                        },
                        {
                            "en": "She has inherited her mother’s stubborn streak.",
                            "vi": "Cô ấy đã thừa hưởng tính cách bướng bỉnh của mẹ mình."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "difficult to get rid of or deal with",
                        "vi": "khó thoát khỏi hoặc đối phó với"
                    },
                    "examples": [
                        {
                            "en": "a stubborn cough/stain",
                            "vi": "một vết ho / vết bẩn cứng đầu"
                        },
                        {
                            "en": "a stubborn problem",
                            "vi": "một vấn đề khó khăn"
                        }
                    ]
                }
            ]
