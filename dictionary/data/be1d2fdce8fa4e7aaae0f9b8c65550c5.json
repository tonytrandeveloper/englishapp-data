                        "vi": "để chọn ai đó / cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "They've fixed on Paris for their honeymoon.",
                            "vi": "Họ đã cố định ở Paris cho tuần trăng mật của họ."
                        },
                        {
                            "en": "Have you fixed on a date for the meeting?",
                            "vi": "Bạn đã ấn định ngày họp chưa?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to look at or think about somebody/something with great attention",
                        "vi": "nhìn hoặc nghĩ về ai đó / điều gì đó với sự chú ý lớn"
                    },
                    "examples": [
                        {
                            "en": "Her gaze fixed on Jess.",
                            "vi": "Ánh mắt cô ấy nhìn chằm chằm vào Jess."
                        },
                        {
                            "en": "She fixed her gaze on Jess.",
                            "vi": "Cô nhìn chằm chằm vào Jess."
                        }
                    ]
                }
