                    "define": {
                        "en": "to gradually pass into a worse or less active state or condition",
                        "vi": "dần dần chuyển sang trạng thái hoặc tình trạng tồi tệ hơn hoặc kém hoạt động hơn"
                    },
                    "examples": [
                        {
                            "en": "to lapse into unconsciousness/a coma",
                            "vi": "rơi vào trạng thái bất tỉnh / hôn mê"
                        },
                        {
                            "en": "She lapsed into silence again.",
                            "vi": "Cô lại chìm vào im lặng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to start speaking or behaving in a different way, often one that is less acceptable",
                        "vi": "bắt đầu nói hoặc cư xử theo một cách khác, thường là một cách ít được chấp nhận"
                    },
                    "examples": [
                        {
                            "en": "He soon lapsed back into his old ways.",
                            "vi": "Anh ấy sớm quay trở lại con đường cũ của mình."
                        }
                    ]
                }
