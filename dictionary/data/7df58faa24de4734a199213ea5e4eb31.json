            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "if two things are confusable, it is easy to confuse them",
                        "vi": "nếu hai thứ có thể nhầm lẫn, rất dễ nhầm lẫn giữa chúng"
                    },
                    "examples": [
                        {
                            "en": "‘Historic’ and ‘historical’ are easily confusable.",
                            "vi": "'Lịch sử' và 'lịch sử' rất dễ bị nhầm lẫn."
                        },
                        {
                            "en": "The various types of owl are easily confusable with one another.",
                            "vi": "Các loại cú khác nhau rất dễ nhầm lẫn với nhau."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "two or more words or ideas that can easily be confused",
                        "vi": "hai hoặc nhiều từ hoặc ý tưởng có thể dễ bị nhầm lẫn"
                    },
                    "examples": [
                        {
                            "en": "confusables such as ‘principle’ and ‘principal’",
                            "vi": "khó hiểu chẳng hạn như 'nguyên tắc' và 'nguyên tắc'"
                        }
                    ]
                }
            ]
        }
