                        "vi": "một loại súng lớn, hạng nặng cũ, thường có bánh xe, bắn ra kim loại rắn hoặc bi đá"
                    },
                    "examples": [
                        {
                            "en": "Three cannon opened fire.",
                            "vi": "Ba phát đại bác nổ súng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a gun that fires many shots from an aircraft or tank",
                        "vi": "một khẩu súng bắn nhiều phát từ máy bay hoặc xe tăng"
                    },
                    "examples": [
                        {
                            "en": "a burst of cannon fire",
                            "vi": "một loạt pháo"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
