            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "containing information and details that strongly suggest that something is true but do not prove it",
                        "vi": "chứa thông tin và chi tiết gợi ý mạnh mẽ rằng điều gì đó là đúng nhưng không chứng minh được điều đó"
                    },
                    "examples": [
                        {
                            "en": "circumstantial evidence",
                            "vi": "bằng chứng hoàn cảnh"
                        },
                        {
                            "en": "The case against him was largely circumstantial.",
                            "vi": "Trường hợp chống lại anh ta phần lớn là tình huống."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "connected with particular circumstances",
                        "vi": "kết nối với các hoàn cảnh cụ thể"
                    },
                    "examples": [
                        {
                            "en": "Their problems were circumstantial rather than personal.",
                            "vi": "Vấn đề của họ là hoàn cảnh thay vì cá nhân."
                        }
                    ]
                }
            ]
        }
