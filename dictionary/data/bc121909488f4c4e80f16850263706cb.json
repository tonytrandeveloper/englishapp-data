{
    "id": "bc121909488f4c4e80f16850263706cb",
    "word": "repellent",
    "phonetic": {
        "uk": "/rɪˈpelənt/",
        "us": "/rɪˈpelənt/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a substance that is used for keeping insects away from you",
                        "vi": "một chất được sử dụng để ngăn côn trùng tránh xa bạn"
                    },
                    "examples": [
                        {
                            "en": "(an) insect repellent",
                            "vi": "(an) thuốc chống côn trùng"
                        },
                        {
                            "en": "mosquito repellent",
                            "vi": "thuốc đuổi muỗi"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a substance that is used on cloth, stone, etc. to prevent water from passing through it",
                        "vi": "một chất được sử dụng trên vải, đá, v.v. để ngăn nước đi qua nó"
                    },
                    "examples": [
                        {
                            "en": "(a) water repellent",
                            "vi": "(a) thấm nước"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "very unpleasant; causing strong dislike",
                        "vi": "rất khó chịu; gây phản cảm mạnh mẽ"
                    },
                    "examples": [
                        {
                            "en": "I found the pictures repellent.",
                            "vi": "Tôi tìm thấy những bức tranh hấp dẫn."
                        },
                        {
                            "en": "Their political ideas are repellent to most people.",
                            "vi": "Những ý tưởng chính trị của họ không được lòng hầu hết mọi người."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not letting a particular substance, especially water, pass through it",
                        "vi": "không để một chất cụ thể, đặc biệt là nước, đi qua nó"
                    },
                    "examples": [
                        {
                            "en": "water-repellent cloth",
                            "vi": "vải thấm nước"
                        },
                        {
                            "en": "mutually repellent substances such as oil and water",
                            "vi": "các chất chống thấm lẫn nhau như dầu và nước"
                        }
                    ]
                }
            ]
        }
    ],
