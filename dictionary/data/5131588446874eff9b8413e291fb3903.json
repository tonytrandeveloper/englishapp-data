    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "looking like fire; consisting of fire",
                        "vi": "trông giống như lửa; bao gồm lửa"
                    },
                    "examples": [
                        {
                            "en": "fiery red hair",
                            "vi": "tóc đỏ rực"
                        },
                        {
                            "en": "The sun was now sinking, a fiery ball of light in the west.",
                            "vi": "Mặt trời lúc này đã lặn, một quả cầu ánh sáng rực lửa ở phía tây."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "quickly or easily becoming angry",
                        "vi": "nhanh chóng hoặc dễ dàng trở nên tức giận"
                    },
                    "examples": [
                        {
                            "en": "She has a fiery temper.",
                            "vi": "Cô ấy có một tính khí bốc lửa."
                        },
                        {
                            "en": "a fiery young man",
                            "vi": "một thanh niên bốc lửa"
                        },
                        {
                            "en": "He’s a big strong lad with a fiery temper.",
                            "vi": "Anh ấy là một chàng trai to khỏe với tính khí nóng nảy."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "showing strong emotions, especially anger",
                        "vi": "thể hiện cảm xúc mạnh mẽ, đặc biệt là tức giận"
                    },
                    "examples": [
                        {
                            "en": "a fiery look",
                            "vi": "một cái nhìn bốc lửa"
                        },
                        {
                            "en": "a fiery and heated meeting",
                            "vi": "một cuộc họp nảy lửa và nóng bỏng"
                        },
                        {
                            "en": "He delivered the sermon with fiery passion.",
                            "vi": "Ông đã thuyết pháp với niềm đam mê rực lửa."
                        },
                        {
                            "en": "John Wesley preached his fiery sermons to large crowds.",
                            "vi": "John Wesley đã thuyết giảng những bài giảng rực lửa của mình cho những đám đông lớn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "causing a part of your body to feel as if it is burning",
                        "vi": "khiến một phần của cơ thể bạn cảm thấy như thể nó đang bị đốt cháy"
                    },
                    "examples": [
                        {
                            "en": "a fiery Mexican dish",
                            "vi": "một món ăn Mexico bốc lửa"
                        },
                        {
                            "en": "The fiery liquor burnt its way down her throat.",
                            "vi": "Rượu bốc cháy ngùn ngụt xuống cổ họng cô."
