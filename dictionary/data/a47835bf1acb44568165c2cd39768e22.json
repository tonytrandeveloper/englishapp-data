{
    "id": "a47835bf1acb44568165c2cd39768e22",
    "word": "tint",
    "phonetic": {
        "uk": "/tɪnt/",
        "us": "/tɪnt/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a shade or small amount of a particular colour; a small amount of colour covering a surface",
                        "vi": "một bóng râm hoặc một lượng nhỏ của một màu cụ thể; một lượng nhỏ màu phủ trên bề mặt"
                    },
                    "examples": [
                        {
                            "en": "leaves with red and gold autumn tints",
                            "vi": "lá màu đỏ và vàng mùa thu"
                        },
                        {
                            "en": "the brownish tint of an old photo",
                            "vi": "màu nâu của một bức ảnh cũ"
                        },
                        {
                            "en": "The fabrics were mainly in rich autumn tints, reds and oranges.",
                            "vi": "Các loại vải chủ yếu có sắc thái mùa thu phong phú, đỏ và cam."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "an artificial colour used to change the colour of your hair; the act of colouring the hair with a tint",
                        "vi": "một màu nhân tạo được sử dụng để thay đổi màu tóc của bạn; hành động nhuộm tóc với một màu"
                    },
                    "examples": [
                        {
                            "en": "a blond tint",
                            "vi": "một màu vàng"
                        },
                        {
                            "en": "to have a tint",
                            "vi": "để có một màu"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to add a small amount of colour to something",
                        "vi": "để thêm một lượng nhỏ màu sắc vào thứ gì đó"
                    },
                    "examples": [
                        {
                            "en": "She’s having her eyelashes tinted.",
                            "vi": "Cô ấy đang nhuộm lông mi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to change the colour of somebody’s hair with a tint",
                        "vi": "thay đổi màu tóc của ai đó bằng một màu"
                    },
                    "examples": [
                        {
                            "en": "Have you tinted your hair?",
                            "vi": "Bạn đã nhuộm tóc chưa?"
                        }
                    ]
                }
            ]
        }
    ],
