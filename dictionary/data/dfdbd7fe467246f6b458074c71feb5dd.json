                            "vi": "sự thiếu hụt các nguồn lực của chúng tôi"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a state of not being able or confident to deal with a situation",
                        "vi": "trạng thái không thể hoặc không tự tin để đối phó với một tình huống"
                    },
                    "examples": [
                        {
