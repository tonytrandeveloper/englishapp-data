                            "vi": "một cảm giác / cảm giác thiếu sót"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a weakness; a lack of something",
                        "vi": "một điểm yếu; thiếu một cái gì đó"
                    },
                    "examples": [
