            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to be forced to stay somewhere or suffer something unpleasant for a long time",
                        "vi": "buộc phải ở lại một nơi nào đó hoặc phải chịu đựng điều gì đó khó chịu trong một thời gian dài"
                    },
                    "examples": [
                        {
                            "en": "She continues to languish in a foreign prison.",
                            "vi": "Cô tiếp tục sống mòn mỏi trong một nhà tù nước ngoài."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to become weaker or fail to make progress",
                        "vi": "trở nên yếu hơn hoặc không đạt được tiến bộ"
                    },
                    "examples": [
                        {
                            "en": "The share price languished at 102p.",
                            "vi": "Giá cổ phiếu giảm ở mức 102p."
                        }
                    ]
                }
            ]
        }
