            "means": [
                {
                    "define": {
                        "en": "to treat something as if it is not important",
                        "vi": "đối xử với một cái gì đó như thể nó không quan trọng"
                    },
                    "examples": [
                        {
                            "en": "Shrugging off her injury, she played on.",
                            "vi": "Cô ấy sẽ tiếp tục chấn thương để gỡ bỏ vết thương."
                        },
                        {
                            "en": "He shrugged aside suggestions that he resign.",
                            "vi": "Anh ta gạt những lời đề nghị rằng anh ta từ chức sang một bên."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to push somebody/something back or away with your shoulders",
                        "vi": "đẩy ai đó / vật gì đó lùi lại hoặc ra xa bằng vai của bạn"
                    },
                    "examples": [
                        {
                            "en": "Kevin shrugged off his jacket.",
                            "vi": "Kevin cởi áo khoác."
                        },
                        {
                            "en": "She shrugged him away angrily.",
                            "vi": "Cô giận dữ hất anh ra."
                        }
                    ]
                }
            ]
