    "word": "infinity",
    "phonetic": {
        "uk": "/ɪnˈfɪnəti/",
        "us": "/ɪnˈfɪnəti/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the state of having no end or limit",
                        "vi": "trạng thái không có kết thúc hoặc giới hạn"
                    },
                    "examples": [
                        {
                            "en": "the infinity/infinities of space",
                            "vi": "sự vô cùng / vô tận của không gian"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a point far away that can never be reached",
                        "vi": "một điểm xa mà không bao giờ có thể đạt được"
                    },
                    "examples": [
                        {
                            "en": "The landscape seemed to stretch into infinity.",
                            "vi": "Cảnh vật như trải dài đến vô tận."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a number larger than any other",
                        "vi": "một con số lớn hơn bất kỳ con số nào khác"
                    },
                    "examples": [
                        {
                            "en": "The number tends towards infinity.",
                            "vi": "Con số có xu hướng tiến tới vô cùng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a large amount that is impossible to count",
                        "vi": "một số lượng lớn không thể đếm được"
                    },
                    "examples": [
                        {
                            "en": "an infinity of stars",
                            "vi": "vô số các ngôi sao"
                        }
                    ]
                }
            ]
        }
