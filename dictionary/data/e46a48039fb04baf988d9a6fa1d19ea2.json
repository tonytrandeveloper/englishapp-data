                {
                    "define": {
                        "en": "an infectious disease can be passed easily from one person to another, especially through air or water",
                        "vi": "một bệnh truyền nhiễm có thể dễ dàng truyền từ người này sang người khác, đặc biệt là qua không khí hoặc nước"
                    },
                    "examples": [
                        {
                            "en": "Flu is highly infectious.",
                            "vi": "Cảm cúm có khả năng lây nhiễm cao."
                        },
                        {
                            "en": "(figurative) infectious laughter",
                            "vi": "(nghĩa bóng) tiếng cười truyền nhiễm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "if a person or an animal is infectious, they have a disease that can be spread to others",
                        "vi": "Nếu một người hoặc một động vật có khả năng lây nhiễm, họ có một căn bệnh có thể lây lan cho những người khác"
                    },
                    "examples": [
                        {
                            "en": "I'm still infectious.",
                            "vi": "Tôi vẫn còn lây nhiễm."
                        }
                    ]
                }
            ]
