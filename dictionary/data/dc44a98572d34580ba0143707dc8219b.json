    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not involving or causing argument or violence",
                        "vi": "không liên quan hoặc gây ra tranh cãi hoặc bạo lực"
                    },
                    "examples": [
                        {
                            "en": "A peaceable settlement has been reached.",
                            "vi": "Một giải quyết hòa bình đã đạt được."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not liking to argue; wishing to live in peace with others",
                        "vi": "không thích tranh luận; mong muốn được sống trong hòa bình với những người khác"
                    },
                    "examples": [
                        {
                            "en": "a peaceable character",
                            "vi": "một nhân vật hòa bình"
                        },
                        {
                            "en": "I like to think of myself as a peaceable man.",
                            "vi": "Tôi thích nghĩ về mình như một người đàn ông hòa bình."
                        },
                        {
                            "en": "They sat in peaceable silence. (= they were not arguing).",
                            "vi": "Họ ngồi trong im lặng yên bình. (= họ đã không tranh cãi)."
                        }
                    ]
                }
            ]
        }
