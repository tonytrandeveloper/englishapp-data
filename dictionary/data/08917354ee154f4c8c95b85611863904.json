    "word": "parasite",
    "phonetic": {
        "uk": "/ˈpærəsaɪt/",
        "us": "/ˈpærəsaɪt/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a small animal or plant that lives on or inside another animal or plant and gets its food from it",
                        "vi": "một động vật hoặc thực vật nhỏ sống trên hoặc bên trong động vật hoặc thực vật khác và lấy thức ăn từ chúng"
                    },
                    "examples": [
                        {
                            "en": "fleas, lice and other parasites",
                            "vi": "bọ chét, chấy rận và các ký sinh trùng khác"
                        },
                        {
                            "en": "an intestinal parasite of cattle",
                            "vi": "ký sinh trùng đường ruột của gia súc"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a person who always relies on or benefits from other people and gives nothing back",
                        "vi": "một người luôn dựa vào hoặc hưởng lợi từ người khác và không cho lại gì"
                    },
                    "examples": [
                        {
                            "en": "He regards students as parasites on society.",
                            "vi": "Anh coi học sinh như những kẻ ăn bám trên xã hội."
                        }
                    ]
                }
            ]
        }
