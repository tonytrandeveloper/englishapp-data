    "blocks": [
        {
            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a way that is very definite and will not be changed",
                        "vi": "theo một cách rất chắc chắn và sẽ không bị thay đổi"
                    },
                    "examples": [
                        {
                            "en": "to flatly deny/reject/oppose something",
                            "vi": "thẳng thừng từ chối / bác bỏ / phản đối điều gì đó"
                        },
                        {
                            "en": "I flatly refused to spend any more time helping him.",
                            "vi": "Tôi thẳng thừng từ chối dành thêm thời gian giúp đỡ anh ta."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that shows very little interest or emotion",
                        "vi": "theo cách thể hiện rất ít sự quan tâm hoặc cảm xúc"
                    },
                    "examples": [
                        {
                            "en": "‘Oh, it's you,’ she said flatly.",
                            "vi": "\"Ồ, là bạn,\" cô ấy nói thẳng thừng."
                        }
                    ]
                }
            ]
        }
