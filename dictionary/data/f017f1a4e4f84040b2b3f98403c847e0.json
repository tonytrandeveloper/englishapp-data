{
    "id": "f017f1a4e4f84040b2b3f98403c847e0",
    "word": "bin",
    "phonetic": {
        "uk": "/bɪn/",
        "us": "/bɪn/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a container that you put waste in",
                        "vi": "một thùng chứa mà bạn bỏ chất thải vào"
                    },
                    "examples": [
                        {
                            "en": "a rubbish bin",
                            "vi": "cái thùng đựng rác"
                        },
                        {
                            "en": "Grey bins will be emptied weekly.",
                            "vi": "Các thùng màu xám sẽ được làm trống hàng tuần."
                        },
                        {
                            "en": "Many councils now have fortnightly bin collections.",
                            "vi": "Nhiều hội đồng hiện có các bộ sưu tập thùng hai tuần một lần."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a large container, usually with a lid (= cover), for storing things in",
                        "vi": "một hộp đựng lớn, thường có nắp (= cover), để đựng những thứ trong"
                    },
                    "examples": [
                        {
                            "en": "a bread bin",
                            "vi": "một thùng bánh mì"
                        },
                        {
                            "en": "All their toys are kept in plastic storage bins under the bed.",
                            "vi": "Tất cả đồ chơi của chúng đều được đựng trong các thùng nhựa đựng đồ dưới gầm giường."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to throw something away",
                        "vi": "vứt thứ gì đó đi"
                    },
                    "examples": [
                        {
                            "en": "Do you need to keep these letters or shall we bin them?",
                            "vi": "Bạn có cần giữ những bức thư này hay chúng ta sẽ bỏ chúng đi?"
                        },
                        {
                            "en": "Sorry—I’ve already binned it.",
                            "vi": "Xin lỗi — tôi đã chuyển nó rồi."
                        }
                    ]
                }
            ]
        }
    ],
