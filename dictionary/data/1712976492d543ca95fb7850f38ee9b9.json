{
    "id": "1712976492d543ca95fb7850f38ee9b9",
    "word": "unequal",
    "phonetic": {
        "uk": "/ʌnˈiːkwəl/",
        "us": "/ʌnˈiːkwəl/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "in which people are treated in different ways or have different advantages in a way that seems unfair",
                        "vi": "trong đó mọi người bị đối xử theo những cách khác nhau hoặc có những lợi thế khác nhau theo cách có vẻ không công bằng"
                    },
                    "examples": [
                        {
                            "en": "an unequal distribution of wealth",
                            "vi": "sự phân bổ của cải không công bằng"
                        },
                        {
                            "en": "an unequal contest",
                            "vi": "một cuộc thi không bình đẳng"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "different in size, amount, etc.",
                        "vi": "khác nhau về kích thước, số lượng, v.v."
                    },
                    "examples": [
                        {
                            "en": "The sleeves are unequal in length.",
                            "vi": "Các tay áo có chiều dài không bằng nhau."
                        },
                        {
                            "en": "The rooms upstairs are of unequal size.",
                            "vi": "Các phòng trên lầu có kích thước không bằng nhau."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not capable of doing something",
                        "vi": "không có khả năng làm điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "She felt unequal to the task she had set herself.",
                            "vi": "Cô cảm thấy bất bình đẳng với nhiệm vụ mà bản thân đã đặt ra."
                        }
                    ]
                }
            ]
        }
    ],
