    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "confident in yourself and your abilities",
                        "vi": "tự tin vào bản thân và khả năng của bạn"
                    },
                    "examples": [
                        {
                            "en": "He spoke in a calm, assured voice.",
                            "vi": "Anh ta nói với một giọng bình tĩnh và chắc chắn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "certain to happen",
                        "vi": "nhất định để xảy ra"
                    },
                    "examples": [
                        {
                            "en": "Success seemed assured.",
                            "vi": "Thành công dường như được đảm bảo."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "certain to get something",
                        "vi": "nhất định để có được một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "You are assured of a warm welcome at this hotel.",
                            "vi": "Bạn hoàn toàn có thể yên tâm về sự chào đón nồng nhiệt tại khách sạn này."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to emphasize that what you say is true or will definitely happen",
                        "vi": "được sử dụng để nhấn mạnh rằng những gì bạn nói là đúng hoặc chắc chắn sẽ xảy ra"
                    },
                    "examples": [
                        {
                            "en": "You may rest assured that we will do all we can to find him.",
                            "vi": "Bạn có thể yên tâm rằng chúng tôi sẽ làm tất cả những gì có thể để tìm thấy anh ấy."
                        }
                    ]
                }
