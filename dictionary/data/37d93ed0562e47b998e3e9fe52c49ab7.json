            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not friendly or pleasant to be with",
                        "vi": "không thân thiện hoặc dễ chịu khi ở cùng"
                    },
                    "examples": [
                        {
                            "en": "uncongenial company",
                            "vi": "công ty không thể phủ nhận"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not pleasant; not making you feel relaxed; not suitable for your personality",
                        "vi": "không vừa ý; không làm cho bạn cảm thấy thư thái; không phù hợp với tính cách của bạn"
                    },
                    "examples": [
                        {
                            "en": "an uncongenial atmosphere",
                            "vi": "một bầu không khí không thể phủ nhận"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not suitable for something; not encouraging something",
                        "vi": "không phù hợp với một cái gì đó; không khuyến khích điều gì đó"
                    },
                    "examples": [
                        {
                            "en": "The religious climate at the time was uncongenial to new ideas.",
                            "vi": "Bầu không khí tôn giáo vào thời điểm đó không thể phủ nhận những ý tưởng mới."
                        }
                    ]
                }
