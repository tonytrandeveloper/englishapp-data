    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a person who does work that needs a special skill, making things with their hands",
                        "vi": "một người làm công việc cần một kỹ năng đặc biệt, làm mọi thứ bằng tay của họ"
                    },
                    "examples": [
                        {
                            "en": "The hand-woven textiles were made by skilled local artisans.",
                            "vi": "Các loại vải dệt bằng tay được thực hiện bởi các nghệ nhân lành nghề của địa phương."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "relating to an artisan, or typical of an artisan's work",
                        "vi": "liên quan đến một nghệ nhân, hoặc tiêu biểu cho công việc của một nghệ nhân"
                    },
                    "examples": [
                        {
                            "en": "an artisan bakery",
                            "vi": "một tiệm bánh thủ công"
                        },
                        {
                            "en": "artisanal skills",
                            "vi": "kỹ năng thủ công"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "(of food and drink) made in a traditional way with high-quality ingredients",
                        "vi": "(thực phẩm và đồ uống) được làm theo cách truyền thống với các nguyên liệu chất lượng cao"
                    },
                    "examples": [
                        {
                            "en": "artisan bread",
                            "vi": "bánh mì thủ công"
                        }
                    ]
                }
            ]
        }
    ],
