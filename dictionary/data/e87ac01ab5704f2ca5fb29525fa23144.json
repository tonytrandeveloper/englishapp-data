    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a flower (usually one on a plant that people admire for its flowers)",
                        "vi": "một bông hoa (thường là một bông hoa trên cây mà mọi người ngưỡng mộ vì những bông hoa của nó)"
                    },
                    "examples": [
                        {
                            "en": "the exotic blooms of the orchid",
                            "vi": "sự nở hoa kỳ lạ của phong lan"
                        },
                        {
                            "en": "The plant produced a single white bloom.",
                            "vi": "Cây ra hoa đơn màu trắng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a healthy fresh appearance",
                        "vi": "một vẻ ngoài tươi mới khỏe mạnh"
                    },
                    "examples": [
                        {
                            "en": "the bloom in her cheeks",
                            "vi": "má cô ấy nở"
                        },
                        {
                            "en": "the bloom of youth",
                            "vi": "sự nở rộ của tuổi trẻ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with the flowers fully open",
                        "vi": "với những bông hoa mở hoàn toàn"
                    },
                    "examples": [
                        {
                            "en": "The roses were in full bloom.",
                            "vi": "Những bông hồng đã nở rộ."
                        },
                        {
                            "en": "He loved watching the garden come into bloom.",
                            "vi": "Anh thích ngắm nhìn khu vườn nở hoa."
                        },
                        {
                            "en": "daffodils in bloom",
                            "vi": "hoa thủy tiên vàng nở"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to produce flowers",
                        "vi": "để sản xuất hoa"
                    },
                    "examples": [
                        {
                            "en": "Most roses will begin to bloom from late May.",
                            "vi": "Hầu hết hoa hồng sẽ bắt đầu nở từ cuối tháng Năm."
                        },
                        {
                            "en": "Tulips were blooming as far as the eye could see.",
                            "vi": "Những bông hoa tulip đã nở ra xa như những gì mắt thường có thể nhìn thấy."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to become healthy, happy or confident",
                        "vi": "trở nên khỏe mạnh, hạnh phúc hoặc tự tin"
                    },
                    "examples": [
                        {
                            "en": "The children had bloomed during their stay on the farm.",
                            "vi": "Những đứa trẻ đã nở rộ trong thời gian ở trang trại."
                        },
                        {
                            "en": "She was blooming with good health.",
                            "vi": "Cô ấy đã nở rộ với một sức khỏe tốt."
                        }
                    ]
                }
            ]
        }
