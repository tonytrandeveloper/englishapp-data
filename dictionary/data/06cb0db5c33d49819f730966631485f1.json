                            "vi": "sương mù dày đặc / khói / khói"
                        },
                        {
                            "en": "The fog was getting very dense.",
                            "vi": "Sương mù ngày càng dày đặc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "stupid",
                        "vi": "dốt nát"
                    },
                    "examples": [
                        {
                            "en": "How can you be so dense?",
