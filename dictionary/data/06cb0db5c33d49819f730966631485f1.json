                            "vi": "một đám đông / rừng rậm rạp"
                        },
                        {
                            "en": "areas of dense population",
                            "vi": "khu vực đông dân cư"
                        },
                        {
                            "en": "The forest is quite dense at that point.",
                            "vi": "Khu rừng khá rậm rạp vào thời điểm đó."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "difficult to see through",
                        "vi": "khó nhìn thấu"
                    },
                    "examples": [
