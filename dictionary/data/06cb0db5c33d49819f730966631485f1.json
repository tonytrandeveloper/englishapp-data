                        },
                        {
                            "en": "John's all right, but he can be a bit dense sometimes.",
                            "vi": "John không sao, nhưng đôi khi anh ấy có thể hơi dày đặc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "difficult to understand because it contains a lot of information",
                        "vi": "khó hiểu vì nó chứa rất nhiều thông tin"
