    "blocks": [
        {
            "pos": "verb",
            "means": [
                {
                    "define": {
                        "en": "to throw something/somebody violently in a particular direction",
                        "vi": "ném một cái gì đó / ai đó một cách thô bạo theo một hướng cụ thể"
                    },
                    "examples": [
                        {
                            "en": "He hurled a brick through the window.",
                            "vi": "Anh ném một viên gạch qua cửa sổ."
                        },
                        {
                            "en": "Someone had hurled a grenade into the building.",
                            "vi": "Ai đó đã ném lựu đạn vào tòa nhà."
                        },
                        {
                            "en": "They hurled spears, screaming hideously.",
                            "vi": "Họ ném giáo, la hét một cách gớm ghiếc."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to shout offensive words, etc. at somebody",
                        "vi": "hét lên những lời xúc phạm, v.v. vào ai đó"
                    },
                    "examples": [
                        {
                            "en": "Rival fans hurled abuse at each other.",
                            "vi": "Những người hâm mộ đối thủ ném sự lạm dụng vào nhau."
                        }
                    ]
                },
                {
                    "define": {
