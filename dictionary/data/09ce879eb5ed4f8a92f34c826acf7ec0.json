{
    "id": "09ce879eb5ed4f8a92f34c826acf7ec0",
    "word": "uncertain",
    "phonetic": {
        "uk": "/ʌnˈsɜːtn/",
        "us": "/ʌnˈsɜːrtn/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "feeling doubt about something; not sure",
                        "vi": "cảm thấy nghi ngờ về điều gì đó; không chắc"
                    },
                    "examples": [
                        {
                            "en": "They're both uncertain about what to do.",
                            "vi": "Cả hai đều không chắc chắn về những gì phải làm."
                        },
                        {
                            "en": "I'm still uncertain of my feelings for him.",
                            "vi": "Tôi vẫn chưa chắc chắn về tình cảm của mình dành cho anh ấy."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "likely to change, especially in a negative or unpleasant way",
                        "vi": "có khả năng thay đổi, đặc biệt là theo cách tiêu cực hoặc khó chịu"
                    },
                    "examples": [
                        {
                            "en": "Our future looks uncertain.",
                            "vi": "Tương lai của chúng tôi có vẻ không chắc chắn."
                        },
                        {
                            "en": "a man of uncertain temper",
                            "vi": "một người đàn ông nóng nảy không chắc chắn"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not definite or decided",
                        "vi": "không xác định hoặc quyết định"
                    },
                    "examples": [
                        {
                            "en": "It is uncertain what his role in the company will be.",
                            "vi": "Không chắc chắn vai trò của anh ấy trong công ty sẽ như thế nào."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not confident",
                        "vi": "không chắc chắn"
                    },
                    "examples": [
                        {
                            "en": "The baby took its first uncertain steps.",
                            "vi": "Em bé bước những bước đầu tiên đầy bỡ ngỡ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "clearly and strongly",
                        "vi": "rõ ràng và mạnh mẽ"
                    },
                    "examples": [
                        {
                            "en": "I told him what I thought of him in no uncertain terms.",
                            "vi": "Tôi nói với anh ấy những gì tôi nghĩ về anh ấy mà không có điều kiện chắc chắn."
                        }
                    ]
                }
            ]
        }
    ],
