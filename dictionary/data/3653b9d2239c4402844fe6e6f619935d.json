    "blocks": [
        {
            "pos": "phrasal verb",
            "means": [
                {
                    "define": {
                        "en": "to reduce the power or importance of something; to reverse the progress made with something",
                        "vi": "để giảm sức mạnh hoặc tầm quan trọng của một cái gì đó; để đảo ngược tiến trình đã thực hiện với một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "Many of the gains made in the last 20 years have been rolled back.",
                            "vi": "Nhiều lợi nhuận đạt được trong 20 năm qua đã bị đảo ngược."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to push something further away",
                        "vi": "để đẩy một cái gì đó đi xa hơn"
                    },
                    "examples": [
                        {
                            "en": "(figurative) to roll back the frontiers of space",
                            "vi": "(nghĩa bóng) để quay trở lại biên giới của không gian"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to reduce prices, etc.",
                        "vi": "để giảm giá, v.v."
                    },
                    "examples": [
                        {
                            "en": "to roll back inflation",
                            "vi": "để đẩy lùi lạm phát"
                        }
                    ]
                }
            ]
        }
