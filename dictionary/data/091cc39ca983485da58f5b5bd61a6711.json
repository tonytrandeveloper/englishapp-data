            "means": [
                {
                    "define": {
                        "en": "in a way that is stupid or not sensible",
                        "vi": "theo cách ngu ngốc hoặc không hợp lý"
                    },
                    "examples": [
                        {
                            "en": "a crazily optimistic plan",
                            "vi": "một kế hoạch lạc quan điên rồ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "with a lot of enthusiasm and energy",
                        "vi": "với rất nhiều nhiệt huyết và năng lượng"
                    },
                    "examples": [
                        {
                            "en": "They danced crazily.",
                            "vi": "Họ nhảy múa điên cuồng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is untidy and confusing",
                        "vi": "theo một cách không rối rắm và khó hiểu"
                    },
                    "examples": [
                        {
                            "en": "crazily tangled wires",
                            "vi": "dây điện rối rắm"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "extremely; used to emphasize an adjective",
                        "vi": "cực kỳ; được sử dụng để nhấn mạnh một tính từ"
                    },
                    "examples": [
                        {
                            "en": "She's crazily talented.",
                            "vi": "Cô ấy tài năng một cách điên cuồng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that suggests somebody has a mental illness",
                        "vi": "theo một cách nào đó cho thấy ai đó bị bệnh tâm thần"
                    },
                    "examples": [
                        {
                            "en": "The actors have to scream crazily.",
                            "vi": "Các diễn viên phải hét lên một cách điên cuồng."
