            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "much loved; very attractive, special, etc.",
                        "vi": "yêu nhiều; rất hấp dẫn, đặc biệt, v.v."
                    },
                    "examples": [
                        {
                            "en": "My darling daughter.",
                            "vi": "Con gái yêu của mẹ."
                        },
                        {
                            "en": "‘Darling Henry,’ the letter began.",
                            "vi": "\"Henry yêu,\" bức thư bắt đầu."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "very pretty and pleasing",
                        "vi": "rất đẹp và dễ chịu"
                    },
                    "examples": [
                        {
                            "en": "What a darling little hat!",
                            "vi": "Đúng là một chiếc mũ nhỏ đáng yêu!"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a way of addressing somebody that you love",
                        "vi": "một cách xưng hô với ai đó mà bạn yêu quý"
                    },
                    "examples": [
                        {
                            "en": "What's the matter, darling?",
                            "vi": "Có chuyện gì vậy anh yêu?"
                        },
                        {
                            "en": "I love you too, my darling.",
                            "vi": "Anh cũng yêu em, em yêu."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a person who is very friendly and kind",
                        "vi": "một người rất thân thiện và tốt bụng"
                    },
                    "examples": [
                        {
                            "en": "You are a darling, Hugo.",
                            "vi": "Bạn là một người yêu dấu, Hugo."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a person who is especially liked and very popular",
                        "vi": "một người đặc biệt được yêu thích và rất nổi tiếng"
                    },
                    "examples": [
                        {
                            "en": "She is the darling of the newspapers and can do no wrong.",
                            "vi": "Cô ấy là con cưng của các tờ báo và không thể làm gì sai."
                        }
                    ]
                }
            ]
        }
