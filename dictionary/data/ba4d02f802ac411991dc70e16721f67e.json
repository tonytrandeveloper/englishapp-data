            "means": [
                {
                    "define": {
                        "en": "to make somebody unable to recognize where they are or where they should go",
                        "vi": "để làm cho ai đó không thể nhận ra họ đang ở đâu hoặc nơi họ nên đi"
                    },
                    "examples": [
                        {
                            "en": "The darkness had disoriented him.",
                            "vi": "Bóng tối đã làm anh mất phương hướng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to make somebody feel confused",
                        "vi": "làm cho ai đó cảm thấy bối rối"
                    },
                    "examples": [
                        {
                            "en": "Ex-soldiers can be disoriented by the transition to civilian life.",
                            "vi": "Những người lính cũ có thể bị mất phương hướng khi chuyển sang cuộc sống thường dân."
                        }
                    ]
                }
