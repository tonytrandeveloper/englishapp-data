{
    "id": "abc3b8dc34dc492da8f9ecce1f44a9d6",
    "word": "resistant",
    "phonetic": {
        "uk": "/rɪˈzɪstənt/",
        "us": "/rɪˈzɪstənt/"
    },
    "blocks": [
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "not affected by something; able to resist something",
                        "vi": "không bị ảnh hưởng bởi điều gì đó; có thể chống lại một cái gì đó"
                    },
                    "examples": [
                        {
                            "en": "plants that are resistant to disease",
                            "vi": "cây kháng bệnh"
                        },
                        {
                            "en": "Mosquitoes are becoming resistant to insecticides.",
                            "vi": "Muỗi đang trở nên kháng thuốc diệt côn trùng."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "opposing something and trying to stop it happening",
                        "vi": "phản đối điều gì đó và cố gắng ngăn chặn nó xảy ra"
                    },
                    "examples": [
                        {
                            "en": "Elderly people are not always resistant to change.",
                            "vi": "Người cao tuổi không phải lúc nào cũng có khả năng chống lại sự thay đổi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not damaged by the thing mentioned",
                        "vi": "không bị hư hỏng bởi điều được đề cập"
                    },
                    "examples": [
                        {
                            "en": "disease-resistant plants",
                            "vi": "cây kháng bệnh"
                        },
                        {
                            "en": "fire-resistant materials",
                            "vi": "vật liệu chống cháy"
                        }
                    ]
                }
            ]
        }
    ],
