            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "not in an even way; in a way that does not have an even, smooth pattern or shape",
                        "vi": "không theo một cách đồng đều; theo cách không có hoa văn hoặc hình dạng đều, mịn"
                    },
                    "examples": [
                        {
                            "en": "irregularly shaped",
                            "vi": "hình dạng bất thường"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not at times that are at an equal distance from each other; not regularly",
                        "vi": "không phải vào những thời điểm ở khoảng cách bằng nhau; không thường xuyên"
                    },
                    "examples": [
                        {
                            "en": "His heart started beating irregularly.",
                            "vi": "Tim anh bắt đầu đập bất thường."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "not according to the usual rules",
                        "vi": "không theo quy tắc thông thường"
                    },
                    "examples": [
                        {
                            "en": "people crossing the border irregularly",
                            "vi": "người vượt biên bất thường"
                        }
                    ]
                }
            ]
