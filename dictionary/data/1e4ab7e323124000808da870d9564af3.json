    "word": "desensitization",
    "phonetic": {
        "uk": "/diːˌsensətaɪˈzeɪʃn/",
        "us": "/diːˌsensətəˈzeɪʃn/"
    },
    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "the process or fact of becoming less aware of something as a problem by becoming used to it",
                        "vi": "quá trình hoặc thực tế của việc trở nên ít nhận thức về một cái gì đó như một vấn đề bằng cách trở nên quen thuộc với nó"
                    },
                    "examples": [
                        {
                            "en": "viewers' desensitization to on-screen violence",
                            "vi": "sự nhạy cảm của người xem với bạo lực trên màn ảnh"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "the process of treating somebody/something so that they will stop being sensitive to physical or chemical changes, or to a particular substance",
                        "vi": "Quá trình xử lý ai đó / điều gì đó để họ không còn nhạy cảm với những thay đổi vật lý hoặc hóa học, hoặc với một chất cụ thể"
                    },
                    "examples": [
                        {
                            "en": "allergy desensitization",
                            "vi": "giải mẫn cảm dị ứng"
                        }
                    ]
                }
            ]
        }
    ],
