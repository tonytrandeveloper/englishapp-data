    "blocks": [
        {
            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a substance that is able or likely to cause an explosion",
                        "vi": "một chất có thể hoặc có khả năng gây nổ"
                    },
                    "examples": [
                        {
                            "en": "plastic explosives",
                            "vi": "chất nổ dẻo"
                        },
                        {
                            "en": "The bomb was packed with several pounds of high explosive.",
                            "vi": "Quả bom được đóng gói với chất nổ cao vài pound."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "means": [
                {
                    "define": {
                        "en": "easily able or likely to explode",
                        "vi": "có thể dễ dàng hoặc có khả năng phát nổ"
                    },
                    "examples": [
                        {
                            "en": "an explosive device (= a bomb)",
                            "vi": "một thiết bị nổ (= bom)"
                        },
                        {
                            "en": "an explosive mixture of chemicals",
                            "vi": "một hỗn hợp hóa chất nổ"
                        },
                        {
                            "en": "Hydrogen is highly explosive.",
                            "vi": "Hydro rất dễ nổ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "likely to cause violence or strong feelings of anger or hate",
                        "vi": "có khả năng gây ra bạo lực hoặc cảm giác tức giận hoặc căm thù mạnh mẽ"
                    },
                    "examples": [
                        {
                            "en": "one of the most explosive issues of our time",
                            "vi": "một trong những vấn đề bùng nổ nhất của thời đại chúng ta"
                        },
                        {
                            "en": "The political situation is potentially explosive.",
                            "vi": "Tình hình chính trị tiềm ẩn nguy cơ bùng nổ."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "often having sudden violent or angry feelings",
                        "vi": "thường có cảm giác bạo lực hoặc tức giận đột ngột"
                    },
                    "examples": [
                        {
                            "en": "an explosive temper",
                            "vi": "một tính khí bùng nổ"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "increasing suddenly and rapidly",
                        "vi": "tăng đột ngột và nhanh chóng"
                    },
                    "examples": [
                        {
                            "en": "the explosive growth of the export market",
                            "vi": "sự phát triển bùng nổ của thị trường xuất khẩu"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "sudden and loud",
                        "vi": "đột ngột và ồn ào"
                    },
                    "examples": [
                        {
                            "en": "There was an explosive crash and then everything fell silent.",
                            "vi": "Có một vụ nổ va chạm và sau đó mọi thứ chìm trong im lặng."
