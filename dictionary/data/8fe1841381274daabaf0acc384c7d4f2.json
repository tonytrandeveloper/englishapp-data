            "pos": "adverb",
            "means": [
                {
                    "define": {
                        "en": "in a kind, polite and generous way, especially to somebody of a lower social position",
                        "vi": "một cách tử tế, lịch sự và hào phóng, đặc biệt là với những người có địa vị xã hội thấp hơn"
                    },
                    "examples": [
                        {
                            "en": "She graciously accepted our invitation.",
                            "vi": "Cô vui vẻ nhận lời mời của chúng tôi."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "in a way that is kind and shows mercy",
                        "vi": "theo cách tử tế và thể hiện lòng thương xót"
                    },
                    "examples": [
                        {
                            "en": "They offered praise for what God had graciously given them.",
                            "vi": "Họ ngợi khen những gì Đức Chúa Trời đã ban cho họ."
                        }
                    ]
                }
            ]
