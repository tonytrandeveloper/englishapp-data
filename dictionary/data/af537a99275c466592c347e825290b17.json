            "means": [
                {
                    "define": {
                        "en": "to reach somebody who is ahead by going faster",
                        "vi": "để tiếp cận ai đó đi trước bằng cách đi nhanh hơn"
                    },
                    "examples": [
                        {
                            "en": "Go on ahead. I'll catch up with you.",
                            "vi": "Đi về phía trước. Tôi sẽ bắt kịp với bạn."
                        },
                        {
                            "en": "I'll catch you up.",
                            "vi": "Tôi sẽ bắt kịp bạn."
                        }
                    ]
                },
                {
                    "define": {
                        "en": "to reach the same level or standard as somebody who was better or more advanced",
                        "vi": "để đạt được cùng một cấp độ hoặc tiêu chuẩn với một người tốt hơn hoặc cao cấp hơn"
                    },
                    "examples": [
                        {
                            "en": "After missing a term through illness, he had to work hard to catch up with the others.",
                            "vi": "Sau một kỳ nghỉ vì bệnh tật, anh phải cố gắng rất nhiều để bắt kịp với những người khác."
                        }
                    ]
                }
