                        }
                    ]
                },
                {
                    "define": {
                        "en": "not in agreement with something; not supporting an idea, aim, etc.",
                        "vi": "không đồng ý với một cái gì đó; không hỗ trợ một ý tưởng, mục đích, v.v."
                    },
                    "examples": [
                        {
                            "en": "The government was unsympathetic to the needs of the poor.",
                            "vi": "Chính phủ không thông cảm với nhu cầu của người nghèo."
