            "pos": "noun",
            "means": [
                {
                    "define": {
                        "en": "a piece of clothing made of very thin cloth that fits closely over the hips, legs and feet, usually worn under other clothes",
                        "vi": "một bộ quần áo làm bằng vải rất mỏng ôm sát vào hông, chân và bàn chân, thường được mặc dưới quần áo khác"
                    },
                    "examples": [
                        {
                            "en": "a pair of tights",
                            "vi": "một cặp quần bó"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "a piece of clothing similar to tights but made of thicker cloth, worn especially by dancers",
                        "vi": "một bộ quần áo tương tự như quần bó nhưng được làm bằng vải dày hơn, đặc biệt được mặc bởi các vũ công"
