                    },
                    "examples": [
                        {
                            "en": "It was a tempting offer.",
                            "vi": "Đó là một lời đề nghị hấp dẫn."
                        },
                        {
                            "en": "That cake looks very tempting.",
                            "vi": "Bánh trông rất hấp dẫn."
                        },
                        {
                            "en": "It's tempting to speculate about what might have happened.",
                            "vi": "Thật hấp dẫn để suy đoán về những gì có thể đã xảy ra."
                        },
                        {
                            "en": "A weekend in Rome? Mm, sounds tempting!",
                            "vi": "Một ngày cuối tuần ở Rome? Mm, nghe có vẻ hấp dẫn!"
                        }
                    ]
                }
            ]
