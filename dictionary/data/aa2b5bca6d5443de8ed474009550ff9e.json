                        },
                        {
                            "en": "Have you got a middle name?",
                            "vi": "Bạn đã có tên đệm chưa?"
                        }
                    ]
                },
                {
                    "define": {
                        "en": "used to say that somebody has a lot of a particular quality",
                        "vi": "thường nói rằng ai đó có rất nhiều phẩm chất cụ thể"
                    },
                    "examples": [
                        {
