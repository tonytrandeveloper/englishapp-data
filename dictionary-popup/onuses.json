            "meaning": [
                {
                    "en": "A difficult or unpleasant task, duty, etc.; burden.",
                    "vi": "Một nhiệm vụ, nhiệm vụ khó khăn hoặc khó chịu, v.v.; gánh nặng."
                },
                {
                    "en": "A difficult or disagreeable responsibility or necessity; a burden or obligation.",
                    "vi": "Một trách nhiệm hoặc sự cần thiết khó khăn hoặc bất đồng; một gánh nặng hoặc nghĩa vụ."
                },
                {
                    "en": "The burden of proof.",
                    "vi": "Nghĩa vụ chứng minh."
                },
                {
                    "en": "Responsibility for an error or fault; blame.",
                    "vi": "Trách nhiệm đối với một lỗi hoặc lỗi; khiển trách."
                },
                {
                    "en": "A legal obligation.",
                    "vi": "Một nghĩa vụ pháp lý."
                },
                {
                    "en": "(uncountable) Burden of proof, onus probandi.",
                    "vi": "(không thể đếm được) Gánh nặng của bằng chứng, sự cố chấp."
                },
                {
