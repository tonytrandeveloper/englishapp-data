    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "One that holds others spellbound, especially an enthralling speaker or a particularly interesting book.",
                    "vi": "Một cuốn sách khiến người khác say mê, đặc biệt là một diễn giả say mê hoặc một cuốn sách đặc biệt thú vị."
                },
                {
                    "en": "A speaker, esp. a politician, who can sway an audience with eloquence.",
                    "vi": "Một diễn giả, đặc biệt. một chính trị gia, người có thể khiến khán giả điêu đứng bằng tài hùng biện."
                },
                {
                    "en": "Something that is spellbinding, that causes rapt attention.",
                    "vi": "Một thứ gì đó có khả năng gây chú ý, gây ra sự chú ý."
                }
            ]
        }
    ],
    "meaning_vi": [
        "(thông tục) diễn giả hấp dẫn"
