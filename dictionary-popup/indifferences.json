            "meaning": [
                {
                    "en": "The quality, state, or fact of being indifferent.  Lack of concern, interest, or feeling; apathy. Lack of importance, meaning, or worth.",
                    "vi": "Chất lượng, trạng thái hoặc thực tế là không quan tâm. Thiếu sự quan tâm, quan tâm hoặc cảm giác; thờ ơ. Thiếu tầm quan trọng, ý nghĩa hoặc giá trị."
                },
                {
                    "en": "The state or quality of being indifferent.",
                    "vi": "Trạng thái hoặc chất lượng của việc thờ ơ."
                },
                {
                    "en": "The state of being indifferent.",
                    "vi": "Trạng thái thờ ơ."
                },
                {
                    "en": "The definition of indifference is a lack of care, concern or interest.",
                    "vi": "Định nghĩa của sự thờ ơ là sự thiếu quan tâm, chăm sóc hoặc quan tâm."
                },
                {
                    "en": "Unbiased impartiality.",
                    "vi": "Không thiên vị vô tư."
                },
                {
                    "en": "Unemotional apathy.",
                    "vi": "Sự thờ ơ vô cảm."
                },
                {
                    "en": "A lack of enthusiasm.",
                    "vi": "Một sự thiếu nhiệt tình."
                },
                {
                    "en": "Unconcerned nonchalance.",
                    "vi": "Sự hờ hững không quan tâm."
                }
            ]
        }
