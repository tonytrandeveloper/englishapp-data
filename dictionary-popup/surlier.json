        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Sullenly ill-humored; gruff.",
                    "vi": "Hờn dỗi hờn dỗi; cộc cằn."
                },
                {
                    "en": "Gloomy and threatening.",
                    "vi": "U ám và đe dọa."
                },
                {
                    "en": "(obsolete) Arrogant; domineering.",
                    "vi": "(lỗi thời) Kiêu ngạo; độc đoán."
                },
                {
                    "en": "(obs.) Haughty; arrogant.",
                    "vi": "(obs.) Kiêu kỳ; kiêu ngạo."
                },
                {
                    "en": "Bad-tempered; sullenly rude; hostile and uncivil.",
                    "vi": "Nóng tính; lầm lì một cách thô lỗ; thù địch và không văn minh."
                },
                {
                    "en": "Threatening, as of weather conditions; ominous.",
                    "vi": "Đe dọa, tùy theo điều kiện thời tiết; đáng ngại."
                },
                {
                    "en": "The definition of surly is someone who is bad-tempered, or something that is threatening such as poor weather.",
                    "vi": "Định nghĩa của surly là một người nào đó có tính cách xấu, hoặc một cái gì đó đang đe dọa chẳng hạn như thời tiết xấu."
                },
                {
                    "en": "Irritated, bad-tempered, unfriendly.",
                    "vi": "Hay cáu gắt, xấu tính, không thân thiện."
                },
                {
                    "en": "Threatening, menacing, gloomy.",
                    "vi": "Đe dọa, uy hiếp, ảm đạm."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
