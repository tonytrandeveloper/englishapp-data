        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Relating to or consisting of words; verbal.",
                    "vi": "Liên quan đến hoặc bao gồm các từ; bằng lời nói."
                },
                {
                    "en": "Tending to use, using, or expressed in more words than are necessary to convey meaning.",
                    "vi": "Có xu hướng sử dụng, sử dụng hoặc diễn đạt bằng nhiều từ hơn mức cần thiết để truyền đạt ý nghĩa."
                },
                {
                    "en": "Of words; verbal.",
                    "vi": "Của từ; bằng lời nói."
                },
                {
                    "en": "Containing or using many or too many words; verbose.",
                    "vi": "Chứa hoặc sử dụng nhiều hoặc quá nhiều từ; dài dòng."
                },
                {
                    "en": "Using an excessive number of words.",
                    "vi": "Sử dụng quá nhiều từ."
                }
            ]
        }
    ],
