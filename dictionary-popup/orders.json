    "sentences": [
        {
            "en": "I don't take orders from your kind.",
            "vi": "Tôi không nhận lệnh của đồng loại."
        },
        {
            "en": "I just follow orders.",
            "vi": "Tôi chỉ làm theo đơn đặt hàng."
        },
        {
            "en": "He gave everybody strict orders to leave you alone.",
            "vi": "Ông ấy đã ra lệnh nghiêm ngặt cho mọi người để bạn được yên."
        },
        {
            "en": "I'm under strict orders to keep you safe.",
            "vi": "Tôi theo lệnh nghiêm ngặt để giữ cho bạn an toàn."
        },
        {
            "en": "She turned away, issuing silent orders to the death-dealers.",
            "vi": "Cô quay đi, ra lệnh im lặng cho những kẻ buôn bán tử thần."
        },
        {
            "en": "The orders were not to let them in.",
            "vi": "Các lệnh không cho họ vào."
        },
        {
            "en": "I know the service, and it is my habit orders strictly to obey.",
            "vi": "Tôi biết dịch vụ, và thói quen của tôi là phải tuân thủ nghiêm ngặt."
        },
        {
            "en": "You don't give me orders, Damian.",
