    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Amusing in an odd or wry way.",
                    "vi": "Gây cười một cách kỳ quặc hoặc gượng gạo."
                },
                {
                    "en": "Amusingly odd or whimsically comical.",
                    "vi": "Hài hước một cách kỳ quặc hoặc kỳ quái."
                },
                {
                    "en": "The definition of droll refers to unusual, often sarcastic or dry humor.",
                    "vi": "Định nghĩa của droll dùng để chỉ sự hài hước bất thường, thường mang tính châm biếm hoặc khô khan."
                },
                {
                    "en": "Oddly humorous; whimsical, amusing in a quaint way; waggish.",
                    "vi": "Hài hước một cách kỳ lạ; hay thay đổi, gây cười một cách kỳ lạ; lải nhải."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A buffoon.",
                    "vi": "Một bữa tiệc."
                },
                {
                    "en": "(now rare) A droll person; jester.",
                    "vi": "(bây giờ hiếm) Một người bay lượn; hề."
                },
                {
                    "en": "(archaic) A buffoon.",
                    "vi": "(cổ xưa) Một bữa tiệc."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(now rare) To joke; play the jester.",
                    "vi": "(bây giờ hiếm) Để nói đùa; chơi trò hề."
                },
                {
                    "en": "(archaic) To joke, to jest.",
                    "vi": "(cổ xưa) Nói đùa, nói đùa."
                }
            ]
        }
    ],
