            "pos": "noun",
            "meaning": [
                {
                    "en": "A form of hunting, at night, in which bright lights or lamps are used to dazzle the hunted animal.",
                    "vi": "Một hình thức săn bắn vào ban đêm, trong đó đèn hoặc đèn sáng được sử dụng để làm chói mắt con vật bị săn đuổi."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "(archaic) Bright, flashing, resplendent.",
                    "vi": "(cổ xưa) Sáng, nhấp nháy, rực rỡ."
                }
            ]
        }
