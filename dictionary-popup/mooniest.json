    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or suggestive of the moon or moonlight.",
                    "vi": "Của hoặc gợi của mặt trăng hoặc ánh trăng."
                },
                {
                    "en": "Moonlit.",
                    "vi": "Ánh trăng."
                },
                {
                    "en": "Dreamy in mood or nature; absent-minded.",
                    "vi": "Mơ mộng trong tâm trạng hoặc thiên nhiên; lơ đễnh."
                },
                {
                    "en": "Of or characteristic of the moon.",
                    "vi": "Của hoặc đặc tính của mặt trăng."
                },
                {
                    "en": "Like the moon, esp. in shape; round or crescent-shaped.",
                    "vi": "Như mặt trăng, đặc biệt. trong hình dạng; tròn hoặc hình lưỡi liềm."
                },
                {
                    "en": "Lighted by the moon.",
                    "vi": "Được thắp sáng bởi mặt trăng."
                },
                {
                    "en": "Like moonlight.",
                    "vi": "Như ánh trăng."
                },
                {
                    "en": "Mooning; listless; dreamy.",
                    "vi": "Khoảnh khắc; bơ phờ; mơ màng."
                },
                {
                    "en": "Resembling the moon.",
                    "vi": "Giống như mặt trăng."
                },
                {
                    "en": "Moonlit.",
                    "vi": "Ánh trăng."
                },
                {
                    "en": "Absent-minded.",
                    "vi": "- Không có đầu óc."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
