    "sentences": [
        {
            "en": "Cynthia was thrilled with her new job and her school classes were finally coming together.",
            "vi": "Cynthia rất vui mừng với công việc mới của mình và các lớp học ở trường của cô ấy cuối cùng cũng đến với nhau."
        },
        {
            "en": "How are classes going?",
            "vi": "Lớp học diễn ra như thế nào?"
        },
        {
            "en": "She had continued her classes and was somehow maintaining acceptable grades.",
            "vi": "Cô ấy đã tiếp tục các lớp học của mình và bằng cách nào đó vẫn duy trì được điểm số ở mức chấp nhận được."
        },
        {
            "en": "Cattle and poultry are the principal classes of live stock.",
            "vi": "Gia súc và gia cầm là những loại gia súc sống chủ yếu."
        },
        {
            "en": "Quinn was required to pick up extra classes when an older professor passed away suddenly.",
            "vi": "Quinn được yêu cầu phải đi học thêm khi một giáo sư lớn tuổi đột ngột qua đời."
        },
        {
            "en": "They are divided into two classes.",
            "vi": "Chúng được chia thành hai lớp."
        },
        {
            "en": "The direct taxes fall into two classes.",
            "vi": "Thuế trực thu được chia thành hai loại."
        },
        {
            "en": "I didn't have any classes today and I decided to take off work.",
            "vi": "Tôi không có bất kỳ lớp học nào hôm nay và tôi quyết định nghỉ làm."
        },
        {
            "en": "I find I get on faster, and do better work with Mr. Keith than I did in the classes at the Cambridge School, and I think it was well that I gave up that kind of work.",
            "vi": "Tôi thấy mình làm việc nhanh hơn, và làm việc với ông Keith tốt hơn so với khi tôi làm trong các lớp học ở Trường Cambridge, và tôi nghĩ rằng thật tốt khi tôi đã từ bỏ loại công việc đó."
        },
        {
            "en": "The Code contemplates the whole population as falling into three classes, the amelu, the muskinu and the ardu.",
            "vi": "Bộ luật cho rằng toàn bộ dân số được chia thành ba giai cấp, amelu, muskinu và ardu."
        }
    ]
