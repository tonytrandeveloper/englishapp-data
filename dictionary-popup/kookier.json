    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Characteristic of a kook; strange or crazy.",
                    "vi": "Đặc điểm của một con gấu túi; kỳ lạ hoặc điên rồ."
                },
                {
                    "en": "(informal) Of or characteristic of a kook; eccentric, crazy, etc.",
                    "vi": "(không chính thức) Của hoặc đặc điểm của một con gấu túi; lập dị, điên rồ, v.v."
                },
                {
                    "en": "Irreverent; idiosyncratic or unexpected; not normal.",
                    "vi": "Khiếm nhã; mang phong cách riêng hoặc bất ngờ; không bình thường."
                },
                {
                    "en": "(describing a person) Crazy or insane.",
                    "vi": "(miêu tả một người) Điên rồ hoặc mất trí."
                },
                {
                    "en": "(surfing) Resembling a kook in behavior.",
                    "vi": "(lướt sóng) Có vẻ như một người khác trong hành vi."
                }
            ]
        }
    ],
