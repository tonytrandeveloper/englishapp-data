        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To criticize severely; reprimand or rebuke.",
                    "vi": "Phê bình nghiêm khắc; khiển trách hoặc khiển trách."
                },
                {
                    "en": "To punish, as for wrongdoing.",
                    "vi": "Để trừng phạt, đối với hành vi sai trái."
                },
                {
                    "en": "To scold or condemn sharply.",
                    "vi": "Để mắng mỏ hoặc lên án gay gắt."
                },
                {
                    "en": "(archaic) To chasten.",
                    "vi": "(cổ xưa) Để bắt kịp."
                },
                {
                    "en": "(archaic) To purify.",
                    "vi": "(cổ xưa) Để thanh lọc."
                },
                {
                    "en": "To punish, esp. by beating.",
                    "vi": "Để trừng phạt, đặc biệt. bằng cách đánh đập."
                },
                {
                    "en": "To chastise is to scold someone severely for bad behavior or even to punish someone by beating the person.",
                    "vi": "Chastise là mắng mỏ người nào đó một cách nghiêm khắc vì hành vi xấu hoặc thậm chí trừng phạt ai đó bằng cách đánh người đó."
                },
                {
                    "en": "To punish or scold someone.",
                    "vi": "Để trừng phạt hoặc la mắng ai đó."
                }
            ]
        }
