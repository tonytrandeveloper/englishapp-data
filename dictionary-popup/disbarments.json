    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The act of revoking an attorney’s license to practice law, usually because he or she has committed a crime or violated a legal rule of ethics.",
                    "vi": "Hành động thu hồi giấy phép hành nghề luật sư của luật sư, thường là do người đó đã phạm tội hoặc vi phạm quy tắc đạo đức luật."
                },
                {
                    "en": "(law) The disqualification of a lawyer from membership in a bar association, usually as punishment for wrongdoing; the result of being disbarred.",
                    "vi": "(luật) Việc luật sư không đủ tư cách thành viên trong đoàn luật sư, thường là hình phạt cho hành vi sai trái; kết quả của việc bị loại bỏ."
                }
            ]
        }
    ],
