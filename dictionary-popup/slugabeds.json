        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "One inclined to stay in bed out of laziness.",
                    "vi": "Một người có xu hướng nằm trên giường vì lười biếng."
                },
                {
                    "en": "(old-fashioned) A lazy person who stays in bed when he or she should be up.",
                    "vi": "(kiểu cũ) Một người lười biếng nằm trên giường khi anh ta hoặc cô ta phải dậy."
                },
                {
                    "en": "One who lies late in bed; a sluggard.",
                    "vi": "Một người nằm trên giường muộn; một kẻ lười biếng."
                }
            ]
        }
