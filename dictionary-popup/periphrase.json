    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(rhetoric) The use of more words than are necessary to express the idea; a roundabout, or indirect, way of speaking; circumlocution.",
                    "vi": "(hùng biện) Việc sử dụng nhiều từ hơn mức cần thiết để diễn đạt ý tưởng; cách nói vòng vo, hoặc gián tiếp; sự lộn xộn."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To express by periphrase or circumlocution.",
                    "vi": "Để diễn đạt bằng cách diễn đạt hoặc ngắt quãng."
                },
                {
                    "en": "(intransitive) To use circumlocution.",
                    "vi": "(intransitive) Để sử dụng tính năng ngắt quãng."
                }
            ]
        }
    ],
