    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To interfere in the affairs of others, often officiously; meddle.",
                    "vi": "Can thiệp vào công việc của người khác, thường là một cách chính thức; can thiệp."
                },
                {
                    "en": "To meddle in the affairs of others, esp. to do so officiously.",
                    "vi": "Để can thiệp vào công việc của người khác, đặc biệt. làm như vậy một cách chính thức."
                },
                {
                    "en": "(intransitive) To butt in, to interfere in or with. [from 15th c.]",
                    "vi": "(intransitive) Để tham gia, can thiệp vào hoặc với. [từ ngày 15 c.]"
                }
            ]
        }
    ],
    "meaning_vi": [
