    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having a feeble or unsteady gait; shaky.",
                    "vi": "Có dáng đi yếu ớt hoặc loạng choạng; lung lay."
                },
                {
                    "en": "(informal) Feebleminded or crazy.",
                    "vi": "(không chính thức) Feebleminded hoặc điên."
                },
                {
                    "en": "Obsessively infatuated or enamored.",
                    "vi": "Mê hoặc say mê một cách ám ảnh."
                },
                {
                    "en": "Mentally unbalanced; crazy.",
                    "vi": "Không cân bằng về mặt tinh thần; khùng."
                },
                {
                    "en": "Amusingly eccentric or unconventional.",
                    "vi": "Lập dị hoặc độc đáo một cách thú vị."
                },
                {
                    "en": "Ridiculous or absurd.",
                    "vi": "Vô lý hay vô lý."
                },
                {
                    "en": "Having many dots.",
                    "vi": "Có nhiều dấu chấm."
                },
                {
                    "en": "(UK) Mildly insane or excessively preoccupied; often, senile.",
                    "vi": "(Anh) Điên lạc nhẹ hoặc bận tâm quá mức; thường, về già."
                },
                {
                    "en": "Dotted.",
                    "vi": "Say mê."
                }
            ]
        }
    ],
