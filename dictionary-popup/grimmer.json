    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Fierce; cruel; savage.",
                    "vi": "Hung dữ; hung ác; độc ác."
                },
                {
                    "en": "The definition of grim is something that is so unpleasant it pushes you away.",
                    "vi": "Định nghĩa của nghiệt ngã là một thứ gì đó khó chịu đến mức đẩy bạn ra xa."
                },
                {
                    "en": "Grim is defined as stern or unmoving.",
                    "vi": "Grim được định nghĩa là nghiêm khắc hoặc không cử động."
                },
                {
                    "en": "Unrelenting or uncompromising.",
                    "vi": "Không ngừng hoặc không khoan nhượng."
                },
                {
                    "en": "Discouraging or depressing.",
                    "vi": "Làm nản lòng hoặc chán nản."
                },
                {
                    "en": "Dismal; gloomy.",
                    "vi": "Suy mòn; ảm đạm."
                },
                {
                    "en": "Stern or forbidding.",
                    "vi": "Nghiêm khắc hoặc cấm đoán."
                },
                {
                    "en": "Repellent or horrifying.",
                    "vi": "Hấp dẫn hoặc kinh hoàng."
                },
                {
                    "en": "Hard and unyielding; relentless; stern; resolute.",
                    "vi": "Chăm chỉ và không khuất phục; không ngừng nghỉ; đuôi tàu; kiên quyết."
                },
                {
                    "en": "Appearing stern, forbidding, harsh, etc.",
                    "vi": "Xuất hiện nghiêm khắc, ngăn cấm, khắc nghiệt, v.v."
                },
                {
                    "en": "Repellent; uninviting.",
                    "vi": "Chất xua đuổi; không mời."
                },
                {
                    "en": "Dealing with unpleasant subjects; frightful; ghastly.",
                    "vi": "Đối phó với những đối tượng khó chịu; ghê sợ; kinh khủng."
                },
                {
                    "en": "Dismal and gloomy, cold and forbidding.",
                    "vi": "Xấu xa và u ám, lạnh lùng và cấm đoán."
                },
                {
                    "en": "Rigid and unrelenting.",
                    "vi": "Cứng nhắc và không ngừng."
                },
                {
                    "en": "Ghastly or sinister.",
                    "vi": "Ghê tởm hoặc nham hiểm."
                },
                {
                    "en": "(UK, slang) Disgusting; gross.",
                    "vi": "(Anh, tiếng lóng) Kinh tởm; Tổng."
                }
            ]
        },
        {
            "pos": "pronoun",
            "meaning": [
                {
                    "en": "An English surname​, probably derived from Old English grimm or Old Norse grimr or grimmr.",
                    "vi": "Một họ trong tiếng Anh, có thể bắt nguồn từ tiếng Anh cổ Grimm hoặc Old Norse hoặc nhăn nhó."
                }
            ]
        }
    ],
