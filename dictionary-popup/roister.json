    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To engage in boisterous merrymaking; revel noisily.",
                    "vi": "Tham gia vào hoạt động vui chơi náo nhiệt; vui chơi ồn ào."
                },
                {
                    "en": "To behave in a blustering manner; swagger.",
                    "vi": "Cư xử một cách đỏ mặt; đi vênh vang."
                },
                {
                    "en": "To be lively and noisy; revel boisterously.",
                    "vi": "Sống động và ồn ào; vui chơi náo nhiệt."
                },
                {
                    "en": "(intransitive) To engage in noisy, drunken, or riotous behavior.",
                    "vi": "(nội tâm) Tham gia vào các hành vi ồn ào, say rượu hoặc bạo loạn."
                },
                {
                    "en": "(intransitive) To walk with a swaying motion.",
                    "vi": "(không trực quan) Để đi bộ với chuyển động lắc lư."
                },
                {
                    "en": "To boast or swagger.",
                    "vi": "Để khoe khoang hoặc vênh váo."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(archaic) A roisterer.",
                    "vi": "(cổ xưa) Một người xếp hàng."
                }
            ]
        }
    ],
