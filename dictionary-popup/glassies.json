            "meaning": [
                {
                    "en": "Characteristic of or resembling glass.",
                    "vi": "Có đặc điểm giống hoặc giống thủy tinh."
                },
                {
                    "en": "Lifeless; expressionless.",
                    "vi": "Vô hồn; vô cảm."
                },
                {
                    "en": "Like glass, as in smoothness or transparency.",
                    "vi": "Giống như thủy tinh, như độ mịn hoặc trong suốt."
                },
                {
                    "en": "Expressionless or lifeless.",
                    "vi": "Vô cảm hoặc vô hồn."
                },
                {
                    "en": "Of or like glass, in particular smooth and (somewhat) reflective.",
                    "vi": "Bằng hoặc giống như thủy tinh, đặc biệt là mịn và (hơi) phản chiếu."
                },
                {
                    "en": "Dull, expressionless.",
                    "vi": "Thẫn thờ, vô cảm."
                },
                {
                    "en": "(surfing, of water, not comparable) Lacking any chop; smooth and mostly flat.",
                    "vi": "(lướt, của nước, không thể so sánh) Thiếu bất kỳ miếng; mịn và hầu hết là phẳng."
                }
            ]
        },
        {
            "pos": "noun",
