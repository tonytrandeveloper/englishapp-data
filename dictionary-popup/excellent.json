    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of the highest or finest quality; exceptionally good for its kind.",
                    "vi": "Có chất lượng cao nhất hoặc tốt nhất; đặc biệt tốt cho loại của nó."
                },
                {
                    "en": "Outstandingly good of its kind; of exceptional merit, virtue, etc.",
                    "vi": "Đặc biệt tốt của loại hình này; về công đức đặc biệt, đức hạnh, v.v."
                },
                {
                    "en": "(archaic) Being so to an extreme degree.",
                    "vi": "(cổ xưa) Là như vậy ở một mức độ cực kỳ."
                },
                {
                    "en": "(obs.) Excelling; surpassing.",
                    "vi": "(obs.) Xuất sắc; vượt qua."
                },
                {
                    "en": "The definition of excellent is someone or something as exceptional or of high quality.",
                    "vi": "Định nghĩa của xuất sắc là một người nào đó hoặc một cái gì đó đặc biệt hoặc có chất lượng cao."
                },
                {
                    "en": "Of the highest quality; splendid.",
                    "vi": "Chất lượng cao nhất; lộng lẫy."
                },
                {
                    "en": "Exceptionally good of its kind.",
                    "vi": "Đặc biệt tốt của loại hình này."
                },
                {
                    "en": "Superior in kind or degree, irrespective of moral quality.",
                    "vi": "Cấp trên về hiện vật hay bằng cấp, không phân biệt phẩm chất đạo đức."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "(obsolete) Excellently.",
                    "vi": "(lỗi thời) Xuất sắc."
                }
            ]
        }
    ],
