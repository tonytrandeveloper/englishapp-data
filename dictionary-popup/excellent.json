    "sentences": [
        {
            "en": "He was an excellent horseman, and rode as if he were part of the horse.",
            "vi": "Anh ta là một kỵ sĩ xuất sắc, và cưỡi như thể anh ta là một phần của con ngựa."
        },
        {
            "en": "He was in excellent condition.",
            "vi": "Anh ấy đã ở trong tình trạng tuyệt vời."
        },
        {
            "en": "You have an excellent memory.",
            "vi": "Bạn có một trí nhớ tuyệt vời."
        },
        {
            "en": "Excellent idea – if you enjoy it.",
            "vi": "Ý tưởng tuyệt vời - nếu bạn thích nó."
        },
        {
            "en": "Excellent wine is made.",
            "vi": "Rượu tuyệt hảo được làm ra."
        },
        {
            "en": "He was an excellent judge of horseflesh.",
            "vi": "Ông ấy là một thẩm phán xuất sắc về ngựa."
        },
        {
            "en": "He made an excellent companion, a fact that hadn't occurred to her before that moment.",
            "vi": "Anh ấy đã trở thành một người bạn đồng hành tuyệt vời, một sự thật chưa từng xảy ra với cô trước thời điểm đó."
        },
        {
            "en": "Oh, this would be an excellent idea!",
            "vi": "Ồ, đây sẽ là một ý tưởng tuyệt vời!"
