    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Marked by arrogance; haughty and overbearing.",
                    "vi": "Được đánh dấu bởi sự kiêu ngạo; kiêu kỳ và hống hách."
                },
                {
                    "en": "(idiomatic) Overbearingly arrogant; ostentatiously self-important or self-aggrandizing.",
                    "vi": "(thành ngữ) Hách dịch ngạo mạn; phô trương bản thân quan trọng hoặc tự làm nặng bản thân."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(idiomatic) A social or economic group wielding undue power, influence or economic clout.",
                    "vi": "(thành ngữ) Một nhóm xã hội hoặc kinh tế sử dụng quyền lực, ảnh hưởng hoặc tầm ảnh hưởng kinh tế quá mức."
                }
            ]
        }
    ],
