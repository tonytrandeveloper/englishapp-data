        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(informal) A state of frenzied excitement, esp. over some trivial matter.",
                    "vi": "(không chính thức) Trạng thái phấn khích điên cuồng, đặc biệt. về một số vấn đề tầm thường."
                },
                {
                    "en": "A state of nervous excitement or confusion; a dither.",
                    "vi": "Trạng thái hồi hộp phấn khích hoặc bối rối; một hòa sắc."
                },
                {
                    "en": "(UK, slang, archaic) A sixpence; a tester.",
                    "vi": "(Anh, tiếng lóng, cổ) A sixpence; một người thử nghiệm."
                },
                {
                    "en": "A state of nervous excitement, confusion, or distress; a dither.",
                    "vi": "Trạng thái hồi hộp phấn khích, bối rối hoặc lo lắng; một hòa sắc."
                }
            ]
        }
    ],
