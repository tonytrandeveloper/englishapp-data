    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Right or fair; equitable; impartial.",
                    "vi": "Đúng hoặc công bằng; công bằng; vô tư."
                },
                {
                    "en": "Honorable and fair in one's dealings and actions.",
                    "vi": "Danh dự và công bằng trong giao dịch và hành động của một người."
                },
                {
                    "en": "Suitable or proper in nature; fitting.",
                    "vi": "Phù hợp hoặc thích hợp trong tự nhiên; vừa vặn."
                },
                {
                    "en": "Correct or true.",
                    "vi": "Đúng hay đúng."
                },
                {
                    "en": "Legally right; lawful; rightful.",
                    "vi": "Đúng về mặt pháp lý; hợp pháp; đúng đắn."
                },
                {
                    "en": "Righteous; upright.",
                    "vi": "Đúng đắn; ngay thẳng."
                },
                {
                    "en": "(law) Valid within the law; lawful.",
                    "vi": "(luật) Có hiệu lực trong luật; đúng luật."
                },
                {
                    "en": "Deserved; merited.",
                    "vi": "Xứng đáng; có công."
                },
                {
                    "en": "Proper, fitting, etc.",
                    "vi": "Thích hợp, vừa vặn, v.v."
                },
                {
                    "en": "Well-founded; reasonable.",
                    "vi": "Có cơ sở; hợp lý."
                },
                {
                    "en": "Accurate; exact.",
                    "vi": "Chính xác; chính xác."
                },
                {
                    "en": "Factually fair; right, correct; proper.",
                    "vi": "Thực tế công bằng; Ừ đúng rồi; thích hợp."
                },
                {
                    "en": "Morally fair; upright; righteous, equitable.",
                    "vi": "Công bằng về mặt đạo đức; ngay thẳng; chính trực, bình đẳng."
                },
                {
                    "en": "The definition of just is fair or right.",
                    "vi": "Định nghĩa của công bằng là công bằng hoặc đúng."
                },
                {
                    "en": "Consistent with what is morally right; righteous.",
                    "vi": "Phù hợp với những gì là đúng đắn về mặt đạo đức; đúng đắn."
                },
                {
                    "en": "Properly due or merited.",
                    "vi": "Đúng hạn hoặc xứng đáng."
                },
                {
                    "en": "Based on fact or sound reason; well-founded.",
                    "vi": "Dựa trên thực tế hoặc lý do hợp lý; có cơ sở."
                }
            ]
        },
        {
