    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To dismantle, take apart, or demolish; raze.",
                    "vi": "Để tháo dỡ, tháo rời hoặc phá dỡ; san bằng."
                },
                {
                    "en": "To tear down (something built); demolish; raze.",
                    "vi": "Để phá bỏ (một cái gì đó được xây dựng); phá hủy; san bằng."
                },
                {
                    "en": "To dismantle or deconstruct (something previously built).",
                    "vi": "Để tháo dỡ hoặc xây dựng lại (một cái gì đó đã được xây dựng trước đó)."
                }
            ]
        }
    ],
