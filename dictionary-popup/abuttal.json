    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The border of a parcel of land in relation to adjoining lands.",
                    "vi": "Ranh giới của thửa đất đối với các khu đất liền kề."
                },
                {
                    "en": "(rare, plural only) The butting or boundary of land, particularly at the end; buttals. [First attested in the early 17th century.]",
                    "vi": "(hiếm, chỉ số nhiều) Hạch hoặc ranh giới của đất, đặc biệt là ở cuối; mông. [Được chứng thực lần đầu vào đầu thế kỷ 17.]"
                },
                {
                    "en": "An abutment. [First attested in the early 17th century.]",
                    "vi": "Một trụ cầu. [Được chứng thực lần đầu vào đầu thế kỷ 17.]"
                },
                {
                    "en": "The act of abutting.",
                    "vi": "Hành động tiếp giáp."
                }
            ]
        }
    ],
