            "meaning": [
                {
                    "en": "Full of fighting spirit.",
                    "vi": "Đầy tinh thần chiến đấu."
                },
                {
                    "en": "Composed of scraps; fragmentary.",
                    "vi": "Bao gồm các phế liệu; rời rạc."
                },
                {
                    "en": "Disconnected; disjointed.",
                    "vi": "Đã ngắt kết nối; rời rạc."
                },
                {
                    "en": "(informal) Fond of fighting, arguing, etc.; aggressive.",
                    "vi": "(thân mật) Thích đánh nhau, tranh cãi, v.v.; xâm lược."
                },
                {
                    "en": "Consisting of scraps; fragmentary; lacking unity or consistency.",
                    "vi": "Bao gồm các mảnh vụn; rời rạc; thiếu sự thống nhất hoặc nhất quán."
                },
                {
                    "en": "(informal) Having an aggressive spirit; inclined to fight or strive.",
                    "vi": "(không chính thức) Có tinh thần hiếu chiến; thiên về chiến đấu hoặc phấn đấu."
                },
                {
                    "en": "Quarrelsome; contentious.",
                    "vi": "Quarrelsome; gây tranh cãi."
                },
                {
                    "en": "Made of scraps; consisting of odds and ends.",
                    "vi": "Làm bằng phế liệu; bao gồm tỷ lệ cược và kết thúc."
                }
            ]
        }
