    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Constant, excessive reference to oneself in speaking or writing.",
                    "vi": "Tham khảo liên tục, quá mức về bản thân khi nói hoặc viết."
                },
                {
                    "en": "Conceit or vanity.",
                    "vi": "Tự phụ hoặc phù phiếm."
                },
                {
                    "en": "An inflated sense of one's own importance; conceit.",
                    "vi": "Cảm giác được thổi phồng về tầm quan trọng của bản thân; tự cao."
                },
                {
                    "en": "Selfishness.",
                    "vi": "Tính vị kỷ."
                },
                {
                    "en": "A tendency to talk excessively about oneself.",
                    "vi": "Có xu hướng nói quá nhiều về bản thân."
                },
                {
                    "en": "A belief that one is superior to or more important than others.",
                    "vi": "Niềm tin rằng một người cao hơn hoặc quan trọng hơn những người khác."
                },
                {
                    "en": "Egoism.",
                    "vi": "Chủ nghĩa vị kỷ."
                },
                {
                    "en": "(countable) The result or product of being egoistic.",
                    "vi": "(đếm được) Kết quả hoặc sản phẩm của việc sống ích kỷ."
                }
            ]
        }
    ],
