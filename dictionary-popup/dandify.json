        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To dress as or cause to resemble a dandy.",
                    "vi": "Để ăn mặc giống hoặc gây ra sự giống một người bảnh bao."
                },
                {
                    "en": "To make look like a dandy; dress up.",
                    "vi": "Để làm cho trông giống như một bảnh bao; ăn mặc đẹp lên."
                },
                {
                    "en": "To dress as, or to adopt the style of, a dandy.",
                    "vi": "Ăn mặc như, hoặc áp dụng phong cách bảnh bao."
                }
            ]
        }
    ],
