    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Quick, clever, and acute in devising or understanding.",
                    "vi": "Nhanh chóng, thông minh và nhạy bén trong việc nghĩ ra hoặc hiểu biết."
                },
                {
                    "en": "Moving quickly and lightly.",
                    "vi": "Di chuyển nhanh và nhẹ."
                },
                {
                    "en": "Mentally quick; quick-witted; alert.",
                    "vi": "Tinh thần nhanh chóng; nhanh trí; báo động."
                },
                {
                    "en": "(rare) Showing mental quickness.",
                    "vi": "(hiếm) Thể hiện tinh thần nhanh nhạy."
                },
                {
                    "en": "Quick, light, or agile in movement or action; deft.",
                    "vi": "Nhanh nhẹn, nhẹ nhàng, hoặc nhanh nhẹn trong di chuyển hoặc hành động; khéo léo."
                },
                {
                    "en": "The definition of nimble is someone who is spry, and quick to move or understand.",
                    "vi": "Định nghĩa của nhanh nhẹn là người nhanh nhẹn, di chuyển hoặc hiểu chuyện nhanh chóng."
                },
                {
                    "en": "Quick and light in movement or action.",
                    "vi": "Nhanh chóng và nhẹ nhàng trong chuyển động hoặc hành động."
                },
                {
                    "en": "Quick-witted and alert.",
                    "vi": "Nhanh trí và tỉnh táo."
                }
            ]
        }
    ],
    "meaning_vi": [
