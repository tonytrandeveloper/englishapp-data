    "hasImage": 0,
    "phonetics": {
        "uk": "ˈkeɪsˌhɑːdn",
        "us": "caseharden"
    },
    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To harden the surface or case of (iron or steel) by high-temperature shallow infusion of carbon followed by quenching.",
                    "vi": "Để làm cứng bề mặt hoặc vỏ của (sắt hoặc thép) bằng cách truyền cacbon nông ở nhiệt độ cao sau đó làm nguội."
                },
                {
                    "en": "To make callous or insensitive.",
                    "vi": "Để tạo ra sự nhẫn tâm hoặc vô cảm."
                },
                {
                    "en": "(metallurgy) To form a hard, thin surface on (an iron alloy)",
                    "vi": "(luyện kim) Để tạo bề mặt cứng, mỏng trên (hợp kim sắt)"
                },
                {
                    "en": "To make callous or unfeeling.",
                    "vi": "Để làm cho chai sạn hoặc không có cảm xúc."
                },
                {
                    "en": "To harden the surface of iron or steel by infusing carbon into the surface layer.",
                    "vi": "Để làm cứng bề mặt của sắt hoặc thép bằng cách truyền cacbon vào lớp bề mặt."
                },
                {
                    "en": "(by extension) To make insensitive to hardship.",
                    "vi": "(mở rộng) Để làm cho vô cảm trước khó khăn."
                }
            ]
        }
    ],
