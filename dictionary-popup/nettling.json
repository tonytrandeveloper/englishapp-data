                },
                {
                    "en": "The process of tying together the ends of yarns in pairs, to prevent tangling.",
                    "vi": "Quá trình buộc các đầu sợi lại với nhau theo từng cặp, để tránh bị rối."
                }
            ]
        }
    ],
