    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A circular or spiral motion or form, especially a circular ocean current.",
                    "vi": "Một dạng hoặc chuyển động tròn hoặc xoắn ốc, đặc biệt là một dòng hải lưu tròn."
                },
                {
                    "en": "A circular or spiral motion; whirl; revolution.",
                    "vi": "Một chuyển động tròn hoặc xoắn ốc; quay cuồng; Cuộc cách mạng."
                },
                {
                    "en": "A circular or spiral form; ring or vortex.",
                    "vi": "Một dạng tròn hoặc xoắn ốc; vòng hoặc xoáy."
                },
                {
                    "en": "A swirling vortex.",
                    "vi": "Một cơn lốc xoáy."
                },
                {
                    "en": "A circular current, especially a large-scale ocean current.",
                    "vi": "Dòng điện tròn, đặc biệt là dòng hải lưu có quy mô lớn."
                },
                {
                    "en": "A circular motion, or a circle described by a moving body; a turn or revolution; a circuit.",
                    "vi": "Một chuyển động tròn, hoặc một vòng tròn được mô tả bởi một cơ thể đang chuyển động; một ngã rẽ hoặc một cuộc cách mạng; một mạch."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To whirl.",
                    "vi": "Quay cuồng."
                },
                {
                    "en": "To whirl.",
                    "vi": "Quay cuồng."
                },
                {
                    "en": "(intransitive) To whirl.",
                    "vi": "(intransitive) Để quay cuồng."
                }
            ]
        }
    ],
