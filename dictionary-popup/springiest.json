    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Marked by resilience; elastic.",
                    "vi": "Đánh dấu bằng khả năng phục hồi; đàn hồi."
                },
                {
                    "en": "Abounding in freshwater springs.",
                    "vi": "Dồi dào trong các suối nước ngọt."
                },
                {
                    "en": "Having spring; elastic, resilient, etc.",
                    "vi": "Có mùa xuân; đàn hồi, đàn hồi, v.v."
                },
                {
                    "en": "Having many springs of water.",
                    "vi": "Có nhiều suối nước."
                },
                {
                    "en": "That returns rapidly to its original form (as a spring does) after being bent, compressed, stretched, etc.",
                    "vi": "Điều đó nhanh chóng trở lại dạng ban đầu (như lò xo) sau khi bị uốn cong, nén, kéo căng, v.v."
                }
            ]
        }
    ],
