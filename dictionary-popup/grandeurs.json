    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The quality or condition of being grand; magnificence.",
                    "vi": "Chất lượng hoặc điều kiện của sự vĩ đại; sự tráng lệ."
                },
                {
                    "en": "The quality of being grand.  Splendor; magnificence. Moral or intellectual greatness; nobility.",
                    "vi": "Chất lượng của sự vĩ đại. Lộng lẫy; sự tráng lệ. Sự vĩ đại về đạo đức hoặc trí tuệ; quý tộc."
                },
                {
                    "en": "Nobility or greatness of character.",
                    "vi": "Sự cao quý hoặc vĩ đại của nhân vật."
                },
                {
                    "en": "Grandeur is defined as magnificence, something very impressive and amazing, high moral character or intellectual greatness.",
                    "vi": "Grandeur được định nghĩa là sự tráng lệ, một cái gì đó rất ấn tượng và đáng kinh ngạc, tính cách đạo đức cao hoặc sự vĩ đại về trí tuệ."
                },
                {
                    "en": "The state of being grand or splendid; magnificence.",
                    "vi": "Trạng thái của sự vĩ đại hoặc lộng lẫy; sự tráng lệ."
                },
                {
                    "en": "Nobility.",
                    "vi": "Quý tộc."
                },
                {
                    "en": "(archaic, rare) Greatness; largeness; tallness; loftiness.",
                    "vi": "(cổ xưa, hiếm) Sự vĩ đại; sự rộng lớn; độ cao; sự cao cả."
                }
            ]
        }
    ],
    "meaning_vi": [
