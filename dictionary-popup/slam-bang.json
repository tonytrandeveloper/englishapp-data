    "phonetics": {
        "uk": "slæm-bæŋ",
        "us": "slæm-bæŋ"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "With force and much noise.",
                    "vi": "Với lực và nhiều tiếng ồn."
                },
                {
                    "en": "With heedless speed; slapdash.",
                    "vi": "Với tốc độ không cần chú ý; tát."
                },
                {
                    "en": "With vigorous relentless action and pace.",
                    "vi": "Với tốc độ và hành động không ngừng mạnh mẽ."
                },
                {
                    "en": "Characterized by liveliness, noise, etc.",
                    "vi": "Được đặc trưng bởi sự sống động, tiếng ồn, v.v."
                },
                {
                    "en": "Violent and noisy; unrestrained.",
                    "vi": "Bạo lực và ồn ào; không bị kiềm chế."
                },
                {
                    "en": "(onomatopoeia) Noisy, raucous.",
                    "vi": "(từ tượng thanh) Ồn ào, khàn khàn."
                },
                {
                    "en": "Violent, forceful.",
                    "vi": "Bạo lực, cưỡng bức."
                },
                {
                    "en": "Impressive, exciting.",
                    "vi": "Ấn tượng, thú vị."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "Swiftly or abruptly and recklessly.",
                    "vi": "Nhanh chóng hoặc đột ngột và liều lĩnh."
                },
                {
                    "en": "With loud noise.",
                    "vi": "Với tiếng ồn lớn."
                },
                {
                    "en": "With a slam and a bang; with noisy or headlong violence.",
                    "vi": "Với một tiếng sầm và một tiếng nổ; với bạo lực ồn ào hoặc kéo dài."
                },
                {
                    "en": "Shot or hit with a noise.",
                    "vi": "Bắn hoặc đánh có tiếng ồn."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(intransitive) To go with a slam and a bang; go noisily.",
                    "vi": "(intransitive) Để đi với một tiếng sầm và một tiếng nổ; đi ồn ào."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(onomatopoeia) Noisy activity.",
                    "vi": "(từ tượng thanh) Hoạt động ồn ào."
                }
            ]
        }
    ],
    "meaning_vi": [
        "hết sức ầm ĩ; dữ dội",
        "lơ đễnh; cẩu thả"
    ],
