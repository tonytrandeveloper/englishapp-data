    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Pretentious, showy finery.",
                    "vi": "Đồ mỹ nghệ đẹp đẽ, sặc sỡ."
                },
                {
                    "en": "Something trivial or nonessential.",
                    "vi": "Một cái gì đó tầm thường hoặc không cần thiết."
                },
                {
                    "en": "Showy display in dress, manners, speech, etc.; affectation of elegance.",
                    "vi": "Thể hiện sặc sỡ trong cách ăn mặc, cách cư xử, cách nói năng, v.v ...; ảnh hưởng của sự sang trọng."
                },
                {
                    "en": "Ostentation, as in fancy clothing.",
                    "vi": "Thoải mái, như trong trang phục sang trọng."
                },
                {
                    "en": "Useless things; trifles.",
                    "vi": "Thứ vô dụng; những chuyện vặt vãnh."
                },
                {
                    "en": "Hence: secondhand finery; cheap and tawdry decoration; affected elegance.",
                    "vi": "Do đó: đồ mỹ nghệ đã qua sử dụng; trang trí rẻ tiền và tạp nham; sự sang trọng bị ảnh hưởng."
                },
                {
                    "en": "Pretentious elegance; ostentation.",
                    "vi": "Vẻ đẹp thanh lịch; phô trương."
                },
                {
                    "en": "Cheap, gaudy clothes; tawdry finery.",
                    "vi": "Quần áo rẻ tiền, lòe loẹt; tawdry finery."
                }
            ]
        }
    ],
    "meaning_vi": [
        "đồ trang trí loè loẹt rẻ tiền (ở quần áo)",
        "câu văn sáo, câu văn rỗng tuếch",
