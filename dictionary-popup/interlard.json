    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To insert something foreign into.",
                    "vi": "Để chèn một cái gì đó nước ngoài vào."
                },
                {
                    "en": "To insert strips or pieces of fat, bacon, etc. in (meat to be cooked)",
                    "vi": "Để chèn các dải hoặc miếng mỡ, thịt xông khói, v.v. vào (thịt được nấu chín)"
                },
                {
                    "en": "To intersperse; diversify.",
                    "vi": "Để xen kẽ; đa dạng hóa."
                },
                {
                    "en": "To mix together.",
                    "vi": "Để trộn lẫn với nhau."
                },
                {
                    "en": "To be intermixed in.",
                    "vi": "Để được trộn lẫn vào."
                },
                {
                    "en": "Bloat or embellish (something) by including (often minor and extraneous) details at regular intervals.",
                    "vi": "Làm nổi hoặc tô điểm (một cái gì đó) bằng cách bao gồm (thường là những chi tiết nhỏ và không liên quan) vào những khoảng thời gian đều đặn."
                }
            ]
        }
    ],
    "meaning_vi": [
        "xen (tiếng nước ngoài, lời nguyền rủa...) vào (văn, lời nói)",
        "(từ cổ,nghĩa cổ) để xen lẫn mỡ vào (với thịt để nấu)"
