    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The act of hindering or preventing the discovery, knowledge, or sight of something.",
                    "vi": "Hành động cản trở hoặc ngăn cản việc khám phá, kiến thức hoặc nhìn thấy một thứ gì đó."
                },
                {
                    "en": "The hiding or placement of an object out of notice or sight.",
                    "vi": "Việc che giấu hoặc đặt một đối tượng ngoài tầm nhìn hoặc thông báo."
                },
                {
                    "en": "The practice of keeping secrets.",
                    "vi": "Thực hành giữ bí mật."
                },
                {
                    "en": "The condition of being hidden or concealed.",
                    "vi": "Tình trạng bị che giấu hoặc bị che giấu."
                },
                {
                    "en": "(military) Protection from observation or surveillance.",
                    "vi": "(quân sự) Bảo vệ khỏi sự quan sát hoặc giám sát."
                }
            ]
        }
    ],
