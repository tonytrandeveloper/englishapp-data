            "pos": "adjective",
            "meaning": [
                {
                    "en": "Eccentric or crazy.",
                    "vi": "Lập dị hoặc điên rồ."
                },
                {
                    "en": "Ludicrously odd, unlikely, or inappropriate.",
                    "vi": "Lố bịch một cách kỳ quặc, khó có thể xảy ra hoặc không phù hợp."
                },
                {
                    "en": "Mentally unbalanced; crazy.",
                    "vi": "Không cân bằng về mặt tinh thần; khùng."
                },
                {
                    "en": "Peculiar, eccentric, or odd in a confusing way.",
                    "vi": "Kỳ dị, lập dị hoặc kỳ quặc một cách khó hiểu."
                },
                {
                    "en": "(informal) Crazy; silly; ridiculous; insane; demented; unreasonable.",
                    "vi": "(không chính thức) Điên rồ; điên; lố bịch; điên cuồng; điên; không hợp lý."
                },
                {
                    "en": "(archaic, informal) Tipsy; slightly drunk.",
                    "vi": "(cổ xưa, không chính thức) Tipsy; hơi say."
                }
            ]
        }
    ],
