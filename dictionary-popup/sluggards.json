    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A slothful person; an idler.",
                    "vi": "Một người lười biếng; một người làm biếng."
                },
                {
                    "en": "A habitually lazy or idle person.",
                    "vi": "Một người có thói quen lười biếng hoặc nhàn rỗi."
                },
                {
                    "en": "A person who is lazy, stupid, or idle by habit.",
                    "vi": "Một người lười biếng, ngu ngốc, hay nhàn rỗi theo thói quen."
                },
                {
                    "en": "A person slow to begin necessary work, a slothful person.",
                    "vi": "Một người chậm bắt đầu công việc cần thiết, một người lười biếng."
                },
                {
                    "en": "A fearful or cowardly person, a poltroon.",
                    "vi": "Một kẻ đáng sợ hay hèn nhát, một kẻ xấu xa."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Lazy.",
                    "vi": "Lười biếng."
                },
                {
                    "en": "Lazy or idle.",
                    "vi": "Lười biếng hoặc nhàn rỗi."
                }
            ]
        }
    ],
    "meaning_vi": [
        "người chậm chạp lười biếng",
