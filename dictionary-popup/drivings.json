        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The way one drives an automobile, etc.",
                    "vi": "Cách một người lái ô tô, v.v."
                },
                {
                    "en": "The action of the verb to drive in any sense.",
                    "vi": "Hành động của động từ lái xe theo nghĩa nào."
                },
                {
                    "en": "In particular, the action of operating a motor vehicle.",
                    "vi": "Đặc biệt là hành động vận hành một phương tiện cơ giới."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Vigorous; energetic.",
                    "vi": "Mạnh mẽ; năng lượng."
                },
                {
                    "en": "That drives (a mechanism or process).",
                    "vi": "Điều đó thúc đẩy (một cơ chế hoặc quá trình)."
                },
                {
                    "en": "(of wind, rain, etc): That drives forcefully; strong; forceful; violent.",
                    "vi": "(gió, mưa, v.v.): Điều đó thúc đẩy mạnh mẽ; mạnh; mạnh mẽ; hung bạo."
                },
                {
                    "en": "Transmitting power or motion.",
                    "vi": "Truyền lực hoặc chuyển động."
                },
                {
                    "en": "Violent, intense, or forceful.",
                    "vi": "Bạo lực, dữ dội hoặc cưỡng bức."
                },
                {
                    "en": "Energetic or active.",
                    "vi": "Hăng hái hoặc năng động."
                },
                {
                    "en": "Transmitting force or motion.",
                    "vi": "Truyền lực hoặc chuyển động."
                },
                {
                    "en": "Moving with force and violence.",
                    "vi": "Di chuyển bằng vũ lực và bạo lực."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
