                {
                    "en": "Lollygag.",
                    "vi": "Lollygag."
                },
                {
                    "en": "(See lollygag.) To dawdle; to be lazy or idle; to avoid necessary work or effort.",
                    "vi": "(Xem lollygag.) Để dawdle; lười biếng hoặc nhàn rỗi; để tránh công việc hoặc nỗ lực cần thiết."
                },
                {
                    "en": "(archaic, US) To pet, kiss, or otherwise demonstrate overt affection, generally in public.",
                    "vi": "(cổ, Hoa Kỳ) Để cưng nựng, hôn hoặc thể hiện tình cảm công khai, nói chung là ở nơi công cộng."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Horseplay, fooling around.",
                    "vi": "Horseplay, đánh lừa xung quanh."
                },
                {
                    "en": "A layabout, one who lallygags.",
                    "vi": "Một kẻ nằm vùng, một kẻ chậm chạp."
                }
            ]
        }
