    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To leave hastily; flee.",
                    "vi": "Ra đi một cách vội vàng; chạy trốn."
                },
                {
                    "en": "To run off or away; leave in a hurry.",
                    "vi": "Để bỏ chạy; vội vàng rời đi."
                },
                {
                    "en": "To move or run away quickly.",
                    "vi": "Để di chuyển hoặc chạy trốn một cách nhanh chóng."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A running or scurrying away.",
                    "vi": "Chạy hoặc chạy trốn."
                }
            ]
        }
    ],
    "meaning_vi": [
        "(thông tục) sự chạy tán loạn",
