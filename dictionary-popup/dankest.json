                {
                    "en": "Disagreeably damp or humid.",
                    "vi": "Không thể phân biệt được ẩm ướt hoặc ẩm ướt."
                },
                {
                    "en": "The definition of dank is very wet and cold.",
                    "vi": "Định nghĩa của dank là rất ướt và lạnh."
                },
                {
                    "en": "Dark, damp and humid.",
                    "vi": "Tối tăm, ẩm thấp."
                },
                {
                    "en": "(figuratively) Highly potent.",
                    "vi": "(nghĩa bóng) Rất mạnh."
                }
