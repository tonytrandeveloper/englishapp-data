            "meaning": [
                {
                    "en": "Having the flavor, aroma, or quality of spice.",
                    "vi": "Có hương vị, mùi thơm hoặc chất lượng của gia vị."
                },
                {
                    "en": "High-spirited; lively.",
                    "vi": "Tinh thần cao; sống động."
                },
                {
                    "en": "Piquant; zesty.",
                    "vi": "Cay; uy nghiêm."
                },
                {
                    "en": "Producing or abounding in spices.",
                    "vi": "Sản xuất hoặc nhiều gia vị."
                },
                {
                    "en": "Slightly scandalous; risqué.",
                    "vi": "Hơi tai tiếng; risqué."
                },
                {
                    "en": "Containing or abounding in spices.",
                    "vi": "Chứa hoặc nhiều gia vị."
                },
                {
                    "en": "Having the flavor or aroma of spice; fragrant, aromatic, or pungent.",
                    "vi": "Có hương vị hoặc mùi thơm của gia vị; thơm, thơm, hoặc hăng."
                },
                {
                    "en": "Piquant or zestful; lively, interesting, etc.",
                    "vi": "Piquant hoặc zestful; sinh động, thú vị, v.v."
                },
                {
                    "en": "Risqué; racy.",
                    "vi": "Risqué; lạnh lùng."
                },
                {
                    "en": "Of, pertaining to, or containing spice.",
                    "vi": "Của, liên quan đến, hoặc có chứa gia vị."
                },
                {
                    "en": "Piquant; provoking a burning sensation due to the presence of chillies or similar spices.",
                    "vi": "Cay; gây cảm giác bỏng rát do có ớt hoặc các loại gia vị tương tự."
                },
                {
                    "en": "(of tastes or scents) Tangy, zesty, or pungent.",
                    "vi": "(vị hoặc mùi hương) Tangy, zesty, hoặc hăng."
                },
                {
                    "en": "(of expression or behavi) Vigorous; colorful; stimulating.",
