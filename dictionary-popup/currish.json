        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or resembling a cur; bad-tempered; mean; ill-bred.",
                    "vi": "Của hoặc giống như một đường cong; nóng tính; bần tiện; xấu số."
                },
                {
                    "en": "Snarling and bad-tempered.",
                    "vi": "Lầm bầm và xấu tính."
                },
                {
                    "en": "Pertaining to a cur or mongrel.",
                    "vi": "Liên quan đến một con chó săn hoặc chó lai."
                },
                {
                    "en": "(now rare) Ignoble, mean-spirited.",
                    "vi": "(bây giờ hiếm) Dốt nát, hèn hạ."
                }
            ]
        }
    ],
