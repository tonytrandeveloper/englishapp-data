        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Consisting of or having many loops.",
                    "vi": "Bao gồm hoặc có nhiều vòng lặp."
                },
                {
                    "en": "Crazy or eccentric.",
                    "vi": "Điên rồ hoặc lập dị."
                },
                {
                    "en": "Offbeat or bizarre.",
                    "vi": "Bất thường hoặc kỳ quái."
                },
                {
                    "en": "Befuddled or disoriented.",
                    "vi": "Băn khoăn hoặc mất phương hướng."
                },
                {
                    "en": "Slightly crazy.",
                    "vi": "Hơi điên rồ."
                },
                {
                    "en": "Confused; befuddled.",
                    "vi": "Bối rối; bối rối."
                },
                {
                    "en": "Having loops.",
                    "vi": "Có vòng lặp."
                },
                {
                    "en": "(slang) Idiotic, crazy or drunk.",
                    "vi": "(tiếng lóng) Ngu ngốc, điên rồ hoặc say xỉn."
                }
            ]
        }
    ],
