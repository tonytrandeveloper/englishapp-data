    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Characterized by the prevalence of disease or sickness; unhealthful.",
                    "vi": "Đặc trưng bởi sự phổ biến của bệnh tật hoặc ốm đau; không có lợi."
                },
                {
                    "en": "Conducive to sickness.",
                    "vi": "Xứng đáng với bệnh tật."
                },
                {
                    "en": "Prone to sickness.",
                    "vi": "Dễ bị ốm."
                },
                {
                    "en": "Causing nausea; nauseating.",
                    "vi": "Gây buồn nôn; buồn nôn."
                },
                {
                    "en": "Lacking vigor or strength; feeble or weak.",
                    "vi": "Thiếu sức sống hoặc sức mạnh; yếu ớt hoặc yếu ớt."
                },
                {
                    "en": "In poor health; chronically sick or prone to sickness; not strong or robust.",
                    "vi": "Trong tình trạng sức khỏe kém; bệnh mãn tính hoặc dễ bị ốm; không mạnh mẽ hoặc mạnh mẽ."
                },
                {
                    "en": "Of or produced by sickness.",
                    "vi": "Của hoặc sản xuất bởi bệnh tật."
                },
                {
                    "en": "Sickening; nauseating.",
                    "vi": "Sickening; buồn nôn."
                },
                {
                    "en": "Faint; feeble.",
                    "vi": "Mờ nhạt; yếu ớt."
                },
                {
                    "en": "Weak; mawkish.",
                    "vi": "Yếu ớt; mawkish."
                },
                {
                    "en": "Prone to sickness.",
                    "vi": "Dễ bị ốm."
                },
                {
                    "en": "Of, caused by, or associated with sickness.",
                    "vi": "Của, gây ra, hoặc liên quan đến bệnh tật."
                },
                {
                    "en": "Conducive to sickness.",
                    "vi": "Xứng đáng với bệnh tật."
                },
                {
                    "en": "Causing nausea; nauseating.",
                    "vi": "Gây buồn nôn; buồn nôn."
                },
                {
                    "en": "Frequently ill; often in poor health; given to becoming ill.",
                    "vi": "Thường xuyên bị ốm; thường xuyên trong tình trạng sức khỏe kém; bị bệnh."
                },
                {
                    "en": "Having the appearance of sickness or ill health; appearing ill, infirm or unhealthy; pale.",
                    "vi": "Có biểu hiện ốm yếu hoặc sức khỏe kém; xuất hiện ốm yếu, ốm yếu hoặc không khỏe mạnh; tái nhợt."
                },
                {
                    "en": "Weak; faint; suggesting unhappiness.",
                    "vi": "Yếu ớt; mờ nhạt; gợi sự bất hạnh."
                },
                {
                    "en": "Somewhat sick; disposed to illness; attended with disease.",
                    "vi": "Hơi ốm; giải quyết bệnh tật; tham dự với bệnh tật."
                },
                {
                    "en": "Tending to produce disease.",
