            "pos": "adjective",
            "meaning": [
                {
                    "en": "Resistant to authority or discipline; recalcitrant.",
                    "vi": "Chống lại quyền hạn hoặc kỷ luật; ngoan cố."
                },
                {
                    "en": "Not docile; difficult to manage or discipline.",
                    "vi": "Không ngoan ngoãn; khó quản lý hoặc kỷ luật."
                },
                {
                    "en": "Unwilling to be taught or instructed; intractable or recalcitrant.",
                    "vi": "Không muốn được dạy hoặc hướng dẫn; khó chữa hoặc ngoan cố."
                }
            ]
        }
    ],
