            "meaning": [
                {
                    "en": "A flippant act or remark.",
                    "vi": "Một hành động hoặc nhận xét xuề xòa."
                },
                {
                    "en": "A disrespectful levity or pertness especially in respect to grave or sacred matters.",
                    "vi": "Một sự khinh suất hoặc sai trái không tôn trọng, đặc biệt là đối với các vấn đề nghiêm trọng hoặc linh thiêng."
                },
                {
                    "en": "The quality or state of being flippant.",
                    "vi": "Chất lượng hoặc trạng thái không ổn định."
                }
            ]
        }
    ],
