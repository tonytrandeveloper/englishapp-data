                },
                {
                    "en": "A person who believes in mentalism.",
                    "vi": "Một người tin vào thuyết tâm thần."
                },
                {
                    "en": "A person who professes to read minds or tell fortunes.",
                    "vi": "Một người tự xưng là đọc được suy nghĩ hoặc nói về vận may."
                },
                {
                    "en": "A practitioner of mentalism.",
                    "vi": "Một học viên của chủ nghĩa tâm thần."
                },
                {
                    "en": "(slang) An insane person.",
                    "vi": "(tiếng lóng) Một người mất trí."
                }
            ]
        },
