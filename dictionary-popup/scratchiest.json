    "phonetics": {
        "uk": "ˈskræʧɪɪst",
        "us": "ˈskræʧɪɪst"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Marked by or consisting of scratches.",
                    "vi": "Được đánh dấu bằng hoặc bao gồm các vết xước."
                },
                {
                    "en": "Making a harsh scratching noise.",
                    "vi": "Tạo ra một tiếng cào mạnh."
                },
                {
                    "en": "Harsh and irritating.",
                    "vi": "Khắc nghiệt và khó chịu."
                },
                {
                    "en": "Irregular; uneven.",
                    "vi": "Không thường xuyên; không đồng đều."
                },
                {
                    "en": "Having the appearance of being drawn roughly, hurriedly, etc.; made with scratches.",
                    "vi": "Có hình thức vẽ đại khái, vội vàng, v.v ...; được thực hiện với các vết xước."
                },
                {
                    "en": "Making a scratching or scraping noise.",
                    "vi": "Tạo ra tiếng cào hoặc tiếng cào."
                },
                {
                    "en": "Scratched together; haphazard.",
                    "vi": "Trầy xước với nhau; bừa bãi."
                },
                {
                    "en": "That scratches, scrapes, chafes, itches, etc.",
                    "vi": "Vết xước, vết xước, vết xước, vết ngứa, v.v."
                },
                {
                    "en": "Characterized by scratches.",
                    "vi": "Đặc trưng bởi các vết xước."
                },
                {
                    "en": "Annoying, irritating, itchy.",
                    "vi": "Khó chịu, khó chịu, ngứa ngáy."
                },
                {
                    "en": "(informal, of an analogue radio transmission) Noisy, lossy; marred by white noise or static as a result of poor or low signal, interference or unfavourable atmospheric conditions.",
                    "vi": "(không chính thức, truyền dẫn vô tuyến tương tự) Ồn ào, mất mát; bị nhiễu bởi tiếng ồn trắng hoặc tĩnh do tín hiệu kém hoặc thấp, nhiễu hoặc các điều kiện khí quyển không thuận lợi."
                }
            ]
        }
    ],
