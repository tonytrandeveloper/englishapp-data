    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(archaic) To stop; end.",
                    "vi": "(cổ xưa) Để dừng lại; chấm dứt."
                },
                {
                    "en": "To bring or come to an end; stop.",
                    "vi": "Để mang lại hoặc kết thúc; ngừng lại."
                },
                {
                    "en": "(intransitive) To come to an end; to desist.",
                    "vi": "(intransitive) Để kết thúc; để hủy bỏ."
                },
                {
                    "en": "To bring to an end.",
                    "vi": "Để kết thúc."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "An end, or cessation.",
                    "vi": "Một sự kết thúc, hoặc sự chấm dứt."
                },
                {
                    "en": "Cessation; stop; end.",
                    "vi": "Đình chỉ; ngừng lại; chấm dứt."
                },
                {
                    "en": "Cessation.",
                    "vi": "Đình chỉ."
                }
            ]
        }
    ],
