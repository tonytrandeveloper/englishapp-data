    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A favorable remark that one has overheard about another person and offers to repeat to that person in exchange for a compliment overheard about oneself.",
                    "vi": "Một nhận xét thuận lợi mà một người đã nghe lỏm về một người khác và đề nghị lặp lại với người đó để đổi lấy một lời khen ngợi về bản thân họ."
                },
                {
                    "en": "A compliment offered to be repeated in exchange for another.",
                    "vi": "Một lời khen được đề nghị lặp lại để đổi lấy một lời khen khác."
                }
            ]
        }
    ],
