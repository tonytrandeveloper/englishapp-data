    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Lacking soundness or sturdiness, as of construction.",
                    "vi": "Thiếu âm thanh hoặc độ bền, khi xây dựng."
                },
                {
                    "en": "Not to be depended on; precarious.",
                    "vi": "Không để bị phụ thuộc vào; bấp bênh."
                },
                {
                    "en": "Wavering in firmness.",
                    "vi": "Dao động trong sự vững chắc."
                },
                {
                    "en": "Open to question or doubt.",
                    "vi": "Mở câu hỏi hoặc nghi ngờ."
                },
                {
                    "en": "Not firm, substantial, or secure; weak, unsound, or unsteady.",
                    "vi": "Không chắc chắn, đáng kể hoặc an toàn; yếu, không ổn định hoặc không ổn định."
                },
                {
                    "en": "Not dependable or reliable; questionable.",
                    "vi": "Không đáng tin cậy hoặc đáng tin cậy; nghi vấn."
                },
                {
                    "en": "Trembling or tremulous.",
                    "vi": "Run rẩy hoặc run rẩy."
                },
                {
                    "en": "Nervous or jittery.",
                    "vi": "Lo lắng hoặc bồn chồn."
                },
                {
                    "en": "Shaking or trembling.",
                    "vi": "Run rẩy hoặc run rẩy."
                },
                {
                    "en": "Nervous; Anxious.",
                    "vi": "Thần kinh; Lo lắng."
                },
                {
                    "en": "(of wood) Full of shakes or cracks; cracked.",
                    "vi": "(bằng gỗ) Đầy rung chuyển hoặc nứt nẻ; nứt nẻ."
                },
                {
                    "en": "Easily shaken; tottering; unsound.",
                    "vi": "Dễ bị rung lắc; loạng choạng; không chắc chắn."
                },
                {
                    "en": "Trembling or quivering; tremulous.",
                    "vi": "Run rẩy hoặc run rẩy; run."
                }
            ]
        }
    ],
