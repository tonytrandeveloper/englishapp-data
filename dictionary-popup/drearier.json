            "meaning": [
                {
                    "en": "Gloomy; cheerless; depressing; dismal; dull.",
                    "vi": "U ám; vui vẻ; chán nản; ảm đạm; đần độn."
                },
                {
                    "en": "Boring; dull.",
                    "vi": "Nhàm chán; đần độn."
                },
                {
                    "en": "Dismal; bleak.",
                    "vi": "Suy mòn; ảm đạm."
                },
                {
                    "en": "Drab; dark, colorless, or cheerless.",
                    "vi": "Buồn tẻ; tối, không màu hoặc không có màu sắc tươi vui."
                },
                {
                    "en": "The definition of dreary is something that is gloomy or depressing.",
                    "vi": "Định nghĩa của ảm đạm là một cái gì đó u ám hoặc buồn bã."
                }
            ]
        }
