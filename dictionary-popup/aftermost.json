    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Nearest the stern; farthest aft.",
                    "vi": "Gần nhất đuôi tàu; xa nhất về phía sau."
                },
                {
                    "en": "Nearest the end or rear; hindmost or last.",
                    "vi": "Gần nhất cuối hoặc phía sau; sau cùng hoặc cuối cùng."
                },
                {
                    "en": "Nearest to the stern.",
                    "vi": "Gần đuôi tàu nhất."
                },
                {
                    "en": "(nautical) Nearest the stern of a vessel; hindmost.",
                    "vi": "(hải lý) Gần đuôi tàu; sau cùng."
                }
            ]
        }
    ],
    "meaning_vi": [
