            "meaning": [
                {
                    "en": "The quality of being perspicuous; clearness and lucidity.",
                    "vi": "Chất lượng của việc dễ nhìn thấy; sự minh mẫn và sáng suốt."
                },
                {
                    "en": "Perspicacity.",
                    "vi": "Độ mờ ảo."
                },
                {
                    "en": "Clarity, lucidity, especially in expression; the state or characteristic of being perspicuous.",
                    "vi": "Sự sáng suốt, minh mẫn, đặc biệt là trong cách diễn đạt; trạng thái hoặc đặc điểm dễ thấy."
                },
                {
                    "en": "Perspicacity; insight.",
                    "vi": "Tính cách; cái nhìn sâu sắc."
                },
                {
                    "en": "(rare) Transparency; translucence.",
                    "vi": "(hiếm) Tính minh bạch; trong suốt."
                }
            ]
        }
    ],
