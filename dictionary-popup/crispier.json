                    "vi": "Sắc nét."
                },
                {
                    "en": "Having small curls, waves, or ripples.",
                    "vi": "Có các lọn tóc nhỏ, sóng hoặc gợn sóng."
                },
                {
                    "en": "Having a crisp texture; brittle yet tender.",
                    "vi": "Có một kết cấu rõ nét; giòn nhưng mềm."
                }
            ]
