    "phonetics": {
        "uk": "ˈʃruːdɪst",
        "us": "ˈʃrudəst"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having or showing a clever awareness or resourcefulness, especially in practical matters.",
                    "vi": "Có hoặc thể hiện một nhận thức thông minh hoặc sự tháo vát, đặc biệt là trong các vấn đề thực tế."
                },
                {
                    "en": "Keen-witted, clever, or sharp in practical affairs; astute.",
                    "vi": "Nhạy bén, thông minh, nhạy bén trong công việc thực tế; sắc sảo."
                },
                {
                    "en": "Disposed to or marked by artful and cunning practices; tricky.",
                    "vi": "Xử lý hoặc đánh dấu bằng các hoạt động nghệ thuật và xảo quyệt; khó khăn."
                },
                {
                    "en": "The definition of shrewd is sharp or intelligent with practical concerns.",
                    "vi": "Định nghĩa của sắc sảo là sắc sảo hoặc thông minh với những mối quan tâm thực tế."
                },
                {
                    "en": "Streetwise.",
                    "vi": "Theo chiều đường phố."
                },
                {
                    "en": "Knowledgeable.",
                    "vi": "Có kiến thức."
                },
                {
                    "en": "(archaic) Scolding, satirical, sharp.",
                    "vi": "(cổ) Chửi mắng, trào phúng, đanh thép."
                },
                {
                    "en": "(archaic) Keen; piercing; sharp.",
                    "vi": "(cổ xưa) Keen; xuyên; nhọn."
                },
                {
                    "en": "Evil, bad, wicked, mischievous, shrewish, etc.",
                    "vi": "Ác, xấu, độc ác, ranh ma, láu cá, v.v."
                },
                {
                    "en": "Artful, cunning, wily, etc. in one's dealings with others.",
                    "vi": "Nghệ thuật, xảo quyệt, quỷ quyệt, v.v. trong cách cư xử của một người với người khác."
                },
                {
                    "en": "Showing clever resourcefulness in practical matters.",
                    "vi": "Thể hiện sự tháo vát thông minh trong các vấn đề thực tế."
                },
                {
                    "en": "Artful, tricky or cunning.",
                    "vi": "Nghệ thuật, khôn lanh hoặc xảo quyệt."
                },
                {
                    "en": "(archaic) Sharp; penetrating.",
                    "vi": "(cổ xưa) Sắc nét; thấm thía."
                }
            ]
        }
    ],
    "meaning_vi": [
