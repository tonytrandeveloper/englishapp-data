    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Prejudice or bias in favor of something.",
                    "vi": "Định kiến hoặc thiên vị về điều gì đó."
                },
                {
                    "en": "Particular fondness or liking.",
                    "vi": "Yêu thích hoặc thích đặc biệt."
                },
                {
                    "en": "A special fondness; a predilection.",
                    "vi": "Một sự yêu thích đặc biệt; một xu hướng."
                },
                {
                    "en": "The state or quality of being partial; tendency to favor unfairly; bias.",
                    "vi": "Trạng thái hoặc chất lượng của một phần; khuynh hướng ưu ái không công bằng; Thiên kiến."
                },
                {
                    "en": "Partiality is defined as a fondness or a bias towards something or someone.",
                    "vi": "Tính đảng phái được định nghĩa là sự yêu thích hoặc thiên vị đối với một cái gì đó hoặc một người nào đó."
                },
                {
                    "en": "Preference, bias in favor of, tendency.",
                    "vi": "Sự ưa thích, sự thiên vị trong sự ủng hộ, xu hướng."
                }
            ]
        }
    ],
