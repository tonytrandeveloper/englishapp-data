    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The state or fact of being entire; wholeness; completeness.",
                    "vi": "Trạng thái hoặc thực tế của toàn bộ; sự toàn vẹn; sự đầy đủ."
                },
                {
                    "en": "An entire thing; whole; total.",
                    "vi": "Toàn bộ điều; trọn; toàn bộ."
                },
                {
                    "en": "The state of being entire or complete; wholeness.",
                    "vi": "Trạng thái toàn bộ hoặc toàn bộ; sự toàn vẹn."
                },
                {
                    "en": "The entire amount or extent; the whole.",
                    "vi": "Toàn bộ số tiền hoặc mức độ; toàn bộ."
                },
                {
                    "en": "(law) Undivided or sole possession.",
                    "vi": "(luật) Sở hữu không phân chia hoặc duy nhất."
                },
                {
                    "en": "Entirety is defined as the whole thing, or the state of being complete.",
                    "vi": "Toàn bộ được định nghĩa là toàn bộ hay trạng thái hoàn chỉnh."
                },
                {
                    "en": "The whole of a thing; something incapable of being divided.",
                    "vi": "Toàn bộ của một sự vật; một cái gì đó không có khả năng bị phân chia."
                },
                {
                    "en": "Wholeness; fullness; the whole.",
                    "vi": "Tính toàn vẹn; viên mãn; toàn bộ."
                }
            ]
        },
        {
            "pos": "idiom",
            "meaning": [
                {
                    "en": "in its entirety  as a whole; completely",
                    "vi": "trong toàn bộ tổng thể của nó; hoàn toàn"
                }
            ]
        }
    ],
