    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Designating or of a list of tasks one must attend to.",
                    "vi": "Chỉ định hoặc một danh sách các nhiệm vụ mà một người phải tham gia."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "An excited reaction; a commotion or fuss.",
                    "vi": "Một phản ứng phấn khích; một sự náo động hoặc ồn ào."
                },
                {
                    "en": "A commotion; stir; fuss.",
                    "vi": "Một sự náo động; khuấy động; ồn ào."
                },
                {
                    "en": "A task yet to be done; an item on a to-do list.",
                    "vi": "Một nhiệm vụ chưa được thực hiện; một mục trong danh sách việc cần làm."
                },
                {
                    "en": "(archaic) Ado.",
                    "vi": "(cổ xưa) Ado."
                },
                {
                    "en": "A task that has been noted as one that must be completed, especially on a list.",
                    "vi": "Một nhiệm vụ đã được ghi nhận là một nhiệm vụ phải được hoàn thành, đặc biệt là trên một danh sách."
                },
                {
                    "en": "A fuss made over something, commotion.",
                    "vi": "Một sự ồn ào đã tạo ra một cái gì đó, náo động."
                }
            ]
        }
    ],
