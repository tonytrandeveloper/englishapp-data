            "meaning": [
                {
                    "en": "Great intellectual insight or understanding.",
                    "vi": "Trí tuệ sáng suốt hoặc sự hiểu biết tuyệt vời."
                },
                {
                    "en": "Depth, esp. great depth.",
                    "vi": "Độ sâu, đặc biệt. rất sâu."
                },
                {
                    "en": "Intellectual depth.",
                    "vi": "Chiều sâu trí tuệ."
                },
                {
                    "en": "Profundity is defined as intellectual or emotional depth, or to an idea that shows great intellectual depth.",
                    "vi": "Sự sâu sắc được định nghĩa là chiều sâu trí tuệ hoặc cảm xúc, hoặc một ý tưởng thể hiện chiều sâu trí tuệ tuyệt vời."
                },
                {
                    "en": "Intensity of feeling or conviction.",
                    "vi": "Cường độ của cảm giác hoặc niềm tin."
                },
                {
                    "en": "Something profound or abstruse.",
                    "vi": "Một cái gì đó sâu sắc hoặc trừu tượng."
                },
                {
                    "en": "Great extent downward; great depth.",
                    "vi": "Mức độ lớn đi xuống; rất sâu."
                },
                {
                    "en": "A profound idea, matter, etc.",
                    "vi": "Một ý tưởng sâu sắc, vấn đề, v.v."
                },
                {
                    "en": "The state of being profound or abstruse.",
                    "vi": "Trạng thái sâu sắc hoặc trừu tượng."
                },
                {
                    "en": "A great depth.",
                    "vi": "Một chiều sâu tuyệt vời."
                },
                {
                    "en": "Deep intellect or insight.",
                    "vi": "Trí tuệ hay sự sáng suốt sâu sắc."
                }
            ]
        }
    ],
