    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Marked or characterized by overacting; affectedly humorous or dramatic.",
                    "vi": "Được đánh dấu hoặc được đặc trưng bởi hoạt động quá mức; hài hước hoặc kịch tính bị ảnh hưởng."
                },
                {
                    "en": "(slang) Like or characteristic of a ham (actor); overacting.",
                    "vi": "(tiếng lóng) Giống hoặc đặc điểm của ham (diễn viên); quá mức."
                },
                {
                    "en": "Resembling ham.",
                    "vi": "Giăm bông có vẻ giống."
                },
                {
                    "en": "Amateurish; characterized by overacting.",
                    "vi": "Nghiệp dư; có đặc điểm là hoạt động quá mức."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(US, Australia, New Zealand, chiefly sports, slang) Short for hamstring; a hamstring injury.",
                    "vi": "(Mỹ, Úc, New Zealand, chủ yếu là thể thao, tiếng lóng) Viết tắt của hamstring; chấn thương gân khoeo."
                },
                {
                    "en": "(informal, childish) A hamster.",
                    "vi": "(thân mật, trẻ con) Một con chuột đồng."
                }
            ]
        }
    ],
    "meaning_vi": [
        "(thông tục) không có kinh nghiệm (diễn viên)"
