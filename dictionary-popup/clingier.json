            "meaning": [
                {
                    "en": "The definition of clingy is a person or fabric that stays near or hangs on.",
                    "vi": "Định nghĩa của bám dính là một người hoặc vải ở gần hoặc bám vào."
                },
                {
                    "en": "Having a tendency to cling.",
                    "vi": "Có xu hướng bám víu."
                },
                {
                    "en": "(informal, usually derogatory) Pathetically possessive of someone, usually a significant other.",
                    "vi": "(không chính thức, thường là xúc phạm) Sở hữu một cách thảm hại ai đó, thường là một người quan trọng khác."
                }
            ]
        }
