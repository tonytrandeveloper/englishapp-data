    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "The definition of filmy is something airy, sheer or hazy.",
                    "vi": "Định nghĩa của filmy là một cái gì đó thoáng đãng, tuyệt đối hoặc mơ hồ."
                },
                {
                    "en": "Covered with a film or sheen.",
                    "vi": "Được bao phủ bởi một bộ phim hoặc ánh sáng."
                },
                {
                    "en": "Gauzy; sheer; very thin.",
                    "vi": "Gauzy; tuyệt đối; rất mỏng."
                },
                {
                    "en": "Blurred or hazy.",
                    "vi": "Mờ hoặc mơ hồ."
                },
                {
                    "en": "Resembling or made of a thin film; gauzy.",
                    "vi": "Kết dính hoặc làm từ một màng mỏng; gầy còm."
                },
                {
                    "en": "Covered by (as if by) a film; hazy.",
                    "vi": "Được bao phủ bởi (như thể bởi) một bộ phim; mơ hồ."
                },
                {
                    "en": "Resembling film in thinness or translucency; gauzy.",
                    "vi": "Màng kết dính ở độ mỏng hoặc trong suốt; gầy còm."
                }
            ]
        }
    ],
    "meaning_vi": [
