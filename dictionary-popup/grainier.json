    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having a granular appearance, as from the clumping of particles in the emulsion of a photograph.",
                    "vi": "Có dạng hạt, giống như sự kết tụ của các hạt trong nhũ tương của một bức ảnh."
                },
                {
                    "en": "Made of or resembling grain; granular.",
                    "vi": "Làm bằng hoặc giống hạt; dạng hạt."
                },
                {
                    "en": "Resembling the grain of wood.",
                    "vi": "Giống như các thớ gỗ."
                },
                {
                    "en": "Having a clearly defined grain.",
                    "vi": "Có một hạt xác định rõ ràng."
                },
                {
                    "en": "Consisting of grains; coarsely textured; granular.",
                    "vi": "Bao gồm các loại ngũ cốc; kết cấu thô; dạng hạt."
                },
                {
                    "en": "Resembling grains; granular.",
                    "vi": "Hạt giống; dạng hạt."
                },
                {
                    "en": "Coarsely ground or gritty.",
                    "vi": "Đất thô hoặc sạn."
                }
            ]
        }
    ],
