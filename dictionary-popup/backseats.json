                },
                {
                    "en": "A secondary or inconspicuous position.",
                    "vi": "Vị trí thứ yếu hoặc không dễ thấy."
                },
                {
                    "en": "Any of the seats in the rear of a vehicle.",
                    "vi": "Bất kỳ ghế nào ở phía sau xe."
                },
                {
