            "meaning": [
                {
                    "en": "Disagreeably damp; moist and chilly.",
                    "vi": "Ẩm ướt đáng kinh ngạc; ẩm và lạnh."
                },
                {
                    "en": "Disagreeably damp or humid.",
                    "vi": "Không thể phân biệt được ẩm ướt hoặc ẩm ướt."
                },
                {
                    "en": "The definition of dank is very wet and cold.",
                    "vi": "Định nghĩa của dank là rất ướt và lạnh."
                },
                {
                    "en": "Dark, damp and humid.",
                    "vi": "Tối tăm, ẩm thấp."
                },
                {
                    "en": "(figuratively) Highly potent.",
                    "vi": "(nghĩa bóng) Rất mạnh."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(obsolete, intransitive) To moisten, dampen; used of mist, dew etc.",
                    "vi": "(lỗi thời, không liên quan) Để làm ẩm, làm ẩm ướt; sử dụng sương mù, sương, v.v."
