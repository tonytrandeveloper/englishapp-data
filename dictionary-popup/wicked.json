    "sentences": [
        {
            "en": "It was a wicked thing to say.",
            "vi": "Đó là một điều xấu xa để nói."
        },
        {
            "en": "It was a wicked thought.",
            "vi": "Đó là một suy nghĩ xấu xa."
        },
        {
            "en": "And finally she made a wicked plan to satisfy her depraved appetite for pork.",
            "vi": "Và cuối cùng cô đã thực hiện một kế hoạch độc ác để thỏa mãn cơn thèm ăn thịt lợn sa đọa của mình."
        },
        {
            "en": "Meet the original wicked stepmother.",
            "vi": "Gặp lại bà mẹ kế độc ác ban đầu."
        },
        {
            "en": "Oh, that wicked Prince Hippolyte! she said.",
            "vi": "Ôi, hoàng tử Hippolyte độc ác đó! cô ấy nói."
        },
        {
            "en": "The punishment of the wicked especially occupies his thoughts.",
            "vi": "Sự trừng phạt của kẻ ác đặc biệt chiếm trọn suy nghĩ của anh ta."
        },
        {
            "en": "The wicked side of her wanted to push in a few books next time he left, just to irk him.",
            "vi": "Mặt xấu xa của cô muốn đẩy vài cuốn sách vào lần sau khi anh rời đi, chỉ để làm anh khó chịu."
        },
        {
            "en": "He leaned in close with a wicked smile.",
            "vi": "Anh ta ghé sát vào với một nụ cười xấu xa."
        },
        {
            "en": "He pulled a wicked, toothy grin.",
            "vi": "Anh ta nở một nụ cười nham nhở, nham nhở."
        },
        {
            "en": "Even now he was helping Katie push her out into the wicked world.",
            "vi": "Thậm chí bây giờ anh ấy đang giúp Katie đẩy cô ấy vào thế giới xấu xa."
        }
    ]
