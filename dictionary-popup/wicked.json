    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Evil or immoral.",
                    "vi": "Ác độc hoặc vô đạo đức."
                },
                {
                    "en": "Severe and distressing.",
                    "vi": "Nặng nề và xót xa."
                },
                {
                    "en": "Playfully malicious or mischievous.",
                    "vi": "Tinh nghịch hoặc tinh quái."
                },
                {
                    "en": "Naughty in a playful way; mischievous.",
                    "vi": "Nghịch ngợm một cách vui tươi; nghịch ngợm."
                },
                {
                    "en": "Highly offensive; obnoxious.",
                    "vi": "Có tính công kích cao; khó ưa."
                },
                {
                    "en": "Painful, unpleasant, etc.",
                    "vi": "Đau đớn, khó chịu, v.v."
                },
                {
                    "en": "The definition of wicked is someone or something who is cruel or acts in an evil way.",
                    "vi": "Định nghĩa về kẻ ác là ai đó hoặc điều gì đó độc ác hoặc hành động theo cách xấu xa."
                },
                {
                    "en": "(slang) Strikingly good, effective, or skillful.",
                    "vi": "(tiếng lóng) Đặc biệt tốt, hiệu quả hoặc khéo léo."
                },
                {
                    "en": "Evil or mischievous by nature.",
                    "vi": "Bản chất xấu xa hay tinh quái."
                },
                {
                    "en": "(slang) Excellent; awesome; masterful; deeply satisfying.",
                    "vi": "(tiếng lóng) Tuyệt vời; đáng kinh ngạc; thành thạo; thỏa mãn sâu sắc."
                },
                {
                    "en": "Having a wick.",
                    "vi": "Có một bấc."
                },
                {
                    "en": "(slang) Showing great skill.",
                    "vi": "(tiếng lóng) Thể hiện kỹ năng tuyệt vời."
                },
                {
                    "en": "Morally bad or wrong; acting or done with evil intent; depraved.",
                    "vi": "Đạo đức tồi tệ hoặc sai trái; hành động hoặc thực hiện với ý định xấu xa; đồi trụy."
                },
                {
                    "en": "Vicious; cruel.",
                    "vi": "Luẩn quẩn; hung ác."
                },
                {
                    "en": "(UK, dialect, chiefly Yorkshire) Infested with maggots.",
                    "vi": "(Vương quốc Anh, thổ ngữ, chủ yếu là Yorkshire) Bị nhiễm giòi."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "Used as an intensive.",
                    "vi": "Được sử dụng như một chuyên sâu."
                },
                {
                    "en": "(slang, New England, UK) Very, extremely.",
                    "vi": "(tiếng lóng, New England, Vương quốc Anh) Rất, vô cùng."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Simple past tense and past participle of wick.",
                    "vi": "Quá khứ đơn và quá khứ phân từ của wick."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "People who are wicked.",
                    "vi": "Những người độc ác."
                }
            ]
        }
