                },
                {
                    "en": "A person regarded as fallen from society; an outcast.",
                    "vi": "Một người bị coi là sa ngã khỏi xã hội; người bị đuổi."
                },
                {
                    "en": "An outcast from society.",
                    "vi": "Một kẻ bị xã hội ruồng bỏ."
                },
                {
                    "en": "Refuse removed from something by scouring.",
                    "vi": "Loại bỏ từ chối khỏi một cái gì đó bằng cách cọ rửa."
                },
                {
                    "en": "(figuratively) An outcast, a pariah.",
                    "vi": "(nghĩa bóng) Một kẻ bị ruồng bỏ, một kẻ xấu xa."
                },
                {
                    "en": "Something scoured off; rubbish; refuse.",
                    "vi": "Một cái gì đó đã được quét sạch; rác; từ chối."
