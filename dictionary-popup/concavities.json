    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The state of being curved like the inner surface of a sphere.",
                    "vi": "Trạng thái cong như mặt trong của quả cầu."
                },
                {
                    "en": "A surface or structure configured in such a curve.",
                    "vi": "Một bề mặt hoặc cấu trúc được cấu hình theo một đường cong như vậy."
                },
                {
                    "en": "The quality or condition of being concave.",
                    "vi": "Chất lượng hoặc tình trạng bị lõm."
                },
                {
                    "en": "A concave surface, line, etc.",
                    "vi": "Bề mặt lõm, đường, v.v."
                },
                {
                    "en": "(uncountable) The state of being concave.",
                    "vi": "(không đếm được) Tình trạng bị lõm."
                },
                {
                    "en": "(countable) A concave structure or surface.",
                    "vi": "(đếm được) Một cấu trúc hoặc bề mặt lõm."
                }
            ]
        }
    ],
    "meaning_vi": [
