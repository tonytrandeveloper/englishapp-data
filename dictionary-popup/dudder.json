    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(UK, dated) A peddler or hawker, especially of cheap and flashy goods pretended to be smuggled; a duffer.",
                    "vi": "(Vương quốc Anh, đề ngày) Một người bán rong hoặc bán rong, đặc biệt là những mặt hàng rẻ tiền và hào nhoáng đã giả vờ buôn lậu; một người thợ thô."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To confuse or confound with noise.",
                    "vi": "Để gây nhầm lẫn hoặc nhầm lẫn với tiếng ồn."
                },
                {
                    "en": "(intransitive) To shiver or tremble; to dodder.",
                    "vi": "(nội tâm) Rùng mình hoặc run rẩy; để tránh né."
                }
            ]
        }
    ],
