    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A dishonest act or statement; fraud, lie, etc.",
                    "vi": "Một hành động hoặc tuyên bố không trung thực; gian lận, dối trá, v.v."
                },
                {
                    "en": "Lack of honesty or integrity; improbity.",
                    "vi": "Thiếu trung thực hoặc liêm chính; sự ngẫu hứng."
                },
                {
                    "en": "A dishonest act or statement.",
                    "vi": "Một hành động hoặc tuyên bố không trung thực."
                },
                {
                    "en": "The quality of being dishonest; dishonest behavior; deceiving, stealing, etc.",
                    "vi": "Phẩm chất không trung thực; hành vi không trung thực; lừa dối, ăn cắp, v.v."
                },
                {
                    "en": "(uncountable) The characteristic or condition of being dishonest.",
                    "vi": "(không đếm được) Đặc điểm hoặc tình trạng không trung thực."
                },
                {
                    "en": "(countable) An act which is fraudulent or otherwise dishonest.",
                    "vi": "(có thể đếm được) Một hành động gian lận hoặc không trung thực."
                }
            ]
        }
    ],
    "meaning_vi": [
