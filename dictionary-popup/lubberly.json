    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Clumsy and stupid; resembling a lubber (an inexperienced person).",
                    "vi": "Vụng về và ngu ngốc; giống như một lubber (một người thiếu kinh nghiệm)."
                },
                {
                    "en": "Lacking in seamanship; of or suitable to a landlubber who is new to being at sea and unfamiliar with the ways of a sailor.",
                    "vi": "Thiếu đường may; hoặc phù hợp với chủ nhà mới đi biển và chưa quen với cách sống của một thủy thủ."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "In the manner of a landlubber.",
                    "vi": "Theo cách của một chủ nhà trọ."
                }
            ]
        }
    ],
    "meaning_vi": [
        "vụng về; ngớ ngẩn, khờ dại"
