    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A speech disorder in which the flow of speech is disrupted by involuntary repetitions and prolongations of sounds, syllables, words or phrases, and by involuntary silent pauses or blocks in which the stutterer is unable to produce sounds.",
                    "vi": "Rối loạn giọng nói trong đó luồng lời nói bị gián đoạn bởi sự lặp lại và kéo dài không tự chủ của âm thanh, âm tiết, từ hoặc cụm từ và bởi những khoảng dừng hoặc khối im lặng không chủ ý trong đó người nói lắp không thể phát ra âm thanh."
                },
                {
                    "en": "An instance of stuttering.",
                    "vi": "Một trường hợp nói lắp."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of stutter.",
                    "vi": "Hiện tại phân từ của nói lắp."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "That stutters.",
                    "vi": "Nói lắp đó."
                },
                {
                    "en": "(figuratively) Hesitant.",
                    "vi": "(nghĩa bóng) Do dự."
                }
            ]
        }
    ],
