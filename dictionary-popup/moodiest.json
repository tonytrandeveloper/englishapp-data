    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Subject to periods of depression; sulky.",
                    "vi": "Tùy thuộc vào giai đoạn trầm cảm; hờn dỗi."
                },
                {
                    "en": "Given to frequent changes of mood; temperamental.",
                    "vi": "Do tâm trạng thay đổi thường xuyên; thất thường."
                },
                {
                    "en": "Subject to or characterized by gloomy, sullen moods or changes of mood.",
                    "vi": "Chủ đề hoặc được đặc trưng bởi tâm trạng u ám, ủ rũ hoặc thay đổi tâm trạng."
                },
                {
                    "en": "Resulting from or indicating such a mood.",
                    "vi": "Kết quả từ hoặc chỉ ra một tâm trạng như vậy."
                },
                {
                    "en": "Expressive of a mood, especially a sullen or gloomy mood.",
                    "vi": "Biểu hiện của một tâm trạng, đặc biệt là tâm trạng ủ rũ hoặc u ám."
                },
                {
                    "en": "The definition of moody is someone who experiences wild shifts in emotions, often from happy to sad or nice to mean quickly or without reason.",
                    "vi": "Định nghĩa của ủ rũ là một người trải qua những thay đổi dữ dội trong cảm xúc, thường là từ vui sang buồn hoặc tốt đẹp có nghĩa là nhanh chóng hoặc không có lý do."
                },
                {
                    "en": "Given to sudden or frequent changes of mind; temperamental.",
                    "vi": "Do thay đổi tâm trí đột ngột hoặc thường xuyên; thất thường."
                },
                {
                    "en": "Sulky or depressed.",
                    "vi": "Buồn bã hoặc chán nản."
                },
                {
                    "en": "Dour, gloomy or brooding.",
                    "vi": "Ảm đạm, u ám hoặc nghiền ngẫm."
                },
                {
                    "en": "(slang) Dodgy or stolen.",
                    "vi": "(tiếng lóng) Dodgy hoặc ăn cắp."
                }
            ]
        },
        {
