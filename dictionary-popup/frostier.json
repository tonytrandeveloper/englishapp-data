            "meaning": [
                {
                    "en": "Silvery white; hoary.",
                    "vi": "Màu trắng bạc; hoary."
                },
                {
                    "en": "Producing or characterized by frost; freezing.",
                    "vi": "Sản xuất hoặc đặc trưng bởi sương giá; đóng băng."
                },
                {
                    "en": "Covered with frost.",
                    "vi": "Được bao phủ bởi sương giá."
                },
                {
                    "en": "Cold in manner; unfriendly.",
                    "vi": "Lạnh lùng trong cách thức; không thân thiện."
                },
                {
                    "en": "Lacking enthusiasm.",
                    "vi": "Thiếu nhiệt tình."
                },
                {
                    "en": "Producing frost or cold enough to produce frost; freezing.",
                    "vi": "Sản xuất sương giá hoặc đủ lạnh để tạo ra sương giá; đóng băng."
                },
                {
                    "en": "Covered with or as with frost; hoary, glistening, etc.",
                    "vi": "Được bao phủ bởi hoặc như với sương giá; hoary, lấp lánh, v.v."
                },
                {
                    "en": "Cold in manner or feeling; austere; unfriendly.",
                    "vi": "Lạnh lùng về cách thức hoặc cảm giác; khắc khổ; không thân thiện."
                },
                {
                    "en": "Cold, chilly.",
                    "vi": "Lạnh lạnh."
                },
                {
                    "en": "Having frost on it.",
                    "vi": "Có sương giá trên đó."
                },
                {
                    "en": "(figuratively) Having an aloof or inhospitable manner.",
                    "vi": "(nghĩa bóng) Có thái độ xa cách hoặc hiếu khách."
                }
            ]
        },
        {
            "pos": "pronoun",
            "meaning": [
                {
                    "en": "A generic name for a snowman.",
                    "vi": "Tên chung cho một người tuyết."
