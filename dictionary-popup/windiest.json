            "meaning": [
                {
                    "en": "Resembling the wind in speed, force, or variability.",
                    "vi": "Giống gió về tốc độ, lực hoặc độ biến thiên."
                },
                {
                    "en": "Characterized by or abounding in wind.",
                    "vi": "Đặc trưng bởi hoặc phong phú trong gió."
                },
                {
                    "en": "Open to the wind; unsheltered.",
                    "vi": "Mở cửa đón gió; không có gì nổi bật."
                },
                {
                    "en": "Accompanied by wind.",
                    "vi": "Kèm theo gió."
                },
                {
                    "en": "Unsheltered and open to the wind.",
                    "vi": "Không bị choáng ngợp và cởi mở với gió."
                },
                {
                    "en": "Flatulent.",
                    "vi": "Kiêu căng."
                },
                {
                    "en": "Lacking substance; empty.",
                    "vi": "Chất thiếu; trống rỗng."
                },
                {
