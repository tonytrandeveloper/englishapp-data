                },
                {
                    "en": "Long-winded, pompous, boastful, etc.",
                    "vi": "Dài dòng, vênh váo, khoe khoang, v.v."
                },
                {
                    "en": "Empty and lacking substance.",
                    "vi": "Rỗng và thiếu chất."
                },
                {
                    "en": "Long-winded; orally verbose.",
                    "vi": "Dài dòng; nói dài dòng."
                },
                {
                    "en": "Flatulent.",
                    "vi": "Kiêu căng."
                },
                {
                    "en": "(of a path etc) Having many bends; winding, twisting or tortuous.",
