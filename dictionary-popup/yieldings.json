        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Inclined to give way to pressure, argument, or influence; docile.",
                    "vi": "Nghiêng để nhường chỗ cho áp lực, tranh luận hoặc ảnh hưởng; ngoan ngoãn."
                },
                {
                    "en": "Producing a good yield; productive.",
                    "vi": "Sản xuất một sản lượng tốt; năng suất."
                },
                {
                    "en": "Bending easily; flexible.",
                    "vi": "Uốn dễ dàng; Linh hoạt."
                },
                {
                    "en": "Submissive; obedient.",
                    "vi": "Phục tùng; nghe lời."
                },
                {
                    "en": "Docile, or inclined to give way to pressure.",
                    "vi": "Ngoan ngoãn, hoặc có xu hướng nhường chỗ cho áp lực."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of yield.",
                    "vi": "Hiện tại phân từ của lợi suất."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A concession.",
                    "vi": "Một sự nhượng bộ."
                }
            ]
        }
