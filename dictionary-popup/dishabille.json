    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The state of being partially or very casually dressed.",
                    "vi": "Tình trạng mặc quần áo một phần hoặc rất bình thường."
                },
                {
                    "en": "The state of being dressed only partially or in night clothes.",
                    "vi": "Tình trạng chỉ mặc một phần hoặc quần áo ban đêm."
                },
                {
                    "en": "Casual or lounging attire.",
                    "vi": "Trang phục giản dị hoặc đi chơi."
                },
                {
                    "en": "An intentionally careless manner.",
                    "vi": "Một cách cố ý bất cẩn."
                },
                {
                    "en": "(now rare) Clothing worn in this state.",
                    "vi": "(bây giờ hiếm) Quần áo mặc ở trạng thái này."
                },
                {
                    "en": "Extreme casual or disorderly dress, shirt tail out, sleeves unbuttoned, etc.",
                    "vi": "Ăn mặc quá bình thường hoặc mất trật tự, áo sơ mi cắt đuôi, tay áo không cài cúc, v.v."
                },
                {
                    "en": "A loose, negligent dress.",
                    "vi": "Một chiếc váy xuề xòa, cẩu thả."
                }
            ]
        }
    ],
    "meaning_vi": [
        "áo xềnh xoàng mặc trong nhà",
        "sự ăn mặc xềnh xoàng, sự ăn mặc không kín đáo"
