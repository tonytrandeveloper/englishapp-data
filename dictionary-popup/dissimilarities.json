        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The quality of being distinct or unlike; difference.",
                    "vi": "Chất lượng khác biệt hoặc không giống nhau; Sự khác biệt."
                },
                {
                    "en": "An instance or point of difference or unlikeness.",
                    "vi": "Một ví dụ hoặc điểm khác biệt hoặc không giống nhau."
                },
                {
                    "en": "Lack of similarity or lack of likeness in appearance to something else.",
                    "vi": "Thiếu sự tương đồng hoặc thiếu sự giống về ngoại hình với một thứ khác."
                },
                {
                    "en": "A point of distinction or difference.",
                    "vi": "Một điểm phân biệt hoặc khác biệt."
                },
                {
                    "en": "Absence of similarity; unlikeness; difference.",
                    "vi": "Sự vắng mặt của sự tương đồng; sự không giống nhau; Sự khác biệt."
                }
            ]
        }
