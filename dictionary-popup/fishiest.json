    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Resembling or suggestive of fish, as in taste or odor.",
                    "vi": "Giống hoặc gợi ý về cá, như vị hoặc mùi."
                },
                {
                    "en": "Cold or expressionless.",
                    "vi": "Lạnh lùng hoặc vô cảm."
                },
                {
                    "en": "(informal) Inspiring doubt or suspicion.",
                    "vi": "(không chính thức) Khơi gợi sự nghi ngờ hoặc nghi ngờ."
                },
                {
                    "en": "Like a fish in odor, taste, etc., specif., strongly or undesirably so.",
                    "vi": "Giống như một loài cá có mùi, vị, v.v., đặc biệt là như vậy."
                },
                {
                    "en": "Dull or expressionless.",
                    "vi": "Im lặng hoặc vô cảm."
                },
                {
                    "en": "Causing doubt or suspicion; questionable.",
                    "vi": "Gây nghi ngờ hoặc nghi ngờ; nghi vấn."
                },
                {
                    "en": "Expressing doubt or suspicion.",
                    "vi": "Thể hiện sự nghi ngờ hoặc nghi ngờ."
                },
                {
                    "en": "Of, from, or similar to fish.",
                    "vi": "Của, từ, hoặc tương tự như cá."
                },
                {
                    "en": "Suspicious; inspiring doubt.",
                    "vi": "Khả nghi; cảm hứng nghi ngờ."
                },
                {
                    "en": "Full of fish.",
                    "vi": "Toàn cá."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(childish) Diminutive of fish.",
                    "vi": "(trẻ con) Nhỏ bé của con cá."
                }
            ]
        }
    ],
