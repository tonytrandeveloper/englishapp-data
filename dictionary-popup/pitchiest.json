                    "vi": "Màu đen."
                },
                {
                    "en": "Of, pertaining to, or resembling pitch.",
                    "vi": "Liên quan đến, hoặc tương tự như quảng cáo chiêu hàng."
                },
                {
                    "en": "Very dark black; pitch-black.",
                    "vi": "Màu đen rất đậm; tối đen như mực."
                },
                {
