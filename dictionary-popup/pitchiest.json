                {
                    "en": "(informal) Musically off-key.",
                    "vi": "(không chính thức) Không chính xác về mặt âm nhạc."
                },
                {
                    "en": "Resembling pitch in consistency.",
                    "vi": "Cao độ giống nhất quán."
