    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Pleasing to see; visually appealing.",
                    "vi": "Rất vui khi thấy; hấp dẫn trực quan."
                },
                {
                    "en": "Affording a fine view; scenic.",
                    "vi": "Ghi lại một khung cảnh đẹp; danh lam thắng cảnh."
                },
                {
                    "en": "Pleasant to the sight; comely.",
                    "vi": "Dễ chịu cho tầm nhìn; hài hước."
                },
                {
                    "en": "Providing a fine view.",
                    "vi": "Cung cấp một cái nhìn tốt."
                },
                {
                    "en": "Attractive, pleasing to the eye; affording gratification to the sense of sight; aesthetically pleasing.",
                    "vi": "Hấp dẫn, dễ chịu cho mắt; mang lại sự hài lòng cho cảm giác của thị giác; đẹp về mặt thẩm mỹ."
                },
                {
                    "en": "Open to sight; conspicuous.",
                    "vi": "Mở rộng tầm nhìn; dễ thấy."
                }
            ]
        }
    ],
