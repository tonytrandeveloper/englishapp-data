            "pos": "noun",
            "meaning": [
                {
                    "en": "A weapon formerly used, consisting of a large blade fixed on the end of a pole, whose edge was on the outside curve.",
                    "vi": "Một loại vũ khí trước đây được sử dụng, bao gồm một lưỡi dao lớn được cố định trên đầu của một cây sào, có cạnh nằm trên đường cong bên ngoài."
                },
                {
                    "en": "A light lance with a long sharp-pointed head.",
                    "vi": "Một cây thương nhẹ với một đầu dài nhọn."
                },
                {
                    "en": "(poetically or loosely) A sword.",
                    "vi": "(thơ mộng hay lãng đãng) Một thanh gươm."
                },
                {
                    "en": "A sword, especially a broadsword.",
                    "vi": "Một thanh kiếm, đặc biệt là một thanh trường kiếm."
                },
                {
                    "en": "(obs.) A sword; esp., a broadsword.",
                    "vi": "(obs.) Một thanh kiếm; đặc biệt, một từ rộng."
                }
            ]
