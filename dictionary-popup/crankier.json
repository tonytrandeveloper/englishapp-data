    "phonetics": {
        "uk": "ˈkræŋkɪə",
        "us": "ˈkræŋkɪər"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Full of bends and turns; crooked.",
                    "vi": "Đầy những khúc cua và ngã rẽ; quanh co."
                },
                {
                    "en": "Having a bad disposition; peevish.",
                    "vi": "Có tính cách xấu; hư hỏng."
                },
                {
                    "en": "(of a machine, etc.) Not in good working condition; shaky.",
                    "vi": "(của máy, v.v.) Không ở trong tình trạng hoạt động tốt; lung lay."
                },
                {
                    "en": "Grouchy, irritable; easily upset.",
                    "vi": "Khó chịu, cáu kỉnh; dễ buồn chán."
                },
                {
                    "en": "Not in perfect mental working order; eccentric, peculiar.",
                    "vi": "Không theo trình tự làm việc trí óc hoàn hảo; lập dị, kỳ dị."
                },
                {
                    "en": "(archaic) Full of spirit; spirited.",
                    "vi": "(cổ xưa) Đầy tinh thần; tinh thần phấn chấn."
                },
                {
                    "en": "The definition of cranky is someone grumpy, ill-tempered and irritable, or a machine that doesn't work well, or something eccentric or strange.",
                    "vi": "Định nghĩa của cranky là một người nào đó cục cằn, nóng nảy và cáu kỉnh, hoặc một cỗ máy hoạt động không tốt, hoặc một thứ gì đó lập dị hoặc kỳ lạ."
                },
                {
                    "en": "Rickety; loose.",
                    "vi": "Còi xương; lỏng lẻo."
                },
                {
                    "en": "Liable to capsize.",
                    "vi": "Có khả năng lật úp."
                },
                {
                    "en": "In poor condition; apt to operate poorly.",
                    "vi": "Trong tình trạng tồi tệ; apt để hoạt động kém."
                },
                {
                    "en": "Irritable; cross.",
                    "vi": "Dễ cáu bẳn; vượt qua."
                },
                {
                    "en": "Odd; eccentric.",
                    "vi": "Số lẻ; kỳ dị."
                },
                {
                    "en": "(rare) Full of turns; crooked.",
                    "vi": "(hiếm) Có đầy đủ lượt; quanh co."
                },
                {
                    "en": "(naut.) Liable to lurch or capsize; unstable.",
                    "vi": "(naut.) Có khả năng chao đảo hoặc lật úp; không ổn định."
                },
                {
                    "en": "Having eccentric ways; odd.",
                    "vi": "Có những cách lập dị; số lẻ."
                },
                {
                    "en": "Working unpredictably; erratic.",
                    "vi": "Làm việc không thể đoán trước; thất thường."
                }
            ]
        }
    ],
