    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Mild and pleasant.",
                    "vi": "Nhẹ nhàng và dễ chịu."
                },
                {
                    "en": "Having the quality or fragrance of balm; soothing.",
                    "vi": "Có chất lượng hoặc mùi thơm của dầu dưỡng; êm dịu."
                },
                {
                    "en": "(chiefly british slang) Eccentric in behavior.",
                    "vi": "(chủ yếu là tiếng lóng của người Anh) Lập dị trong hành vi."
                },
                {
                    "en": "The definition of balmy is something that is soothing and pleasant feeling, often medicinal.",
                    "vi": "Định nghĩa của balmy là một cái gì đó mang lại cảm giác nhẹ nhàng và dễ chịu, thường là thuốc."
                },
                {
                    "en": "Balmy is defined as something that is moderate and pleasant.",
                    "vi": "Balmy được định nghĩa là một thứ gì đó vừa phải và dễ chịu."
                },
                {
                    "en": "(chiefly brit., slang) Crazy or foolish.",
                    "vi": "(chủ yếu là dòn., tiếng lóng) Điên rồ hoặc ngu ngốc."
                },
                {
                    "en": "Having the qualities of balm; soothing, fragrant, etc.",
                    "vi": "Có phẩm chất của dầu dưỡng; nhẹ nhàng, thơm, v.v."
                },
                {
                    "en": "Pleasantly warm and breezy.",
                    "vi": "Dễ chịu ấm áp và mát mẻ."
                },
                {
                    "en": "Producing balm.",
                    "vi": "Sản xuất dầu dưỡng."
                },
                {
                    "en": "Soothing or fragrant.",
                    "vi": "Nhẹ nhàng hoặc thơm."
                },
                {
                    "en": "Mild and pleasant.",
                    "vi": "Nhẹ nhàng và dễ chịu."
                },
                {
                    "en": "(informal) Foolish; slightly crazy or mad; eccentric.",
                    "vi": "(không chính thức) Ngu xuẩn; hơi điên hoặc điên cuồng; kỳ dị."
                }
            ]
        }
    ],
