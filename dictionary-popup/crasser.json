        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Grossly stupid, dull, or obtuse.",
                    "vi": "Ngốc nghếch, đần độn, hay ngu ngốc."
                },
                {
                    "en": "So crude and unrefined as to be lacking in discrimination and sensibility.",
                    "vi": "Thật thô thiển và thiếu tinh tế đến mức thiếu khả năng phân biệt và cảm thụ."
                },
                {
                    "en": "Tasteless, insensitive, and coarse.",
                    "vi": "Vô vị, vô cảm và thô thiển."
                },
                {
                    "en": "Money-grubbing; blatantly materialistic.",
                    "vi": "Ăn tiền; một cách phiến diện về vật chất."
                },
                {
                    "en": "The definition of crass is something that is crude, insensitive and unrefined.",
                    "vi": "Định nghĩa của crass là một thứ gì đó thô thiển, thiếu tế nhị và không tinh tế."
                },
                {
                    "en": "Coarse; crude; not refined or sensible.",
                    "vi": "Thô; thô thiển; không tinh tế hoặc hợp lý."
                },
                {
                    "en": "Materialistic.",
                    "vi": "Nặng về vật chất."
                },
                {
                    "en": "Dense.",
                    "vi": "Ngu độn."
                }
            ]
        }
