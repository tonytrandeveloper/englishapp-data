        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Pettifog is to argue over unimportant things.",
                    "vi": "Pettifog là để tranh luận về những điều không quan trọng."
                },
                {
                    "en": "To quibble over trivial matters; nitpick.",
                    "vi": "Để ngụy biện về những vấn đề tầm thường; xoi mói."
                },
                {
                    "en": "To do a petty business as a lawyer, or carry out law business in a petty or tricky way.",
                    "vi": "Để làm một công việc kinh doanh nhỏ với tư cách là một luật sư, hoặc thực hiện công việc kinh doanh luật một cách nhỏ mọn hoặc xảo quyệt."
                }
            ]
        }
    ],
