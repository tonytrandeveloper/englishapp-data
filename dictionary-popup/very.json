    "defines": [
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "In a high degree; extremely.",
                    "vi": "Ở một mức độ cao; cực kì."
                },
                {
                    "en": "Used in titles.",
                    "vi": "Được sử dụng trong các tiêu đề."
                },
                {
                    "en": "In a high degree; to a great extent; extremely; exceedingly.",
                    "vi": "Ở một mức độ cao; đến một giới hạn rất lớn; cực kì; cực kỳ."
                },
                {
                    "en": "Truly; really.",
                    "vi": "Quả thật; thật sự."
                },
                {
                    "en": "To what is regarded as an extreme, and hence obvious, degree; obviously; unmistakably.",
                    "vi": "Đối với những gì được coi là cực đoan, và do đó hiển nhiên, mức độ; chắc chắn; không thể nhầm lẫn."
                },
                {
                    "en": "Truly; absolutely.",
                    "vi": "Quả thật; chắc chắn rồi."
                },
                {
                    "en": "To a great extent or degree; extremely; exceedingly.",
                    "vi": "Ở một mức độ hoặc mức độ lớn; cực kì; cực kỳ."
                },
                {
                    "en": "True, truly.",
                    "vi": "Đúng, thực sự."
                },
                {
                    "en": "Very is defined as extremely or really.",
                    "vi": "Very được định nghĩa là cực kỳ hoặc thực sự."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Complete; absolute.",
                    "vi": "Hoàn thành; tuyệt đối."
                },
                {
                    "en": "Being the same; identical.",
                    "vi": "Là giống nhau; giống hệt nhau."
                },
                {
                    "en": "Same; identical.",
                    "vi": "Tương tự; giống hệt nhau."
                },
                {
                    "en": "Being just what is needed or suitable.",
                    "vi": "Chỉ là những gì cần thiết hoặc phù hợp."
                },
                {
                    "en": "Being nothing more than what is specified; mere.",
                    "vi": "Không là gì hơn những gì được chỉ định; chỉ là."
                },
                {
                    "en": "Being particularly suitable or appropriate.",
                    "vi": "Đặc biệt thích hợp hoặc thích hợp."
                },
                {
                    "en": "(archaic) Genuine; true.",
                    "vi": "(cổ) Chính hãng; thật."
                },
                {
                    "en": "Actual [caught in the very act]",
                    "vi": "Thực tế [bắt gặp trong hành động]"
                },
                {
                    "en": "The definition of very is something complete or something identical.",
                    "vi": "Định nghĩa của rất là một cái gì đó hoàn chỉnh hoặc một cái gì đó giống hệt nhau."
                },
                {
                    "en": "Used to emphasize the importance of what is specified.",
                    "vi": "Được sử dụng để nhấn mạnh tầm quan trọng của những gì được chỉ định."
                },
                {
                    "en": "In the fullest sense; complete; absolute.",
                    "vi": "Theo nghĩa đầy đủ nhất; hoàn thành; tuyệt đối."
                },
                {
                    "en": "Real; true; genuine.",
                    "vi": "Thực tế; thật; thành thật."
                },
                {
                    "en": "Legitimate; lawful; rightful.",
                    "vi": "Hợp pháp; hợp pháp; đúng đắn."
                },
                {
                    "en": "True, real, actual.",
                    "vi": "Đúng, thực tế, thực tế."
                },
                {
                    "en": "The same; identical.",
                    "vi": "Như nhau; giống hệt nhau."
                },
                {
                    "en": "With limiting effect: mere.",
                    "vi": "Với tác dụng hạn chế: chỉ."
                }
            ]
        }
    ],
