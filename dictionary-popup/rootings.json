    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Originally, a system of roots; a secure attachment (in something); a firm grounding.",
                    "vi": "Ban đầu, một hệ thống rễ; một phần đính kèm an toàn (trong một cái gì đó); một nền tảng vững chắc."
                },
                {
                    "en": "The process of forming roots.",
                    "vi": "Quá trình hình thành rễ."
                },
                {
                    "en": "A method of creating a new plant by getting part of an existing plant to form roots.",
                    "vi": "Một phương pháp tạo cây mới bằng cách lấy một phần của cây hiện có để hình thành rễ."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of root.",
                    "vi": "Trình bày phân từ của gốc."
                }
            ]
        }
    ],
