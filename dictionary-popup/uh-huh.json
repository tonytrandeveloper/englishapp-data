            "pos": "interjection",
            "meaning": [
                {
                    "en": "Used to express agreement or an answer in the affirmative.",
                    "vi": "Được sử dụng để thể hiện sự đồng ý hoặc một câu trả lời trong câu khẳng định."
                },
                {
                    "en": "Used to respond in the affirmative.",
                    "vi": "Được sử dụng để đáp lại trong câu khẳng định."
                },
                {
                    "en": "Alternative spelling of uh-huh.",
                    "vi": "Cách viết khác của uh-huh."
                },
                {
                    "en": "Yes; yeah.",
                    "vi": "Vâng; Vâng."
                },
                {
                    "en": "Used to signify that one is listening attentively.",
                    "vi": "Được sử dụng để biểu thị rằng một người đang chăm chú lắng nghe."
                }
            ]
        }
    ],
