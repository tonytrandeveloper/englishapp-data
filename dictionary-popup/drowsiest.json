            "meaning": [
                {
                    "en": "Inducing sleepiness; soporific.",
                    "vi": "Gây buồn ngủ; soporific."
                },
                {
                    "en": "Dull with sleepiness; sluggish.",
                    "vi": "Buồn ngủ đờ đẫn; chậm chạp."
                },
                {
                    "en": "Produced or characterized by sleepiness.",
                    "vi": "Được tạo ra hoặc được đặc trưng bởi cảm giác buồn ngủ."
                },
                {
                    "en": "Brought on by sleepiness.",
                    "vi": "Do buồn ngủ mang lại."
                },
                {
                    "en": "The definition of drowsy is a feeling of being sleepy, tired or not fully awake.",
                    "vi": "Định nghĩa của buồn ngủ là cảm giác buồn ngủ, mệt mỏi hoặc không hoàn toàn tỉnh táo."
                },
                {
                    "en": "Peacefully quiet or inactive.",
                    "vi": "Yên tĩnh hoặc không hoạt động."
                },
                {
                    "en": "Sleepy or half asleep; lethargic.",
                    "vi": "Buồn ngủ hoặc nửa ngủ nửa mơ; hôn mê."
                },
                {
                    "en": "Making drowsy; soporific.",
                    "vi": "Làm buồn ngủ; soporific."
                },
                {
                    "en": "Inclined to drowse; heavy with sleepiness; lethargic; dozy.",
                    "vi": "Nghiêng để ngủ gật; nặng nề với cơn buồn ngủ; hôn mê; lười biếng."
                },
                {
                    "en": "Disposing to sleep; lulling; soporific.",
                    "vi": "Bỏ đi ngủ; ru ngủ; soporific."
                },
                {
                    "en": "Dull; stupid.",
                    "vi": "Đần độn; ngốc nghếch."
                }
            ]
        }
    ],
