    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "(informal) Tiny. Often used in combination.",
                    "vi": "(không chính thức) Nhỏ xíu. Thường được sử dụng kết hợp."
                },
                {
                    "en": "(chiefly british) Composed of small pieces that lack cohesion; fragmented.",
                    "vi": "(chủ yếu là người Anh) Bao gồm các mảnh nhỏ thiếu sự gắn kết; rời rạc."
                },
                {
                    "en": "Tiny: a playful term or child's term.",
                    "vi": "Tiny: một thuật ngữ vui tươi hoặc thuật ngữ của trẻ em."
                },
                {
                    "en": "(brit.) Made up of bits, or small pieces; without unity; disjointed.",
                    "vi": "(giòn.) Được tạo thành từ các mảnh, hoặc các mảnh nhỏ; không có sự thống nhất; rời rạc."
                },
                {
                    "en": "Containing bits; fragmented.",
                    "vi": "Chứa bit; rời rạc."
                },
                {
                    "en": "Very small.",
                    "vi": "Rất nhỏ."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Alternative form of bittie.",
                    "vi": "Hình thức thay thế của bittie."
                }
            ]
        }
