    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To run before.",
                    "vi": "Để chạy trước đây."
                },
                {
                    "en": "To precede as an indication of what is to follow; foreshadow.",
                    "vi": "Để đi trước như một dấu hiệu về những gì sẽ theo sau; điềm báo trước."
                },
                {
                    "en": "To prevent from arriving or occurring; forestall.",
                    "vi": "Để ngăn chặn việc đến hoặc xảy ra; rừng cây."
                },
                {
                    "en": "To run before; go before; precede.",
                    "vi": "Để chạy trước đây; đi trước; đứng trước."
                },
                {
                    "en": "To be the precursor of; be a prediction or sign of (a thing to follow); foreshadow.",
                    "vi": "Là tiền thân của; là một dự đoán hoặc dấu hiệu của (một điều để theo dõi); điềm báo trước."
                },
                {
                    "en": "To forestall.",
                    "vi": "Để cảnh báo."
                },
                {
                    "en": "To run in front.",
                    "vi": "Để chạy phía trước."
                },
                {
                    "en": "To forecast or foreshadow.",
                    "vi": "Để dự báo hoặc báo trước."
                }
            ]
        }
    ],
    "meaning_vi": [
        "báo hiệu; báo trước",
