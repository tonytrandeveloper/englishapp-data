            "meaning": [
                {
                    "en": "Refinement and elegance of manner; polished courtesy.",
                    "vi": "Sàng lọc và sang trọng của phong cách; lịch sự đánh bóng."
                },
                {
                    "en": "Courtesies; civilities.",
                    "vi": "Phép lịch sự; công dân."
                },
                {
                    "en": "The quality of being urbane.",
                    "vi": "Chất lượng của urbane."
                },
                {
                    "en": "Civilities, courtesies, or amenities.",
                    "vi": "Công dân, phép lịch sự hoặc tiện nghi."
                },
                {
                    "en": "Behaviour that is polished, refined, courteous.",
                    "vi": "Hành vi trau chuốt, trau chuốt, lịch sự."
                },
                {
                    "en": "(in the plural) Courtesies.",
                    "vi": "(ở số nhiều) Courtesies."
                },
                {
                    "en": "What is characteristically urban in an area; urbanness.",
                    "vi": "Đặc trưng của đô thị trong một khu vực là gì; tính thành thị."
                }
            ]
        }
