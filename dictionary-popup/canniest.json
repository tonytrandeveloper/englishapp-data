            "meaning": [
                {
                    "en": "Careful and shrewd, especially where one's own interests are concerned.",
                    "vi": "Cẩn thận và khôn khéo, đặc biệt là khi quan tâm đến lợi ích của bản thân."
                },
                {
                    "en": "(brit., dial.) Good; nice; fine.",
                    "vi": "(brit., quay số.) Tốt; Đẹp; tốt."
                },
                {
                    "en": "Careful and shrewd in one's actions and dealings; clever and cautious.",
                    "vi": "Cẩn thận và khôn khéo trong các hành động và đối phó của một người; khôn khéo và thận trọng."
                },
                {
                    "en": "The definition of canny is someone shrewd, clever or careful with money.",
                    "vi": "Định nghĩa của canny là một người sắc sảo, thông minh hoặc cẩn thận với tiền bạc."
                },
                {
                    "en": "Cautious in spending money; frugal.",
                    "vi": "Thận trọng trong việc tiêu tiền; thanh đạm."
                },
                {
                    "en": "Steady, restrained, and gentle.",
                    "vi": "Ổn định, kiềm chế và nhẹ nhàng."
                },
                {
                    "en": "Snug and quiet.",
                    "vi": "Snug và yên tĩnh."
                },
                {
                    "en": "Careful with money; thrifty.",
                    "vi": "Cẩn thận với tiền bạc; tiết kiệm."
                },
                {
                    "en": "(scot.) Careful in action; gentle; easy; quiet.",
                    "vi": "(scot.) Cẩn thận trong hành động; dịu dàng; dễ; Yên tĩnh."
                },
                {
                    "en": "Careful, prudent, cautious.",
                    "vi": "Cẩn thận, thận trọng, thận trọng."
                },
