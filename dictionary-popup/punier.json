            "pos": "adjective",
            "meaning": [
                {
                    "en": "(chiefly southern us) Sickly; ill.",
                    "vi": "(chủ yếu là miền nam chúng tôi) ốm yếu; tôi sẽ."
                },
                {
                    "en": "Of inferior size, strength, or importance; weak; slight.",
                    "vi": "Có kích thước, sức mạnh hoặc tầm quan trọng kém hơn; Yếu; mảnh dẻ."
                },
                {
                    "en": "Of inferior size, strength, or significance; weak.",
                    "vi": "Có kích thước, sức mạnh hoặc ý nghĩa kém hơn; Yếu."
                },
                {
                    "en": "The definition of puny is something insufficient in size or strength.",
                    "vi": "Định nghĩa của puny là một cái gì đó không đủ về kích thước hoặc sức mạnh."
                },
                {
                    "en": "Of inferior size, strength or significance.",
                    "vi": "Có kích thước, sức mạnh hoặc ý nghĩa kém hơn."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(archaic) An inferior person; a subordinate.",
                    "vi": "(cổ xưa) Một người kém cỏi; một cấp dưới."
                }
            ]
        }
