    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Not lucky; having, attended with, bringing, or involving bad luck; unfortunate, ill-fated, or ill-omened.",
                    "vi": "Không may mắn; có, tham dự với, mang lại, hoặc liên quan đến vận rủi; không may mắn, xấu số, hoặc đen đủi."
                },
                {
                    "en": "Resulting or likely to result in misfortune; inauspicious.",
                    "vi": "Kết quả hoặc có khả năng dẫn đến bất hạnh; không tốt."
                },
                {
                    "en": "Subjected to or marked by misfortune.",
                    "vi": "Chủ đề hoặc được đánh dấu bởi sự bất hạnh."
                },
                {
                    "en": "Unfortunate, marked by misfortune.",
                    "vi": "Bất hạnh, được đánh dấu bởi bất hạnh."
                },
                {
                    "en": "Inauspicious.",
                    "vi": "Không tốt."
                },
                {
                    "en": "Having ill luck.",
                    "vi": "Gặp xui xẻo."
                },
                {
                    "en": "Bringing ill luck.",
                    "vi": "Mang lại may mắn."
                }
            ]
        }
    ],
