        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The upper part of the soil.",
                    "vi": "Phần trên của đất."
                },
                {
                    "en": "The upper layer of soil; surface soil.",
                    "vi": "Lớp đất phía trên; đất bề mặt."
                },
                {
                    "en": "Earth of a dark and rich type, for use in growing plants, a lawn, etc.",
                    "vi": "Trái đất thuộc loại tối và giàu, dùng để trồng cây, làm bãi cỏ, v.v."
                },
                {
                    "en": "The most fertile soil, easiest to start new plants in.",
                    "vi": "Đất màu mỡ nhất, dễ bắt đầu trồng cây mới."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To place topsoil on (land).",
                    "vi": "Để đặt lớp đất mặt trên (đất)."
                }
            ]
        }
    ],
