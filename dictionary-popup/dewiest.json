    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Moist with or as if with dew.",
                    "vi": "Làm ẩm với hoặc như thể với sương."
                },
                {
                    "en": "Of dew.",
                    "vi": "Của sương."
                },
                {
                    "en": "(old poet.) Dewlike; refreshing, gentle, etc.",
                    "vi": "(nhà thơ cũ.) Như sương; sảng khoái, nhẹ nhàng, v.v."
                },
                {
                    "en": "Covered by dew.",
                    "vi": "Được bao phủ bởi sương."
                },
                {
                    "en": "Having the quality of bearing droplets of water.",
                    "vi": "Có chất lượng mang giọt nước."
                },
                {
                    "en": "Accompanied by dew.",
                    "vi": "Kèm theo sương."
                },
                {
                    "en": "Suggestive of the freshness or purity of dew, as in innocence or naiveté.",
                    "vi": "Gợi đến sự trong lành hoặc tinh khiết của sương, như sự ngây thơ hoặc ngây thơ."
                },
                {
                    "en": "Wet or damp with dew.",
                    "vi": "Ẩm ướt hoặc ẩm ướt với sương."
                }
            ]
        }
    ],
