    "defines": [
        {
            "pos": "pronoun",
            "meaning": [
                {
                    "en": "A diminutive of Rose, Rosemary and of other female names related to the rose. Also used as a formal given name.",
                    "vi": "Một số nhỏ của Rose, Rosemary và các tên phụ nữ khác có liên quan đến hoa hồng. Cũng được sử dụng như một tên chính thức."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(US, informal) A female factory worker during World War II (after the 1942 song Rosie the Riveter).",
                    "vi": "(Hoa Kỳ, không chính thức) Một nữ công nhân nhà máy trong Thế chiến thứ hai (sau bài hát Rosie the Riveter năm 1942)."
                }
            ]
        }
    ],
