    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having or showing a lack of wisdom or sound judgment; foolish; imprudent.",
                    "vi": "Có hoặc thể hiện sự thiếu khôn ngoan hoặc khả năng phán đoán đúng đắn; khờ dại; không thận trọng."
                },
                {
                    "en": "Lacking or exhibiting a lack of wisdom; foolish or imprudent.",
                    "vi": "Thiếu hoặc thể hiện sự thiếu khôn ngoan; dại dột hoặc thiếu thận trọng."
                },
                {
                    "en": "Not wise; defective in wisdom; injudicious; indiscreet; foolish.",
                    "vi": "Không khôn ngoan; khiếm khuyết về trí tuệ; ngu; vô kỷ luật; khờ dại."
                }
            ]
        }
    ],
