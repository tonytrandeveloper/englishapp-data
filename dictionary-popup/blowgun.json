    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A long narrow pipe through which darts or pellets may be blown.",
                    "vi": "Một đường ống dài hẹp mà phi tiêu hoặc viên nén có thể được thổi qua."
                },
                {
                    "en": "A long, tubelike weapon through which a darts or pellet is propelled by means of a forceful breath.",
                    "vi": "Một loại vũ khí dài, giống như săm, qua đó có thể đẩy phi tiêu hoặc viên đạn bằng hơi thở mạnh."
                },
                {
                    "en": "A hollow tube through which a dart or similar missile may be blown.",
                    "vi": "Một ống rỗng có thể thổi phi tiêu hoặc tên lửa tương tự qua đó."
                }
            ]
        }
    ],
    "meaning_vi": [
