    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Characterized by violent emotions, passions, speech, or actions.",
                    "vi": "Đặc trưng bởi cảm xúc bạo lực, đam mê, lời nói hoặc hành động."
                },
                {
                    "en": "Of, characteristic of, or affected by storms.",
                    "vi": "Đặc điểm của, hoặc bị ảnh hưởng bởi bão."
                },
                {
                    "en": "Having or characterized by storms.",
                    "vi": "Có hoặc đặc điểm của bão."
                },
                {
                    "en": "Violent, raging, turbulent, etc.",
                    "vi": "Bạo lực, hoành hành, hỗn loạn, v.v."
                },
                {
                    "en": "Subject to, characterized by, or affected by storms; tempestuous.",
                    "vi": "Đối tượng, đặc điểm của hoặc bị ảnh hưởng bởi bão; khó khăn."
                },
                {
                    "en": "Of or pertaining to storms.",
                    "vi": "Của hoặc liên quan đến bão."
                },
                {
                    "en": "Characterized by, or proceeding from, a storm; subject to storms; agitated with strong winds and heavy rain.",
                    "vi": "Được đặc trưng bởi, hoặc tiếp tục từ một cơn bão; chịu bão tố; bị giao động với gió mạnh và mưa lớn."
                },
                {
                    "en": "Proceeding from violent agitation or fury.",
                    "vi": "Sau khi bị kích động hoặc giận dữ dữ dội."
                },
                {
                    "en": "Violent; passionate; rough.",
                    "vi": "Hung bạo; say đắm; gồ ghề."
                }
            ]
        }
    ],
    "meaning_vi": [
        "mãnh liệt như bão tố",
        "ào ạt, sôi nổi",
        "sóng gió",
        "báo bão"
