    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To shake rapidly or spasmodically; vibrate conspicuously.",
                    "vi": "Lắc nhanh hoặc co thắt; rung động một cách dễ thấy."
                },
                {
                    "en": "(brit.) To shake, wobble, or vibrate.",
                    "vi": "(giòn.) Để lắc, lắc lư hoặc rung động."
                },
                {
                    "en": "(intransitive) To spasm or shake violently.",
                    "vi": "(bên trong) Co thắt hoặc rung lắc dữ dội."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A rapid or spasmodic shaking.",
                    "vi": "Rung nhanh hoặc co thắt."
                },
                {
                    "en": "A spasmodic shaking.",
                    "vi": "Một cơn rung chuyển co thắt."
                },
                {
                    "en": "(television) Jerky playback caused by converting between frame rates; telecine judder.",
                    "vi": "(truyền hình) Phát lại giật cục do chuyển đổi giữa các tốc độ khung hình; telecine judder."
                }
            ]
        }
