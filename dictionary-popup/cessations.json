    "phonetics": {
        "uk": "sɛˈseɪʃənz",
        "us": "ˌsɛˈseɪʃənz"
    },
    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A ceasing, or stopping, either forever or for some time.",
                    "vi": "Sự ngừng lại, hoặc dừng lại, vĩnh viễn hoặc trong một thời gian."
                },
                {
                    "en": "A bringing or coming to an end; a ceasing.",
                    "vi": "Sự kết thúc hoặc kết thúc; một sự ngừng lại."
                },
                {
                    "en": "(formal) A ceasing or discontinuance, as of action, whether temporary or final.",
                    "vi": "(chính thức) Việc ngừng hoặc ngừng, kể từ khi hành động, dù là tạm thời hay cuối cùng."
                },
                {
                    "en": "The definition of a cessation is an ending.",
                    "vi": "Định nghĩa của một sự ngừng lại là một sự kết thúc."
                }
            ]
        }
    ],
