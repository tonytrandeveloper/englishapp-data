    "sentences": [
        {
            "en": "For a moment he looked confused, and then turned away.",
            "vi": "Anh ta trông bối rối trong một lúc, và sau đó quay đi."
        },
        {
            "en": "Sarah seemed confused as well.",
            "vi": "Sarah cũng có vẻ bối rối."
        },
        {
            "en": "He became confused in his speech and stopped in the middle of what he was saying.",
            "vi": "Anh ấy trở nên bối rối trong bài phát biểu của mình và dừng lại giữa chừng những gì anh ấy đang nói."
        },
        {
            "en": "Darcie looked confused as she smiled graciously.",
            "vi": "Darcie trông có vẻ bối rối khi cô ấy mỉm cười ân cần."
        },
        {
            "en": "We were just two confused playmates.",
            "vi": "Chúng tôi chỉ là hai người bạn chơi lẫn lộn."
        },
        {
            "en": "His words confused her.",
            "vi": "Lời nói của anh khiến cô bối rối."
        },
        {
            "en": "I still have confused memories of that illness.",
            "vi": "Tôi vẫn có những ký ức bối rối về căn bệnh đó."
        },
        {
            "en": "In her confused state of mind, she had convinced herself that he loved her.",
