    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Being unable to think with clarity or act with understanding and intelligence.",
                    "vi": "Không thể suy nghĩ rõ ràng hoặc hành động với sự hiểu biết và thông minh."
                },
                {
                    "en": "Chaotic, jumbled or muddled.",
                    "vi": "Hỗn loạn, lộn xộn hoặc lộn xộn."
                },
                {
                    "en": "Making no sense; illogical.",
                    "vi": "Không có ý nghĩa; phi logic."
                },
                {
                    "en": "The definition of confused is a person who cannot think clearly, or is something that is jumbled or without order.",
                    "vi": "Định nghĩa của bối rối là một người không thể suy nghĩ rõ ràng, hoặc là một cái gì đó lộn xộn hoặc không có trật tự."
                },
                {
                    "en": "Lacking logical order or sense.",
                    "vi": "Thiếu trật tự hoặc ý nghĩa hợp lý."
                },
                {
                    "en": "Chaotic; jumbled.",
                    "vi": "Kỳ lạ; lộn xộn."
                },
                {
                    "en": "Embarrassed.",
                    "vi": "Lúng túng."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Confused means you caused someone to feel bewildered or perplexed.",
                    "vi": "Lúng túng có nghĩa là bạn đã khiến ai đó cảm thấy hoang mang hoặc bối rối."
                },
                {
                    "en": "Simple past tense and past participle of confuse.",
                    "vi": "Quá khứ đơn và quá khứ phân từ của sự nhầm lẫn."
                }
            ]
        }
    ],
