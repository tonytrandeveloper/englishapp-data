            "meaning": [
                {
                    "en": "To cover or obscure with or as if with fog.",
                    "vi": "Để che hoặc che khuất bằng hoặc như thể có sương mù."
                },
                {
                    "en": "To cause confusion in; muddle.",
                    "vi": "Để gây nhầm lẫn trong; lộn xộn."
                },
                {
                    "en": "To cover with or envelop in fog; make foggy.",
                    "vi": "Để che phủ hoặc bao phủ trong sương mù; làm cho sương mù."
                },
                {
                    "en": "To make obscure or muddled; confuse; bewilder.",
                    "vi": "Để làm cho mờ hoặc lộn xộn; xáo trộn; hoang mang."
                },
                {
                    "en": "To envelop in fog.",
                    "vi": "Để bao trùm trong sương mù."
                },
                {
                    "en": "To confuse; mystify.",
                    "vi": "Xáo trộn; làm hoang mang."
                }
            ]
        }
    ],
