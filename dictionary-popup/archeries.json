                },
                {
                    "en": "The practice, art, or sport of shooting with bow and arrow.",
                    "vi": "Việc luyện tập, nghệ thuật hoặc môn thể thao bắn súng bằng cung tên."
                },
                {
                    "en": "Archers collectively.",
                    "vi": "Cung thủ nói chung."
                },
                {
                    "en": "An archer's bows, arrows, and other equipment.",
                    "vi": "Cung tên, và các thiết bị khác của cung thủ."
                },
                {
                    "en": "The equipment of an archer.",
                    "vi": "Các thiết bị của một cung thủ."
                },
                {
                    "en": "(uncountable) The practice or sport of shooting arrows with a bow.",
                    "vi": "(không đếm được) Thực hành hoặc môn thể thao bắn tên bằng cung."
                },
                {
                    "en": "(countable) A group of archers.",
                    "vi": "(đếm được) Một nhóm cung thủ."
                }
            ]
        }
