            "meaning": [
                {
                    "en": "Of a person, lacking volition, not exercising one's will.",
                    "vi": "Của một người, thiếu ý chí, không thực hiện ý chí của mình."
                },
                {
                    "en": "Of an action, involuntary.",
                    "vi": "Của một hành động, không tự nguyện."
                },
                {
                    "en": "Intestate; without a legal will governing one's property or estate.",
                    "vi": "Thân mật; không có pháp luật sẽ quản lý tài sản hoặc di sản của một người."
                }
            ]
