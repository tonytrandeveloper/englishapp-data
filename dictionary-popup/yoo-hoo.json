    "defines": [
        {
            "pos": "interjection",
            "meaning": [
                {
                    "en": "Used to call someone at a distance or to gain someone's attention.",
                    "vi": "Được sử dụng để gọi ai đó ở khoảng cách xa hoặc để thu hút sự chú ý của ai đó."
                },
                {
                    "en": "(a shout or call) Used to attract someone's attention.",
                    "vi": "(tiếng hét hoặc tiếng gọi) Được sử dụng để thu hút sự chú ý của ai đó."
                },
                {
                    "en": "Used to get attention.",
                    "vi": "Được sử dụng để gây sự chú ý."
                },
                {
                    "en": "Used to call to someone at a distance or to gain someone's attention.",
                    "vi": "Được sử dụng để gọi cho ai đó ở khoảng cách xa hoặc để thu hút sự chú ý của ai đó."
                },
                {
                    "en": "(dated) An interjection to grab someone's attention.",
                    "vi": "(ngày tháng) Một thán từ để thu hút sự chú ý của ai đó."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(intransitive) To give a cry of \"yoohoo\".",
                    "vi": "(intransitive) Để phát ra tiếng kêu \"\"yoohoo\"\"."
                }
            ]
        }
    ],
