        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Being such that attack, seizure, or capture is possible; vulnerable or assailable.",
                    "vi": "Có thể tấn công, chiếm giữ hoặc bắt giữ; dễ bị tổn thương hoặc có sẵn."
                },
                {
                    "en": "That can be captured, as a fortress.",
                    "vi": "Đó có thể được chiếm giữ, như một pháo đài."
                },
                {
                    "en": "That can be attacked or injured; assailable or vulnerable.",
                    "vi": "Điều đó có thể bị tấn công hoặc bị thương; có sẵn hoặc dễ bị tổn thương."
                },
                {
                    "en": "Vulnerable to attack.",
                    "vi": "Dễ bị tấn công."
                }
            ]
        }
    ],
