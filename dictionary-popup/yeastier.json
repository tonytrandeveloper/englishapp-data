                    "vi": "Đầy năng suất hoặc sức sống; hết sức sáng tạo."
                },
                {
                    "en": "Of, similar to, or containing yeast.",
                    "vi": "Của, tương tự, hoặc có chứa men."
                },
                {
                    "en": "Causing or characterized by unrest or agitation; turbulent.",
                    "vi": "Gây ra hoặc đặc trưng bởi tình trạng bất ổn hoặc kích động; sóng gió."
                },
                {
                    "en": "Frothy; frivolous.",
                    "vi": "Bọt nước; phù phiếm."
                },
                {
                    "en": "Of, like, or containing yeast.",
                    "vi": "Của, giống như, hoặc có chứa men."
                },
                {
                    "en": "Frothy; foamy.",
                    "vi": "Bọt nước; có bọt."
                },
                {
                    "en": "Marked by ferment and change.",
                    "vi": "Đánh dấu bằng sự lên men và thay đổi."
                },
                {
                    "en": "Having or resembling yeast.",
                    "vi": "Có hoặc giống nấm men."
                },
                {
