            "meaning": [
                {
                    "en": "(archaic) An idiot or fool.",
                    "vi": "(cổ xưa) Một thằng ngốc hay khờ khạo."
                },
                {
                    "en": "A fool.",
                    "vi": "Một kẻ ngốc."
                },
                {
                    "en": "A freak.",
                    "vi": "Kỳ dị."
                },
                {
                    "en": "(now rare) An abnormal mass within the uterus; a false conception. [from 16th c.]",
                    "vi": "(hiếm gặp) Một khối bất thường trong tử cung; một quan niệm sai lầm. [từ ngày 16 c.]"
                },
                {
                    "en": "A poorly-conceived idea or plan. [from 17th c.]",
                    "vi": "Một ý tưởng hoặc kế hoạch chưa được hình thành tốt. [từ ngày 17 c.]"
                },
                {
                    "en": "A dreamer, someone absent-minded or distracted; a fool, simpleton. [from 17th c.]",
                    "vi": "Một người mơ mộng, một người lơ đãng hoặc mất tập trung; một kẻ ngốc, simpleton. [từ ngày 17 c.]"
                }
            ]
        }
