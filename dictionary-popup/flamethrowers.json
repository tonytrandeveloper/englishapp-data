    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A weapon that projects ignited incendiary fuel, such as napalm, in a steady stream.",
                    "vi": "Một loại vũ khí phóng ra nhiên liệu cháy, chẳng hạn như bom napalm, trong một dòng ổn định."
                },
                {
                    "en": "A weapon for shooting a stream of flaming gasoline, oil, napalm, etc.",
                    "vi": "Một loại vũ khí để bắn một dòng xăng, dầu, bom napalm, v.v."
                },
                {
                    "en": "A device that projects a flame for starting fires, it may also project additional fuel to help ignition. Used either as a weapon or a tool.",
                    "vi": "Một thiết bị chiếu ra ngọn lửa để bắt đầu đám cháy, nó cũng có thể chiếu thêm nhiên liệu để giúp bắt lửa. Được sử dụng như một vũ khí hoặc một công cụ."
                }
            ]
        }
    ],
