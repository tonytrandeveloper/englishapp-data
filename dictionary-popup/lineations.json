            "meaning": [
                {
                    "en": "The act of marking or outlining with lines.",
                    "vi": "Hành động đánh dấu hoặc lập dàn ý với các dòng."
                },
                {
                    "en": "An outline.",
                    "vi": "Một dàn ý."
                },
                {
                    "en": "An arrangement of lines.",
                    "vi": "Một sự sắp xếp của các dòng."
                },
                {
                    "en": "A division into lines.",
                    "vi": "Một sự phân chia thành các dòng."
                },
                {
                    "en": "Any linear structure in a rock, as the ripple marks in a sedimentary rock.",
                    "vi": "Bất kỳ cấu trúc tuyến tính nào trong đá, như vết gợn trong đá trầm tích."
                },
                {
                    "en": "A marking with lines.",
                    "vi": "Một đánh dấu với các dòng."
                },
                {
                    "en": "A system or series of lines.",
                    "vi": "Một hệ thống hoặc một loạt các dòng."
                },
                {
                    "en": "(geology) A linear feature in rock, often structural.",
                    "vi": "(địa chất) Một đặc điểm tuyến tính trong đá, thường là cấu trúc."
                },
                {
                    "en": "(literature) The way in which line breaks are inserted in a poem.",
                    "vi": "(văn học) Cách ngắt dòng trong bài thơ."
