    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The state or quality of being ideal.",
                    "vi": "Trạng thái hoặc phẩm chất lý tưởng."
                },
                {
                    "en": "Existence in idea only.",
                    "vi": "Chỉ tồn tại trong ý tưởng."
                },
                {
                    "en": "The state or quality of being ideal or of existing only in the mind.",
                    "vi": "Trạng thái hoặc phẩm chất của việc trở thành lý tưởng hoặc chỉ tồn tại trong tâm trí."
                },
                {
                    "en": "Something that is only ideal and has no reality.",
                    "vi": "Một cái gì đó chỉ là lý tưởng và không có thực tế."
                },
                {
                    "en": "(uncountable) The quality or state of being ideal.",
                    "vi": "(không đếm được) Chất lượng hoặc trạng thái lý tưởng."
                },
                {
                    "en": "(uncountable) The capacity to form deals of beauty or perfection.",
                    "vi": "(không đếm được) Khả năng hình thành các giao dịch về vẻ đẹp hoặc sự hoàn hảo."
                },
                {
                    "en": "The conceptive faculty.",
                    "vi": "Các giảng viên hiểu biết."
                }
            ]
        }
    ],
