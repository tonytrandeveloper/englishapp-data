            "meaning": [
                {
                    "en": "A person whose behavior is rough, quarrelsome, and disorderly; hoodlum.",
                    "vi": "Một người có hành vi thô bạo, gây gổ và mất trật tự; du côn."
                },
                {
                    "en": "A rough, disorderly person.",
                    "vi": "Một người thô bạo, mất trật tự."
                },
                {
                    "en": "A boisterous person; a brawler.",
                    "vi": "Một người huyên náo; một kẻ cãi lộn."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having the nature of or characteristic of a rowdy; rough, quarrelsome, etc.",
                    "vi": "Có bản chất hoặc đặc điểm của một người ồn ào; thô bạo, hay gây gổ, v.v."
                },
                {
                    "en": "Disorderly; rough.",
                    "vi": "Mất trật tự; gồ ghề."
                },
                {
                    "en": "The definition of rowdy is noisy and disorderly.",
                    "vi": "Định nghĩa của om sòm là ồn ào và mất trật tự."
                },
                {
                    "en": "Rough and disorderly; riotous or just boisterous.",
                    "vi": "Thô sơ và mất trật tự; náo loạn hoặc chỉ náo nhiệt."
                }
