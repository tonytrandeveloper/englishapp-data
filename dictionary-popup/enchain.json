        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To bind with or as if with chains.",
                    "vi": "Để ràng buộc với hoặc như thể với dây chuyền."
                },
                {
                    "en": "To bind or hold with chains; fetter.",
                    "vi": "Để ràng buộc hoặc giữ bằng dây chuyền; cái kiềng."
                },
                {
                    "en": "To hold fast; captivate.",
                    "vi": "Để giữ nhanh; quyến rũ."
                },
                {
                    "en": "To restrain with, or as if with, chains.",
                    "vi": "Để kiềm chế bằng, hoặc như thể bằng dây xích."
                }
            ]
        }
    ],
