        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To undergo thickening or cause to thicken, as by boiling or evaporation; condense.",
                    "vi": "Bị cô đặc hoặc gây ra cô đặc, như do đun sôi hoặc bay hơi; cô đặc lại."
                },
                {
                    "en": "To thicken, as by evaporation; condense.",
                    "vi": "Để làm đặc, bằng cách bay hơi; cô đặc lại."
                },
                {
                    "en": "To thicken, especially by boiling, evaporation, or condensation; condense.",
                    "vi": "Làm đặc, đặc biệt là bằng cách đun sôi, bay hơi hoặc ngưng tụ; cô đặc lại."
                },
                {
                    "en": "(intransitive) To become viscous.",
                    "vi": "(intransitive) Để trở nên nhớt."
                }
            ]
        }
    ],
