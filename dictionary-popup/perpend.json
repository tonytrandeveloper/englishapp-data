    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(archaic) To ponder or consider.",
                    "vi": "(cổ xưa) Để suy ngẫm hoặc cân nhắc."
                },
                {
                    "en": "To consider carefully; ponder.",
                    "vi": "Để xem xét cẩn thận; suy ngẫm."
                },
                {
                    "en": "To be attentive; reflect.",
                    "vi": "Để được chăm chú; phản chiếu."
                },
                {
                    "en": "(archaic) To ponder, consider.",
                    "vi": "(cổ xưa) Để suy ngẫm, hãy cân nhắc."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A large stone extending through a wall from one side to the other, used as a binder.",
                    "vi": "Một tảng đá lớn kéo dài xuyên qua bức tường từ bên này sang bên kia, được sử dụng như một chất kết dính."
                },
                {
                    "en": "A brick or stone that has its longest dimension perpendicular to the face of a wall, especially one that extends through the wall's entire thickness.",
                    "vi": "Gạch hoặc đá có kích thước dài nhất vuông góc với mặt tường, đặc biệt là kích thước kéo dài qua toàn bộ chiều dày của tường."
                },
                {
                    "en": "A vertical joint between bricks or blocks in a horizontal course.",
                    "vi": "Một mối nối dọc giữa các viên gạch hoặc khối theo phương nằm ngang."
                }
            ]
        }
    ],
    "meaning_vi": [
