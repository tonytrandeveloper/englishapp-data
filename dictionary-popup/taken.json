        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Take.",
                    "vi": "Lấy."
                },
                {
                    "en": "Taken is defined as to have acquired or gotten something.",
                    "vi": "Taken được định nghĩa là đã đạt được hoặc có được một cái gì đó."
                },
                {
                    "en": "Past participle of take.",
                    "vi": "Quá khứ phân từ của lấy."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "The definition of taken is unavailable, or having a deep interest in someone or something.",
                    "vi": "Không có định nghĩa về được thực hiện hoặc có mối quan tâm sâu sắc đến ai đó hoặc điều gì đó."
                },
                {
                    "en": "(informal) In a monoamorous relationship.",
                    "vi": "(thân mật) Trong một mối quan hệ độc thân."
                },
                {
                    "en": "Infatuated; fond of or attracted to.",
                    "vi": "Say mê; thích hoặc bị thu hút."
                }
            ]
        }
    ],
