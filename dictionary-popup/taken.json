    "sentences": [
        {
            "en": "It must have taken a long time to say good-bye.",
            "vi": "Phải mất một thời gian dài để nói lời tạm biệt."
        },
        {
            "en": "I've not taken a prize in weeks.",
            "vi": "Tôi đã không nhận được giải thưởng trong nhiều tuần."
        },
        {
            "en": "Taken together, those findings suggest that almost all economic growth in the last 120-plus years was from technology.",
            "vi": "Tổng hợp lại, những phát hiện đó cho thấy hầu hết tăng trưởng kinh tế trong hơn 120 năm qua đều là từ công nghệ."
        },
        {
            "en": "I've taken up enough of his time.",
            "vi": "Tôi đã chiếm đủ thời gian của anh ấy."
        },
        {
            "en": "His ride had taken almost an hour.",
            "vi": "Chuyến đi của anh ấy đã mất gần một giờ."
        },
        {
            "en": "The small house in which he had taken shelter was almost between the two armies.",
            "vi": "Ngôi nhà nhỏ mà anh đã trú ẩn gần như nằm giữa hai quân đội."
        },
        {
            "en": "It was a picture taken at the party and the focus was on Carmen and Alex.",
            "vi": "Đó là một bức ảnh được chụp tại bữa tiệc và tâm điểm là Carmen và Alex."
        },
        {
            "en": "I think the man who did it may have taken my wife and a young girl.",
            "vi": "Tôi nghĩ người đàn ông đã làm điều đó có thể đã lấy vợ và một cô gái trẻ của tôi."
        },
        {
            "en": "At last a ship happened to pass that way and Robinson was taken on board.",
            "vi": "Cuối cùng, một con tàu tình cờ đi qua con đường đó và Robinson được đưa lên tàu."
        },
        {
            "en": "She rolled her eyes, irritated that her brother hadn't taken his promise to her seriously.",
            "vi": "Cô đảo mắt, cáu kỉnh vì anh trai cô đã không thực hiện lời hứa với cô một cách nghiêm túc."
        }
