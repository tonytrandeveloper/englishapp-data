    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having the nature of numbness.",
                    "vi": "Có tính chất tê dại."
                },
                {
                    "en": "Emotionally unresponsive; indifferent.",
                    "vi": "Không phản hồi về mặt tình cảm; vô tư."
                },
                {
                    "en": "Deprived of the power to feel or move normally; benumbed.",
                    "vi": "Mất khả năng cảm nhận hoặc cử động bình thường; nằm sấp."
                },
                {
                    "en": "The definition of numb is someone or something without feeling or unable to move.",
                    "vi": "Định nghĩa của tê liệt là một người nào đó hoặc một cái gì đó không có cảm giác hoặc không thể di chuyển."
                },
                {
                    "en": "Without the power of sensation and motion or feeling; insensible.",
                    "vi": "Không có sức mạnh của cảm giác và chuyển động hoặc cảm giác; không thể hiểu được."
                },
                {
                    "en": "Not able to react, surprised, shocked.",
                    "vi": "Không kịp phản ứng, bất ngờ, bàng hoàng."
                },
                {
                    "en": "Causing numbness.",
                    "vi": "Gây tê bì."
                },
                {
                    "en": "Weakened in or deprived of the power of feeling or moving; benumbed; deadened; insensible.",
                    "vi": "Suy yếu hoặc mất khả năng cảm nhận hoặc cử động; nằm sấp; nguôi ngoai; không thể hiểu được."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To make or become numb.",
                    "vi": "Để làm cho hoặc trở nên tê liệt."
                },
                {
                    "en": "To make numb.",
                    "vi": "Để làm cho tê."
                },
                {
                    "en": "To cause to become numb.",
                    "vi": "Để gây ra tê liệt."
                }
            ]
        }
    ],
    "meaning_vi": [
