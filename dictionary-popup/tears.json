    "sentences": [
        {
            "en": "Tears burned her eyes and her lower lip trembled.",
            "vi": "Nước mắt cô bỏng rát và môi dưới run lên."
        },
        {
            "en": "Tears were in his eyes; but he tried to look brave.",
            "vi": "Nước mắt anh trào ra; nhưng anh ấy cố tỏ ra dũng cảm."
        },
        {
            "en": "Tears stung her eyes.",
            "vi": "Nước mắt cô cay xè."
        },
        {
            "en": "The stored tears continued to flow and the sobs wracked her body, robbing it of the ability to speak – barely allowing a breath to be drawn.",
            "vi": "Những giọt nước mắt tích trữ vẫn tiếp tục chảy ra và những tiếng nức nở quấn lấy cơ thể cô, cướp đi khả năng nói của cô - hầu như không cho phép lấy một hơi."
        },
        {
            "en": "Her eyes were filling with tears and she didn't want him to see.",
            "vi": "Đôi mắt cô ngấn lệ và cô không muốn anh nhìn thấy."
        },
        {
            "en": "She rocked back and fourth, tears coursing down her cheeks unchecked.",
            "vi": "Cô ấy lắc lư trở lại và thứ tư, nước mắt chảy dài trên má không kiểm soát."
        },
        {
            "en": "My heart was full of tears, for I love the beautiful truth with my whole heart and mind.",
            "vi": "Trái tim tôi rưng rưng, vì tôi yêu sự thật đẹp đẽ bằng cả trái tim và khối óc."
        },
        {
            "en": "Her eyes were probably bloodshot and tears were beginning to blur her vision.",
            "vi": "Đôi mắt cô ấy có lẽ đỏ ngầu và nước mắt bắt đầu làm mờ tầm nhìn của cô ấy."
        },
        {
            "en": "Her tears felt good.",
            "vi": "Nước mắt của cô ấy cảm thấy dễ chịu."
        },
        {
            "en": "She coughed, and tears stung her eyes.",
            "vi": "Cô ho, và nước mắt cô cay xè."
        }
