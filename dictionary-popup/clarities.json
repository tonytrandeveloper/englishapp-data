    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The quality or condition of being clear; clearness.",
                    "vi": "Chất lượng hoặc tình trạng rõ ràng; độ trong."
                },
                {
                    "en": "Clearness of thought or style; lucidity.",
                    "vi": "Sự rõ ràng của tư tưởng hoặc phong cách; sự minh mẫn."
                },
                {
                    "en": "Clearness of appearance.",
                    "vi": "Sự rõ ràng của ngoại hình."
                },
                {
                    "en": "The definition of clarity is the quality or condition of being clear or easy to understand.",
                    "vi": "Định nghĩa về sự rõ ràng là chất lượng hoặc điều kiện của sự rõ ràng hoặc dễ hiểu."
                },
                {
                    "en": "The state, or measure of being clear, either in appearance, thought or style; lucidity.",
                    "vi": "Trạng thái, hoặc thước đo về sự rõ ràng, cả về ngoại hình, tư tưởng hoặc phong cách; sự minh mẫn."
                }
            ]
        }
    ],
