    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Resembling a maze, as in design or complexity; labyrinthine.",
                    "vi": "Giống như một mê cung, như trong thiết kế hoặc độ phức tạp; mê cung."
                },
                {
                    "en": "Like a maze; intricately winding; bewildering.",
                    "vi": "Như một mê cung; quanh co phức tạp; hoang mang."
                },
                {
                    "en": "Mazelike; like a maze.",
                    "vi": "Mazelike; như một mê cung."
                },
                {
                    "en": "Not strait, zigzagging.",
                    "vi": "Không phải eo biển, ngoằn ngoèo."
                }
            ]
        }
    ],
    "meaning_vi": [
        "quanh co, khó lần ra manh mối, khó tìm lối ra",
