            "meaning": [
                {
                    "en": "To disgorge.",
                    "vi": "Để làm phiền lòng."
                },
                {
                    "en": "To throw up or back; disgorge.",
                    "vi": "Để ném lên hoặc trở lại; nôn ra."
                },
                {
                    "en": "To flow or gush back, as water.",
                    "vi": "Để chảy hoặc chảy ngược lại, như nước."
                },
                {
                    "en": "To disgorge or vomit.",
                    "vi": "Để làm khó chịu hoặc nôn mửa."
                },
                {
                    "en": "To swallow again; to swallow back.",
                    "vi": "Để nuốt một lần nữa; để nuốt trở lại."
                }
            ]
        }
    ],
