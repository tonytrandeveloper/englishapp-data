    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A condition of noisy excitement and confusion; a tumult.",
                    "vi": "Một tình trạng của sự phấn khích ồn ào và nhầm lẫn; một sự xôn xao."
                },
                {
                    "en": "The definition of an uproar is a violent disturbance or a loud noise.",
                    "vi": "Định nghĩa của náo động là một sự xáo trộn dữ dội hoặc một tiếng ồn lớn."
                },
                {
                    "en": "Tumultuous, noisy excitement.",
                    "vi": "Náo nhiệt náo nhiệt, ồn ào."
                },
                {
                    "en": "Loud confused noise, especially when coming from several sources.",
                    "vi": "Tiếng ồn lớn gây nhầm lẫn, đặc biệt là khi đến từ một số nguồn."
                },
                {
                    "en": "An impassioned protest or heated controversy.",
                    "vi": "Một cuộc phản đối nóng nảy hoặc một cuộc tranh cãi nảy lửa."
                },
                {
                    "en": "Violent disturbance or commotion, esp. one accompanied by loud, confused noise, as of shouting; tumult.",
                    "vi": "Bạo lực hoặc náo động, đặc biệt. một kèm theo tiếng ồn lớn, bối rối, như la hét; xôn xao."
                },
                {
                    "en": "Loud, confused noise; din.",
                    "vi": "Tiếng ồn lớn, nhầm lẫn; din."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To throw into uproar or confusion.",
                    "vi": "Để ném vào náo động hoặc nhầm lẫn."
                }
            ]
        }
    ],
