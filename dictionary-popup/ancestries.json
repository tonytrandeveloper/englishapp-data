    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Family descent or lineage.",
                    "vi": "Nguồn gốc gia đình hoặc dòng họ."
                },
                {
                    "en": "Ancestral descent or lineage.",
                    "vi": "Nguồn gốc hoặc dòng dõi tổ tiên."
                },
                {
                    "en": "Ancestors considered as a group.",
                    "vi": "Tổ tiên coi như một nhóm."
                },
                {
                    "en": "Ancestors collectively.",
                    "vi": "Tổ tiên gọi chung là."
                },
                {
                    "en": "Condition as to ancestors; ancestral lineage; hence, birth or honorable descent.",
                    "vi": "Tình trạng đối với tổ tiên; dòng dõi tổ tiên; do đó, sinh ra hoặc dòng dõi danh giá."
                },
                {
                    "en": "A series of ancestors or progenitors; lineage, or those who compose the line of natural descent.",
                    "vi": "Một loạt các tổ tiên hoặc tiền nhân; dòng dõi, hoặc những người sáng tác dòng dõi thiên hạ."
                },
                {
                    "en": "Noble or distinguished descent.",
                    "vi": "Dòng dõi cao quý hoặc phân biệt."
                }
            ]
        }
    ],
    "meaning_vi": [
        "tổ tiên, tổ tông, tông môn",
