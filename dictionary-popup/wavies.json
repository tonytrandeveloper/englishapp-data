    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having waves.",
                    "vi": "Có sóng."
                },
                {
                    "en": "Moving in a wavelike motion.",
                    "vi": "Chuyển động như dao động."
                },
                {
                    "en": "Having undulating curves; forming waves and hollows; sinuous.",
                    "vi": "Có đường cong nhấp nhô; hình thành sóng và rỗng; quanh co."
                },
                {
                    "en": "Characteristic or suggestive of waves.",
                    "vi": "Đặc trưng hoặc gợi hình của sóng."
                },
                {
                    "en": "Wavering; fluctuating; unsteady.",
                    "vi": "Dao động; dao động; chông chênh."
                },
                {
                    "en": "Rising or swelling in waves.",
                    "vi": "Nổi lên hoặc sưng lên theo từng đợt."
                },
                {
                    "en": "Full of waves.",
                    "vi": "Đầy sóng."
                },
                {
                    "en": "Moving to and fro; undulating.",
                    "vi": "Di chuyển đến và đi; nhấp nhô."
                },
                {
                    "en": "Having wave-like shapes on its border or surface; waved.",
                    "vi": "Có hình dạng giống như sóng trên đường viền hoặc bề mặt của nó; vẫy tay chào."
                },
                {
                    "en": "(botany, of a margin) Moving up and down relative to the surface; undulate.",
                    "vi": "(thực vật học, của một lề) Di chuyển lên và xuống so với bề mặt; uốn lượn."
                },
                {
                    "en": "Abounding or rising in waves.",
                    "vi": "Nhiều hoặc tăng theo từng đợt."
                },
                {
                    "en": "Marked by or moving in a wavelike form or motion; sinuous.",
                    "vi": "Được đánh dấu bằng hoặc chuyển động ở dạng hoặc chuyển động giống như sóng; quanh co."
                },
                {
                    "en": "Having curls, curves, or undulations.",
                    "vi": "Có lọn tóc, đường cong hoặc uốn lượn."
                },
                {
                    "en": "Characteristic or suggestive of waves.",
                    "vi": "Đặc trưng hoặc gợi hình của sóng."
                },
                {
                    "en": "Wavering; unstable.",
                    "vi": "Dao động; không ổn định."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(possibly dated) Alternative form of wavey (goose).",
                    "vi": "(có thể có niên đại) Hình thức thay thế của wavey (ngỗng)."
                }
            ]
        }
