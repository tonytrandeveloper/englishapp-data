            "meaning": [
                {
                    "en": "Tending to complain or grumble; peevish or grumpy.",
                    "vi": "Có xu hướng phàn nàn hoặc càu nhàu; cáu kỉnh hoặc gắt gỏng."
                },
                {
                    "en": "In a bad-tempered or sulky mood; grumpy.",
                    "vi": "Có tâm trạng xấu tính hoặc hờn dỗi; gắt gỏng."
                },
                {
                    "en": "Irritable; easily upset; angry; tending to complain. [From 1895]",
                    "vi": "Dễ cáu bẳn; dễ buồn chán; tức giận; có xu hướng phàn nàn. [Từ 1895]"
                }
