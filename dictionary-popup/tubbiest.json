    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "(informal) Short and plump.",
                    "vi": "(trang trọng) Ngắn và đầy đặn."
                },
                {
                    "en": "Shaped like a tub.",
                    "vi": "Có hình dạng giống như một chiếc bồn tắm."
                },
                {
                    "en": "Stout, rotund.",
                    "vi": "Mập mạp, kháu khỉnh."
                },
                {
                    "en": "Resembling a tub; sounding dull and without resonance or freedom of sound.",
                    "vi": "Giống như một cái bồn tắm; âm thanh buồn tẻ và không có âm vang hoặc tự do của âm thanh."
                },
                {
                    "en": "Having a rounded shape.",
                    "vi": "Có hình dạng tròn."
                },
                {
                    "en": "Having a dull sound; lacking resonance.",
                    "vi": "Có âm thanh buồn tẻ; thiếu cộng hưởng."
                },
                {
                    "en": "(informal) Fat and short.",
                    "vi": "(không chính thức) Béo và ngắn."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(pejorative, slang, often used teasingly) An overweight person.",
                    "vi": "(khinh bỉ, tiếng lóng, thường được dùng để trêu chọc) Một người thừa cân."
                }
            ]
        }
    ],
