    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To tell a fib.",
                    "vi": "Để nói với một fib."
                },
                {
                    "en": "To tell such a lie or lies.",
                    "vi": "Nói dối như vậy hay nói dối."
                },
                {
                    "en": "(intransitive) To lie, especially more or less inconsequentially.",
                    "vi": "(nội tâm) Nói dối, đặc biệt là nói dối ít nhiều."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "An insignificant or childish lie.",
                    "vi": "Một lời nói dối tầm thường hoặc trẻ con."
                },
                {
                    "en": "A small or trivial lie.",
                    "vi": "Một lời nói dối nhỏ hoặc tầm thường."
                },
                {
                    "en": "(informal) A lie, especially one that is more or less inconsequential.",
                    "vi": "(không chính thức) Một lời nói dối, đặc biệt là một lời nói dối ít nhiều không quan trọng."
                },
                {
                    "en": "(medicine, informal) Short form of fibula.",
                    "vi": "(y học, không chính thức) Dạng sợi tơ ngắn."
                }
            ]
        }
    ],
    "meaning_vi": [
        "điều nói dối nhỏ; chuyện bịa",
