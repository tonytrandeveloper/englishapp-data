    "phonetics": {
        "uk": "ˈspraɪtlɪɪst",
        "us": "ˈspraɪtlɪɪst"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Full of spirit and vitality; lively; brisk.",
                    "vi": "Đầy tinh thần và sức sống; sống động; nhanh chóng."
                },
                {
                    "en": "Full of energy and spirit; lively, brisk, etc.",
                    "vi": "Đầy năng lượng và tinh thần; sống động, nhanh nhẹn, v.v."
                },
                {
                    "en": "Animated, vivacious, or gay; lively.",
                    "vi": "Hoạt bát, hoạt bát hoặc đồng tính nam; sống động."
                },
                {
                    "en": "Full of life and vigor, especially with a light and springy step.",
                    "vi": "Tràn đầy sức sống và mạnh mẽ, đặc biệt là bước đi nhẹ nhàng và thanh xuân."
                },
                {
                    "en": "(especially of old people) Energetic and in good health.",
                    "vi": "(đặc biệt là người già) Hăng hái và có sức khỏe tốt."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "In a lively and vigorous way.",
                    "vi": "Một cách sống động và mạnh mẽ."
                },
                {
                    "en": "In a lively, animated manner.",
                    "vi": "Một cách sinh động, hoạt hình."
                },
                {
                    "en": "In a sprightly manner.",
                    "vi": "Một cách lanh lợi."
                }
            ]
        }
    ],
    "meaning_vi": [
