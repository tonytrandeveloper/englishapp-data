    "sentences": [
        {
            "en": "I could hear the baby crying the background.",
            "vi": "Tôi có thể nghe thấy tiếng khóc của đứa bé."
        },
        {
            "en": "His children were crying for food.",
            "vi": "Những đứa con của ông đang khóc đòi ăn."
