            "meaning": [
                {
                    "en": "Demanding or requiring action or attention.",
                    "vi": "Yêu cầu hoặc yêu cầu hành động hoặc sự chú ý."
                },
                {
                    "en": "Abominable; reprehensible.",
                    "vi": "Khả ái; đáng trách."
                },
                {
                    "en": "That demands action or attention.",
                    "vi": "Điều đó đòi hỏi hành động hoặc sự chú ý."
                },
                {
                    "en": "That deserves rebuke or censure.",
                    "vi": "Điều đó đáng bị quở trách hoặc chỉ trích."
                },
                {
                    "en": "That cries.",
                    "vi": "Đó là tiếng khóc."
                },
                {
                    "en": "Demanding immediate notice or remedy.",
                    "vi": "Yêu cầu thông báo hoặc khắc phục ngay lập tức."
