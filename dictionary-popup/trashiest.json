            "meaning": [
                {
                    "en": "Resembling or containing trash; cheap or worthless.",
                    "vi": "Có vẻ giống hoặc chứa rác; rẻ tiền hoặc vô giá trị."
                },
                {
                    "en": "In very poor taste or of very poor quality.",
                    "vi": "Có mùi vị rất kém hoặc chất lượng rất kém."
                },
                {
                    "en": "Containing, consisting of, or like trash; worthless, offensive, etc.",
                    "vi": "Chứa, bao gồm, hoặc giống như rác; vô giá trị, xúc phạm, v.v."
                },
                {
                    "en": "Like trash; containing much trash.",
                    "vi": "Như rác rưởi; chứa nhiều rác."
                }
            ]
        }
    ],
