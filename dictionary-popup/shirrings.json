    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A gathering made in cloth by drawing the material up on parallel rows of short running stitches.",
                    "vi": "Tập hợp được làm bằng vải bằng cách kéo vật liệu lên trên các hàng mũi may chạy ngắn song song."
                },
                {
                    "en": "Any trimming made by this method.",
                    "vi": "Bất kỳ sự cắt tỉa nào được thực hiện bằng phương pháp này."
                },
                {
                    "en": "Two or more rows of gathers used to decorate parts of garments, usually the sleeves, bodice and yoke.",
                    "vi": "Hai hoặc nhiều hàng tập hợp được sử dụng để trang trí các bộ phận của hàng may mặc, thường là tay áo, vạt áo và ách."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of shirr.",
                    "vi": "Hiện tại phân từ shirr."
                }
            ]
        }
    ],
