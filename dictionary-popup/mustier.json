    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Stale or moldy in odor or taste.",
                    "vi": "Có mùi hôi hoặc vị."
                },
                {
                    "en": "Having a stale, moldy smell or taste, as an unused room, food kept in a damp place, etc.",
                    "vi": "Có mùi hoặc vị ôi thiu, ẩm mốc do phòng không sử dụng, thực phẩm để nơi ẩm thấp, v.v."
                },
                {
                    "en": "Stale or trite; worn-out; antiquated.",
                    "vi": "Cũ kỹ hoặc sáo mòn; bị mòn; cổ kính."
                },
                {
                    "en": "Dull; apathetic.",
                    "vi": "Đần độn; thờ ơ."
                },
                {
                    "en": "The definition of musty is having a moldy, stale or damp smell.",
                    "vi": "Định nghĩa của mốc là có mùi mốc, ôi thiu hoặc ẩm ướt."
                },
                {
                    "en": "Hackneyed or trite; dull.",
                    "vi": "Hackneyed hoặc sáo mòn; đần độn."
                },
                {
                    "en": "Out of date; antiquated.",
                    "vi": "Hết hạn; cổ kính."
                },
                {
                    "en": "Out of use or practice; rusty.",
                    "vi": "Hết sử dụng hoặc thực hành; hoen gỉ."
                },
                {
                    "en": "Having a stale odor.",
                    "vi": "Có mùi hôi thối."
                }
            ]
        }
    ],
    "meaning_vi": [
