            "meaning": [
                {
                    "en": "Prolonged, sometimes senseless talk.",
                    "vi": "Nói kéo dài, đôi khi vô nghĩa."
                },
                {
                    "en": "(slang) Prolonged chatter; uninterrupted, idle talk; gossip.",
                    "vi": "(tiếng lóng) Nói nhảm kéo dài; không bị gián đoạn, nói chuyện nhàn rỗi; Mach lẻo."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(intransitive, slang) To talk pointlessly and uninterruptedly.",
                    "vi": "(intransitive, slang) Để nói chuyện một cách vô nghĩa và không bị gián đoạn."
                }
            ]
        }
