    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A person who is stupid or easily deceived; fool.",
                    "vi": "Một người ngu ngốc hoặc dễ bị lừa dối; lừa gạt."
                },
                {
                    "en": "A person who is felt to be deficient in judgment, good sense, or intelligence; a fool.",
                    "vi": "Một người được cho là thiếu khả năng phán đoán, ý thức tốt, hoặc trí thông minh; một kẻ ngốc."
                },
                {
                    "en": "(pejorative) A simple person lacking common sense.",
                    "vi": "Một người đơn giản thiếu ý thức chung."
                }
            ]
        }
    ],
