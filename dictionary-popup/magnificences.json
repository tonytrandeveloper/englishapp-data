    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Greatness or lavishness of surroundings; splendor.",
                    "vi": "Sự vĩ đại hoặc xa hoa của môi trường xung quanh; huy hoàng."
                },
                {
                    "en": "Grand or imposing beauty.",
                    "vi": "Vẻ đẹp hùng vĩ hoặc hùng vĩ."
                },
                {
                    "en": "Richness and splendor, as of furnishings, color, dress, etc.; stately or imposing beauty.",
                    "vi": "Sự giàu có và lộng lẫy, như đồ đạc, màu sắc, trang phục, v.v.; vẻ đẹp trang nghiêm hoặc đường bệ."
                },
                {
                    "en": "The definition of magnificence is splendor and lavishness.",
                    "vi": "Định nghĩa của sự tráng lệ là sự lộng lẫy và xa hoa."
                },
                {
                    "en": "Grandeur, brilliance, lavishness or splendor.",
                    "vi": "Sự xa hoa, rực rỡ, xa hoa hay lộng lẫy."
                },
                {
                    "en": "The act of doing what magnificent; the state or quality of being magnificent.",
                    "vi": "Hành động làm những gì tuyệt vời; trạng thái hoặc chất lượng tuyệt vời."
                },
                {
                    "en": "Impressiveness.",
                    "vi": "Sự ấn tượng."
                }
            ]
        }
    ],
