        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Dark or dim, as from mist.",
                    "vi": "Tối hoặc mờ, như từ sương mù."
                },
                {
                    "en": "Dark or gloomy.",
                    "vi": "Tối tăm hoặc u ám."
                },
                {
                    "en": "Not clearly known, understood, or expressed.",
                    "vi": "Không được biết, hiểu hoặc diễn đạt rõ ràng."
                },
                {
                    "en": "Darkened, clouded, or blurry.",
                    "vi": "Bị tối, bị mờ hoặc bị mờ."
                },
                {
                    "en": "The definition of murky is something that is dark, gloomy, or dirty, or something that is not clear and that might involve deception.",
                    "vi": "Định nghĩa của âm u là một cái gì đó tối tăm, u ám hoặc bẩn thỉu, hoặc một cái gì đó không rõ ràng và có thể liên quan đến sự lừa dối."
                },
                {
                    "en": "Hard to see through, as a fog or mist.",
                    "vi": "Khó nhìn xuyên qua, như một làn sương mù hoặc sương mù."
                },
                {
                    "en": "Gloomy, dark, dim.",
                    "vi": "Âm u, tăm tối, mờ mịt."
                },
                {
                    "en": "Obscure, indistinct, cloudy.",
                    "vi": "Không rõ ràng, không rõ ràng, nhiều mây."
                },
                {
                    "en": "Dishonest, shady.",
                    "vi": "Không trung thực, mờ ám."
                },
                {
                    "en": "Heavy and obscure with smoke, mist, etc.",
                    "vi": "Nặng nề và mờ mịt với khói, sương mù, v.v."
                },
                {
                    "en": "Unclear, obscure, cryptic, etc.",
                    "vi": "Không rõ ràng, tối nghĩa, khó hiểu, v.v."
                }
            ]
        }
    ],
