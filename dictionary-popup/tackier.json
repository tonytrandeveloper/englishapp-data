    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "In poor taste; inelegant.",
                    "vi": "Trong vị nghèo; không lịch sự."
                },
                {
                    "en": "Slightly adhesive or gummy to the touch; sticky.",
                    "vi": "Hơi dính hoặc keo khi chạm vào; dính."
                },
                {
                    "en": "Sticky.",
                    "vi": "Dính."
                },
                {
                    "en": "Dowdy or shabby, as in dress or appearance.",
                    "vi": "Xuống hoặc tồi tàn, như trong cách ăn mặc hoặc ngoại hình."
                },
                {
                    "en": "The definition of tacky is something tasteless and overdone, or something that is still sticky.",
                    "vi": "Định nghĩa của tacky là một thứ gì đó vô vị và quá trớn, hoặc một thứ gì đó vẫn còn dính."
                },
                {
                    "en": "Flimsy, rundown, or in poor repair.",
                    "vi": "Mỏng manh, hư hỏng hoặc sửa chữa kém."
                },
                {
                    "en": "Lacking style or good taste; tawdry.",
                    "vi": "Thiếu phong cách hoặc hương vị tốt; sự chế nhạo."
                },
                {
                    "en": "Distasteful or offensive; tasteless.",
                    "vi": "Khó chịu hoặc xúc phạm; vô vị."
                },
                {
                    "en": "Of a substance, slightly sticky.",
                    "vi": "Của một chất, hơi dính."
                },
                {
                    "en": "(colloquial) Of low quality.",
                    "vi": "(thông tục) Chất lượng thấp."
                },
                {
                    "en": "(colloquial) In poor taste.",
                    "vi": "(thông tục) Ở hương vị kém."
                },
                {
                    "en": "Gaudy, flashy, showy, garish.",
                    "vi": "Cầu kỳ, hào nhoáng, sặc sỡ, sặc sỡ."
                },
                {
                    "en": "Dowdy, shabbily dressed.",
                    "vi": "Ăn mặc xuề xòa, tồi tàn."
                },
                {
                    "en": "Shabby, dowdy (in one's appearance)",
