        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A minor injury or bruise.",
                    "vi": "Một vết thương hoặc vết bầm tím nhẹ."
                },
                {
                    "en": "A stupid mistake; a blunder.",
                    "vi": "Một sai lầm ngu ngốc; một sự nhầm lẫn."
                },
                {
                    "en": "A slight physical injury, such as a scratch.",
                    "vi": "Một chấn thương thể chất nhẹ, chẳng hạn như một vết xước."
                },
                {
                    "en": "(slang) A stupid or foolish mistake; blunder.",
                    "vi": "(tiếng lóng) Một sai lầm ngu xuẩn hoặc ngu xuẩn; sai lầm."
                },
                {
                    "en": "Alternative spelling of boo-boo.",
                    "vi": "Cách viết khác của boo-boo."
                },
                {
                    "en": "(colloquial, often childish) A mistake or error.",
                    "vi": "(thông tục, thường là trẻ con) Một sai lầm hoặc lỗi."
                },
                {
                    "en": "(colloquial, childish, by or to young children) A minor injury, such as a cut or a bruise.",
                    "vi": "(thông tục, trẻ con, bởi hoặc với trẻ nhỏ) Một vết thương nhẹ, chẳng hạn như vết cắt hoặc vết bầm tím."
                }
            ]
        }
