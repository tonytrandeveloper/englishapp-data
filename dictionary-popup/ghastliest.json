            "meaning": [
                {
                    "en": "Extremely unpleasant or bad.",
                    "vi": "Cực kỳ khó chịu hoặc tồi tệ."
                },
                {
                    "en": "Horrible; frightful.",
                    "vi": "Tệ hại; kinh khủng."
                },
                {
                    "en": "Causing shock, revulsion, or horror; terrifying.",
                    "vi": "Gây sốc, kinh hãi hoặc kinh hoàng; kinh hoàng."
                },
                {
                    "en": "Resembling a ghost; pale or pallid.",
                    "vi": "Giống như một bóng ma; nhợt nhạt hoặc xanh xao."
                },
                {
                    "en": "Very bad or unpleasant.",
                    "vi": "Rất tệ hoặc khó chịu."
                },
                {
                    "en": "Ghostlike; pale; haggard.",
                    "vi": "Như ma; tái nhợt; xanh xao."
                },
                {
                    "en": "The definition of ghastly is something repellent, horrible, frightful, ugly, macabre or sickly.",
                    "vi": "Định nghĩa của ghê rợn là một thứ gì đó ghê tởm, khủng khiếp, đáng sợ, xấu xí, rùng rợn hoặc bệnh hoạn."
                },
                {
                    "en": "Like a ghost in appearance; deathlike; pale; pallid; dismal.",
                    "vi": "Giống như một con ma trong sự xuất hiện; giống như chết chóc; tái nhợt; xanh xao; ảm đạm."
                },
                {
                    "en": "Horrifyingly shocking.",
                    "vi": "Sốc kinh hoàng."
                },
                {
                    "en": "Extremely bad.",
                    "vi": "Thực sự rất tồi tệ."
                }
            ]
        },
