            "meaning": [
                {
                    "en": "Grouchy; ill-tempered.",
                    "vi": "Rắc rối; xấu tính."
                },
                {
                    "en": "Cross and complaining; peevish; ill-tempered.",
                    "vi": "Vượt qua và phàn nàn; hư hỏng; xấu tính."
                },
                {
                    "en": "Visibly irritated or annoyed; grouchy, irritable, in a foul mood; given to complaining or finding fault in an annoyed way.",
                    "vi": "Rõ ràng là bị kích thích hoặc khó chịu; cáu kỉnh, cáu kỉnh, có tâm trạng khó chịu; được đưa ra để phàn nàn hoặc tìm ra lỗi một cách khó chịu."
                },
                {
                    "en": "Crabbed; difficult, or perplexing.",
                    "vi": "Chữ viết tay; khó, hoặc bối rối."
                }
            ]
        }
    ],
