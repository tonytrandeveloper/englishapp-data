    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A stretch of level and open country; a plain.",
                    "vi": "Một sự trải dài của đẳng cấp và đất nước rộng mở; một đồng bằng."
                },
                {
                    "en": "A broad plain; flat, open country.",
                    "vi": "Một vùng đồng bằng rộng lớn; đất nước bằng phẳng, rộng mở."
                },
                {
                    "en": "(geography, archaic) Open countryside, or an area of open countryside.",
                    "vi": "(địa lý, cổ) Vùng nông thôn rộng mở, hoặc một vùng nông thôn rộng mở."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or like a champaign.",
                    "vi": "Của hoặc giống như một champaign."
                },
                {
                    "en": "Pertaining to open countryside; unforested, flat.",
                    "vi": "Khơi dậy vùng nông thôn rộng mở; không lường trước, bằng phẳng."
                }
            ]
        },
        {
            "pos": "proper name",
            "meaning": [
                {
                    "en": "(place) City in EC Ill.",
                    "vi": "(địa điểm) Thành phố ở EC Ill."
                }
            ]
        }
    ],
    "meaning_vi": [
