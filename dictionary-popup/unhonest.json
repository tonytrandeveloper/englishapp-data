                },
                {
                    "en": "(obsolete) Dishonourable (of people); immoral, not respectable.",
                    "vi": "(lỗi thời) Nhục nhã (của người ta); vô đạo đức, không đáng kính."
                },
                {
                    "en": "(obsolete) Dishonest.",
                    "vi": "(lỗi thời) Không trung thực."
                }
            ]
        }
