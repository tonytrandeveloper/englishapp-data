    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A decorative trinket; a bauble.",
                    "vi": "Một món đồ trang trí; một món trang sức."
                },
                {
                    "en": "Something showy but useless and of little value; trinket.",
                    "vi": "Một thứ gì đó sặc sỡ nhưng vô dụng và ít giá trị; đồ nữ trang."
                },
                {
                    "en": "A showy trifle, a toy; a showy trinket, ornament or decoration. [from 15th c.]",
                    "vi": "Một món đồ lặt vặt, một món đồ chơi sặc sỡ; một món đồ trang sức, vật trang trí hoặc đồ trang trí sặc sỡ. [từ ngày 15 c.]"
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Showy but useless.",
                    "vi": "Trưng bày nhưng vô dụng."
                },
                {
                    "en": "Showy; unreal; pretentious.",
                    "vi": "Sặc sỡ; không có thật; tự phụ."
                }
            ]
        }
    ],
    "meaning_vi": [
