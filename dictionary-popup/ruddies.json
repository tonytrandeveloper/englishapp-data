    "phonetics": {
        "uk": "ˈrʌdiz",
        "us": "ˈrʌdiz"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having a healthy red color.",
                    "vi": "Có màu đỏ tươi khỏe khoắn."
                },
                {
                    "en": "The definition of ruddy is a person or thing with a rosy red color.",
                    "vi": "Định nghĩa của hồng hào là người hoặc vật có màu đỏ hồng."
                },
                {
                    "en": "(chiefly british slang) Used as an intensive.",
                    "vi": "(chủ yếu là tiếng lóng của người Anh) Được sử dụng như một từ chuyên sâu."
                },
                {
                    "en": "Having a healthy, reddish color.",
                    "vi": "Có một màu đỏ, khỏe mạnh."
                },
                {
                    "en": "Reddish; rosy.",
                    "vi": "Hơi đỏ; hồng hào."
                },
                {
                    "en": "Reddish in color, especially of the face, fire, or sky.",
                    "vi": "Màu hơi đỏ, đặc biệt là ở mặt, lửa hoặc bầu trời."
                },
                {
                    "en": "(UK, slang) A mild intensifier.",
                    "vi": "(Anh, tiếng lóng) Một chất tăng cường nhẹ."
                },
                {
                    "en": "(brit., informal) Confounded: an intensive.",
                    "vi": "(Anh, không chính thức) Nhầm lẫn: chuyên sâu."
                },
                {
                    "en": "Red or reddish.",
                    "vi": "Đỏ hoặc hơi đỏ."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(informal) Ruddy duck.",
                    "vi": "(thân mật) Vịt hồng hào."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To make reddish in colour.",
                    "vi": "Để tạo màu đỏ."
                }
            ]
        }
    ],
