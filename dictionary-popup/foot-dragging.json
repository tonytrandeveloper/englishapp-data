    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Failure to take prompt or required action.",
                    "vi": "Không thực hiện hành động nhanh chóng hoặc bắt buộc."
                },
                {
                    "en": "Foot dragging is defined as procrastination or behavior that is not very eager.",
                    "vi": "Kéo chân được định nghĩa là sự trì hoãn hoặc hành vi không mấy háo hức."
                },
                {
                    "en": "Deliberate slowness or delay; stalling.",
                    "vi": "Cố ý làm chậm hoặc trì hoãn; sự đình trệ."
                },
                {
                    "en": "Alternative spelling of foot-dragging.",
                    "vi": "Cách viết khác của thao tác kéo chân."
                },
                {
                    "en": "The deliberate delaying of obligatory action.",
                    "vi": "Việc cố ý trì hoãn hành động bắt buộc."
                }
            ]
        }
    ],
