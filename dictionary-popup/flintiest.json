    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Containing or composed of flint.",
                    "vi": "Chứa hoặc cấu tạo từ đá lửa."
                },
                {
                    "en": "Unyielding; stern.",
                    "vi": "Bất khuất; nghiêm nghị."
                },
                {
                    "en": "Made of or containing flint.",
                    "vi": "Làm bằng hoặc chứa đá lửa."
                },
                {
                    "en": "Like flint; extremely hard and firm; inflexible.",
                    "vi": "Giống như đá lửa; cực kỳ cứng và chắc chắn; không linh hoạt."
                },
                {
                    "en": "Resembling or containing flint.",
                    "vi": "Kết dính hoặc chứa đá lửa."
                },
                {
                    "en": "Siliceous (including basanite)",
                    "vi": "Siliceous (bao gồm cả basanite)"
                },
                {
                    "en": "Showing a lack of emotion.",
                    "vi": "Tỏ ra thiếu cảm xúc."
                },
                {
                    "en": "Having a taste characteristic of certain white wines, especially Chablis, supposed to evoke the sensation of flint striking steel.",
                    "vi": "Có một hương vị đặc trưng của một số loại rượu vang trắng, đặc biệt là Chablis, được cho là gợi lên cảm giác của đá lửa nổi bật."
                }
            ]
        }
    ],
    "meaning_vi": [
        "bằng đá lửa; có đá lửa",
        "như đá lửa; rắn như đá lửa",
        "(nghĩa bóng) cứng rắn; sắt đá"
    ],
    "synonyms": [
        "steely",
        "firm",
        "hard",
        "cruel",
        "unsympathetic",
        "unyielding",
        "inflexible",
        "rigid",
        "stony"
    ],
