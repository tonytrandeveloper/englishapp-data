    "sentences": [
        {
            "en": "His moods came and went like summer storms.",
            "vi": "Tâm trạng của anh đến và đi như những cơn bão mùa hè."
        },
        {
            "en": "The chickens went to roost.",
            "vi": "Đàn gà đi gáy."
        },
        {
            "en": "I went along with it.",
            "vi": "Tôi đã đi cùng với nó."
        },
        {
            "en": "The smith went on with his work.",
            "vi": "Người thợ rèn tiếp tục công việc của mình."
        },
        {
            "en": "He pushed the bushes aside and went a little farther.",
            "vi": "Anh gạt bụi cây sang một bên và đi xa hơn một chút."
        },
        {
            "en": "Her mouth went dry and her stomach lurched violently.",
            "vi": "Miệng cô khô khốc và bụng cô cồn cào dữ dội."
        },
        {
            "en": "When Ozma went away she closed the door and left her pet on the table.",
            "vi": "Khi Ozma đi khỏi, cô ấy đóng cửa và để lại con vật cưng của mình trên bàn."
        },
        {
            "en": "Maybe because he went into hiding from his family.",
            "vi": "Có lẽ vì anh ấy đã đi trốn gia đình."
        },
        {
            "en": "Michael Ivanovich rose and went to the study.",
            "vi": "Michael Ivanovich đứng dậy và đi đến nghiên cứu."
        },
        {
            "en": "On seeing Alpatych he went up to him.",
            "vi": "Khi nhìn thấy Alpatych, anh ấy đã đi đến chỗ anh ta."
