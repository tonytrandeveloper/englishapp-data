        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To last permanently; endure.",
                    "vi": "Để tồn tại vĩnh viễn; chịu đựng."
                },
                {
                    "en": "To remain in existence.",
                    "vi": "Để duy trì sự tồn tại."
                },
                {
                    "en": "Perdure is defined as to last permanently.",
                    "vi": "Perdure được định nghĩa là tồn tại vĩnh viễn."
                },
                {
                    "en": "To endure; especially for a great length of time.",
                    "vi": "Để tăng sức chịu đựng; đặc biệt là trong một khoảng thời gian dài."
                },
                {
                    "en": "(philosophy) To exist in such a way as to possess distinct temporal parts (in perdurantism)",
                    "vi": "(triết học) Tồn tại theo cách sở hữu những phần thời gian riêng biệt (trong thuyết vĩnh viễn)"
                }
            ]
        }
    ],
