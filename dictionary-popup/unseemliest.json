    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Not in accord with accepted standards of decency or morality.",
                    "vi": "Không phù hợp với các tiêu chuẩn lễ phép hoặc đạo đức được chấp nhận."
                },
                {
                    "en": "Not suited to the circumstances; inappropriate.",
                    "vi": "Không phù hợp với hoàn cảnh; không thích hợp."
                },
                {
                    "en": "Unattractive; unsightly.",
                    "vi": "Không hấp dẫn; khó coi."
                },
                {
                    "en": "Not seemly; not decent or proper; unbecoming; indecorous.",
                    "vi": "Có vẻ như không; không đàng hoàng hay đàng hoàng; không thích hợp; bất lịch sự."
                },
                {
                    "en": "Inconsistent with established standards of good form or taste.",
                    "vi": "Không phù hợp với các tiêu chuẩn đã được thiết lập về hình thức hoặc mùi vị tốt."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "In an improper or inappropriate manner.",
                    "vi": "Theo cách không thích hợp hoặc không phù hợp."
                },
                {
                    "en": "In an unseemly manner.",
                    "vi": "Theo một cách vô hình."
                }
            ]
        }
    ],
    "meaning_vi": [
