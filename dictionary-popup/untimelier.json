            "meaning": [
                {
                    "en": "Occurring or done at an inappropriate time; inopportune.",
                    "vi": "Xảy ra hoặc được thực hiện vào thời điểm không thích hợp; không phù hợp."
                },
                {
                    "en": "Occurring too soon; premature.",
                    "vi": "Xảy ra quá sớm; chết yểu."
                },
                {
                    "en": "Coming, said, done, etc. before the usual or expected time; premature.",
                    "vi": "Đến, nói, làm, vv trước thời gian thông thường hoặc dự kiến; chết yểu."
                },
                {
                    "en": "Coming, said, done, etc. at the wrong time; poorly timed; inopportune.",
                    "vi": "Đến, nói, làm, vv không đúng lúc; hẹn giờ kém; không phù hợp."
                },
                {
