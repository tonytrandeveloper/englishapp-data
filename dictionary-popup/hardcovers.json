    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Bound in cloth, cardboard, or leather rather than paper. Used of books.",
                    "vi": "Bọc bằng vải, bìa cứng, hoặc da chứ không phải bằng giấy. Sử dụng sách."
                },
                {
                    "en": "Designating any book bound in a relatively stiff cover, as of cloth-covered cardboard.",
                    "vi": "Chỉ định bất kỳ cuốn sách nào được đóng bìa cứng, bằng bìa cứng bọc vải."
                },
                {
                    "en": "(of a book) Having a rigid binding.",
                    "vi": "(của một cuốn sách) Có một ràng buộc cứng nhắc."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A hardcover book.",
                    "vi": "Một cuốn sách bìa cứng."
                },
                {
                    "en": "A hardcover book.",
                    "vi": "Một cuốn sách bìa cứng."
                },
                {
                    "en": "A book with a rigid binding, often of cardboard or leather.",
                    "vi": "Sách có bìa cứng, thường bằng bìa cứng hoặc da."
                }
            ]
        }
    ],
