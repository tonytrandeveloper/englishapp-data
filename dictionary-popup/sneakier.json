            "meaning": [
                {
                    "en": "Of or like a sneak; underhanded.",
                    "vi": "Của hoặc giống như một sự lén lút; ám chỉ."
                },
                {
                    "en": "Furtive; surreptitious.",
                    "vi": "Có lông; lén lút."
                },
                {
                    "en": "The definition of sneaky is someone who is deceptive or sly, or is something secret and reluctant.",
                    "vi": "Định nghĩa của lén lút là một người lừa dối hoặc ranh mãnh, hoặc là một cái gì đó bí mật và miễn cưỡng."
                },
                {
                    "en": "Difficult to catch due to constantly outwitting the adversaries.",
                    "vi": "Khó bị bắt bài do liên tục bị đối thủ lấn lướt."
                },
                {
                    "en": "Dishonest; deceitful.",
                    "vi": "Không trung thực; gian dối."
                }
            ]
        }
    ],
