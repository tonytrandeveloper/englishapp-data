    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Sharply outlined or prominent.",
                    "vi": "Đường viền sắc nét hoặc nổi bật."
                },
                {
                    "en": "Bleak; desolate; barren.",
                    "vi": "Ảm đạm; hoang tàn; cằn cỗi."
                },
                {
                    "en": "Clearly distinguished or delineated.",
                    "vi": "Phân biệt hoặc phân định rõ ràng."
                },
                {
                    "en": "Grimly blunt; unsoftened, unembellished, etc.",
                    "vi": "Cùn ghê gớm; không mài nhẵn, không mài nhẵn, v.v."
                },
                {
                    "en": "The definition of stark is something harsh or barren in appearance.",
                    "vi": "Định nghĩa của stark là một cái gì đó khắc nghiệt hoặc cằn cỗi về bề ngoài."
                },
                {
                    "en": "Complete or utter; extreme.",
                    "vi": "Hoàn thành hoặc thốt ra; vô cùng."
                },
                {
                    "en": "Bare, desolate, or unadorned.",
                    "vi": "Trần trụi, hoang vắng hoặc không được trang hoàng."
                },
                {
                    "en": "Severe or unmitigated; harsh or grim.",
                    "vi": "Nghiêm trọng hoặc không có vấn đề gì; khắc nghiệt hoặc nghiệt ngã."
                },
                {
                    "en": "Sheer; utter; downright; unrelieved.",
                    "vi": "Tuyệt đối; thốt ra; hết sức; không được đáp ứng."
                },
                {
                    "en": "(archaic) Strong; powerful.",
                    "vi": "(cổ xưa) Mạnh mẽ; mạnh mẽ."
                },
                {
                    "en": "(archaic) Physically stiff or rigid.",
                    "vi": "(cổ xưa) Về thể chất cứng hoặc cứng."
                },
                {
                    "en": "Rigorous; harsh; severe.",
                    "vi": "Nghiêm ngặt; thô ráp; dữ dội."
                },
                {
                    "en": "Emptied; stripped.",
                    "vi": "Trống rỗng; tước."
                },
                {
                    "en": "(archaic) Totally naked; bare.",
                    "vi": "(cổ xưa) Hoàn toàn khỏa thân; để trần."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "Utterly; entirely.",
                    "vi": "Hoàn toàn; toàn bộ."
                },
                {
                    "en": "In a stark manner; esp., utterly; wholly.",
                    "vi": "Một cách rõ ràng; đặc biệt, hoàn toàn; hoàn toàn."
