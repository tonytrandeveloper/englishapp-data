    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(obsolete) Speed; haste.",
                    "vi": "(lỗi thời) Tốc độ; sự vội vàng."
                },
                {
                    "en": "(uncountable) The quality of being fit or suitable to effect some desired end or the purpose intended; propriety or advisability under the particular circumstances of a case.",
                    "vi": "(không thể đếm được) Chất lượng phù hợp hoặc phù hợp để thực hiện một số mục đích mong muốn hoặc mục đích đã định; tính đúng đắn hoặc khả năng tư vấn trong các trường hợp cụ thể của một trường hợp."
                },
                {
                    "en": "Speed, haste or urgency.",
                    "vi": "Tốc độ, sự vội vàng hoặc khẩn cấp."
                },
                {
                    "en": "Something that is expedient.",
                    "vi": "Một cái gì đó có hiệu lực."
                },
                {
                    "en": "Expediency.",
                    "vi": "Khẩn trương."
                }
            ]
        }
    ],
    "meaning_vi": [
