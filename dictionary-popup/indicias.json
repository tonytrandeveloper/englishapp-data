    "defines": [
        {
            "pos": "pluralNoun",
            "meaning": [
                {
                    "en": "Identifying marks; indications.",
                    "vi": "Dấu hiệu nhận biết; các chỉ dẫn."
                },
                {
                    "en": "Markings on bulk mailings used as a substitute for stamps or cancellations.",
                    "vi": "Đánh dấu trên thư số lượng lớn được sử dụng để thay thế cho tem hoặc giấy hủy."
                },
                {
                    "en": "Characteristic marks or tokens.",
                    "vi": "Dấu hiệu hoặc mã thông báo đặc trưng."
                },
                {
                    "en": "Printed designs or legends on mail signifying that postage has been paid.",
                    "vi": "Bản thiết kế hoặc chú thích được in trên thư biểu thị rằng bưu phí đã được thanh toán."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Distinctive markings; indications.",
                    "vi": "Dấu hiệu phân biệt; các chỉ dẫn."
                },
                {
                    "en": "(philately) A preprinted marking on a mailpiece which shows that postage has been paid by the sender.",
                    "vi": "(philately) Dấu in sẵn trên hộp thư cho biết người gửi đã thanh toán bưu phí."
                }
            ]
        }
    ],
