    "sentences": [
        {
            "en": "A voice broke into their lovemaking.",
            "vi": "Một giọng nói đã phá vỡ cuộc làm tình của họ."
        },
        {
            "en": "Only we really never broke the rules.",
            "vi": "Chỉ chúng tôi thực sự không bao giờ vi phạm các quy tắc."
        },
        {
            "en": "No one broke the silence.",
            "vi": "Không ai phá vỡ sự im lặng."
        },
        {
            "en": "I broke his arm before he could toss the match.",
            "vi": "Tôi đã đánh gãy tay anh ấy trước khi anh ấy có thể quăng que diêm."
        },
        {
            "en": "To her surprise, he was the one who broke away.",
            "vi": "Trước sự ngạc nhiên của cô, anh là người đã phá đám."
        },
        {
            "en": "I broke all the rules.",
            "vi": "Tôi đã phá vỡ tất cả các quy tắc."
        },
        {
            "en": "Her voice broke and she stopped, wiping her eyes.",
            "vi": "Giọng cô ấy đứt quãng và cô ấy dừng lại, lau mắt."
        },
        {
            "en": "They broke off and rose as she entered.",
            "vi": "Chúng vỡ ra và tăng lên khi cô bước vào."
        },
        {
            "en": "Finally she broke the silence.",
            "vi": "Cuối cùng cô phá vỡ sự im lặng."
        },
        {
            "en": "It was late day-three by our calculations when we broke through.",
            "vi": "Theo tính toán của chúng tôi thì đã đến muộn ngày thứ ba khi chúng tôi đột phá."
        }
    ]
