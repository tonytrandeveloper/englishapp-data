            "pos": "adjective",
            "meaning": [
                {
                    "en": "(archaic) Short or shortened.",
                    "vi": "(cổ xưa) Ngắn hoặc rút gọn."
                },
                {
                    "en": "Rudely brief or abrupt, as in speech or manner.",
                    "vi": "Ngắn gọn một cách thô bạo hoặc đột ngột, như trong cách nói hoặc cách nói."
                },
                {
                    "en": "Brief, esp. to the point of rudeness; terse or brusque.",
                    "vi": "Tóm lại, đặc biệt. đến mức thô lỗ; ngắn gọn hoặc thô kệch."
                },
                {
                    "en": "The definition of curt is a statement, response or reply that is very short and potentially rude.",
                    "vi": "Định nghĩa của cộc lốc là một tuyên bố, phản hồi hoặc trả lời rất ngắn và có khả năng thô lỗ."
                },
                {
                    "en": "Terse or condensed.",
                    "vi": "Ngắn hơn hoặc cô đặc."
                },
                {
                    "en": "Brief or terse, especially to the point of being rude.",
                    "vi": "Ngắn gọn hoặc ngắn gọn, đặc biệt là đến mức thô lỗ."
                },
                {
                    "en": "Short or concise.",
                    "vi": "Ngắn gọn hoặc súc tích."
                }
            ]
        },
        {
            "pos": "pronoun",
            "meaning": [
                {
                    "en": "A short form of the male given name Curtis.",
                    "vi": "Một dạng viết tắt của tên gọi nam giới là Curtis."
                },
                {
                    "en": "A male given name, an anglicized spelling of Kurt.",
                    "vi": "Một cái tên nam giới, cách viết của Kurt phức tạp."
                }
            ]
        }
    ],
