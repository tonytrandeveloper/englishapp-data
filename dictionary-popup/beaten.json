    "sentences": [
        {
            "en": "Someone had beaten them home.",
            "vi": "Ai đó đã đánh họ về nhà."
        },
        {
            "en": "His little army had been beaten and scattered.",
            "vi": "Đội quân nhỏ bé của ông đã bị đánh tan tác."
        },
        {
            "en": "Her unwillingness to be beaten has developed her courage.",
            "vi": "Việc không muốn bị đánh đã phát triển lòng can đảm của cô ấy."
        },
        {
            "en": "Having been beaten in a trial of soothsaying, Calchas died of chagrin or committed suicide.",
            "vi": "Bị đánh đập trong một phiên tòa xét xử về hành vi xoa dịu, Calchas chết vì chán nản hoặc tự sát."
        },
        {
            "en": "The king looked, and saw that his soldiers were beaten, and that the battle was everywhere going against him.",
            "vi": "Nhà vua nhìn, thấy quân lính của mình bị đánh, và trận chiến ở khắp nơi đang chống lại mình."
        },
        {
            "en": "He'd have beaten her to ... a light came on.",
            "vi": "Anh ta đã đánh cô đến ... một ngọn đèn bật sáng."
        },
        {
            "en": "All Rostov's cards were beaten and he had eight hundred rubles scored up against him.",
            "vi": "Tất cả các thẻ của Rostov đều bị đánh bại và anh ta có tám trăm rúp được ghi vào lưới anh ta."
        },
        {
            "en": "Jonny's body was bloodied and beaten, though his pulse was strong.",
            "vi": "Cơ thể của Jonny đầy máu và bị đánh đập, mặc dù mạch của anh ấy rất mạnh."
        },
        {
            "en": "He reached out to her, pained by her beaten appearance.",
            "vi": "Anh tìm đến cô, đau đớn trước vẻ ngoài bị đánh đập của cô."
        },
        {
            "en": "Vases of all kinds, carved in marble or other stones, cast or beaten in metals or fashioned in clay, the latter in enormous number and variety, richly ornamented with coloured schemes, and sometimes bearing moulded decoration.",
            "vi": "Các loại bình, được chạm khắc bằng đá cẩm thạch hoặc các loại đá khác, đúc hoặc đập bằng kim loại hoặc tạo kiểu bằng đất sét, loại sau với số lượng rất lớn và đa dạng, được trang trí phong phú bằng các cách phối màu, và đôi khi được trang trí bằng khuôn đúc."
        }
    ]
