    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Struck with repeated blows; whipped.",
                    "vi": "Mắc kẹt với những cú đánh lặp đi lặp lại; quất."
                },
                {
                    "en": "Formed or made thin by hammering.",
                    "vi": "Được tạo thành hoặc làm mỏng bằng búa đập."
                },
                {
                    "en": "Worn by continuous use; familiar and much traveled.",
                    "vi": "Bị mòn do sử dụng liên tục; quen thuộc và đi nhiều."
                },
                {
                    "en": "Totally worn-out; exhausted.",
                    "vi": "Hoàn toàn mòn; kiệt quệ."
                },
                {
                    "en": "Shaped or made thin by hammering.",
                    "vi": "Định hình hoặc làm mỏng bằng cách đóng búa."
                },
                {
                    "en": "Flattened by treading; much traveled.",
                    "vi": "Bị san bằng do giẫm chân lên; đi du lịch nhiều."
                },
                {
                    "en": "Tired out.",
                    "vi": "Mệt mỏi."
                },
                {
                    "en": "Searched through for game.",
                    "vi": "Đã tìm kiếm qua trò chơi."
                },
                {
                    "en": "Defeated.",
                    "vi": "Bị đánh bại."
                },
                {
                    "en": "Crushed in spirit by defeat.",
                    "vi": "Bị đánh gục tinh thần bởi thất bại."
                },
                {
                    "en": "Defeated.",
                    "vi": "Bị đánh bại."
                },
                {
                    "en": "Repeatedly struck.",
                    "vi": "Liên tiếp xảy ra."
                },
                {
                    "en": "(cookery - of a liquid) Mixed by paddling with a wooden spoon or other implement.",
                    "vi": "(dụng cụ nấu ăn - chất lỏng) Được trộn bằng cách dùng thìa gỗ hoặc dụng cụ khác dùng để khuấy."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Past participle of beat.",
                    "vi": "Quá khứ phân từ của nhịp."
                }
            ]
        },
        {
            "pos": "idiom",
            "meaning": [
                {
                    "en": "off the beaten track  away or apart from others of its kind unusual, unfamiliar, original, etc.",
