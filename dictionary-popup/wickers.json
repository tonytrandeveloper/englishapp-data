    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Flexible twigs, branches, plant stems, or pieces of synthetic material, used for making baskets or furniture.",
                    "vi": "Cành, cành, thân cây hoặc mảnh vật liệu tổng hợp mềm dẻo, được sử dụng để làm giỏ hoặc đồ nội thất."
                },
                {
                    "en": "Such twigs or long, woody strips woven together, as in making baskets or furniture.",
                    "vi": "Những cành cây hoặc dải gỗ dài như vậy đan lại với nhau, như để làm giỏ hoặc đồ nội thất."
                },
                {
                    "en": "Wickerwork.",
                    "vi": "Nghề đan lát."
                },
                {
                    "en": "A thin, flexible twig; withe.",
                    "vi": "Một cành cây mỏng, linh hoạt; hớ hênh."
                },
                {
                    "en": "A flexible branch or twig of a plant such as willow, used in weaving baskets and furniture.",
                    "vi": "Cành hoặc cành mềm dẻo của cây như liễu, được sử dụng để đan giỏ và đồ nội thất."
                },
                {
                    "en": "Wickerwork.",
                    "vi": "Nghề đan lát."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Made of or covered with wicker.",
                    "vi": "Làm bằng hoặc phủ bằng liễu gai."
                },
                {
                    "en": "Made of wickerwork.",
                    "vi": "Làm bằng liễu gai."
                }
            ]
        }
    ],
