    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The condition or quality of being ignorant; lack of knowledge, education, etc.",
                    "vi": "Tình trạng hoặc phẩm chất của việc không biết gì; thiếu kiến thức, giáo dục, v.v."
                },
                {
                    "en": "Unawareness (of)",
                    "vi": "Không nhận thức (trong số)"
                },
                {
                    "en": "The condition of being uneducated, unaware, or uninformed.",
                    "vi": "Tình trạng không được học hành, không biết hoặc không hiểu biết."
                },
                {
                    "en": "The condition of being uninformed or uneducated. Lack of knowledge or information.",
                    "vi": "Tình trạng không được hiểu biết hoặc không được đào tạo. Thiếu kiến thức hoặc thông tin."
                },
                {
                    "en": "The definition of ignorance is being unaware, uneducated or unknowledgeable.",
                    "vi": "Định nghĩa của sự thiếu hiểu biết là không biết, không có học thức hoặc không hiểu biết."
                }
            ]
        },
        {
            "pos": "pronoun",
            "meaning": [
                {
                    "en": "A personification of ignorance.",
                    "vi": "Một hiện thân của sự thiếu hiểu biết."
                }
            ]
        }
    ],
