            "meaning": [
                {
                    "en": "To outwit by such thinking.",
                    "vi": "Để vượt qua bởi suy nghĩ như vậy."
                },
                {
                    "en": "To outthink is to outwit or to think more quickly or better than someone else.",
                    "vi": "Suy nghĩ nhanh hơn là đánh bại hoặc suy nghĩ nhanh hơn hoặc tốt hơn người khác."
                },
                {
                    "en": "To outdo (another) in thinking.",
                    "vi": "Vượt lên (khác) trong suy nghĩ."
                },
                {
                    "en": "To outwit by thinking.",
                    "vi": "Để vượt qua bằng cách suy nghĩ."
                },
                {
                    "en": "To think deeper, faster, or more cunningly than.",
                    "vi": "Để suy nghĩ sâu hơn, nhanh hơn hoặc khôn ngoan hơn."
                },
                {
                    "en": "To best an opponent by thinking.",
                    "vi": "Để tốt nhất đối thủ bằng cách suy nghĩ."
                }
            ]
        }
    ],
    "meaning_vi": [
