    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To clothe; dress.",
                    "vi": "Trang phục; đầm."
                },
                {
                    "en": "Garb is defined as to dress someone.",
                    "vi": "Garb được định nghĩa là để ăn mặc cho ai đó."
                },
                {
                    "en": "To clothe; dress; attire.",
                    "vi": "Trang phục; đầm; trang phục."
                },
                {
                    "en": "To dress in garb.",
                    "vi": "Để ăn mặc trong trang phục."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A distinctive style or form of clothing; dress.",
                    "vi": "Một kiểu hoặc dạng quần áo đặc biệt; đầm."
                },
                {
                    "en": "The definition of garb is clothing style, or outward appearance.",
                    "vi": "Định nghĩa của garb là phong cách quần áo, hoặc hình thức bên ngoài."
                },
                {
                    "en": "An outward appearance; a guise.",
                    "vi": "Hình thức bên ngoài; một chiêu bài."
                },
                {
                    "en": "Manner or style of clothing, esp. as characteristic of an occupation, profession, or rank.",
                    "vi": "Cách cư xử hoặc kiểu quần áo, đặc biệt. như đặc điểm của một nghề nghiệp, nghề nghiệp hoặc cấp bậc."
                },
                {
                    "en": "External form or appearance.",
                    "vi": "Hình thức bên ngoài hoặc hình thức bên ngoài."
                },
                {
                    "en": "(obs.) Style; manner.",
                    "vi": "(obs.) Phong cách; cách thức."
                },
                {
                    "en": "Fashion, style of dressing oneself up [from late 16th c.]",
                    "vi": "Thời trang, phong cách ăn mặc của bản thân [từ cuối ngày 16 c.]"
                },
                {
                    "en": "A type of dress or clothing. [from early 17th c.]",
                    "vi": "Một loại váy hoặc quần áo. [từ đầu ngày 17 c.]"
                },
                {
                    "en": "(figuratively) A guise, external appearance.",
                    "vi": "(nghĩa bóng) Một chiêu bài, hình thức bên ngoài."
                },
                {
                    "en": "(heraldry) A wheat sheaf.",
                    "vi": "(huy hiệu) Một bó lúa mì."
                },
                {
                    "en": "A measure of arrows in the Middle Ages.",
                    "vi": "Một thước đo của mũi tên trong thời Trung cổ."
                }
            ]
        }
    ],
