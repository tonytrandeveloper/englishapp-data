        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Training or education; esp., formal instruction at school.",
                    "vi": "Đào tạo hoặc giáo dục; đặc biệt là, hướng dẫn chính thức ở trường."
                },
                {
                    "en": "Education obtained through experience or exposure.",
                    "vi": "Giáo dục thu được thông qua kinh nghiệm hoặc tiếp xúc."
                },
                {
                    "en": "Cost of instruction and living at school.",
                    "vi": "Chi phí giảng dạy và sinh hoạt tại trường."
                },
                {
                    "en": "The training of a horse or a horse and rider in equitation.",
                    "vi": "Việc huấn luyện một con ngựa hoặc một con ngựa và người cưỡi ngựa trong cuộc đua."
                },
                {
                    "en": "(archaic) Disciplinary correction.",
                    "vi": "(cổ xưa) Sửa chữa kỷ luật."
                },
                {
                    "en": "Instruction or training given at school.",
                    "vi": "Hướng dẫn hoặc đào tạo tại trường."
                },
                {
                    "en": "Schooling is training, instruction or education.",
                    "vi": "Đi học là đào tạo, hướng dẫn hoặc giáo dục."
                },
                {
                    "en": "Training or instruction.",
                    "vi": "Đào tạo hoặc hướng dẫn."
                },
                {
                    "en": "Institutional education; attendance of school.",
                    "vi": "Thể chế giáo dục; đi học."
                },
                {
                    "en": "(dressage) The training of a horse at dressage.",
                    "vi": "(dressage) Việc huấn luyện một con ngựa trong trang phục."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of school.",
                    "vi": "Hiện tại phân từ của trường."
                }
            ]
        }
    ],
