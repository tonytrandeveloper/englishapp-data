                {
                    "en": "Lack of ability or means.",
                    "vi": "Thiếu khả năng hoặc phương tiện."
                },
                {
                    "en": "The quality or state of being unable; lack of ability, capacity, means, or power.",
                    "vi": "Chất lượng hoặc trạng thái không thể; thiếu khả năng, năng lực, phương tiện, hoặc quyền lực."
                },
                {
                    "en": "The definition of inability is the state of having no power or a lack of ability.",
                    "vi": "Định nghĩa của sự bất lực là tình trạng không có quyền lực hoặc thiếu khả năng."
                },
                {
                    "en": "Lack of the ability to do something; incapability.",
                    "vi": "Thiếu khả năng để làm một cái gì đó; không có khả năng."
                }
            ]
        }
