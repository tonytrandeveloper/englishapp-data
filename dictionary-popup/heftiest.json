    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Large and powerful.",
                    "vi": "Lớn và mạnh mẽ."
                },
                {
                    "en": "Big or fairly big.",
                    "vi": "Lớn hoặc khá lớn."
                },
                {
                    "en": "Heavy.",
                    "vi": "Nặng."
                },
                {
                    "en": "Strong, bulky.",
                    "vi": "Mạnh mẽ, đồ sộ."
                },
                {
                    "en": "(of a person) Possessing physical strength and weight; rugged and powerful; powerfully or heavily built.",
                    "vi": "(của một người) Có thể lực và cân nặng; chắc chắn và mạnh mẽ; mạnh mẽ hoặc được xây dựng mạnh mẽ."
                },
                {
                    "en": "Impressive, mighty.",
                    "vi": "Ấn tượng, hùng tráng."
                },
                {
                    "en": "Of considerable weight; heavy.",
                    "vi": "Có trọng lượng đáng kể; nặng."
                },
                {
                    "en": "Big and strong; stout or muscular.",
                    "vi": "To lớn và mạnh mẽ; mập mạp hoặc vạm vỡ."
                },
                {
                    "en": "Strong and sturdy.",
                    "vi": "Mạnh mẽ và cứng cáp."
                },
                {
                    "en": "Of considerable size or amount; substantial.",
                    "vi": "Có kích thước hoặc số lượng đáng kể; đáng kể."
                },
                {
                    "en": "Weighty; heavy.",
                    "vi": "Trọng lượng; nặng."
                }
            ]
        }
    ],
    "meaning_vi": [
        "lực lưỡng, vạm vỡ, khoẻ mạnh",
        "(từ Mỹ,nghĩa Mỹ) nặng"
