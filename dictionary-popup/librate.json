                },
                {
                    "en": "To remain balanced; hover.",
                    "vi": "Để duy trì sự cân bằng; bay lượn."
                },
                {
                    "en": "To oscillate (like the beam of a balance)",
                    "vi": "Dao động (giống như chùm cân bằng)"
                }
            ]
        },
        {
