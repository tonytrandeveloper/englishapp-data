            "meaning": [
                {
                    "en": "The state or condition of impoverishment; material need, especially of an urgent nature.",
                    "vi": "Tình trạng hoặc tình trạng bần cùng hóa; nhu cầu vật chất, đặc biệt là có tính chất cấp thiết."
                },
                {
                    "en": "(rare) The state or condition of being necessary or essential; necessity.",
                    "vi": "(hiếm) Tình trạng hoặc tình trạng cần thiết hoặc thiết yếu; sự cần thiết."
                }
            ]
        }
