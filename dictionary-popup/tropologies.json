            "meaning": [
                {
                    "en": "The use of tropes in speech or writing.",
                    "vi": "Việc sử dụng tropes trong lời nói hoặc văn bản."
                },
                {
                    "en": "A mode of biblical interpretation insisting on the morally edifying sense of tropes in the Scriptures.",
                    "vi": "Một phương thức giải thích Kinh thánh nhấn mạnh vào ý nghĩa gây dựng về mặt đạo đức của những trò lố trong Kinh thánh."
                },
                {
                    "en": "The use of tropes or figurative language.",
                    "vi": "Việc sử dụng tropes hoặc ngôn ngữ tượng hình."
                },
                {
                    "en": "A method of considering or interpreting Scripture in a figurative, moralistic way rather than in a literal sense.",
                    "vi": "Một phương pháp xem xét hoặc giải thích Kinh thánh theo nghĩa bóng, đạo đức hơn là theo nghĩa đen."
                },
                {
                    "en": "The use of a trope.",
                    "vi": "Việc sử dụng một trope."
                }
            ]
        }
