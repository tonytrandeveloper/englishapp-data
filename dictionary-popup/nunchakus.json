    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A martial-arts weapon consisting of a pair of wooden sticks joined lengthwise by a short cord, chain, etc.",
                    "vi": "Một vũ khí võ thuật bao gồm một cặp thanh gỗ được nối theo chiều dọc bằng dây ngắn, dây xích, v.v."
                },
                {
                    "en": "A pair of hardwood sticks joined by a chain or cord and used as a weapon.",
                    "vi": "Một cặp thanh gỗ cứng được nối bằng dây xích hoặc dây và được sử dụng làm vũ khí."
                },
                {
                    "en": "(martial arts) A weapon consisting of two sticks joined by a chain or cord.",
                    "vi": "(võ thuật) Một vũ khí bao gồm hai cây gậy được nối với nhau bằng dây xích hoặc dây."
                },
                {
                    "en": "A similarly formed device, such as the Wii Nunchuk attachment.",
                    "vi": "Một thiết bị được hình thành tương tự, chẳng hạn như tệp đính kèm Wii Nunchuk."
                }
            ]
        }
    ],
