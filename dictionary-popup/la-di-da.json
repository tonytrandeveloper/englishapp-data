    "phonetics": {
        "uk": "lɑː-di-dɑː",
        "us": "lɑ-di-dɑ"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Affectedly genteel; pretentious.",
                    "vi": "Bị ảnh hưởng bởi lịch lãm; tự phụ."
                },
                {
                    "en": "Affected in speech, manners, etc.; pretentiously refined.",
                    "vi": "Bị ảnh hưởng trong lời nói, cách cư xử, vv; tinh tế một cách giả tạo."
                },
                {
                    "en": "Disdainful description of pretension or haughtiness.",
                    "vi": "Mô tả khinh thường về chứng cao huyết áp hoặc tính kiêu ngạo."
                }
            ]
        },
        {
            "pos": "interjection",
            "meaning": [
                {
                    "en": "Used to express disdain for something viewed as pretentious.",
                    "vi": "Được sử dụng để bày tỏ sự coi thường đối với một cái gì đó được coi là kiêu căng."
                },
                {
                    "en": "Used to express derision in response to affectation, foppishness, etc.",
                    "vi": "Được sử dụng để thể hiện sự chế nhạo để đáp lại sự ảnh hưởng, xấu xa, v.v."
                },
                {
                    "en": "Expression of disdain for pretension or haughtiness.",
                    "vi": "Biểu hiện của sự coi thường đối với sự tự cao hoặc ngạo mạn."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A la-di-da person.",
                    "vi": "Một người la-di-đà."
                },
                {
                    "en": "Affected speech or behavior.",
                    "vi": "Lời nói hoặc hành vi bị ảnh hưởng."
                }
            ]
        }
    ],
    "meaning_vi": [
        "người màu mè, người kiểu cách"
