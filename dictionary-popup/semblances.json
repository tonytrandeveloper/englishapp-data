    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Outward form or appearance; aspect.",
                    "vi": "Hình thức bên ngoài hoặc hình thức bên ngoài; diện mạo."
                },
                {
                    "en": "A representation; a copy.",
                    "vi": "Đại diện; một bản sao."
                },
                {
                    "en": "An outward or token appearance.",
                    "vi": "Hình dáng bên ngoài hoặc mã thông báo."
                },
                {
                    "en": "False, assumed, or deceiving form or appearance.",
                    "vi": "Hình thức hoặc bề ngoài sai, giả định hoặc lừa dối."
                },
                {
                    "en": "A likeness, image, or representation.",
                    "vi": "Chân dung, hình ảnh hoặc đại diện."
                },
                {
                    "en": "Seeming likeness; resemblance.",
                    "vi": "Có vẻ giống; sự giống nhau."
                },
                {
                    "en": "Mere empty show; pretense.",
                    "vi": "Chỉ là buổi biểu diễn trống rỗng; sự giả vờ."
                },
                {
                    "en": "The barest trace; a modicum.",
                    "vi": "Dấu vết trần trụi nhất; một modicum."
                },
                {
                    "en": "Semblance is having an outward appearance that resembles something desired, even if the reality doesn't match the appearance.",
                    "vi": "Semblance là có hình dáng bên ngoài giống với điều gì đó mong muốn, ngay cả khi thực tế không khớp với ngoại hình."
                },
                {
                    "en": "Likeness, similarity; the quality of being similar.",
                    "vi": "Giống nhau, giống nhau; chất lượng tương tự."
                },
                {
                    "en": "Seeming; appearance; show; figure; form.",
                    "vi": "Có vẻ như; vẻ bề ngoài; chỉ; nhân vật; biểu mẫu."
                }
            ]
        }
    ],
