    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Dirty-colored; not bright or clean; grimy.",
                    "vi": "Bẩn màu; không sáng sủa hoặc sạch sẽ; đen."
                },
                {
                    "en": "Mentally deranged; crazy.",
                    "vi": "Rối loạn trí tuệ; khùng."
                },
                {
                    "en": "Darkened with smoke or grime.",
                    "vi": "Bị ám khói hoặc bụi bẩn."
                },
                {
                    "en": "The definition of dingy is something kind of dirty, gloomy or dull.",
                    "vi": "Định nghĩa của dingy là một thứ gì đó bẩn thỉu, u ám hoặc buồn tẻ."
                },
                {
                    "en": "Shabby, drab, or squalid.",
                    "vi": "Xấu, xám xịt hoặc ẩm mốc."
                },
                {
                    "en": "Dismal; shabby.",
                    "vi": "Suy mòn; tồi tàn."
                },
                {
                    "en": "Drab; shabby; dirty; squalid.",
                    "vi": "Buồn tẻ; tồi tàn; bẩn thỉu; nhăn nheo."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Alternative form of dinghy.",
                    "vi": "Hình thức thay thế của xuồng ba lá."
                }
            ]
        }
    ],
    "meaning_vi": [
