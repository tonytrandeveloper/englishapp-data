                },
                {
                    "en": "(informal) Talk or writing that is wordy, pompous, etc. and largely incomprehensible or meaningless.",
                    "vi": "(thân mật) Nói hoặc viết dài dòng, rườm rà, v.v. và phần lớn khó hiểu hoặc vô nghĩa."
                },
                {
                    "en": "(informal) Something written in an overly complex, incoherent, or incomprehensible manner.",
                    "vi": "(không chính thức) Nội dung nào đó được viết theo cách quá phức tạp, không mạch lạc hoặc khó hiểu."
                }
            ]
        }
