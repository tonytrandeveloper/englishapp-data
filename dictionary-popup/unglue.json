    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To separate by dissolving a glue or other adhesive.",
                    "vi": "Để tách bằng cách hòa tan một loại keo hoặc chất kết dính khác."
                },
                {
                    "en": "To separate or detach by or as if by dissolving an adhesive.",
                    "vi": "Để tách hoặc tách bằng hoặc như thể bằng cách hòa tan chất kết dính."
                },
                {
                    "en": "(slang) To upset; confuse.",
                    "vi": "(tiếng lóng) Làm khó chịu; xáo trộn."
                },
                {
                    "en": "To separate that which was held by glue.",
                    "vi": "Để tách cái được giữ bằng keo."
                }
            ]
        },
        {
            "pos": "idiom",
            "meaning": [
                {
                    "en": "come unglued  to become emotionally upset and lose one's composure",
                    "vi": "trở nên khó chịu về cảm xúc và mất bình tĩnh"
                }
            ]
        }
    ],
