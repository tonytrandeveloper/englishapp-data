                {
                    "en": "To speak or pronounce incorrectly.",
                    "vi": "Nói hoặc phát âm sai."
                },
                {
                    "en": "To speak mistakenly, inappropriately, or rashly.",
                    "vi": "Nói nhầm, không thích hợp hoặc hấp tấp."
                },
                {
                    "en": "To speak or say incorrectly.",
                    "vi": "Nói hoặc nói không chính xác."
                },
                {
                    "en": "(intransitive, chiefly US) To fail to pronounce, utter, or speak correctly.",
                    "vi": "(không rõ ràng, chủ yếu là Hoa Kỳ) Không thể phát âm, thốt ra hoặc nói một cách chính xác."
                }
