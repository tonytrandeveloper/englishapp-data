                {
                    "en": "A stupid person; a dunce.",
                    "vi": "Một người ngu ngốc; một con dunce."
                },
                {
                    "en": "A stupid, slow-witted person; blockhead.",
                    "vi": "Một người ngu ngốc, chậm chạp; đầu chặn."
                },
                {
                    "en": "The definition of a dolt is a stupid person.",
                    "vi": "Định nghĩa của một dolt là một người ngu ngốc."
                },
                {
                    "en": "(pejorative) A stupid person; a blockhead or dullard.",
                    "vi": "(khinh bỉ) Một người ngu ngốc; một blockhead hoặc xỉn màu."
                }
            ]
        },
        {
            "pos": "verb",
