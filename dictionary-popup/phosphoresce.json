    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To persist in emitting light, unaccompanied by sensible heat or combustion, after exposure to and removal of a source of radiation.",
                    "vi": "Tiếp tục phát ra ánh sáng, không bị kèm theo bởi nhiệt hoặc sự đốt cháy hợp lý, sau khi tiếp xúc và loại bỏ nguồn bức xạ."
                },
                {
                    "en": "To produce, show, or undergo phosphorescence.",
                    "vi": "Để sản xuất, hiển thị hoặc trải qua quá trình phát quang."
                },
                {
                    "en": "To exhibit phosphorescence.",
                    "vi": "Thể hiện sự phát lân quang."
                }
            ]
        }
    ],
    "meaning_vi": [
        "phát lân quang"
    ],
