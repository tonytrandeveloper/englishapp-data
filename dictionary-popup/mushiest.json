    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Excessively tender or romantic; sentimental.",
                    "vi": "Dịu dàng hoặc lãng mạn quá mức; đa cảm."
                },
                {
                    "en": "Resembling mush in consistency or firmness; soft.",
                    "vi": "Dạng bột nhão đặc hoặc cứng; Dịu dàng."
                },
                {
                    "en": "(informal) Affectionate or sentimental in a maudlin fashion.",
                    "vi": "(thân mật) Tình cảm hoặc đa cảm theo kiểu maudlin."
                },
                {
                    "en": "Like mush; thick, soft, and yielding.",
                    "vi": "Như hồ ly; dày, mềm và năng suất."
                },
                {
                    "en": "Poorly defined; blurry.",
                    "vi": "Kém được xác định; mờ."
                },
                {
                    "en": "Resembling or having the consistency of mush; semiliquid, pasty, or granular.",
                    "vi": "Kết dính hoặc có độ đặc của hồ; bán lỏng, nhão hoặc dạng hạt."
                },
                {
                    "en": "Soft; squishy.",
                    "vi": "Mềm mại; hơi tanh."
                },
                {
                    "en": "Overly sappy, corny, or cheesy.",
                    "vi": "Quá buồn tẻ, ngô nghê hoặc sến súa."
                },
                {
                    "en": "Poorly defined; indistinct or blurry.",
                    "vi": "Kém được xác định; không rõ ràng hoặc mờ."
                }
            ]
        }
    ],
