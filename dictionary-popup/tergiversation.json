    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The act of abandoning something or someone, of changing sides; desertion; betrayal.",
                    "vi": "Hành động từ bỏ một cái gì đó hoặc một người nào đó, thay đổi bên; sự đào ngũ; sự phản bội."
                },
                {
                    "en": "The act of evading any clear course of action or speech, of being deliberately ambiguous; equivocation; fickleness.",
                    "vi": "Hành động trốn tránh bất kỳ hành động hoặc lời nói rõ ràng nào, hoặc cố tình mơ hồ; Sự không rõ nghĩa; hay thay đổi."
                }
            ]
        }
    ],
    "meaning_vi": [
        "sự nói quanh, sự tìm cớ thoái thác; sự lần nữa",
