                },
                {
                    "en": "Something congealed.",
                    "vi": "Một cái gì đó đông tụ."
                },
                {
                    "en": "The act or process of passing, or causing to pass, from a fluid to a solid state, as by the abstraction of heat; the act or process of freezing.",
                    "vi": "Hành động hoặc quá trình truyền hoặc gây ra sự truyền từ chất lỏng sang trạng thái rắn, như là do nhiệt lượng trừu tượng; hành động hoặc quá trình đóng băng."
                },
                {
                    "en": "The state of being congealed.",
                    "vi": "Tình trạng đông tụ."
                },
                {
                    "en": "That which is congealed.",
                    "vi": "Đó là một chất đông tụ."
                }
