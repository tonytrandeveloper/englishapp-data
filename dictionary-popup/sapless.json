        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Devoid of sap; dry.",
                    "vi": "Không có nhựa cây; khô."
                },
                {
                    "en": "Lacking spirit or energy.",
                    "vi": "Thiếu tinh thần hoặc năng lượng."
                },
                {
                    "en": "(of a plant) Lacking in sap.",
                    "vi": "(của cây) Thiếu nhựa cây."
                },
                {
                    "en": "(figuratively, of a person etc.) Lacking vivacity.",
                    "vi": "(nghĩa bóng là của một người, v.v.) Thiếu sự hoạt bát."
                }
            ]
        }
    ],
