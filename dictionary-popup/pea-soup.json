            "pos": "noun",
            "meaning": [
                {
                    "en": "A purée or soup made of cooked dried peas.",
                    "vi": "Một món súp hoặc đậu Hà Lan khô nấu chín."
                },
                {
                    "en": "(informal) Dense fog.",
                    "vi": "(không chính thức) Sương mù dày đặc."
                },
                {
                    "en": "A heavy soup made from dried split peas or, sometimes, fresh peas.",
                    "vi": "Một món súp nặng được làm từ đậu Hà Lan khô hoặc đôi khi, đậu Hà Lan tươi."
                },
                {
                    "en": "A dense, yellowish fog.",
                    "vi": "Một làn sương mù dày đặc, màu vàng nhạt."
                },
                {
                    "en": "A thick soup made with dried split peas and various other ingredients.",
                    "vi": "Một món súp đặc được làm từ đậu Hà Lan khô và nhiều nguyên liệu khác."
                }
            ]
        }
