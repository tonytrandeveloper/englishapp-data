            "meaning": [
                {
                    "en": "Not visible or apparent; unseen.",
                    "vi": "Không nhìn thấy hoặc không rõ ràng; không nhìn thấy được."
                },
                {
                    "en": "Prevented from seeing; having an obstructed view. Used especially of sports officials.",
                    "vi": "Bị ngăn cản nhìn thấy; có tầm nhìn bị che khuất. Được sử dụng đặc biệt của các quan chức thể thao."
                },
                {
                    "en": "Having no sight for aiming. Used of a firearm.",
                    "vi": "Không có tầm nhìn để nhắm mục tiêu. Được sử dụng của một khẩu súng."
                },
                {
                    "en": "Not sighted; unseen.",
                    "vi": "Không nhìn thấy; không nhìn thấy được."
                }
            ]
        }
    ],
