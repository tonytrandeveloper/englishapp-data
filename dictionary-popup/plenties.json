            "meaning": [
                {
                    "en": "A full or completely adequate amount or supply.",
                    "vi": "Một lượng hoặc cung cấp đầy đủ hoặc hoàn toàn đầy đủ."
                },
                {
                    "en": "A large quantity or amount; an abundance.",
                    "vi": "Một số lượng lớn hoặc số lượng; Một sự phong phú."
                },
                {
                    "en": "A condition of general abundance or prosperity.",
                    "vi": "Một điều kiện của sự dồi dào hoặc thịnh vượng chung."
                },
                {
                    "en": "A plentiful or abundant supply; enough or more than enough.",
                    "vi": "Một nguồn cung cấp dồi dào hoặc phong phú; đủ hoặc nhiều hơn đủ."
                },
                {
                    "en": "A large number; multitude.",
                    "vi": "Một số lượng lớn; vô số."
                },
                {
                    "en": "Prosperity; opulence.",
                    "vi": "Sự phồn vinh; sự trong suốt."
                },
                {
                    "en": "Plenty means enough or more than enough.",
                    "vi": "Nhiều có nghĩa là đủ hoặc nhiều hơn đủ."
                },
                {
                    "en": "A more than adequate amount.",
                    "vi": "Một số lượng nhiều hơn đủ."
                }
            ]
        },
        {
