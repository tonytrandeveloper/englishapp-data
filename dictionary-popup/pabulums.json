                },
                {
                    "en": "Nourishment for the mind.",
                    "vi": "Nuôi dưỡng tâm trí."
                },
                {
                    "en": "Food or fodder, particularly that taken in by plants or animals.",
                    "vi": "Thực phẩm hoặc thức ăn gia súc, đặc biệt là thực vật hoặc động vật lấy vào."
                },
                {
                    "en": "Material that feeds a fire.",
                    "vi": "Vật chất nuôi lửa."
                },
                {
                    "en": "(figuratively) Food for thought.",
                    "vi": "(nghĩa bóng) Thức ăn cho sự suy nghĩ."
                },
                {
                    "en": "Bland intellectual fare; an undemanding diet of words.",
                    "vi": "Giá vé trí tuệ nhạt nhẽo; một chế độ ăn uống không đòi hỏi của lời nói."
                },
                {
                    "en": "Insipid intellectual nourishment.",
                    "vi": "Nuôi dưỡng trí tuệ vô vị."
                },
                {
                    "en": "Food or sustenance.",
                    "vi": "Thực phẩm hoặc thực phẩm."
                },
                {
