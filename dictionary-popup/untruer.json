            "meaning": [
                {
                    "en": "Deviating from a standard; not straight, even, level, or exact.",
                    "vi": "Đi lệch khỏi tiêu chuẩn; không thẳng, đều, mức hoặc chính xác."
                },
                {
                    "en": "Not faithful or loyal.",
                    "vi": "Không trung thành hoặc không trung thành."
                },
                {
                    "en": "False; not true.",
                    "vi": "Sai; không đúng."
                },
                {
                    "en": "Contrary to fact; false.",
                    "vi": "Trái với thực tế; sai."
                },
                {
                    "en": "Disloyal; unfaithful.",
                    "vi": "Không trung thành; không chung thủy."
                },
                {
                    "en": "Contrary to fact or truth; false or incorrect.",
                    "vi": "Trái ngược với thực tế hoặc sự thật; sai hoặc không chính xác."
                },
                {
                    "en": "Not agreeing with a standard, rule, or measure.",
                    "vi": "Không đồng ý với một tiêu chuẩn, quy tắc hoặc thước đo."
                }
            ]
