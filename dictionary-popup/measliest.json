            "pos": "adjective",
            "meaning": [
                {
                    "en": "(slang) Contemptibly small; meager.",
                    "vi": "(tiếng lóng) Nhỏ một cách đáng ngưỡng mộ; ít ỏi."
                },
                {
                    "en": "The definition of measly is something that is so small that it is almost insulting.",
                    "vi": "Định nghĩa về đo lường là một cái gì đó quá nhỏ bé đến mức gần như là xúc phạm."
                },
                {
                    "en": "Infected with measles.",
                    "vi": "Bị nhiễm bệnh sởi."
                },
                {
                    "en": "Infected with or caused by measles.",
                    "vi": "Bị nhiễm hoặc gây ra bởi bệnh sởi."
                },
                {
                    "en": "(informal) Contemptibly slight, worthless, or skimpy.",
                    "vi": "(không chính thức) Có thể coi là nhẹ, vô giá trị hoặc thiếu vải."
                },
                {
                    "en": "Small in amount, contemptibly so.",
                    "vi": "Với số lượng nhỏ, đáng ngạc nhiên là như vậy."
                },
                {
                    "en": "Infected with measles.",
                    "vi": "Bị nhiễm bệnh sởi."
                },
                {
                    "en": "Infected with larval tapeworms.",
                    "vi": "Nhiễm ấu trùng sán dây."
                },
                {
                    "en": "Infected with tricinae.",
                    "vi": "Bị nhiễm tricinae."
                }
            ]
        }
