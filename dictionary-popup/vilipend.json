    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To view or treat with contempt; despise.",
                    "vi": "Để xem hoặc đối xử với sự khinh thường; coi thường."
                },
                {
                    "en": "To speak ill of; disparage.",
                    "vi": "Nói xấu; chê bai."
                },
                {
                    "en": "To treat or regard contemptuously or slightingly; belittle.",
                    "vi": "Đối xử hoặc coi thường hoặc coi thường người khác; chê."
                },
                {
                    "en": "To vilify; revile.",
                    "vi": "Để phỉ báng; hồi sinh."
                },
                {
                    "en": "To despise.",
                    "vi": "Mà coi thường."
                },
                {
                    "en": "To express a disparaging opinion of; to slander or vilify.",
                    "vi": "Để bày tỏ ý kiến chê bai; để vu khống hoặc phỉ báng."
                }
            ]
        }
    ],
