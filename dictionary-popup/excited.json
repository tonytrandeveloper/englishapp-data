    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Being in a state of excitement; emotionally aroused; stirred.",
                    "vi": "Đang ở trong trạng thái phấn khích; khơi dậy cảm xúc; khuấy động."
                },
                {
                    "en": "(physics) Being at an energy level higher than the ground state.",
                    "vi": "(vật lý) Ở mức năng lượng cao hơn trạng thái cơ bản."
                },
                {
                    "en": "The definition of excited is someone or something that has enthusiasm or is emotionally aroused.",
                    "vi": "Định nghĩa về sự phấn khích là một người nào đó hoặc một cái gì đó có sự nhiệt tình hoặc được kích thích về mặt cảm xúc."
                },
                {
                    "en": "Having great enthusiasm.",
                    "vi": "Có nhiệt huyết cao."
                },
                {
                    "en": "Emotionally aroused; agitated.",
                    "vi": "Được khơi dậy tình cảm; bị kích động."
                },
                {
                    "en": "(physics) In a state of excitation.",
                    "vi": "(vật lý) Ở trạng thái kích thích."
                },
                {
                    "en": "(physics) Being in a state of higher energy.",
                    "vi": "(vật lý) Ở trạng thái năng lượng cao hơn."
                },
                {
                    "en": "Having an erection; erect.",
                    "vi": "Có sự cương cứng; dựng đứng."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Past participle of excite.",
                    "vi": "Quá khứ phân từ kích thích."
                },
                {
                    "en": "Excited is defined as making someone feel emotions, or having an increased activity level.",
                    "vi": "Hứng thú được định nghĩa là khiến ai đó có cảm xúc hoặc mức độ hoạt động tăng lên."
                }
            ]
        }
    ],
    "meaning_vi": [
