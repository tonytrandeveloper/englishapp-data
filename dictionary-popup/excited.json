    "sentences": [
        {
            "en": "He'd been so excited about his phone.",
            "vi": "Anh ấy đã rất hào hứng với chiếc điện thoại của mình."
        },
        {
            "en": "I'm too excited to remember!",
            "vi": "Tôi quá vui mừng để nhớ!"
        },
        {
            "en": "Little feet pounded across the living room into the kitchen and Destiny interrupted them in an excited voice.",
            "vi": "Đôi chân nhỏ đập mạnh từ phòng khách vào nhà bếp và Destiny ngắt lời họ bằng một giọng đầy phấn khích."
        },
        {
            "en": "She turned excited eyes to her father.",
            "vi": "Cô hướng ánh mắt đầy phấn khích về phía cha mình."
        },
        {
            "en": "Jonathan was so excited that he couldn't stop talking about her.",
            "vi": "Jonathan phấn khích đến mức không thể ngừng nói về cô ấy."
        },
        {
            "en": "You seem excited about it.",
            "vi": "Bạn có vẻ hào hứng với nó."
        },
        {
            "en": "The excited faces of the soldiers were blackened with it.",
