    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or like a cloud or clouds.",
                    "vi": "Của hoặc giống như một đám mây hoặc những đám mây."
                },
                {
                    "en": "Marked with indistinct masses or streaks.",
                    "vi": "Đánh dấu bằng các khối hoặc vệt không rõ ràng."
                },
                {
                    "en": "Covered with clouds; overcast.",
                    "vi": "Được bao phủ bởi những đám mây; u ám."
                },
                {
                    "en": "Of or like clouds.",
                    "vi": "Của hoặc giống như những đám mây."
                },
                {
                    "en": "Full of or covered with clouds; overcast.",
                    "vi": "Đầy hoặc được bao phủ bởi những đám mây; u ám."
                },
                {
                    "en": "Troubled; gloomy.",
                    "vi": "Rắc rối; ảm đạm."
                },
                {
                    "en": "Open to more than one interpretation.",
                    "vi": "Mở cho nhiều hơn một cách diễn giải."
                },
                {
                    "en": "Not clearly perceived or perceptible.",
                    "vi": "Không được nhận thức hoặc cảm nhận rõ ràng."
                },
                {
                    "en": "Variegated or streaked, as marble.",
                    "vi": "Loang lổ hoặc có vệt, như đá cẩm thạch."
                },
                {
                    "en": "Opaque, muddy, or foggy.",
                    "vi": "Đục, đục hoặc có sương mù."
                },
                {
                    "en": "Obscure; vague; not clear.",
                    "vi": "Ít người biết đến; mơ hồ; không rõ ràng."
                },
                {
                    "en": "Troubled; gloomy.",
                    "vi": "Rắc rối; ảm đạm."
                },
                {
                    "en": "Covered with or characterised by clouds; overcast.",
                    "vi": "Được bao phủ bởi hoặc có đặc điểm là mây; u ám."
                },
                {
                    "en": "Not transparent or clear.",
                    "vi": "Không minh bạch hoặc rõ ràng."
                },
                {
                    "en": "Uncertain; unclear.",
                    "vi": "Không chắc chắn; không rõ."
                },
                {
                    "en": "Not transparent, as certain liquids.",
                    "vi": "Không trong suốt, như một số chất lỏng nhất định."
                }
            ]
        }
    ],
    "meaning_vi": [
        "có mây phủ, đầy mây; u ám",
