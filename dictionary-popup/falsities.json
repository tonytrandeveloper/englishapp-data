    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The quality or condition of being false.",
                    "vi": "Chất lượng hoặc tình trạng sai lệch."
                },
                {
                    "en": "Something false; a lie.",
                    "vi": "Một cái gì đó sai; lời nói dối."
                },
                {
                    "en": "Something false; esp., a lie.",
                    "vi": "Một cái gì đó sai; đặc biệt, một lời nói dối."
                },
                {
                    "en": "The condition or quality of being false.  Incorrectness. Dishonesty. Deceitfulness. Disloyalty.",
                    "vi": "Điều kiện hoặc chất lượng của việc giả mạo. Không chính xác. Không trung thực. Sự lừa dối. Không trung thành."
                },
                {
                    "en": "(countable) Something that is false; an untrue assertion.",
                    "vi": "(đếm được) Một cái gì đó sai; một khẳng định không đúng sự thật."
                },
                {
                    "en": "(uncountable) The characteristic of being untrue.",
                    "vi": "(không đếm được) Đặc điểm của sự không đúng sự thật."
                }
            ]
        }
    ],
