        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Giving or spending reluctantly.",
                    "vi": "Cho hoặc chi tiêu một cách miễn cưỡng."
                },
                {
                    "en": "Giving or spending grudgingly or only through necessity; mean; miserly.",
                    "vi": "Cho hoặc chi tiêu một cách miễn cưỡng hoặc chỉ khi cần thiết; bần tiện; keo kiệt."
                },
                {
                    "en": "Less than needed or expected; scanty.",
                    "vi": "Ít hơn mức cần thiết hoặc dự kiến; ít ỏi."
                },
                {
                    "en": "The definition of stingy is someone or something that is not generous.",
                    "vi": "Định nghĩa của keo kiệt là một người nào đó hoặc một cái gì đó không hào phóng."
                },
                {
                    "en": "Stinging or capable of stinging.",
                    "vi": "Châm chích hoặc có khả năng châm chích."
                },
                {
                    "en": "Scanty or meager.",
                    "vi": "Ít ỏi hoặc ít ỏi."
                }
            ]
        }
