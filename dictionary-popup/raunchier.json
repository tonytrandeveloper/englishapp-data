                {
                    "en": "Very low class; inferior; inadequate.",
                    "vi": "Đẳng cấp rất thấp; kém cỏi; không thỏa đáng."
                },
                {
                    "en": "With dishonorable, base and vulgar expression.",
                    "vi": "Với cách diễn đạt đáng ghê tởm, cơ sở và thô tục."
