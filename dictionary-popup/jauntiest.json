    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Sprightly; lively.",
                    "vi": "Lanh lợi; sống động."
                },
                {
                    "en": "Lighthearted and merry; sprightly; perky.",
                    "vi": "Vui vẻ và vui vẻ; lanh lợi; vui tươi."
                },
                {
                    "en": "Having or expressing a buoyant or self-confident air.",
                    "vi": "Có hoặc thể hiện khí chất bay bổng hoặc tự tin."
                },
                {
                    "en": "In fashion; stylish; chic.",
                    "vi": "Trong thời trang; sành điệu; sang trọng."
                },
                {
                    "en": "The definition of jaunty is lively in action or appearance.",
                    "vi": "Định nghĩa của vui vẻ là sống động trong hành động hoặc ngoại hình."
                },
                {
                    "en": "Stylish.",
                    "vi": "Phong cách."
                },
                {
                    "en": "Genteel.",
                    "vi": "Genteel."
                },
                {
                    "en": "Airy; showy; finical; hence, characterized by an affected or fantastical manner.",
                    "vi": "Thoáng đãng; sặc sỡ; hình nón; do đó, được đặc trưng bởi một cách thức bị ảnh hưởng hoặc viển vông."
                },
                {
                    "en": "Dapper or stylish.",
                    "vi": "Dapper hoặc phong cách."
                },
                {
                    "en": "Ostentatiously self-confident.",
                    "vi": "Thoải mái tự cao tự đại."
                }
            ]
        }
    ],
    "meaning_vi": [
