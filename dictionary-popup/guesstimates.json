    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "An estimate based on conjecture.",
                    "vi": "Một ước tính dựa trên phỏng đoán."
                },
                {
                    "en": "An estimate based on a guess or conjecture.",
                    "vi": "Một ước tính dựa trên một phỏng đoán hoặc phỏng đoán."
                },
                {
                    "en": "(informal) An estimate that is hardly any better than a guess, often because it is based on insufficient or unreliable data.",
                    "vi": "(không chính thức) Một ước tính khó có thể tốt hơn phỏng đoán, thường là vì nó dựa trên dữ liệu không đủ hoặc không đáng tin cậy."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To form a guesstimate of.",
                    "vi": "Để hình thành một ước tính của."
                },
                {
                    "en": "(intransitive) To make a guesstimate.",
                    "vi": "(intransitive) Để phỏng đoán."
                },
                {
                    "en": "To make a guesstimate of a specific quantity.",
                    "vi": "Để phỏng đoán một số lượng cụ thể."
                }
            ]
        }
    ],
    "meaning_vi": [
        "sự ước tính theo cách vừa dự đoán vừa lập luận"
