    "sentences": [
        {
            "en": "They all grew silent.",
            "vi": "Tất cả đều im lặng."
        },
        {
            "en": "They grew up healthy and strong.",
            "vi": "Họ lớn lên khỏe mạnh và mạnh mẽ."
