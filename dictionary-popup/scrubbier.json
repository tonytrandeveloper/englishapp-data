    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Paltry or shabby.",
                    "vi": "Tệ hoặc tồi tàn."
                },
                {
                    "en": "Covered with or consisting of scrub or underbrush.",
                    "vi": "Được phủ bằng hoặc bao gồm cọ hoặc bàn chải kỹ."
                },
                {
                    "en": "Shrublike or scraggly.",
                    "vi": "Giống cây bụi hoặc xơ xác."
                },
                {
                    "en": "Stunted in growth; undersized or inferior.",
                    "vi": "Còi cọc trong tăng trưởng; nhỏ hơn hoặc kém hơn."
                },
                {
                    "en": "Covered with or consisting of scrub, or brushwood.",
                    "vi": "Được phủ bằng hoặc bao gồm cây chà là, hoặc gỗ chổi."
                },
                {
                    "en": "Paltry, shabby, etc.",
                    "vi": "Tệ, tồi tàn, v.v."
                },
                {
                    "en": "Covered with or consisting of scrub.",
                    "vi": "Được bao phủ bởi hoặc bao gồm lớp tế bào chết."
                },
                {
                    "en": "Inferior in size or quality.",
                    "vi": "Kém hơn về kích thước hoặc chất lượng."
                }
            ]
        }
    ],
