    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The possessions, such as clothing and linens, that a bride assembles for her marriage.",
                    "vi": "Của cải, chẳng hạn như quần áo và khăn trải giường, mà một cô dâu thu thập cho cuộc hôn nhân của mình."
                },
                {
                    "en": "The clothes, linen, jewelry, etc. of a bride.",
                    "vi": "Quần áo, vải lanh, đồ trang sức, v.v. của cô dâu."
                },
                {
                    "en": "The clothes and linen etc. that a bride collects for her wedding and married life.",
                    "vi": "Quần áo và vải lanh, v.v. mà cô dâu thu thập cho đám cưới và cuộc sống hôn nhân của mình."
                }
            ]
        }
    ],
