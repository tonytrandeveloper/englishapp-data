        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "(by extension, chiefly hyperbolic) Very cold.",
                    "vi": "(mở rộng, chủ yếu là hypebol) Rất lạnh."
                },
                {
                    "en": "(literally) Suffering or causing frost.",
                    "vi": "(nghĩa đen) Đau khổ hoặc gây ra sương giá."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(uncountable, physics, chemistry) The change in state of a substance from liquid to solid by cooling to a critically low temperature.",
                    "vi": "(không đếm được, vật lý, hóa học) Sự thay đổi trạng thái của một chất từ lỏng sang rắn bằng cách làm lạnh đến nhiệt độ cực thấp."
                },
                {
                    "en": "(countable, medicine) The action of numbing with anesthetics.",
                    "vi": "(đếm được, thuốc) Hành động gây tê bằng thuốc tê."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of freeze.",
                    "vi": "Trình bày phân từ của sự đóng băng."
                }
            ]
        }
