    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(uncountable) The quality or characteristic of being uneven; irregularity; inconsistency; the lack of smoothness or continuity.",
                    "vi": "(không đếm được) Chất lượng hoặc đặc tính không đồng đều; sự bất thường; sự không nhất quán; sự thiếu trơn tru hoặc liên tục."
                },
                {
                    "en": "(countable) The result or product of being uneven.",
                    "vi": "(đếm được) Kết quả hoặc sản phẩm không đồng đều."
                },
                {
                    "en": "A rough or uneven thing.",
                    "vi": "Một thứ thô ráp hoặc không bằng phẳng."
                }
            ]
        }
    ],
