    "sentences": [
        {
            "en": "I've got people checking sales.",
            "vi": "Tôi đã có người kiểm tra doanh số bán hàng."
        },
        {
            "en": "I'm just checking in.",
            "vi": "Tôi chỉ đang đăng ký."
        },
        {
            "en": "The climbers are checking out of Bird Song tomorrow.",
            "vi": "Các nhà leo núi sẽ kiểm tra Bird Song vào ngày mai."
        },
        {
            "en": "I was checking out a point guard who proved to be too short.",
            "vi": "Tôi đã kiểm tra một điểm bảo vệ người đã được chứng minh là quá thấp."
        },
        {
            "en": "You gave Howard access to the checking account.",
            "vi": "Bạn đã cấp cho Howard quyền truy cập vào tài khoản séc."
        },
        {
            "en": "Checking to see if anyone was around, she exited her room.",
            "vi": "Kiểm tra xem có ai xung quanh không, cô rời khỏi phòng của mình."
        },
        {
            "en": "Her savings and checking accounts combined had never exceeded $3,000 - not even before she paid the bills.",
            "vi": "Các tài khoản tiết kiệm và séc của cô cộng lại chưa bao giờ vượt quá 3.000 đô la - thậm chí trước khi cô thanh toán các hóa đơn."
        },
        {
            "en": "Did you do any more checking on Ed and Edith Plotke— the people from the 1961 newspaper—and missing Josh the miner?",
            "vi": "Bạn có kiểm tra thêm Ed và Edith Plotke - những người của tờ báo năm 1961 - và mất tích Josh thợ mỏ không?"
        },
        {
            "en": "We could probably find out for sure if we kept checking enough records.",
            "vi": "Chúng tôi có thể tìm ra chắc chắn nếu chúng tôi tiếp tục kiểm tra đủ hồ sơ."
        },
        {
            "en": "She'd always hoped Wynn found some miracle cure, even while checking things off her bucket list.",
            "vi": "Cô luôn hy vọng Wynn tìm thấy một phương pháp chữa trị kỳ diệu nào đó, ngay cả khi đang kiểm tra mọi thứ trong danh sách xô của cô."
        }
    ]
