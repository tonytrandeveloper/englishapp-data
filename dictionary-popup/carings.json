        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Feeling and exhibiting concern and empathy for others.",
                    "vi": "Cảm nhận và thể hiện sự quan tâm và đồng cảm với người khác."
                },
                {
                    "en": "The definition of caring is someone or something that shows kindness and concern for others.",
                    "vi": "Định nghĩa về quan tâm là một ai đó hoặc một cái gì đó thể hiện lòng tốt và sự quan tâm đến người khác."
                },
                {
                    "en": "(of a person) Kind, sensitive, empathetic.",
                    "vi": "(của một người) Tốt bụng, nhạy cảm, đồng cảm."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of care.",
                    "vi": "Hiện tại phân từ chăm sóc."
