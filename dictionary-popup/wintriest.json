    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or like winter; cold, bleak, etc.",
                    "vi": "Của hoặc như mùa đông; lạnh lẽo, ảm đạm, v.v."
                },
                {
                    "en": "Suggestive of winter, as in cheerlessness or coldness.",
                    "vi": "Gợi ý về mùa đông, như trong sự vui vẻ hoặc lạnh lẽo."
                },
                {
                    "en": "Suggestive or characteristic of winter; cold, stormy.",
                    "vi": "Gợi ý hoặc đặc trưng của mùa đông; lạnh giá, bão tố."
                },
                {
                    "en": "Aged, white(-haired etc.)",
                    "vi": "Có tuổi, da trắng (-có tóc, v.v.)"
                },
                {
                    "en": "Chilling, cheerless.",
                    "vi": "Ớn lạnh, hớn hở."
                },
                {
                    "en": "Belonging to or characteristic of winter; cold.",
                    "vi": "Thuộc về hoặc đặc trưng của mùa đông; lạnh."
                }
            ]
        }
    ],
    "meaning_vi": [
        "lạnh giá; hiu hắt m đạm như mùa đông",
        "(nghĩa bóng) lạnh nhạt, lạnh lùng ((như) winterly)"
