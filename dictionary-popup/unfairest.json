    "phonetics": {
        "uk": "ʌnˈfeərɪst",
        "us": "ənˈfɛrɪst"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Not just or impartial; biased; inequitable.",
                    "vi": "Không công bằng hoặc không thiên vị; thiên vị; không công bằng."
                },
                {
                    "en": "Not kind or considerate.",
                    "vi": "Không tử tế hay chu đáo."
                },
                {
                    "en": "Contrary to justice or a sense of fairness.",
                    "vi": "Trái ngược với công lý hoặc cảm giác công bằng."
                },
                {
                    "en": "Contrary to laws or conventions, especially in commerce; unethical.",
                    "vi": "Trái với luật pháp hoặc quy ước, đặc biệt là trong thương mại; phi đạo đức."
                },
                {
                    "en": "The definition of unfair is something that is not in accordance with justice or that is not kind or impartial.",
                    "vi": "Định nghĩa của không công bằng là một cái gì đó không phù hợp với công lý hoặc không tử tế hoặc không thiên vị."
                },
                {
                    "en": "Dishonest, dishonorable, or unethical in business dealings.",
                    "vi": "Không trung thực, không đáng khinh hoặc phi đạo đức trong giao dịch kinh doanh."
                },
                {
                    "en": "Not fair, unjust.",
                    "vi": "Không công bằng, bất công."
                }
            ]
        }
    ],
