            "meaning": [
                {
                    "en": "A rude, awkward, or ill-mannered person.",
                    "vi": "Một người thô lỗ, vụng về hoặc thiếu lịch sự."
                },
                {
                    "en": "A person with rude, clumsy manners and little refinement.",
                    "vi": "Một người có cách cư xử thô lỗ, vụng về và ít trau chuốt."
                },
                {
                    "en": "A peasant.",
                    "vi": "Một nông dân."
                },
                {
                    "en": "A Boer, white South African of Dutch or Huguenot descent.",
                    "vi": "Một người Boer, người Nam Phi da trắng, gốc Hà Lan hoặc Huguenot."
                },
                {
                    "en": "A boor is someone with bad manners.",
                    "vi": "Kẻ xấu là người có cách cư xử tồi."
                },
                {
                    "en": "(archaic) A peasant or farm worker.",
                    "vi": "(cổ xưa) Một nông dân hoặc công nhân nông trại."
                },
                {
                    "en": "A peasant.",
                    "vi": "Một nông dân."
                },
                {
                    "en": "A yokel, country bumpkin,",
                    "vi": "Một yokel, da gà quê,"
                },
                {
                    "en": "An uncultured person.",
                    "vi": "Một người vô văn hóa."
                }
            ]
        }
    ],
