        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Surveillance of an area, building, or person, especially by the police.",
                    "vi": "Giám sát khu vực, tòa nhà hoặc người, đặc biệt là bởi cảnh sát."
                },
                {
                    "en": "The staking out of police, etc. in a surveillance of a location, suspected criminal, etc.",
                    "vi": "Việc ngăn chặn cảnh sát, v.v. để giám sát một địa điểm, bị tình nghi là tội phạm, v.v."
                },
                {
                    "en": "An area so staked out.",
                    "vi": "Một khu vực được đặt ra."
                },
                {
                    "en": "The act of watching a location, generally covertly.",
                    "vi": "Hành động theo dõi một vị trí, nói chung là một cách bí mật."
                }
            ]
        }
