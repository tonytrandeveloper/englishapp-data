        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Enduring forever; eternal.",
                    "vi": "Trường tồn mãi mãi; Vĩnh hằng."
                },
                {
                    "en": "Everlasting; perpetual; eternal.",
                    "vi": "Bất diệt; vĩnh viễn; Vĩnh hằng."
                },
                {
                    "en": "Seemingly everlasting or eternal.",
                    "vi": "Dường như vĩnh cửu hoặc vĩnh cửu."
                },
                {
                    "en": "(philosophy) Everlasting, that is having infinite temporal duration; as opposed to eternal, outside time and thus lacking temporal duration.",
                    "vi": "(triết học) Vĩnh viễn, tức là có thời gian vô hạn; trái ngược với vĩnh cửu, bên ngoài thời gian và do đó thiếu thời gian."
                }
            ]
        }
    ],
