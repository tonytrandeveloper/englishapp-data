    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Tending or intended to correct.",
                    "vi": "Có xu hướng hoặc có ý định sửa chữa."
                },
                {
                    "en": "Tending or meant to correct or improve; remedial.",
                    "vi": "Có xu hướng hoặc có nghĩa là để sửa chữa hoặc cải thiện; khắc phục hậu quả."
                },
                {
                    "en": "Of or pertaining to correction; serving to correct.",
                    "vi": "Của hoặc liên quan đến sửa chữa; phục vụ để sửa chữa."
                },
                {
                    "en": "Qualifying; limiting.",
                    "vi": "Đạt tiêu chuẩn; hạn chế."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "An agent that corrects.",
                    "vi": "Một đại lý sửa chữa."
                },
                {
                    "en": "Something corrective; remedy.",
                    "vi": "Một cái gì đó sửa chữa; phương pháp khắc phục."
                },
                {
                    "en": "Something that corrects or counteracts something, especially an injury or disability.",
                    "vi": "Một cái gì đó sửa chữa hoặc chống lại một cái gì đó, đặc biệt là một chấn thương hoặc khuyết tật."
                }
            ]
        }
    ],
