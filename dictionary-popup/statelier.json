    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Impressive and dignified, as in size or appearance; majestic.",
                    "vi": "Ấn tượng và trang nghiêm, như về kích thước hoặc ngoại hình; Hùng vĩ."
                },
                {
                    "en": "Dignified and slow; measured.",
                    "vi": "Trang nghiêm và chậm rãi; đo lường."
                },
                {
                    "en": "Imposing; dignified; majestic.",
                    "vi": "Oai phong; đứng đắn, nghiêm túc; Hùng vĩ."
                },
                {
                    "en": "The definition of stately is someone or something with a majestic and dignified manner.",
                    "vi": "Định nghĩa về trang nghiêm là một người nào đó hoặc một cái gì đó có phong thái uy nghiêm và trang nghiêm."
                },
                {
                    "en": "Of people: regal, dignified; worthy of respect.",
                    "vi": "Của người: vương giả, trang nghiêm; đáng trân trọng."
                },
                {
                    "en": "Of movement: dignified; deliberate, unhurried.",
                    "vi": "Của phong trào: trang nghiêm; có chủ ý, không vội vàng."
                },
                {
                    "en": "Imposing; grand, impressive.",
                    "vi": "Oai phong; hoành tráng, ấn tượng."
                },
                {
                    "en": "Slow, dignified, and deliberate.",
                    "vi": "Chậm rãi, trang nghiêm và cân nhắc."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "In a stately manner.",
                    "vi": "Một cách trang nghiêm."
                }
            ]
        }
    ],
    "meaning_vi": [
        "oai vệ, oai nghiêm (dáng, người)",
        "trang nghiêm, trịnh trọng (văn phong)"
    ],
