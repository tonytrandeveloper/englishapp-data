            "meaning": [
                {
                    "en": "The definition of crumbly is made of crumbs, or easily broken into small parts.",
                    "vi": "Định nghĩa của crumbly được làm bằng các mảnh vụn, hoặc dễ dàng bị vỡ thành các phần nhỏ."
                },
                {
                    "en": "Easily crumbled; friable.",
                    "vi": "Dễ dàng bị vỡ vụn; bở."
                },
                {
                    "en": "Apt to crumble; easily crumbled.",
                    "vi": "Có khả năng sụp đổ; dễ bị vỡ vụn."
                },
                {
                    "en": "Crumblike; consisting of crumbs or small particles.",
                    "vi": "Giống như vụn; bao gồm các mảnh vụn hoặc các hạt nhỏ."
                },
                {
                    "en": "Easy to break into small fragments; brittle or friable.",
                    "vi": "Dễ vỡ thành các mảnh nhỏ; giòn hoặc bở."
                }
            ]
        }
