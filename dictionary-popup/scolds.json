    "phonetics": {
        "uk": "skəʊldz",
        "us": "skoʊldz"
    },
    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To find fault angrily.",
                    "vi": "Để tìm lỗi một cách tức giận."
                },
                {
                    "en": "To use abusive language habitually.",
                    "vi": "Sử dụng ngôn ngữ lạm dụng theo thói quen."
                },
                {
                    "en": "To find fault with angrily; rebuke or chide severely.",
                    "vi": "Để tìm ra lỗi với giận dữ; quở trách hoặc mắng nhiếc nặng nề."
                },
                {
                    "en": "To express harsh or angry disapproval to someone.",
                    "vi": "Để bày tỏ sự phản đối gay gắt hoặc tức giận với ai đó."
                },
                {
                    "en": "To reprimand or criticize harshly and usually angrily.",
                    "vi": "Khiển trách hoặc chỉ trích gay gắt và thường là giận dữ."
                },
                {
                    "en": "To scold is to criticize, chastise or rebuke someone for something.",
                    "vi": "Chửi là chỉ trích, trừng phạt hoặc quở trách ai đó về điều gì đó."
                },
                {
                    "en": "To rebuke.",
                    "vi": "Để quở trách."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A person, esp. a woman, who habitually uses abusive language.",
                    "vi": "Một người, đặc biệt. một phụ nữ thường sử dụng ngôn từ lăng mạ."
                },
                {
                    "en": "One who persistently nags or criticizes.",
                    "vi": "Một người kiên trì cằn nhằn hoặc chỉ trích."
                },
                {
                    "en": "(obsolete) A person fond of abusive language, in particular a troublesome and angry woman.",
                    "vi": "(lỗi thời) Một người thích lạm dụng ngôn ngữ, đặc biệt là một người phụ nữ phiền phức và tức giận."
                }
            ]
        }
    ],
    "meaning_vi": [
        "rầy la, trách mắng, mắng mỏ; gắt gỏng",
        "người đàn bà bẳn tính, người đàn bà hay gắt gỏng; người đàn bà hay chửi rủa"
