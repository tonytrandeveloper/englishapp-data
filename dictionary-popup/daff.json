                },
                {
                    "en": "(archaic) To turn or thrust aside.",
                    "vi": "(cổ xưa) Để quay hoặc đẩy sang một bên."
                },
                {
                    "en": "(obs.) To take off (clothes); doff.",
                    "vi": "(obs.) để cởi (quần áo); ngu ngốc."
                },
                {
                    "en": "(intransitive) To be foolish; make sport; play; toy.",
                    "vi": "(intransitive) Trở nên ngu ngốc; tập thể thao; chơi; đồ chơi."
                },
                {
                    "en": "(UK, dialect) To daunt.",
                    "vi": "(Anh, phương ngữ) Làm nản lòng."
                },
                {
                    "en": "To toss aside; put off; doff.",
                    "vi": "Quăng sang một bên; hoãn; ngu ngốc."
                },
                {
                    "en": "To turn (someone) aside; divert.",
                    "vi": "Để gạt (ai đó) sang một bên; chuyển hướng."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A fool; an idiot; a blockhead.",
                    "vi": "Một kẻ ngốc; một thằng ngốc; một đầu chặn."
                },
                {
                    "en": "(UK, informal) Short form of daffodil.",
                    "vi": "(Vương quốc Anh, không chính thức) Dạng ngắn của hoa thủy tiên vàng."
