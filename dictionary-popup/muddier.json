    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Full of or covered with mud.",
                    "vi": "Đầy hoặc phủ đầy bùn."
                },
                {
                    "en": "Lacking luster; dull.",
                    "vi": "Thiếu ánh sáng; đần độn."
                },
                {
                    "en": "Confused or vague.",
                    "vi": "Lẫn lộn hoặc mơ hồ."
                },
                {
                    "en": "Not bright or pure.",
                    "vi": "Không sáng sủa hoặc tinh khiết."
                },
                {
                    "en": "Not clear; cloudy, as with sediment.",
                    "vi": "Không rõ ràng; vẩn đục, như với trầm tích."
                },
                {
                    "en": "Full of or spattered with mud.",
                    "vi": "Đầy hoặc vương vãi bùn."
                },
                {
                    "en": "Confused, obscure, vague, etc.",
                    "vi": "Khó hiểu, mù mờ, mơ hồ, v.v."
                },
                {
                    "en": "Not clear; containing sediment; cloudy.",
                    "vi": "Không rõ ràng; chứa trầm tích; Nhiều mây."
                },
                {
                    "en": "Not light or bright; dull.",
                    "vi": "Không sáng hoặc không sáng; đần độn."
                },
                {
                    "en": "Covered with or full of mud or wet soil.",
                    "vi": "Được bao phủ bởi hoặc đầy bùn hoặc đất ướt."
                },
                {
                    "en": "With mud or other sediment brought into suspension, turbid.",
                    "vi": "Với bùn hoặc các chất cặn khác đưa đến dạng huyền phù, bị đục."
                },
                {
                    "en": "Not clear; mixed up or blurry.",
                    "vi": "Không rõ ràng; lẫn lộn hoặc mờ."
                },
                {
                    "en": "Confused; stupid; incoherent; vague.",
                    "vi": "Bối rối; ngốc nghếch; không mạch lạc; mơ hồ."
                },
                {
                    "en": "(euphemistic) Soiled with feces.",
                    "vi": "(euphemistic) Làm bẩn phân."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To make dirty or muddy.",
                    "vi": "Để làm cho bẩn hoặc bùn."
                },
                {
                    "en": "To make dull or cloudy.",
                    "vi": "Để làm mờ hoặc đục."
                },
                {
                    "en": "To make obscure or confused.",
                    "vi": "Để làm cho tối nghĩa hoặc nhầm lẫn."
                },
                {
                    "en": "To make or become muddy.",
                    "vi": "Để làm cho hoặc trở nên lầy lội."
                },
                {
                    "en": "To get mud on (something).",
                    "vi": "Để có bùn trên (một cái gì đó)."
                },
                {
                    "en": "To make a mess of, or create confusion with regard to.",
                    "vi": "Để tạo ra một mớ hỗn độn hoặc tạo ra sự nhầm lẫn liên quan đến."
                }
            ]
        }
    ],
    "meaning_vi": [
