    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Lacking stylishness or neatness; shabby.",
                    "vi": "Thiếu phong cách hoặc gọn gàng; tồi tàn."
                },
                {
                    "en": "Old-fashioned; antiquated.",
                    "vi": "Cổ hủ; cổ kính."
                },
                {
                    "en": "Not neat or stylish in dress or appearance; shabby.",
                    "vi": "Không gọn gàng, chỉn chu trong cách ăn mặc hoặc diện mạo; tồi tàn."
                },
                {
                    "en": "Plain and unfashionable in style or dress.",
                    "vi": "Phong cách hoặc trang phục đơn giản và không hợp thời trang."
                },
                {
                    "en": "Lacking stylishness or neatness; shabby.",
                    "vi": "Thiếu phong cách hoặc gọn gàng; tồi tàn."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A dowdy person; a frump.",
                    "vi": "Một người sa sút; một trái cau."
                },
                {
                    "en": "Pandowdy.",
