                {
                    "en": "Having or suited for a low rank or position.",
                    "vi": "Có hoặc phù hợp với cấp bậc hoặc chức vụ thấp."
                },
                {
                    "en": "Humble or meek in manner.",
                    "vi": "Khiêm tốn hoặc nhu mì trong cách cư xử."
                },
                {
                    "en": "Plain or prosaic in nature.",
                    "vi": "Bản chất thuần túy hoặc thuần túy."
                },
                {
                    "en": "Of or suited to a low position or rank.",
                    "vi": "Của hoặc phù hợp với một vị trí hoặc cấp bậc thấp."
                },
                {
                    "en": "Humble; meek.",
                    "vi": "Khiêm tốn; nhu mì."
                },
                {
                    "en": "Ordinary; commonplace.",
                    "vi": "Bình thường; bình thường."
                },
                {
                    "en": "Not high; not elevated in place; low.",
                    "vi": "Không cao; không được nâng cao tại chỗ; Thấp."
                },
                {
                    "en": "Low in rank or social importance.",
                    "vi": "Thứ hạng hoặc tầm quan trọng xã hội thấp."
                },
                {
                    "en": "Not lofty or sublime; humble.",
                    "vi": "Không cao cả hay cao siêu; khiêm tốn."
                },
                {
                    "en": "Having a low esteem of one's own worth; humble; meek; free from pride.",
                    "vi": "Đánh giá thấp giá trị của bản thân; khiêm tốn; nhu mì; không khỏi kiêu ngạo."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
