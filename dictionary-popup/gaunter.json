    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Bleak or desolate.",
                    "vi": "Ảm đạm hoặc hoang vắng."
                },
                {
                    "en": "Thin or emaciated.",
                    "vi": "Gầy hoặc hốc hác."
                },
                {
                    "en": "Thin and bony; hollow-eyed and haggard, as from great hunger or age; emaciated.",
                    "vi": "Mỏng và xương xẩu; mắt trũng và hốc hác, vì đói quá lớn hoặc tuổi cao; hốc hác."
                },
                {
                    "en": "Looking grim, forbidding, or desolate.",
                    "vi": "Trông dữ tợn, ngăn cấm, hoặc hoang tàn."
                },
                {
                    "en": "The definition of gaunt is looking thin, bony or sickly.",
                    "vi": "Định nghĩa của gầy là trông gầy, xương xẩu hoặc ốm yếu."
                },
                {
                    "en": "Lean, angular, and bony.",
                    "vi": "Gầy, góc cạnh và xương xẩu."
                },
                {
                    "en": "Haggard, drawn, and emaciated.",
                    "vi": "Haggard, vẽ và hốc hác."
                },
                {
                    "en": "Bleak, barren, and desolate.",
                    "vi": "Ảm đạm, cằn cỗi và hoang vắng."
                }
            ]
        }
    ],
    "meaning_vi": [
        "gầy, hốc hác",
