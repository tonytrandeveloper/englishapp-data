            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or relating to Vladimir Lenin (Russian: Влади́мир Ильи́ч Ле́нин), a Russian revolutionary and politician.",
                    "vi": "Của hoặc liên quan đến Vladimir Lenin (tiếng Nga: Влади́мир Ильи́ч Ле́нин), một nhà cách mạng và chính trị gia người Nga."
                },
                {
                    "en": "Of or relating to Leninism.",
                    "vi": "Của hoặc liên quan đến chủ nghĩa Lê-nin."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A person who follows or supports Lenin or the philosophy of Leninism.",
                    "vi": "Một người theo hoặc ủng hộ Lenin hoặc triết học của chủ nghĩa Lenin."
                }
            ]
        }
