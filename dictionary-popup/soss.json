            "meaning": [
                {
                    "en": "(UK, dialect) Anything dirty or muddy; a dirty puddle.",
                    "vi": "(Anh, phương ngữ) Bất cứ thứ gì bẩn thỉu hoặc lầy lội; một vũng nước bẩn."
                },
                {
                    "en": "A heavy fall.",
                    "vi": "Một cú ngã nặng nề."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To fall suddenly into a chair or seat; to sit lazily.",
                    "vi": "Đột ngột ngã vào ghế hoặc ghế ngồi; để ngồi một cách uể oải."
                },
                {
                    "en": "To throw in a negligent or careless manner; to toss.",
                    "vi": "Để ném một cách cẩu thả hoặc bất cẩn; tung."
                }
            ]
        }
