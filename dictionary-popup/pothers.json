    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A state of nervous activity; a fuss.",
                    "vi": "Một trạng thái hoạt động thần kinh; om sòm, ồn ào."
                },
                {
                    "en": "A cloud of smoke or dust that chokes or smothers.",
                    "vi": "Một đám khói hoặc bụi làm nghẹt thở hoặc tan chảy."
                },
                {
                    "en": "(archaic) A choking cloud of smoke, dust, etc.",
                    "vi": "(cổ xưa) Một đám khói, bụi, v.v."
                },
                {
                    "en": "An uproar, commotion, fuss, etc.",
                    "vi": "Một sự náo động, náo động, ồn ào, v.v."
                },
                {
                    "en": "A commotion; a disturbance.",
                    "vi": "Một sự náo động; một sự xáo trộn."
                },
                {
                    "en": "A commotion, a tempest.",
                    "vi": "Một sự náo động, một cơn bão."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To make confused; trouble; worry.",
                    "vi": "Để làm cho bối rối; rắc rối; lo."
                },
                {
                    "en": "To be overly concerned with trifles; fuss.",
                    "vi": "Quan tâm quá mức đến những chuyện vặt vãnh; ồn ào."
                },
                {
                    "en": "To fuss or bother.",
                    "vi": "Để làm phiền hoặc làm phiền."
                },
                {
                    "en": "(intransitive) To make a bustle or stir; to be fussy.",
                    "vi": "(nội tâm) Để tạo ra sự náo nhiệt hoặc khuấy động; cầu kỳ."
                }
            ]
        }
    ],
