            "meaning": [
                {
                    "en": "A circular or gracefully rounded object.",
                    "vi": "Một đối tượng hình tròn hoặc được làm tròn một cách duyên dáng."
                },
                {
                    "en": "(rare) A circle or sphere; roundness.",
                    "vi": "(hiếm) Một hình tròn hoặc hình cầu; sự tròn trịa."
                },
                {
                    "en": "A graceful round object, or a graceful curvature.",
                    "vi": "Một vật tròn duyên dáng, hoặc một đường cong duyên dáng."
                },
                {
                    "en": "A ring or sphere.",
                    "vi": "Một chiếc nhẫn hoặc quả cầu."
                }
