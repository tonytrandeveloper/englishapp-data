        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(uncountable) The condition, or quality, of being mean; want of excellence; poorness; lowness; baseness; sordidness; stinginess.",
                    "vi": "(không đếm được) Tình trạng hoặc chất lượng trung bình; muốn xuất sắc; sự nghèo nàn; sự thấp hèn; độ nền; sự bẩn thỉu; keo kiệt."
                },
                {
                    "en": "A mean act; as, to be guilty of a meanness.",
                    "vi": "Một hành động xấu xa; như, để có tội với một sự hèn hạ."
                }
            ]
        }
