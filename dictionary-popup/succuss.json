    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To shake forcibly; esp. formerly, to shake (a patient) from side to side in order to detect a liquid in some body cavity, esp. in the thorax.",
                    "vi": "Để lắc cưỡng bức; đặc biệt. trước đây, lắc (bệnh nhân) từ bên này sang bên kia để phát hiện chất lỏng trong một số khoang cơ thể, đặc biệt là. trong lồng ngực."
                },
                {
                    "en": "To shake with vigor.",
                    "vi": "Để lắc với sức sống."
                },
                {
                    "en": "(medicine) Specifically to shake a patient to detect fluids or air in the body.",
                    "vi": "(y học) Cụ thể là lắc bệnh nhân để phát hiện chất lỏng hoặc không khí trong cơ thể."
                }
            ]
        }
    ],
