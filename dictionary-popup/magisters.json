            "meaning": [
                {
                    "en": "Master; sir: -- a title of the Middle Ages, given to a person in authority, or to one having a license from a university to teach philosophy and the liberal arts.",
                    "vi": "Bậc thầy; thưa ngài: - một tước hiệu của thời Trung Cổ, được trao cho một người có thẩm quyền, hoặc cho một người có giấy phép từ một trường đại học để dạy triết học và nghệ thuật tự do."
                },
                {
                    "en": "The possessor of a master's degree.",
                    "vi": "Người sở hữu bằng thạc sĩ."
                }
            ]
