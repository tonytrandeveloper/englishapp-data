            "meaning": [
                {
                    "en": "A prisoner; convict.",
                    "vi": "Một người tù nhân; kết tội."
                },
                {
                    "en": "(chiefly US, slang) A chicken.",
                    "vi": "(chủ yếu là tiếng Mỹ, tiếng lóng) Một con gà."
                },
                {
                    "en": "(chiefly US, slang) A person who is imprisoned.",
                    "vi": "(chủ yếu là tiếng Mỹ, tiếng lóng) Một người bị bỏ tù."
                },
                {
                    "en": "(chiefly US, slang) A soldier who is required to perform menial work on the grounds of a military base.",
                    "vi": "(chủ yếu là Hoa Kỳ, tiếng lóng) Một người lính được yêu cầu thực hiện công việc nặng nhọc trong căn cứ quân sự."
                },
                {
                    "en": "A military recruit, esp. one frequently assigned to cleanup or other menial duties.",
                    "vi": "Một người tuyển quân, đặc biệt. một người thường xuyên được giao nhiệm vụ dọn dẹp hoặc các nhiệm vụ thường xuyên khác."
                }
            ]
        }
