    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A cheap and showy object of little or no use; a gewgaw.",
                    "vi": "Một vật rẻ tiền và sặc sỡ, ít hoặc không sử dụng; một gewgaw."
                },
                {
                    "en": "A cheap, showy, useless thing.",
                    "vi": "Một thứ rẻ tiền, phô trương, vô dụng."
                },
                {
                    "en": "Something showy but worthless; a gimmick or bauble.",
                    "vi": "Một thứ gì đó sặc sỡ nhưng vô giá trị; một mánh lới quảng cáo hoặc món ăn vặt."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Cheap and tasteless; gaudy.",
                    "vi": "Rẻ và vô vị; xa hoa."
                },
                {
                    "en": "Showy but cheap and useless.",
                    "vi": "Trưng bày nhưng rẻ tiền và vô dụng."
                },
                {
                    "en": "Showy but of poor quality; worthless.",
                    "vi": "Sặc sỡ nhưng chất lượng kém; vô giá trị."
                }
            ]
        }
    ],
    "meaning_vi": [
        "đồ vật vô giá trị; đồ lặt vặt; đồ trang trí loè loẹt, rẻ tiền",
