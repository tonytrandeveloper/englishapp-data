                {
                    "en": "Having the appearance or consistency of soup.",
                    "vi": "Có sự xuất hiện hoặc độ đặc của súp."
                },
                {
                    "en": "(informal) Foggy.",
                    "vi": "(không chính thức) Sương mù."
                },
                {
                    "en": "(informal) Sentimental.",
                    "vi": "(thân mật) Đa cảm."
                },
                {
                    "en": "Watery like soup.",
                    "vi": "Chảy nước như súp."
                },
                {
                    "en": "(slang) Sloppily sentimental; mawkish.",
                    "vi": "(tiếng lóng) Dịu dàng đa cảm; mawkish."
                },
                {
                    "en": "Thick and dank.",
                    "vi": "Dày và chìm."
                },
                {
                    "en": "Quite foggy.",
                    "vi": "Khá nhiều sương mù."
                },
                {
                    "en": "Resembling soup; creamy.",
                    "vi": "Súp sánh lại; mịn."
                },
                {
                    "en": "Extravagantly sentimental; slushy.",
                    "vi": "Đa cảm một cách phi thường; nhão nhoét."
                }
            ]
        }
