    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A drunkard.",
                    "vi": "Một kẻ say xỉn."
                },
                {
                    "en": "A card game, played in many variations, in which the object is to obtain sets of three or more cards of the same rank or suit.",
                    "vi": "Một trò chơi bài, được chơi theo nhiều biến thể, trong đó đối tượng là lấy bộ ba lá bài trở lên cùng cấp bậc hoặc bộ đồ."
                },
                {
                    "en": "A card game, played in many variations, in which the object is to match cards into sets of the same denomination or sequences of the same suit.",
                    "vi": "Một trò chơi bài, được chơi theo nhiều biến thể, trong đó mục tiêu là ghép các quân bài thành các bộ có cùng mệnh giá hoặc dãy của cùng một bộ."
                },
                {
                    "en": "(slang) A drunkard.",
                    "vi": "(tiếng lóng) Một kẻ say rượu."
                },
                {
                    "en": "(uncountable) A card game with many rule variants, conceptually similar to mahjong.",
                    "vi": "(không đếm được) Một trò chơi bài có nhiều biến thể quy tắc, về mặt khái niệm tương tự như mạt chược."
                },
                {
                    "en": "(countable) A rum-drinking alcoholic.",
                    "vi": "(có thể đếm được) Một người nghiện rượu rum."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Odd, strange, or dangerous; rum.",
                    "vi": "Kỳ quặc, kỳ lạ hoặc nguy hiểm; Rum."
                },
                {
                    "en": "(brit., informal) Odd; strange; queer.",
                    "vi": "(Anh, không chính thức) Kỳ quặc; lạ lùng; người kỳ lạ."
                },
                {
                    "en": "Of or like rum.",
                    "vi": "Của hoặc giống như rượu rum."
                },
                {
                    "en": "(dated) Peculiar; odd.",
                    "vi": "(ngày tháng) Đặc biệt; số lẻ."
                },
                {
                    "en": "Resembling or tasting of rum.",
                    "vi": "Có vẻ như hoặc nếm rượu rum."
                }
            ]
        }
    ],
