        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Blood regarded as essential for life.",
                    "vi": "Máu được coi là cần thiết cho sự sống."
                },
                {
                    "en": "An indispensable or vital part.",
                    "vi": "Một phần không thể thiếu hoặc quan trọng."
                },
                {
                    "en": "The blood necessary to life.",
                    "vi": "Máu cần thiết cho sự sống."
                },
                {
                    "en": "A vital element or animating influence.",
                    "vi": "Một yếu tố quan trọng hoặc ảnh hưởng sống động."
                },
                {
                    "en": "Blood which is needed for continued life; blood regarded as the seat of life.",
                    "vi": "Máu cần thiết để tiếp tục cuộc sống; máu được coi là trụ sở của sự sống."
                },
                {
                    "en": "(figuratively) That which is required for continued existence or function.",
                    "vi": "(nghĩa bóng) Đó là thứ cần thiết để tiếp tục tồn tại hoặc hoạt động."
                }
            ]
        }
