    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Rough or surly in manner or speech; brusquely rude.",
                    "vi": "Cách thức hoặc lời nói thô bạo hoặc thô bạo; thô lỗ thô lỗ."
                },
                {
                    "en": "Brusque or stern in manner or appearance.",
                    "vi": "Căng thẳng hoặc nghiêm nghị về cách thức hoặc ngoại hình."
                },
                {
                    "en": "Hoarse; harsh.",
                    "vi": "Khàn tiếng; thô ráp."
                },
                {
                    "en": "The definition of gruff is something harsh sounding, or someone who is abrupt and short-tempered.",
                    "vi": "Định nghĩa của cộc cằn là một cái gì đó nghe có vẻ khắc nghiệt, hoặc một người đột ngột và nóng tính."
                },
                {
                    "en": "Having a rough, surly, and harsh demeanor and nature.",
                    "vi": "Có phong thái và bản chất thô bạo, ngang tàng, khắc nghiệt."
                },
                {
                    "en": "Hoarse-voiced.",
                    "vi": "Khàn giọng."
                },
                {
                    "en": "Harsh and throaty; hoarse.",
                    "vi": "Khắc nghiệt và cổ họng; khản đặc."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To speak gruffly.",
                    "vi": "Nói một cách cộc cằn."
                }
            ]
        }
    ],
    "meaning_vi": [
        "cộc lốc, cộc cằn, thô lỗ (người, giọng nói, thái độ...)"
