    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Containing or consisting of fire.",
                    "vi": "Chứa hoặc bao gồm lửa."
                },
                {
                    "en": "Characterized by strong emotion; ardent; spirited.",
                    "vi": "Đặc trưng bởi cảm xúc mạnh mẽ; hăng hái; tinh thần phấn chấn."
                },
                {
                    "en": "Easily stirred up; excitable.",
                    "vi": "Dễ dàng khuấy động; dễ bị kích động."
                },
                {
                    "en": "Easily set on fire; flammable.",
                    "vi": "Dễ dàng đốt cháy; dễ cháy."
                },
                {
                    "en": "The definition of fiery is to a strong personality, something related to heat, or to an impassioned action or speech.",
                    "vi": "Định nghĩa của bốc lửa là để chỉ một cá tính mạnh mẽ, một cái gì đó liên quan đến nhiệt, hoặc một hành động hoặc lời nói nóng nảy."
                },
                {
                    "en": "Of, or relating to fire.",
                    "vi": "Của, hoặc liên quan đến lửa."
                },
                {
                    "en": "Burning or glowing.",
                    "vi": "Đốt hoặc phát sáng."
                },
                {
                    "en": "Inflammable or easily ignited.",
                    "vi": "Dễ cháy hoặc dễ bắt lửa."
                },
                {
                    "en": "Having the colour of fire.",
                    "vi": "Có màu của lửa."
                },
                {
                    "en": "Hot or inflamed.",
                    "vi": "Nóng hoặc viêm."
                },
                {
                    "en": "Tempestuous or emotionally volatile.",
                    "vi": "Hay thay đổi cảm xúc."
                },
                {
                    "en": "Spirited or filled with emotion.",
                    "vi": "Tinh thần hoặc tràn đầy cảm xúc."
                },
                {
                    "en": "Like fire; glaring, hot, etc.",
                    "vi": "Như lửa; chói mắt, nóng bỏng, v.v."
                },
                {
                    "en": "Inflamed.",
                    "vi": "Bị viêm."
                },
                {
                    "en": "Having the color of fire; brightly red.",
                    "vi": "Có màu của lửa; đỏ rực."
                },
                {
                    "en": "Consisting of or containing fire.",
                    "vi": "Có hoặc chứa lửa."
                },
                {
                    "en": "Burning or glowing.",
                    "vi": "Đốt hoặc phát sáng."
                },
                {
                    "en": "Using or effected with fire.",
                    "vi": "Sử dụng hoặc tác động với lửa."
                },
                {
                    "en": "Easily ignited; flammable.",
                    "vi": "Dễ dàng đánh lửa; dễ cháy."
                },
                {
                    "en": "Torridly hot.",
                    "vi": "Nóng kinh khủng."
                },
                {
                    "en": "Feverishly hot and flushed.",
                    "vi": "Nóng bỏng và đỏ bừng."
                },
                {
                    "en": "Being in an inflamed, usually painful condition.",
                    "vi": "Đang ở trong tình trạng bị viêm, thường là đau đớn."
                },
                {
                    "en": "Easily excited or emotionally volatile; tempestuous.",
                    "vi": "Dễ bị kích động hoặc thay đổi cảm xúc; khó khăn."
                },
                {
                    "en": "Charged with emotion; spirited.",
                    "vi": "Tính phí bằng cảm xúc; tinh thần phấn chấn."
                }
            ]
        }
