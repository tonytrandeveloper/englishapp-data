            "pos": "noun",
            "meaning": [
                {
                    "en": "An abundant or excessive amount of something heard, such as talk or music.",
                    "vi": "Nghe được nhiều thứ hoặc quá nhiều, chẳng hạn như nói chuyện hoặc âm nhạc."
                },
                {
                    "en": "Gossip, especially of an intimate or scandalous nature.",
                    "vi": "Nói chuyện phiếm, đặc biệt là có tính chất thân mật hoặc gây tai tiếng."
                },
                {
                    "en": "A scolding or reprimand.",
                    "vi": "Một lời mắng mỏ hoặc khiển trách."
                },
                {
                    "en": "Enough or too much of what is heard.",
                    "vi": "Đủ hoặc quá nhiều những gì được nghe."
                },
                {
                    "en": "Important or startling news or gossip.",
                    "vi": "Tin tức quan trọng hoặc đáng ngạc nhiên hoặc tin đồn."
                },
                {
                    "en": "A scolding.",
                    "vi": "Một lời mắng mỏ."
                },
                {
                    "en": "(informal) A reprimand, castigation or telling off.",
                    "vi": "(không chính thức) Khiển trách, buộc tội hoặc nói xấu."
                },
                {
                    "en": "(informal) Intimate gossip.",
                    "vi": "(thân mật) Chuyện phiếm thân mật."
                }
            ]
        }
