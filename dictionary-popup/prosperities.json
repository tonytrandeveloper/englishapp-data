                {
                    "en": "The condition of being prosperous.",
                    "vi": "Điều kiện thịnh vượng."
                },
                {
                    "en": "Prosperity is the state of being wealthy, or having a rich and full life.",
                    "vi": "Thịnh vượng là trạng thái giàu có, hoặc có cuộc sống giàu sang, đầy đủ."
                },
                {
                    "en": "The condition of being prosperous, of having good fortune.",
                    "vi": "Nhân duyên thịnh vượng, có phúc khí."
                }
            ]
        }
