        "uk": "ruːd",
        "us": "rud"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Barbarous or ignorant.",
                    "vi": "Man rợ hoặc ngu dốt."
                },
                {
                    "en": "Crude or rough in form or workmanship.",
                    "vi": "Thô hoặc thô về hình thức hoặc tay nghề."
                },
                {
                    "en": "Discourteous; unmannerly.",
                    "vi": "Khéo léo; không người lái."
                },
                {
                    "en": "Harsh in sound; discordant; not musical.",
                    "vi": "Khắc nghiệt trong âm thanh; bất hòa; không phải nhạc kịch."
                },
                {
                    "en": "(chiefly british) Vigorous or robust.",
                    "vi": "(chủ yếu là người Anh) Mạnh mẽ hoặc cường tráng."
                },
                {
                    "en": "Having or showing little skill or development; primitive.",
                    "vi": "Có hoặc thể hiện ít kỹ năng hoặc sự phát triển; nguyên thủy."
                },
                {
                    "en": "Not carefully worked out or finished; not precise.",
                    "vi": "Không được làm việc cẩn thận hoặc hoàn thành; không chính xác."
                },
                {
                    "en": "Rough, violent, or harsh.",
                    "vi": "Thô bạo, bạo lực hoặc khắc nghiệt."
                },
                {
                    "en": "Unpleasantly forceful or harsh.",
                    "vi": "Bất đắc dĩ hoặc thô bạo."
                },
                {
                    "en": "Ill-mannered, discourteous, or insulting.",
                    "vi": "Không lịch sự, kín đáo hoặc xúc phạm."
                },
                {
                    "en": "The definition of rude is behavior that does not conform to what society says would be polite or good manners or inappropriate subjects of discussion.",
                    "vi": "Định nghĩa của thô lỗ là hành vi không phù hợp với những gì xã hội cho là lịch sự hoặc cách cư xử tốt hoặc đối tượng thảo luận không phù hợp."
                },
                {
                    "en": "(archaic) Lacking education or refinement.",
                    "vi": "(cổ xưa) Thiếu giáo dục hoặc sự sàng lọc."
                },
                {
                    "en": "Undeveloped or uncivilized; primitive.",
                    "vi": "Chưa phát triển hoặc không văn minh; nguyên thủy."
                },
                {
                    "en": "Crude, unfinished, or made with limited skill.",
                    "vi": "Thô, chưa hoàn thành hoặc được làm với kỹ năng hạn chế."
                },
                {
                    "en": "In a natural, raw state.",
                    "vi": "Ở trạng thái tự nhiên, thô sơ."
                },
                {
                    "en": "Sturdy; robust; rugged.",
                    "vi": "Cứng cáp; cường tráng; gồ ghề."
                },
                {
                    "en": "Lacking refinement, culture, or elegance; uncouth, boorish, coarse, vulgar, etc.",
                    "vi": "Thiếu sự tinh tế, văn hóa hoặc sự sang trọng; thô thiển, thô lỗ, thô thiển, thô tục, v.v."
                },
                {
                    "en": "(brit.) Indecent; obscene.",
                    "vi": "(Anh) Không đứng đắn; tục tĩu."
                },
                {
                    "en": "Bad-mannered.",
                    "vi": "Cư xử tệ."
                },
                {
                    "en": "Somewhat obscene, pornographic, offensive.",
                    "vi": "Hơi tục tĩu, khiêu dâm, xúc phạm."
                },
                {
                    "en": "Tough, robust.",
                    "vi": "Mạnh mẽ, khỏe khoắn."
                },
                {
                    "en": "Undeveloped, unskilled, basic.",
                    "vi": "Chưa phát triển, chưa có tay nghề, cơ bản."
                },
                {
                    "en": "Hearty, vigorous; found particularly in the phrase rude health.",
                    "vi": "Thịnh soạn, mạnh mẽ; được tìm thấy đặc biệt trong cụm từ sức khỏe thô lỗ."
                }
            ]
        }
    ],
