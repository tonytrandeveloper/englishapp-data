        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(informal) A sound thrashing; whipping.",
                    "vi": "(thân mật) Một âm thanh đập mạnh; đánh roi."
                },
                {
                    "en": "The business or practice of hunting, killing, and processing whales.",
                    "vi": "Kinh doanh hoặc hành nghề săn bắt, giết và chế biến cá voi."
                },
                {
                    "en": "The work or trade of hunting and killing whales for their blubber, whalebone, etc.",
                    "vi": "Công việc hoặc buôn bán săn bắt và giết cá voi để lấy thân mình, xương cá voi, v.v."
                },
                {
                    "en": "The practice of hunting whales.",
                    "vi": "Thực hành săn cá voi."
                },
                {
                    "en": "The practice of spotting whales.",
                    "vi": "Việc thực hành cá voi đốm."
                },
                {
                    "en": "(informal) A beating.",
                    "vi": "(không chính thức) Đánh đập."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of whale.",
                    "vi": "Hiện tại phân từ cá voi."
                }
            ]
        }
