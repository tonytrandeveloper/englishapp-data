    "phonetics": {
        "uk": "ˈplʌʃɪɪst",
        "us": "plushiest"
    },
    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A fabric of silk, rayon, cotton, or other material, having a thick deep pile.",
                    "vi": "Một loại vải bằng lụa, tơ tằm, bông hoặc chất liệu khác, có lớp sâu dày."
                },
                {
                    "en": "A fabric with a soft, thick, deep pile.",
                    "vi": "Là loại vải có chất vải mềm, dày, cọc sâu."
                },
                {
                    "en": "A textile fabric with a nap or shag on one side, longer and softer than the nap of velvet.",
                    "vi": "Là loại vải dệt có nap hoặc lông xù ở một mặt, dài hơn và mềm hơn vải nhung."
                },
                {
                    "en": "A (type of) child's toy, usually an animal, filled with soft material.",
                    "vi": "Một (loại) đồ chơi của trẻ em, thường là một con vật, được làm bằng vật liệu mềm."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or made of plush.",
                    "vi": "Bằng hoặc làm bằng sang trọng."
                },
                {
                    "en": "Made of or covered with plush.",
                    "vi": "Làm bằng hoặc phủ bằng vải sang trọng."
                },
                {
                    "en": "Luxurious.",
                    "vi": "Sang trọng."
                },
                {
                    "en": "(informal) Luxurious, as in furnishings.",
                    "vi": "(không chính thức) Sang trọng, như trong đồ đạc."
                },
                {
                    "en": "(UK) Very extravagant.",
                    "vi": "(Anh) Rất xa hoa."
                },
                {
                    "en": "(UK) Very expensive, or appearing expensive.",
                    "vi": "(Anh) Rất đắt, hoặc có vẻ đắt tiền."
                },
                {
                    "en": "(of a man-made object) Having a soft, fluffy exterior.",
                    "vi": "(của một vật nhân tạo) Có bên ngoài mềm, mịn."
                }
            ]
        }
    ],
