        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Showing, or intended to excite, lust or sexual desire, esp. in an offensive way; lascivious.",
                    "vi": "Thể hiện hoặc có ý định kích thích, ham muốn hoặc ham muốn tình dục, đặc biệt. theo cách gây khó chịu; đa dâm."
                },
                {
                    "en": "(obsolete) Wicked.",
                    "vi": "(lỗi thời) xấu xa."
                },
                {
                    "en": "Preoccupied with sex and sexual desire; lustful.",
                    "vi": "Bận tâm với tình dục và ham muốn tình dục; dâm đãng."
                },
                {
                    "en": "Unlearned; ignorant.",
                    "vi": "Chưa được công bố; dốt."
                },
                {
                    "en": "Unprincipled; vicious.",
                    "vi": "Không đạo đức; luẩn quẩn."
                },
                {
                    "en": "Lascivious, sexually promiscuous, rude.",
                    "vi": "Đa dâm, lăng nhăng, thô lỗ."
                },
                {
                    "en": "Southey.",
                    "vi": "Southey."
                },
                {
                    "en": "The definition of lewd is offensive sexual behavior.",
                    "vi": "Định nghĩa của dâm dục là hành vi tình dục xúc phạm."
                },
                {
                    "en": "Obscene; indecent.",
                    "vi": "Tục tĩu; không đứng đắn."
                }
            ]
        }
    ],
