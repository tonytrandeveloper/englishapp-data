                {
                    "en": "Exposed to breezes; windy.",
                    "vi": "Tiếp xúc với gió; co gio."
                },
                {
                    "en": "With breezes blowing; slightly windy.",
                    "vi": "Với những làn gió thổi qua; gió nhẹ."
                },
                {
                    "en": "Light and lively; carefree.",
                    "vi": "Nhẹ nhàng và sống động; không lo lắng."
                },
                {
                    "en": "With a breeze blowing, with a lively wind, pleasantly windy.",
                    "vi": "Với một làn gió thổi, với một cơn gió sống động, gió dễ chịu."
                },
                {
                    "en": "(figuratively) With a cheerful, casual, lively and light-hearted manner.",
                    "vi": "(nghĩa bóng) Với tính tình vui vẻ, dung dị, hoạt bát, nhẹ nhàng."
                },
                {
                    "en": "Fresh and animated; lively.",
                    "vi": "Tươi trẻ và hoạt hình; sống động."
                }
            ]
