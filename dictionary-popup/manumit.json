            "meaning": [
                {
                    "en": "To free from slavery or bondage; emancipate.",
                    "vi": "Để thoát khỏi nô lệ hoặc nô lệ; giải phóng."
                },
                {
                    "en": "To free from slavery; emancipate (a slave, serf, etc.)",
                    "vi": "Để giải phóng khỏi chế độ nô lệ; giải phóng (nô lệ, nông nô, v.v.)"
                },
                {
                    "en": "To release from slavery, to free.",
                    "vi": "Để giải phóng khỏi chế độ nô lệ, để giải phóng."
                }
            ]
        }
