    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(now rare) To twitch, pluck, etc.",
                    "vi": "(bây giờ hiếm) Để co giật, gảy đàn, v.v."
                },
                {
                    "en": "To touch (a body part) lightly so as to excite the surface nerves and cause uneasiness, laughter, or spasmodic movements.",
                    "vi": "Chạm nhẹ vào (một bộ phận cơ thể) để kích thích các dây thần kinh bề mặt và gây ra cảm giác khó chịu, cười hoặc các cử động co thắt."
                },
                {
                    "en": "To irritate as if by a nip, pinch, or tear.",
                    "vi": "Gây khó chịu như thể bị bóp, véo hoặc xé."
                },
                {
                    "en": "To pinch.",
                    "vi": "Nhéo."
                },
                {
                    "en": "To cause to twitch.",
                    "vi": "Để gây ra co giật."
                }
            ]
        }
    ],
