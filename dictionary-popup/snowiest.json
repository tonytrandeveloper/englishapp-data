            "meaning": [
                {
                    "en": "Like or suggestive of snow.  Pure; unsoiled; spotless. White.",
                    "vi": "Thích hoặc gợi ý về tuyết. Nguyên chất; không bẩn; không tì vết. Trắng."
                },
                {
                    "en": "Covered or filled with snow.",
                    "vi": "Được bao phủ hoặc đầy tuyết."
                },
                {
                    "en": "Of or consisting of snow.",
                    "vi": "Của hoặc bao gồm tuyết."
                },
                {
                    "en": "Characterized by snow or, esp., by much snow.",
                    "vi": "Được đặc trưng bởi tuyết hoặc đặc biệt là tuyết nhiều."
                },
                {
                    "en": "Resembling or suggesting snow, especially in whiteness.",
                    "vi": "Có vẻ như hoặc gợi ý về tuyết, đặc biệt là ở độ trắng."
                },
                {
                    "en": "Abounding in or covered with snow.",
                    "vi": "Nhiều trong hoặc bao phủ bởi tuyết."
                },
                {
                    "en": "Subject to snow.",
                    "vi": "Chủ đề của tuyết."
                },
                {
                    "en": "Covered with snow.",
                    "vi": "Tuyết phủ."
                },
                {
                    "en": "Resembling snow.",
                    "vi": "Có vẻ như tuyết."
                },
                {
                    "en": "When snow is falling.",
                    "vi": "Khi tuyết rơi."
                }
