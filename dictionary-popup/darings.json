            "meaning": [
                {
                    "en": "Audacious bravery; boldness.",
                    "vi": "Bản lĩnh thính giác; tính táo bạo."
                },
                {
                    "en": "Boldness.",
                    "vi": "Sự táo bạo."
                },
                {
                    "en": "Bold courage.",
                    "vi": "Dũng cảm táo bạo."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Willing to take or seek out risks; bold and venturesome.",
                    "vi": "Sẵn sàng chấp nhận hoặc tìm kiếm rủi ro; táo bạo và mạo hiểm."
                },
                {
                    "en": "Having, showing, or requiring a bold willingness to take risks or violate conventions; fearless.",
                    "vi": "Có, thể hiện hoặc đòi hỏi sự sẵn sàng mạnh dạn chấp nhận rủi ro hoặc vi phạm các quy ước; Không sợ hãi."
                },
                {
                    "en": "The definition of daring is brave, risk-taking, willingness to take risks, or to be bold.",
                    "vi": "Định nghĩa của sự táo bạo là dũng cảm, chấp nhận rủi ro, sẵn sàng chấp nhận rủi ro, hoặc táo bạo."
                },
                {
                    "en": "Adventurous, willing to take on or look for risks.",
                    "vi": "Mạo hiểm, sẵn sàng chấp nhận hoặc tìm kiếm rủi ro."
                },
                {
                    "en": "Courageous, or showing bravery.",
                    "vi": "Dũng cảm, hay thể hiện sự dũng cảm."
                },
                {
                    "en": "Involving great risk or danger.",
                    "vi": "Có rủi ro hoặc nguy hiểm lớn."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of dare.",
                    "vi": "Hiện tại phân từ của dám."
