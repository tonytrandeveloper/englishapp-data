    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Characterized by an overabundance of blood.",
                    "vi": "Đặc trưng bởi lượng máu dồi dào."
                },
                {
                    "en": "Excessive in quantity; superabundant.",
                    "vi": "Quá nhiều về số lượng; dư thừa."
                },
                {
                    "en": "Excessive in style; turgid.",
                    "vi": "Quá kiểu cách; cương lên."
                },
                {
                    "en": "Of or characterized by plethora.",
                    "vi": "Của hoặc đặc trưng bởi rất nhiều."
                },
                {
                    "en": "Characterized by excess or profusion; turgid; inflated.",
                    "vi": "Được đặc trưng bởi sự dư thừa hoặc thâm thúy; cương lên; thổi phồng."
                },
                {
                    "en": "Characterized by an overabundance of blood.",
                    "vi": "Đặc trưng bởi lượng máu dồi dào."
                },
                {
                    "en": "(medicine) Suffering from plethora; ruddy in complexion, congested or swollen with blood. [from 14th c.]",
                    "vi": "(y học) Bị viêm màng phổi; da hồng hào, xung huyết hoặc sưng huyết. [từ ngày 14 c.]"
                },
                {
                    "en": "Excessive, overabundant, rife; loosely, abundant, varied. [from 17th c.]",
                    "vi": "Quá mức, dư thừa, đầy rẫy; lỏng lẻo, phong phú, đa dạng. [từ ngày 17 c.]"
                }
            ]
        }
    ],
    "meaning_vi": [
