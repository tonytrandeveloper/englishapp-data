    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The condition of being dissatisfied or displeased; discontent.",
                    "vi": "Tình trạng không hài lòng hoặc không hài lòng; bất mãn."
                },
                {
                    "en": "Anything that dissatisfies.",
                    "vi": "Bất cứ điều gì không hài lòng."
                },
                {
                    "en": "The condition or feeling of being displeased or unsatisfied; discontent.",
                    "vi": "Tình trạng hoặc cảm giác không hài lòng hoặc không hài lòng; bất mãn."
                },
                {
                    "en": "A cause of discontent.",
                    "vi": "Một nguyên nhân của sự bất mãn."
                },
                {
                    "en": "Unhappiness or discontent.",
                    "vi": "Bất hạnh hoặc bất mãn."
                },
                {
                    "en": "The cause of such feelings.",
                    "vi": "Nguyên nhân của những cảm giác như vậy."
                },
                {
                    "en": "Dissatisfaction is defined as the state of being unhappy, or the thing causing the unhappiness.",
                    "vi": "Không hài lòng được định nghĩa là trạng thái không hài lòng, hoặc điều gây ra bất hạnh."
                }
            ]
        }
    ],
