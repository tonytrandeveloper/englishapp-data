    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To go in haste. Often used with it .",
                    "vi": "Đi vội vàng. Thường được sử dụng với nó."
                },
                {
                    "en": "(informal) To hurry; hasten.",
                    "vi": "(không chính thức) Để vội vàng; vội vàng."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "In haste.",
                    "vi": "Vội vàng."
                },
                {
                    "en": "(informal) In great haste.",
                    "vi": "(thân mật) Rất vội vàng."
                },
                {
                    "en": "(UK) Hastily; without delay.",
                    "vi": "(Anh) Vội vàng; không chậm trễ."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The practical joke of lighting a match that has been secretly inserted between the sole and upper of a victim's shoe.",
                    "vi": "Trò đùa thực tế của việc châm một que diêm đã được bí mật nhét vào giữa đế và trên giày của nạn nhân."
                },
                {
                    "en": "The prank of secretly inserting a match between the sole and upper of a victim's shoe and then lighting it.",
                    "vi": "Trò chơi khăm bí mật nhét que diêm vào giữa đế và giày của nạn nhân rồi châm lửa."
                },
                {
                    "en": "(US) The prank of secretly inserting a match between the sole and upper of a victim's shoe and then lighting it.",
                    "vi": "(Mỹ) Trò chơi khăm bí mật nhét que diêm vào giữa đế và giày của nạn nhân rồi châm lửa."
                }
            ]
        },
        {
            "pos": "idiom",
            "meaning": [
                {
                    "en": "hotfoot it  to hurry",
                    "vi": "hotfoot nó đi nhanh lên"
                }
            ]
        }
    ],
