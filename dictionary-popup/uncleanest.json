                {
                    "en": "Foul or dirty.",
                    "vi": "Phạm lỗi hoặc bẩn thỉu."
                },
                {
                    "en": "Morally defiled.",
                    "vi": "Làm ô uế đạo đức."
                },
                {
                    "en": "Ceremonially impure.",
                    "vi": "Không tinh khiết về mặt nghi lễ."
                },
                {
                    "en": "Dirty; filthy; foul.",
                    "vi": "Bẩn thỉu; bẩn thỉu; Hôi."
                },
                {
                    "en": "Dirty, soiled or foul.",
                    "vi": "Bẩn, bẩn hoặc hôi."
                },
                {
                    "en": "Not moral or chaste.",
                    "vi": "Không đạo đức hay thuần khiết."
                },
                {
                    "en": "Ritually or ceremonially impure or unfit.",
                    "vi": "Không trong sạch hoặc không phù hợp về mặt nghi lễ hoặc nghi lễ."
                },
                {
                    "en": "Ceremonially impure.",
