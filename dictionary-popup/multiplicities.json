    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A large number.",
                    "vi": "Một số lượng lớn."
                },
                {
                    "en": "The state of being made of multiple diverse elements.",
                    "vi": "Trạng thái được tạo thành từ nhiều yếu tố đa dạng."
                },
                {
                    "en": "(mathematics) The number of values for which a given condition holds.",
                    "vi": "(toán học) Số lượng giá trị mà một điều kiện nhất định giữ."
                },
                {
                    "en": "A large indeterminate number.",
                    "vi": "Một số lớn không xác định."
                },
                {
                    "en": "(software engineering, UML) The number of instances that can occur on a given end of a relationship, including 0..1, 1, 0..* or *, and 1..*.",
                    "vi": "(kỹ thuật phần mềm, UML) Số lượng trường hợp có thể xảy ra ở một đầu mối quan hệ nhất định, bao gồm 0..1, 1, 0 .. * hoặc *, và 1 .. *."
                },
                {
                    "en": "The state of being various or manifold.",
                    "vi": "Trạng thái đa dạng hoặc đa dạng."
                },
                {
                    "en": "The quality or condition of being manifold or various.",
                    "vi": "Chất lượng hoặc tình trạng của đa dạng hoặc khác nhau."
                },
                {
                    "en": "A great number.",
                    "vi": "Một con số tuyệt vời."
                }
            ]
        }
    ],
    "meaning_vi": [
        "vô số"
