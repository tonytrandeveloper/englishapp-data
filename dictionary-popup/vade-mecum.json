            "meaning": [
                {
                    "en": "A useful thing that one constantly carries about.",
                    "vi": "Một điều hữu ích mà người ta liên tục mang về."
                },
                {
                    "en": "A book, such as a guidebook, for ready reference.",
                    "vi": "Một cuốn sách, chẳng hạn như một cuốn sách hướng dẫn, để sẵn sàng tham khảo."
                },
                {
                    "en": "Something carried about by a person for constant use, reference, etc., as a handbook or manual.",
                    "vi": "Một thứ được một người mang theo để sử dụng liên tục, tham khảo, v.v., như một cuốn sổ tay hoặc sổ tay hướng dẫn."
                },
                {
                    "en": "Alternative capitalization of vade mecum.",
                    "vi": "Viết hoa thay thế của vade mecum."
                },
