        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The goddess of the sea.",
                    "vi": "Nữ thần của biển cả."
                },
                {
                    "en": "(nautical) Yarns coiled on a spun-yarn winch.",
                    "vi": "(hải lý) Sợi được cuộn trên tời kéo sợi."
                },
                {
                    "en": "(obsolete) Open robbery.",
                    "vi": "(lỗi thời) Cướp bóc."
                },
                {
                    "en": "Part or all of this entry has been imported from the 1913 edition of Webster's Dictionary, which is now free of copyright and hence in the public domain. The imported definitions may be significantly out of date, and any more recent senses may be completely missing.",
                    "vi": "Một phần hoặc toàn bộ mục này đã được nhập từ ấn bản năm 1913 của Từ điển Webster, hiện không có bản quyền và do đó thuộc phạm vi công cộng. Các định nghĩa đã nhập có thể đã lỗi thời đáng kể và bất kỳ giác quan nào gần đây hơn có thể bị thiếu hoàn toàn."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Run.",
                    "vi": "Chạy."
                },
                {
                    "en": "Ran is defined as to have moved by quickly moving the legs, or to have gone on a quick trip, or to have been in charge of something.",
                    "vi": "Ran được định nghĩa là đã di chuyển bằng cách di chuyển nhanh chân, hoặc đi nhanh, hoặc phụ trách một việc gì đó."
                },
                {
                    "en": "Simple past tense of run.",
                    "vi": "Thì quá khứ đơn của run."
                }
            ]
        }
    ],
