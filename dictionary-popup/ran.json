    "sentences": [
        {
            "en": "The next few days ran together.",
            "vi": "Những ngày tiếp theo cùng nhau chạy."
        },
        {
            "en": "I slipped from my mother's lap and almost ran toward them.",
            "vi": "Tôi trượt khỏi lòng mẹ và gần như chạy về phía họ."
        },
        {
            "en": "His searching gaze ran over her face again.",
            "vi": "Ánh mắt tìm kiếm của anh lại lướt qua khuôn mặt cô."
        },
        {
            "en": "I ran a marathon for that shirt!",
            "vi": "Tôi đã chạy marathon cho chiếc áo đó!"
        },
        {
            "en": "She ran her hand over the smooth clean surface of the baler.",
            "vi": "Cô lướt tay trên bề mặt sạch sẽ mịn màng của chiếc máy đóng kiện."
        },
        {
            "en": "The two boys saw him and ran to fetch his shoes.",
            "vi": "Hai cậu bé nhìn thấy anh ta và chạy đến lấy giày của anh ta."
        },
        {
            "en": "The young girl ran off without a word.",
            "vi": "Cô gái trẻ bỏ chạy mà không nói một lời."
        },
        {
            "en": "When next the door was opened you ran out and hid yourself--and the piglet was gone.",
            "vi": "Khi cánh cửa tiếp theo được mở ra, bạn chạy ra ngoài và ẩn mình - và con lợn con đã biến mất."
        },
        {
            "en": "He ran up to them.",
            "vi": "Anh chạy đến chỗ họ."
        },
        {
            "en": "Following Señor Medena up the stairs, she ran her hand along the smooth wood, enjoying the cool silky soft feel of it.",
            "vi": "Đi theo Señor Medena lên cầu thang, cô lướt tay dọc theo mặt gỗ mịn, tận hưởng cảm giác mềm mịn mát lạnh của nó."
        }
    ]
