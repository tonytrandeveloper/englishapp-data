    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The act of validating something.",
                    "vi": "Hành động xác nhận một cái gì đó."
                },
                {
                    "en": "Something, such as a certificate, that validates something; attestation, authentication, confirmation, proof or verification.",
                    "vi": "Một cái gì đó, chẳng hạn như một chứng chỉ, xác nhận một cái gì đó; chứng thực, xác thực, xác nhận, bằng chứng hoặc xác minh."
                },
                {
                    "en": "The process whereby others confirm the validity of one's emotions.",
                    "vi": "Quá trình theo đó những người khác xác nhận giá trị của cảm xúc của một người."
                }
            ]
        }
    ],
    "meaning_vi": [
