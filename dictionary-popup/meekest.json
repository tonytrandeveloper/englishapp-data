    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Patient and mild; not inclined to anger or resentment.",
                    "vi": "Kiên nhẫn và nhẹ nhàng; không có khuynh hướng tức giận hoặc bất bình."
                },
                {
                    "en": "Showing patience and humility; gentle.",
                    "vi": "Thể hiện sự kiên nhẫn và khiêm tốn; dịu dàng."
                },
                {
                    "en": "(obs.) Gentle or kind.",
                    "vi": "(obs.) Nhẹ nhàng hoặc tốt bụng."
                },
                {
                    "en": "The definition of meek is someone or something that does not have force or someone who is willing to give into others.",
                    "vi": "Định nghĩa về nhu mì là một ai đó hoặc một cái gì đó không có lực lượng hoặc một người sẵn sàng cho người khác."
                },
                {
                    "en": "Easily imposed on; submissive.",
                    "vi": "Dễ dàng áp đặt; phục tùng."
                },
                {
                    "en": "Too submissive; easily imposed on; spineless; spiritless.",
                    "vi": "Quá phục tùng; dễ bị áp đặt; không có xương sống; không có tinh thần."
                },
                {
                    "en": "Submissive, dispirited.",
                    "vi": "Phục tùng, không công tâm."
                },
                {
                    "en": "Humble, modest, meager, or self-effacing.",
                    "vi": "Khiêm tốn, khiêm tốn, ít ỏi, hoặc tự cao tự đại."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(US) (of horses) To tame; to break.",
                    "vi": "(Mỹ) (ngựa) Để thuần hóa; để phá vỡ."
                }
            ]
        }
    ],
