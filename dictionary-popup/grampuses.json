                {
                    "en": "Any of various dolphins or other toothed whales, such as the orca.",
                    "vi": "Bất kỳ loài cá heo hoặc cá voi có răng nào khác, chẳng hạn như orca."
                },
                {
                    "en": "A playful, black-and-white dolphin (Grampus griseus)",
                    "vi": "Cá heo đen trắng vui tươi (Grampus griseus)"
                },
                {
                    "en": "Killer whale.",
                    "vi": "Cá voi sát thủ."
                },
                {
                    "en": "The killer whale, Orsinus orca.",
                    "vi": "Cá voi sát thủ, Orsinus orca."
                },
                {
                    "en": "Risso's dolphin, Grampus griseus, with a blunt nose.",
                    "vi": "Cá heo của Risso, Grampus griseus, với chiếc mũi cùn."
                },
                {
                    "en": "The hellbender salamander, Cryptobranchus alleganiensis.",
                    "vi": "Kỳ nhông địa ngục, Cryptobranchus alleganiensis."
                }
            ]
        },
        {
            "pos": "pronoun",
            "meaning": [
                {
                    "en": "A taxonomic genus within the family Delphinidae — a type of gray dolphin, Risso's dolphin.",
                    "vi": "Một chi phân loại trong họ Delphinidae - một loại cá heo xám, cá heo Risso."
