    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Gaudy and cheap in nature or appearance.",
                    "vi": "Xa hoa và rẻ tiền về bản chất hoặc ngoại hình."
                },
                {
                    "en": "Tawdry means gaudy or cheap, or it is mean or nasty.",
                    "vi": "Tawdry có nghĩa là lòe loẹt hoặc rẻ tiền, hoặc có nghĩa là xấu xa hoặc khó chịu."
                },
                {
                    "en": "Shameful or indecent.",
                    "vi": "Đáng xấu hổ hoặc không đứng đắn."
                },
                {
                    "en": "Cheap and showy; gaudy; sleazy.",
                    "vi": "Rẻ và sặc sỡ; xa hoa; nhếch nhác."
                },
                {
                    "en": "(of clothing, appearance, etc.) Cheap and gaudy; showy.",
                    "vi": "(quần áo, ngoại hình, v.v.) Rẻ tiền và lòe loẹt; sặc sỡ."
                },
                {
                    "en": "(of character, behavior, situations, etc.) Unseemly, base, shameful.",
                    "vi": "(về tính cách, hành vi, tình huống, v.v.) Không rõ ràng, cơ sở, đáng xấu hổ."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The definition of a tawdry is something cheap or gaudy.",
                    "vi": "Định nghĩa về đồ giả là một thứ gì đó rẻ tiền hoặc lòe loẹt."
                },
                {
                    "en": "Cheap and gaudy finery.",
                    "vi": "Đồ mỹ nghệ rẻ tiền và lòe loẹt."
                }
            ]
        }
    ],
