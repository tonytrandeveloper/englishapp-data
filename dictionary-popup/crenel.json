    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "An open space or notch between two merlons in a battlement or crenelated wall.",
                    "vi": "Một không gian mở hoặc rãnh giữa hai lính đánh thuê trong một chiến trường hoặc bức tường hình tháp."
                },
                {
                    "en": "A crenature.",
                    "vi": "Một dấu vết."
                },
                {
                    "en": "Any of the indentations or loopholes in the top of a battlement or wall; embrasure.",
                    "vi": "Bất kỳ vết lõm hoặc kẽ hở nào trên đỉnh của một chiến trường hoặc bức tường; sự ôm ấp."
                },
                {
                    "en": "The space between merlons in a crenelated battlement.",
                    "vi": "Không gian giữa các lính đánh thuê trong một chiến trường bị thiêu rụi."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To crenelate.",
                    "vi": "Để crenelate."
                }
            ]
