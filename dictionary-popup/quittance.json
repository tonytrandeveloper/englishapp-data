    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Payment of a debt or obligation.",
                    "vi": "Thanh toán một khoản nợ hoặc nghĩa vụ."
                },
                {
                    "en": "Release or discharge from debt or obligation.",
                    "vi": "Giải phóng hoặc giải phóng khỏi nợ hoặc nghĩa vụ."
                },
                {
                    "en": "A document or receipt certifying such release.",
                    "vi": "Một tài liệu hoặc biên nhận xác nhận việc phát hành đó."
                },
                {
                    "en": "Recompense; repayment; reprisal.",
                    "vi": "Tính lại; sự trả nợ; trả thù."
                },
                {
                    "en": "Discharge from a debt or obligation.",
                    "vi": "Thoát khỏi một khoản nợ hoặc nghĩa vụ."
                },
                {
                    "en": "A document certifying this; receipt.",
                    "vi": "Một tài liệu chứng nhận điều này; biên nhận."
                },
                {
                    "en": "A release or acquittal.",
                    "vi": "Trả tự do hoặc tha bổng."
                },
                {
                    "en": "A discharge from a debt or obligation; a document that shows this discharge.",
                    "vi": "Giải phóng khỏi một khoản nợ hoặc nghĩa vụ; một tài liệu cho thấy sự phóng điện này."
                }
            ]
        }
    ],
    "meaning_vi": [
