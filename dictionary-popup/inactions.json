            "meaning": [
                {
                    "en": "Want of action or activity; forbearance from labor; idleness; rest; inertness.",
                    "vi": "Muốn hành động hoặc hoạt động; nhẫn nhịn lao động; sự nhàn rỗi; nghỉ ngơi; tính trơ."
                },
                {
                    "en": "Lack or absence of action.",
                    "vi": "Thiếu hoặc không có hành động."
                },
                {
                    "en": "Absence of action or motion; inertness or idleness.",
                    "vi": "Sự vắng mặt của hành động hoặc chuyển động; tính trơ hay sự nhàn rỗi."
                }
            ]
