        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Excessively suave or ingratiating.",
                    "vi": "Quá yêu hoặc ăn quá mức."
                },
                {
                    "en": "Of or relating to oil.",
                    "vi": "Của hoặc liên quan đến dầu."
                },
                {
                    "en": "Impregnated, smeared with, or containing oil; greasy.",
                    "vi": "Đã ngâm tẩm, bôi hoặc có chứa dầu; bóng nhờn."
                },
                {
                    "en": "Of, like, consisting of, or containing oil.",
                    "vi": "Của, như, bao gồm, hoặc chứa dầu."
                },
                {
                    "en": "Covered with oil; fat; greasy.",
                    "vi": "Được bao phủ bởi dầu; mập mạp; bóng nhờn."
                },
                {
                    "en": "Too smooth; slippery; unctuous.",
                    "vi": "Quá trơn; trơn; không cần thiết."
                },
                {
                    "en": "Relating to oil.",
                    "vi": "Liên quan đến dầu."
                },
                {
                    "en": "Smeared with or containing oil.",
                    "vi": "Được xử lý bằng hoặc có chứa dầu."
                },
                {
                    "en": "(figuratively) Excessively friendly or polite so as to sound insincere.",
                    "vi": "(nghĩa bóng) Thân thiện hoặc lịch sự quá mức để nghe có vẻ thiếu chân thành."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A marble with an oily lustre.",
                    "vi": "Đá hoa cương có bóng nhờn."
                }
            ]
