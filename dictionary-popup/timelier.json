    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Occurring at a suitable or opportune time; well-timed.",
                    "vi": "Xảy ra vào một thời điểm thích hợp hoặc thời cơ; đúng lúc."
                },
                {
                    "en": "(now rare) Appearing in good time; early.",
                    "vi": "(bây giờ hiếm) Xuất hiện trong thời gian tốt; sớm."
                },
                {
                    "en": "The definition of timely refers to something done at a good and suitable time.",
                    "vi": "Định nghĩa của kịp thời đề cập đến một cái gì đó được thực hiện vào một thời điểm tốt và phù hợp."
                },
                {
                    "en": "Done at the proper time.",
                    "vi": "Thực hiện vào thời điểm thích hợp."
                },
                {
                    "en": "Happening or appearing at the proper time.",
                    "vi": "Đang xảy ra hoặc xuất hiện vào thời điểm thích hợp."
                },
                {
                    "en": "Happening, done, said, etc. at a suitable time; well-timed; opportune.",
                    "vi": "Xảy ra, đã làm, đã nói, v.v. vào một thời điểm thích hợp; đúng giờ; cơ hội."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "In time; opportunely.",
                    "vi": "Đúng giờ; một cách cơ hội."
                },
                {
                    "en": "(archaic) Early; soon.",
                    "vi": "(cổ xưa) Sớm; Sớm."
                },
                {
                    "en": "At the right time; opportunely.",
                    "vi": "Vào đúng thời điểm; một cách cơ hội."
                },
                {
                    "en": "(archaic) In good time; early, quickly.",
                    "vi": "(cổ xưa) Trong thời gian tốt đẹp; sớm, nhanh chóng."
                }
            ]
        }
    ],
