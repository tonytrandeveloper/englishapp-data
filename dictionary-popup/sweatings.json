            "pos": "noun",
            "meaning": [
                {
                    "en": "The production and evaporation of a watery fluid called sweat that is excreted by the sweat glands in the skin of mammals.",
                    "vi": "Sự sản sinh và bay hơi của một chất lỏng gọi là mồ hôi được bài tiết bởi các tuyến mồ hôi trên da của động vật có vú."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of sweat.",
                    "vi": "Hiện tại phân từ mồ hôi."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or relating to one who is sweating.",
                    "vi": "Của hoặc liên quan đến một người đang đổ mồ hôi."
                }
            ]
        }
