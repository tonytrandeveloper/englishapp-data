        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The definition of habiliment is clothing.",
                    "vi": "Định nghĩa của habiliment là quần áo."
                },
                {
                    "en": "Clothing, especially the clothing associated with a special occasion or office.",
                    "vi": "Quần áo, đặc biệt là quần áo gắn liền với một dịp đặc biệt hoặc văn phòng."
                },
                {
                    "en": "Clothing; dress; attire.",
                    "vi": "Quần áo; đầm; trang phục."
                },
                {
                    "en": "Furnishings or equipment; trappings.",
                    "vi": "Đồ đạc hoặc thiết bị; bẫy."
                },
                {
                    "en": "Clothes, especially clothing appropriate for someone's job, status, or to an occasion.",
                    "vi": "Quần áo, đặc biệt là quần áo phù hợp với công việc, địa vị của ai đó hoặc cho một dịp nào đó."
                },
                {
                    "en": "Equipment or furnishings characteristic of a place or being; trappings.",
                    "vi": "Thiết bị hoặc đồ đạc đặc trưng của một địa điểm hoặc hiện hữu; bẫy."
                }
            ]
        }
    ],
