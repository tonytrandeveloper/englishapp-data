    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Dim; blurred; clouded.",
                    "vi": "Lờ mờ; bị mờ; có mây."
                },
                {
                    "en": "Confused; perplexed.",
                    "vi": "Bối rối; bối rối."
                },
                {
                    "en": "Clouded or blurred by or as if by fog; vague.",
                    "vi": "Có mây hoặc bị mờ bởi hoặc như thể bởi sương mù; mơ hồ."
                },
                {
                    "en": "Full of or surrounded by fog.",
                    "vi": "Đầy hoặc bao quanh bởi sương mù."
                },
                {
                    "en": "Resembling or suggestive of fog.",
                    "vi": "Có vẻ giống hoặc gợi ý về sương mù."
                },
                {
                    "en": "Obscured by mist or fog; unclear; hazy.",
                    "vi": "Bị sương mù hoặc sương mù che khuất; không rõ; mơ hồ."
                },
                {
                    "en": "(figuratively) Confused, befuddled, etc.",
                    "vi": "(nghĩa bóng) Bối rối, bối rối, v.v."
                },
                {
                    "en": "Full of fog; misty; murky.",
                    "vi": "Đầy sương mù; mù sương; âm u."
                }
            ]
        }
    ],
