    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having or showing great pride in oneself and disdain, contempt, or scorn for others; proud; arrogant; supercilious.",
                    "vi": "Có hoặc tỏ ra rất tự hào về bản thân và coi thường, khinh thường hoặc khinh bỉ người khác; hãnh diện; kiêu ngạo; siêu hiền lành."
                },
                {
                    "en": "Scornfully and condescendingly proud.",
                    "vi": "Tự hào một cách khinh bỉ và trịch thượng."
                },
                {
                    "en": "(archaic) Lofty; noble.",
                    "vi": "(cổ xưa) Cao cả; cao quý."
                },
                {
                    "en": "The definition of haughty is an arrogant person.",
                    "vi": "Định nghĩa của kiêu kỳ là một người kiêu ngạo."
                },
                {
                    "en": "Conveying in demeanour the assumption of superiority; disdainful, supercilious.",
                    "vi": "Truyền đạt trong phong thái giả định về sự vượt trội; khinh người, cao siêu."
                }
            ]
        }
    ],
    "meaning_vi": [
        "kiêu kỳ, kiêu căng, ngạo mạn"
    ],
