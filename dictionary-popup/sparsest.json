    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Thinly spread or distributed; not dense or crowded.",
                    "vi": "Rải mỏng hoặc phân bố; không dày đặc hay đông đúc."
                },
                {
                    "en": "Occurring, growing, or settled at widely spaced intervals; not thick or dense.",
                    "vi": "Xảy ra, lớn lên hoặc định cư ở những khoảng thời gian cách nhau rộng rãi; không dày hoặc đặc."
                },
                {
                    "en": "The definition of sparse is a thinly spread or meager amount or supply.",
                    "vi": "Định nghĩa của thưa thớt là một số lượng hoặc nguồn cung cấp được dàn trải mỏng hoặc ít ỏi."
                },
                {
                    "en": "Not dense; meager.",
                    "vi": "Không dày đặc; ít ỏi."
                },
                {
                    "en": "Having widely spaced intervals.",
                    "vi": "Có các khoảng cách nhau rộng rãi."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(obsolete) To scatter; to disperse.",
                    "vi": "(lỗi thời) Để phân tán; để phân tán."
                }
            ]
        }
    ],
