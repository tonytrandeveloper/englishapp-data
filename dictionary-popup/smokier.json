    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Emitting smoke in profuse volume.",
                    "vi": "Phát ra khói với khối lượng lớn."
                },
                {
                    "en": "Mixed or filled with smoke.",
                    "vi": "Hỗn hợp hoặc chứa đầy khói."
                },
                {
                    "en": "Resembling smoke.",
                    "vi": "Có vẻ như khói."
                },
                {
                    "en": "Discolored or soiled with or as if with smoke.",
                    "vi": "Đã đổi màu hoặc bị bẩn hoặc như có khói."
                },
                {
                    "en": "Tasting of smoke.",
                    "vi": "Nếm khói."
                },
                {
                    "en": "Giving off smoke, esp. excessive smoke.",
                    "vi": "Đang tỏa khói, đặc biệt. khói quá nhiều."
                },
                {
                    "en": "Like, of, or as of smoke.",
                    "vi": "Giống như, của, hoặc như khói."
                },
                {
                    "en": "Filled with smoke.",
                    "vi": "Đầy khói."
                },
                {
                    "en": "Having the color of smoke.",
                    "vi": "Có màu khói."
                },
                {
                    "en": "Having a flavor suggestive of smoke or smoked food.",
                    "vi": "Có hương vị gợi liên tưởng đến khói hoặc thực phẩm hun khói."
                },
                {
                    "en": "Darkened or soiled by smoke.",
                    "vi": "Sậm màu hoặc bị vấy bẩn bởi khói."
                },
                {
                    "en": "Filled with or giving off smoke.",
                    "vi": "Đầy hoặc tỏa ra khói."
                },
                {
                    "en": "Of a colour or colour pattern similar to that of smoke.",
                    "vi": "Có màu hoặc kiểu màu tương tự như màu khói."
                },
                {
                    "en": "Having flavour like smoke.",
                    "vi": "Có hương vị như khói."
                },
                {
                    "en": "(music, informal) Having a dark, thick, bass sound.",
                    "vi": "(âm nhạc, trang trọng) Có âm trầm tối, dày."
                }
            ]
        }
