            "meaning": [
                {
                    "en": "(slang) A contemptible or foolish person; jerk.",
                    "vi": "(tiếng lóng) Một người khinh thường hoặc ngu ngốc; cà trớn."
                },
                {
                    "en": "A clumsy or stupid person; an oaf.",
                    "vi": "Một người vụng về hoặc ngu ngốc; một oaf."
                },
                {
                    "en": "(pejorative, US) A jerk; an unpleasant or detestable person.",
                    "vi": "(pejorative, US) Một kẻ ngu ngốc; một người khó chịu hoặc đáng ghét."
                },
                {
                    "en": "(pejorative) An item or person that is considered useless.",
                    "vi": "(làm phiền lòng) Một đồ vật hoặc một người được coi là vô dụng."
                },
                {
                    "en": "Schmuck is a Yiddish word for a jerk or for a foolish or contemptible person.",
                    "vi": "Schmuck là một từ trong tiếng Yiddish để chỉ một kẻ ngốc nghếch hoặc cho một người ngu ngốc hoặc khinh thường."
                },
                {
                    "en": "(vulgar) The penis.",
                    "vi": "(thô tục) Dương vật."
                }
            ]
        }
