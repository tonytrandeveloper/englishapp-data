        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Belonging to the third string of a team; one who plays behind the first and second strings.",
                    "vi": "Thuộc dây đồng đội thứ ba; một người chơi phía sau dây đầu tiên và thứ hai."
                },
                {
                    "en": "A substitute or replacement.",
                    "vi": "Một thay thế hoặc thay thế."
                },
                {
                    "en": "(idiomatic) Of a decidedly lower quality or condition.",
                    "vi": "(thành ngữ) Có chất lượng hoặc điều kiện thấp hơn một cách rõ ràng."
                },
                {
                    "en": "(sports) A unit of players that plays behind the first and second strings; a junior varsity team.",
                    "vi": "(thể thao) Một đơn vị của người chơi chơi sau dây thứ nhất và thứ hai; một đội varsity cơ sở."
                }
            ]
        }
