            "meaning": [
                {
                    "en": "Out of work, especially involuntarily; jobless.",
                    "vi": "Không làm việc, đặc biệt là không tự nguyện; thất nghiệp."
                },
                {
                    "en": "Not employed; without work.",
                    "vi": "Không được tuyển dụng; không làm việc."
                },
                {
                    "en": "Not being used; idle.",
                    "vi": "Không được sử dụng; nhàn rỗi."
                },
                {
                    "en": "Not being used; idle.",
                    "vi": "Không được sử dụng; nhàn rỗi."
                },
                {
                    "en": "Having no profession (despite being able and willing to work).",
                    "vi": "Không có chuyên môn (mặc dù có khả năng và mong muốn làm việc)."
                },
                {
                    "en": "Having no use, not doing work.",
                    "vi": "Không có tác dụng, không có tác dụng."
                }
            ]
        },
        {
