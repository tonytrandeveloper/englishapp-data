            "meaning": [
                {
                    "en": "(countable) An unpleasant or disagreeable action, taste or smell.",
                    "vi": "(có thể đếm được) Một hành động, mùi vị hoặc mùi khó chịu hoặc bất đồng."
                },
                {
                    "en": "(uncountable) A lack of cleanliness.",
                    "vi": "(không đếm được) Sự thiếu sạch sẽ."
                },
                {
                    "en": "(US, uncountable) Dirt or filth.",
                    "vi": "(Hoa Kỳ, không đếm được) Bụi bẩn hoặc rác rưởi."
                },
                {
                    "en": "(uncountable) Indecency or corruption.",
                    "vi": "(không đếm được) Sự khiếm nhã hoặc tham nhũng."
                }
            ]
