    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Someone or something that yawns.",
                    "vi": "Ai đó hoặc cái gì đó ngáp."
                },
                {
                    "en": "(informal) A dull or boring performance, event, etc.",
                    "vi": "(không chính thức) Một buổi biểu diễn, sự kiện buồn tẻ hoặc buồn tẻ, v.v."
                },
                {
                    "en": "A person who yawns.",
                    "vi": "Một người ngáp."
                },
                {
                    "en": "(figuratively) Something unexciting or boring that induces yawning, as a book, sporting event, or performance.",
                    "vi": "(nghĩa bóng) Một thứ gì đó không thú vị hoặc nhàm chán khiến bạn ngáp, như một cuốn sách, sự kiện thể thao hoặc buổi biểu diễn."
                }
            ]
        }
    ],
