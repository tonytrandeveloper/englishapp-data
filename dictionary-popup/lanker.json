    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Long, straight, and limp.",
                    "vi": "Dài, thẳng và khập khiễng."
                },
                {
                    "en": "Hanging straight and limp; not curly.",
                    "vi": "Treo thẳng và khập khiễng; không xoăn."
                },
                {
                    "en": "Slender or lean.",
                    "vi": "Mảnh mai hoặc gầy."
                },
                {
                    "en": "Gaunt or meager.",
                    "vi": "Gaunt hoặc ít ỏi."
                },
                {
                    "en": "Slender or thin; not well filled out; not plump; shrunken; lean.",
                    "vi": "Mảnh mai hoặc mỏng; điền không tốt; không đầy đặn; teo lại; dựa vào."
                },
                {
                    "en": "(of hair) Straight and flat; thin and limp. (often associated with being greasy)",
                    "vi": "(của tóc) Thẳng và phẳng; gầy và khập khiễng. (thường liên quan đến việc bị nhờn)"
                },
                {
                    "en": "Long and lean.",
                    "vi": "Dài và nạc."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "(rare) To become lank; to make lank.",
                    "vi": "(hiếm) Trở nên cao lêu nghêu; để làm cho lank."
                }
            ]
        }
    ],
    "meaning_vi": [
        "gầy, gầy gò; gầy và cao",
        "thẳng và rũ xuống (tóc)"
