            "meaning": [
                {
                    "en": "The quality or state of being one; singleness or wholeness.",
                    "vi": "Chất lượng hoặc trạng thái của một; tính đơn nhất hoặc toàn bộ."
                },
                {
                    "en": "Singularity; uniqueness.",
                    "vi": "Điểm kỳ dị; tính độc đáo."
                },
                {
                    "en": "A state or condition of perfect harmony or accord.",
                    "vi": "Một trạng thái hoặc điều kiện của sự hòa hợp hoặc phù hợp hoàn hảo."
                },
                {
                    "en": "Sameness of character.",
                    "vi": "Tính cách giống nhau."
                },
                {
                    "en": "Unison; agreement.",
                    "vi": "Đoàn kết; Hiệp định."
                },
                {
                    "en": "Singleness; unity.",
                    "vi": "Tính đơn lẻ; đoàn kết."
                },
                {
                    "en": "Unity of mind, feeling, or purpose.",
                    "vi": "Sự thống nhất của tâm trí, cảm giác hoặc mục đích."
                },
                {
                    "en": "Sameness; identity.",
                    "vi": "Giống nhau; xác thực."
                },
                {
                    "en": "(uncountable) State of being one or undivided; unity.",
                    "vi": "(không đếm được) Trạng thái là một hoặc không phân chia; đoàn kết."
                },
                {
                    "en": "(countable) The product of being one or undivided.",
                    "vi": "(đếm được) Sản phẩm là một hoặc không phân chia."
                }
            ]
        }
