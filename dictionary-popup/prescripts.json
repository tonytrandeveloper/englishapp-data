                    "vi": "Một cái gì đó được quy định, đặc biệt là một quy tắc hoặc quy định về hành vi."
                },
                {
                    "en": "Something prescribed; direction; rule.",
                    "vi": "Một cái gì đó được quy định; phương hướng; qui định."
                },
                {
                    "en": "Something prescribed; a rule, regulation or dictate.",
                    "vi": "Một cái gì đó được quy định; một quy tắc, quy định hoặc mệnh lệnh."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having been established as a rule; prescribed.",
                    "vi": "Đã được thành lập như một quy tắc; quy định."
                },
                {
                    "en": "That is prescribed.",
                    "vi": "Đó là quy định."
                },
                {
