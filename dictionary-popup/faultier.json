    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having a fault or faults; defective, blemished, imperfect, or erroneous.",
                    "vi": "Có lỗi hoặc lỗi; bị lỗi, bị tì vết, không hoàn hảo hoặc có sai sót."
                },
                {
                    "en": "The definition of faulty is something unreliable or that doesn't work, or an incorrect thought pattern.",
                    "vi": "Định nghĩa của lỗi là một cái gì đó không đáng tin cậy hoặc không hoạt động, hoặc một mô hình suy nghĩ không chính xác."
                },
                {
                    "en": "Containing a fault or defect; imperfect or defective.",
                    "vi": "Có lỗi hoặc khiếm khuyết; không hoàn hảo hoặc khiếm khuyết."
                },
                {
                    "en": "(obsolete) Deserving of blame; guilty.",
                    "vi": "(lỗi thời) Đáng trách; có tội."
                },
                {
                    "en": "Having or displaying faults; not perfect; not adequate or acceptable.",
                    "vi": "Có hoặc hiển thị lỗi; không hoàn hảo; không đầy đủ hoặc có thể chấp nhận được."
                }
            ]
        }
    ],
    "meaning_vi": [
        "có thiếu sót, mắc khuyết điểm",
        "mắc lỗi",
        "không tốt, không chính xác",
        "(điện học) bị rò (mạch)"
