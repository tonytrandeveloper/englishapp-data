    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of, characteristic of, like, or befitting a knight; chivalrous, brave, etc.",
                    "vi": "Đặc điểm của, giống, hoặc phù hợp với một hiệp sĩ; hào hiệp, dũng cảm, v.v."
                },
                {
                    "en": "Consisting of knights.",
                    "vi": "Bao gồm các hiệp sĩ."
                },
                {
                    "en": "Of or pertaining to a knight or knights.",
                    "vi": "Của hoặc liên quan đến một hiệp sĩ hoặc các hiệp sĩ."
                },
                {
                    "en": "Befitting a knight; formally courteous (as a knight); chivalrous, gallant and courtly.",
                    "vi": "Phù hợp với một hiệp sĩ; lịch sự lịch sự (như một hiệp sĩ); hào hiệp, hào hiệp và lịch sự."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "(archaic) In a knightly manner.",
                    "vi": "(cổ xưa) Theo phong cách hiệp sĩ."
                },
                {
                    "en": "In the manner of a knight; chivalrously.",
                    "vi": "Với tư cách của một hiệp sĩ; hào hiệp."
                }
            ]
        }
    ],
