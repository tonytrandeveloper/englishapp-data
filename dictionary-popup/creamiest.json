    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Rich in or resembling cream.",
                    "vi": "Giàu hoặc giống kem."
                },
                {
                    "en": "Having the colour of cream.",
                    "vi": "Có màu của kem."
                },
                {
                    "en": "Like cream in consistency; oily, smooth, etc.",
                    "vi": "Giống như kem ở độ nhất quán; nhờn, mịn, v.v."
                },
                {
                    "en": "Of the color of cream; yellowish-white.",
                    "vi": "Màu của kem; trắng vàng."
                },
                {
                    "en": "Containing cream.",
                    "vi": "Kem có chứa."
                },
                {
                    "en": "Of food or drink, having the rich taste or thick, smooth texture of cream, whether or not it actually contains cream.",
                    "vi": "Thực phẩm hoặc đồ uống, có hương vị đậm đà hoặc kết cấu đặc, mịn của kem, cho dù nó có thực sự chứa kem hay không."
                },
                {
                    "en": "Of any liquid, having the thick texture of cream.",
                    "vi": "Chất lỏng, có kết cấu kem đặc."
                },
                {
                    "en": "Full of cream.",
                    "vi": "Toàn kem."
                }
            ]
        }
    ],
