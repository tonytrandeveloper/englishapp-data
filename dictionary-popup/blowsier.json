                },
                {
                    "en": "Fat, ruddy, and coarse-looking.",
                    "vi": "Béo, hồng hào và trông thô kệch."
                },
                {
                    "en": "Coarse and buxom.",
                    "vi": "Thô và buxom."
                },
                {
                    "en": "Having a reddish, coarse complexion, especially with a pudgy face.",
                    "vi": "Có nước da hơi đỏ, thô ráp, đặc biệt là khuôn mặt mập mạp."
                },
                {
                    "en": "(chiefly of a woman) Slovenly or unkempt, in the manner of a beggar or slattern.",
                    "vi": "(chủ yếu là phụ nữ) Lười biếng hoặc nhếch nhác, theo kiểu ăn mày hoặc ăn mày."
                },
                {
                    "en": "Unrefined, countrified.",
                    "vi": "Chưa được tinh chế, đã được kiểm chứng."
                }
            ]
