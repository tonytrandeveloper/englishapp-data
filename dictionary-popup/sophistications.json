            "meaning": [
                {
                    "en": "The act or process of sophisticating.",
                    "vi": "Hành động hoặc quá trình ngụy tạo."
                },
                {
                    "en": "Deceptive logic; sophistry.",
                    "vi": "Logic đánh lừa; ngụy biện."
                },
                {
                    "en": "Sophistication is defined as having character and tastes based on intelligence and worldly experience, or a quality of refinement.",
                    "vi": "Sự tinh tế được định nghĩa là có tính cách và thị hiếu dựa trên trí thông minh và kinh nghiệm thế giới, hoặc phẩm chất của sự sàng lọc."
                },
                {
                    "en": "The state, quality, or character of being sophisticated.",
                    "vi": "Trạng thái, chất lượng hoặc đặc tính của sự tinh vi."
                },
                {
                    "en": "Enlightenment or education.",
                    "vi": "Khai sáng hoặc giáo dục."
                },
                {
                    "en": "Cultivated intellectual worldliness; savoir-faire.",
                    "vi": "Trí tuệ được trau dồi thế giới; savoir-faire."
                },
                {
                    "en": "Falsification or contamination.",
                    "vi": "Làm sai lệch hoặc nhiễm bẩn."
                },
                {
                    "en": "Complexity.",
                    "vi": "Sự phức tạp."
                },
                {
                    "en": "(archaic) The act of sophisticating; adulteration.",
                    "vi": "(cổ xưa) Hành động ngụy tạo; sự tạp nhiễm."
                },
                {
                    "en": "(archaic) The use of sophistry.",
                    "vi": "(cổ xưa) Việc sử dụng phép ngụy biện."
                }
            ]
        }
