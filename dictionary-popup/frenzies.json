    "phonetics": {
        "uk": "ˈfrɛnziz",
        "us": "ˈfrɛnziz"
    },
    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Wild or frantic outburst of feeling or action.",
                    "vi": "Cảm giác hoặc hành động bộc phát hoang dã hoặc điên cuồng."
                },
                {
                    "en": "A violent agitation of the mind approaching madness; rage.",
                    "vi": "Một sự kích động dữ dội của tâm trí đến gần sự điên loạn; cơn thịnh nộ."
                },
                {
                    "en": "A state of violent mental agitation or wild excitement.",
                    "vi": "Trạng thái tinh thần bị kích động dữ dội hoặc hưng phấn hoang dã."
                },
                {
                    "en": "Temporary madness or delirium.",
                    "vi": "Cơn điên hoặc mê sảng tạm thời."
                },
                {
                    "en": "A mania; a craze.",
                    "vi": "Một cơn hưng cảm; cơn sốt."
                },
                {
                    "en": "A state of wild activity or panic.",
                    "vi": "Trạng thái hoạt động hoang dã hoặc hoảng loạn."
                },
                {
                    "en": "The definition of a frenzy is wild, chaotic or out-of-control behavior.",
                    "vi": "Định nghĩa về sự điên cuồng là hành vi hoang dã, hỗn loạn hoặc mất kiểm soát."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To make frantic; drive mad.",
                    "vi": "Để làm cho điên cuồng; Lái xe điên."
                },
                {
                    "en": "(uncommon) To render frantic.",
                    "vi": "(không phổ biến) Để làm cho điên cuồng."
                },
                {
                    "en": "To drive into a frenzy.",
                    "vi": "Để lái xe vào một cơn điên cuồng."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "(obsolete) Mad; frantic.",
                    "vi": "(lỗi thời) Điên rồ; điên cuồng."
                }
            ]
        }
    ],
    "meaning_vi": [
        "sự điên cuồng",
