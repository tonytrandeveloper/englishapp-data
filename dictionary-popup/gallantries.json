            "meaning": [
                {
                    "en": "Nobility of spirit or action; courage.",
                    "vi": "Quý tộc của tinh thần hoặc hành động; lòng can đảm."
                },
                {
                    "en": "Chivalrous attention toward women; courtliness.",
                    "vi": "Sự quan tâm hào hiệp đối với phụ nữ; lịch sự."
                },
                {
                    "en": "The act or an instance of gallant speech or behavior.",
                    "vi": "Hành động hoặc một ví dụ của lời nói hoặc hành vi hào hiệp."
                },
                {
                    "en": "(archaic) A bold or stylish appearance.",
                    "vi": "(cổ xưa) Vẻ ngoài táo bạo hoặc sành điệu."
                },
                {
                    "en": "Nobility of behavior or spirit; heroic courage.",
                    "vi": "Quý tộc về hành vi hoặc tinh thần; lòng dũng cảm anh hùng."
                },
                {
                    "en": "Gallantry is defined as nobility or courage.",
                    "vi": "Gallantry được định nghĩa là sự cao quý hoặc lòng dũng cảm."
                },
                {
                    "en": "The courtly manner of a gallant.",
                    "vi": "Phong thái lịch sự của một dũng sĩ."
                },
                {
                    "en": "An act or speech characteristic of a gallant.",
                    "vi": "Một hành động hoặc lời nói đặc trưng của một dũng sĩ."
                },
                {
                    "en": "Amorous intrigue.",
                    "vi": "Đa tình."
                },
                {
                    "en": "(archaic) Showy appearance.",
                    "vi": "(cổ xưa) Vẻ ngoài sặc sỡ."
                },
                {
                    "en": "Courage.",
                    "vi": "Lòng can đảm."
                },
                {
                    "en": "Chivalrous courtliness, especially towards women.",
                    "vi": "Tính lịch sự hào hiệp, đặc biệt là đối với phụ nữ."
                },
                {
                    "en": "An instance of gallant behaviour or speech.",
