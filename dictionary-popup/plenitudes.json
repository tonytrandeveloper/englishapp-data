            "meaning": [
                {
                    "en": "The condition of being full, ample, or complete.",
                    "vi": "Điều kiện đầy đủ, dư dả, hoặc đầy đủ."
                },
                {
                    "en": "Fullness; completeness.",
                    "vi": "Viên mãn; sự đầy đủ."
                },
                {
                    "en": "Abundance; plenty.",
                    "vi": "Sự dồi dào; nhiều."
                },
                {
                    "en": "An ample amount or quantity; an abundance.",
                    "vi": "Một số lượng hoặc số lượng phong phú; Một sự phong phú."
                },
                {
                    "en": "Fullness; completeness. [from 15th c.]",
                    "vi": "Viên mãn; sự đầy đủ. [từ ngày 15 c.]"
                },
                {
                    "en": "An abundance; a full supply. [from 17th c.]",
                    "vi": "Một sự phong phú; một nguồn cung cấp đầy đủ. [từ ngày 17 c.]"
                },
                {
                    "en": "(heraldry) Fullness (of the moon). [from 19th c.]",
                    "vi": "(huy hiệu) Sự đầy đặn (của mặt trăng). [từ ngày 19 c.]"
                }
            ]
        }
