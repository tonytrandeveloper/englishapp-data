    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To cause to fall from a horse.",
                    "vi": "Làm ngã ngựa."
                },
                {
                    "en": "To overthrow or dislodge; upset.",
                    "vi": "Để lật đổ hoặc lật đổ; khó chịu."
                },
                {
                    "en": "To throw (a rider) from a horse.",
                    "vi": "Để ném (một người cưỡi) từ một con ngựa."
                },
                {
                    "en": "To overthrow; upset.",
                    "vi": "Lật đổ; khó chịu."
                },
                {
                    "en": "To forcibly remove from a horse.",
                    "vi": "Để buộc phải loại bỏ khỏi một con ngựa."
                },
                {
                    "en": "(by extension) To disrupt or unseat; to remove from a position.",
                    "vi": "(theo phần mở rộng) Để làm gián đoạn hoặc mở rộng; để xóa khỏi một vị trí."
                }
            ]
        }
    ],
    "meaning_vi": [
