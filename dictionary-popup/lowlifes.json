    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A person of low social status or moral character.",
                    "vi": "Một người có địa vị xã hội hoặc tư cách đạo đức thấp."
                },
                {
                    "en": "A vulgar, coarse, or undignified person.",
                    "vi": "Một người thô tục, thô thiển hoặc vô lễ."
                },
                {
                    "en": "Lowlifes collectively or their milieu.",
                    "vi": "Lowlifes gọi chung hoặc milieu của họ."
                },
                {
                    "en": "An untrustworthy, despicable, or disreputable person, especially one suspected of being a criminal.",
                    "vi": "Một người không đáng tin cậy, đáng khinh bỉ hoặc đáng khinh bỉ, đặc biệt là một người bị nghi ngờ là tội phạm."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of or characteristic of a lowlife; low-class.",
                    "vi": "Của hoặc đặc trưng của một cuộc sống thấp; hạng thấp."
                }
            ]
        }
    ],
