    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "One that encourages.",
                    "vi": "Một điều đó khuyến khích."
                },
                {
                    "en": "The act of encouraging.",
                    "vi": "Hành động khích lệ."
                },
                {
                    "en": "The state of being encouraged.",
                    "vi": "Trạng thái được khuyến khích."
                },
                {
                    "en": "Something that encourages.",
                    "vi": "Một cái gì đó khuyến khích."
                },
                {
                    "en": "An encouraging or being encouraged.",
                    "vi": "Một sự khích lệ hoặc được khuyến khích."
                },
                {
                    "en": "Encouragement is defined as an expression of support or approval, or is words or actions that assist or inspire someone or something.",
                    "vi": "Khuyến khích được định nghĩa là một biểu hiện của sự ủng hộ hoặc tán thành, hoặc là lời nói hoặc hành động hỗ trợ hoặc truyền cảm hứng cho ai đó hoặc điều gì đó."
                },
                {
                    "en": "The act of encouraging; incitement to action or to practice; as, the encouragement of youth in generosity.",
                    "vi": "Hành động khuyến khích; xúi giục hành động hoặc thực hành; như, sự khuyến khích của tuổi trẻ trong sự hào phóng."
                },
                {
                    "en": "That which serves to incite, support, promote or advance, as favor, countenance, reward etc.; incentive; increase of confidence; as, the fine arts find little encouragement among a rude people.",
                    "vi": "Điều đó phục vụ để kích động, hỗ trợ, thăng chức hoặc thăng tiến, như sự ưu ái, sự ủng hộ, phần thưởng, v.v.; khuyến khích; tăng sự tự tin; như, nghệ thuật mỹ thuật ít tìm thấy sự khích lệ giữa những người thô lỗ."
                }
            ]
        }
    ],
    "meaning_vi": [
