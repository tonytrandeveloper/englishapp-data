    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Cold and cutting; harsh.",
                    "vi": "Lạnh và cắt; thô ráp."
                },
                {
                    "en": "Not cheerful; gloomy; dreary.",
                    "vi": "Không vui vẻ; ảm đạm; thê lương."
                },
                {
                    "en": "Cold and cutting; raw.",
                    "vi": "Lạnh và cắt; thô."
                },
                {
                    "en": "Not promising or hopeful.",
                    "vi": "Không hứa hẹn hay hy vọng."
                },
                {
                    "en": "Exposed to wind and cold; unsheltered; treeless; bare.",
                    "vi": "Tiếp xúc với gió và lạnh; cao ngất ngưởng; không có trem; để trần."
                },
                {
                    "en": "(obs.) Pale; wan.",
                    "vi": "(obs.) Nhạt; wan."
                },
                {
                    "en": "The definition of bleak is something that is gloomy, somber or exposed to wind and cold.",
                    "vi": "Định nghĩa của ảm đạm là một cái gì đó u ám, u ám hoặc tiếp xúc với gió và lạnh."
                },
                {
                    "en": "Exposed to the elements; unsheltered and barren.",
                    "vi": "Tiếp xúc với các yếu tố; trơ trọi và cằn cỗi."
                },
                {
                    "en": "Gloomy and somber.",
                    "vi": "Ảm đạm và u ám."
                },
                {
                    "en": "Providing no encouragement; depressing.",
                    "vi": "Không khuyến khích; chán nản."
                },
                {
                    "en": "Without color; pale; pallid.",
                    "vi": "Không có màu sắc; tái nhợt; xanh xao."
                },
                {
                    "en": "Desolate and exposed; swept by cold winds.",
                    "vi": "Hoang vắng và phơi bày; cuốn theo những cơn gió lạnh."
                },
                {
                    "en": "Unhappy; cheerless; miserable; emotionally desolate.",
                    "vi": "Không vui; vui vẻ; khổ sở; tình cảm hoang vắng."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Any of a genus (Alburnus) of small, slender European carp with silvery scales that are used in making artificial pearls.",
                    "vi": "Bất kỳ thuộc chi nào (Alburnus) của cá chép châu Âu nhỏ, mảnh mai với vảy màu bạc được sử dụng để làm ngọc trai nhân tạo."
                },
                {
                    "en": "Any of various small European freshwater fishes of the genus Alburnus, having silvery scales.",
                    "vi": "Bất kỳ loài cá nước ngọt nhỏ nào ở châu Âu thuộc giống Alburnus, có vảy màu bạc."
                },
                {
                    "en": "A small European river fish (Alburnus alburnus), of the family Cyprinidae.",
                    "vi": "Một loài cá sông nhỏ ở châu Âu (Alburnus alburnus), thuộc họ Cyprinidae."
                }
            ]
        }
    ],
