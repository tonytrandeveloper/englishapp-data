    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To lift forcefully from beneath; heave upward.",
                    "vi": "Để nâng một cách mạnh mẽ từ bên dưới; phập phồng lên trên."
                },
                {
                    "en": "To be lifted or thrust upward.",
                    "vi": "Để được nâng hoặc đẩy lên trên."
                },
                {
                    "en": "To heave or lift up.",
                    "vi": "Để phập phồng hoặc nâng lên."
                },
                {
                    "en": "To rise as if forced up.",
                    "vi": "Để vươn lên như thể bị ép buộc."
                },
                {
                    "en": "To heave or lift up; raise up or aloft.",
                    "vi": "Để nâng lên hoặc nâng lên; nâng lên cao hoặc trên cao."
                },
                {
                    "en": "To lift or thrust something upward forcefully, or be similarly lifted or thrust upward.",
                    "vi": "Để nâng hoặc đẩy một vật gì đó lên trên một cách mạnh mẽ, hoặc tương tự như vậy được nâng hoặc đẩy lên trên."
                },
                {
                    "en": "(intransitive) To be lifted up; rise.",
                    "vi": "(intransitive) Được nâng lên; trỗi dậy."
                }
            ]
        }
    ],
    "meaning_vi": [
        "dâng lên, nâng lên; dấy lên",
        "làm thay đổi đột ngột",
        "nổi lên, nổi dậy"
