        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having received no advice; not informed.",
                    "vi": "Không nhận được lời khuyên; không được thông báo."
                },
                {
                    "en": "Carried out without careful deliberation; imprudent.",
                    "vi": "Thực hiện mà không cần cân nhắc cẩn thận; không thận trọng."
                },
                {
                    "en": "Without counsel or advice.",
                    "vi": "Nếu không có lời khuyên hoặc lời khuyên."
                },
                {
                    "en": "Thoughtlessly hasty; indiscreet; rash.",
                    "vi": "Hấp tấp một cách thiếu suy nghĩ; vô kỷ luật; phát ban."
                },
                {
                    "en": "Not advised.",
                    "vi": "Không được khuyên."
                }
            ]
        }
    ],
