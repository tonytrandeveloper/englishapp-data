    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To cause something to fall by shaking it, or something it is attached down.",
                    "vi": "Làm rơi vật gì đó bằng cách lắc hoặc vật gì đó bị rơi xuống."
                },
                {
                    "en": "To shake someone so money falls from their pockets.",
                    "vi": "Để bắt ai đó để tiền rơi khỏi túi của họ."
                },
                {
                    "en": "(by extension) To get money from someone using threats.",
                    "vi": "(bằng cách mở rộng) Để lấy tiền từ một người nào đó sử dụng các mối đe dọa."
                },
                {
                    "en": "To search exhaustively.",
                    "vi": "Để tìm kiếm toàn diện."
                },
                {
                    "en": "To subject something to a shakedown test.",
                    "vi": "Đối tượng một cái gì đó để kiểm tra gỡ bỏ."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Alternative spelling of shakedown.",
                    "vi": "Cách viết khác của shakedown."
                }
            ]
        }
    ],
