    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Dirty; messy; untidy.",
                    "vi": "Bẩn thỉu; lộn xộn; không gọn gàng."
                },
                {
                    "en": "Dirty; grimy.",
                    "vi": "Bẩn thỉu; đen."
                },
                {
                    "en": "Infested with grubs, esp. with botfly larvae, as cattle or sheep.",
                    "vi": "Bị nhiễm grubs, đặc biệt. với ấu trùng botfly, như gia súc hoặc cừu."
                },
                {
                    "en": "Infested with grubs.",
                    "vi": "Bị nhiễm bẩn."
                },
                {
                    "en": "Contemptible; despicable.",
                    "vi": "Có thể coi thường; đáng khinh."
                },
                {
                    "en": "Inferior, contemptible, mean, etc.",
                    "vi": "Thấp kém, khinh thường, hèn hạ, v.v."
                },
                {
                    "en": "Dirty, unwashed, unclean.",
                    "vi": "Bẩn, chưa rửa, không sạch."
                },
                {
                    "en": "Having grubs in it.",
                    "vi": "Có grubs trong đó."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(US, dialect) Any species of Cottus; a sculpin.",
                    "vi": "(Mỹ, phương ngữ) Bất kỳ loài Cottus nào; một cái đinh ghim."
                }
            ]
        }
    ],
