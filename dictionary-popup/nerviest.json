                    "vi": "(chủ yếu là người Anh) Jumpy; thần kinh."
                },
                {
                    "en": "(archaic) Full of muscular force; sinewy.",
                    "vi": "(cổ xưa) Đầy lực lượng cơ bắp; gân guốc."
                },
                {
                    "en": "(rare) Strong; vigorous; sinewy.",
                    "vi": "(hiếm) Mạnh mẽ; mạnh mẽ; gân guốc."
                },
                {
                    "en": "(brit.) Nervous; excitable; jittery.",
                    "vi": "(giòn.) Thần kinh; dễ bị kích động; bồn chồn."
                },
                {
                    "en": "Full of courage; bold.",
                    "vi": "Đầy lòng dũng cảm; in đậm."
                },
                {
                    "en": "(informal) Rudely bold; brazen; impudent.",
                    "vi": "(không chính thức) Mạnh dạn một cách thô sơ; trơ trẽn; trơ tráo."
                },
                {
                    "en": "(US) Having nerve; bold; brazen.",
                    "vi": "(US) Có thần kinh; in đậm; trơ trẽn."
                },
                {
