        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A servant employed to do menial tasks in a kitchen.",
                    "vi": "Một người hầu được thuê để làm những công việc vặt vãnh trong nhà bếp."
                },
                {
                    "en": "(archaic) A servant who does the rough, dirty work in a kitchen.",
                    "vi": "(cổ xưa) Một người hầu làm công việc thô thiển, bẩn thỉu trong bếp."
                },
                {
                    "en": "A servant of the lower classes.",
                    "vi": "Một người hầu của các tầng lớp thấp hơn."
                },
                {
                    "en": "Alternative form of scallion.",
                    "vi": "Hình thức thay thế của hành lá."
                }
            ]
        }
    ],
