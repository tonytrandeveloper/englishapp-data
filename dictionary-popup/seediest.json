    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Feeling or looking physically bad or low in spirits.",
                    "vi": "Cảm thấy hoặc trông có vẻ tồi tệ về thể chất hoặc tinh thần xuống thấp."
                },
                {
                    "en": "The definition of seedy is something shabby, ailing or sordid, or something with many seeds.",
                    "vi": "Định nghĩa của hạt giống là một cái gì đó tồi tàn, ốm yếu hoặc hôi thối, hoặc một cái gì đó có nhiều hạt."
                },
                {
                    "en": "Resembling seeds or a seed.",
                    "vi": "Hạt giống hoặc một hạt giống."
                },
                {
                    "en": "Somewhat disreputable; squalid.",
                    "vi": "Hơi đáng chê trách; nhăn nheo."
                },
                {
                    "en": "(chiefly british) Tired or sick; unwell.",
                    "vi": "(chủ yếu là người Anh) Mệt mỏi hoặc ốm yếu; không khỏe."
                },
                {
                    "en": "Containing many seeds.",
                    "vi": "Chứa nhiều hạt."
                },
                {
                    "en": "Shabby, run-down, etc.",
                    "vi": "Tồi tàn, chạy xuống, v.v."
                },
                {
                    "en": "Disreputable; run-down.",
                    "vi": "Không thể chối cãi; chạy xuống."
                },
                {
                    "en": "Full of seeds.",
                    "vi": "Toàn hạt."
                },
                {
                    "en": "Untidy; unkempt.",
                    "vi": "Không ngăn nắp; nhếch nhác."
                },
                {
                    "en": "Infirm; gone to seed.",
                    "vi": "Xác nhận; đi gieo hạt."
                },
                {
                    "en": "Suffering the effects of a hangover.",
                    "vi": "Chịu ảnh hưởng của cảm giác nôn nao."
                },
                {
                    "en": "(colloquial) Having a peculiar flavour supposed to be derived from the weeds growing among the vines; said of certain kinds of French brandy.",
                    "vi": "(thông tục) Có một hương vị đặc biệt được cho là có nguồn gốc từ cỏ dại mọc giữa các dây leo; nói về một số loại rượu mạnh của Pháp."
                },
                {
                    "en": "Having many seeds.",
                    "vi": "Có nhiều hạt."
                },
                {
                    "en": "Worn and shabby; unkempt.",
                    "vi": "Mòn và tồi tàn; nhếch nhác."
                },
                {
                    "en": "Gone to seed.",
                    "vi": "Đi đến hạt giống."
                },
                {
                    "en": "Having tiny bubbles.",
                    "vi": "Có bong bóng nhỏ."
                }
            ]
        }
    ],
