            "meaning": [
                {
                    "en": "Watery, filmy, or unable to see clearly.",
                    "vi": "Chảy nước, nhão hoặc không thể nhìn rõ."
                },
                {
                    "en": "Tired, disoriented, or bleary-eyed.",
