            "meaning": [
                {
                    "en": "To cry weakly, like a baby; whimper or whine.",
                    "vi": "Để khóc một cách yếu ớt, như một đứa trẻ; rên rỉ hoặc rên rỉ."
                },
                {
                    "en": "To cry weakly with a soft, high-pitched sound; to whimper; to whine.",
                    "vi": "Khóc yếu ớt với âm thanh nhỏ và the thé; thút thít; than thở."
                },
                {
                    "en": "To cry weakly; whimper.",
                    "vi": "Để khóc một cách yếu ớt; rên."
                }
            ]
        },
