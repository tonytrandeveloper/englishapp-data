        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To subject to the fumes of ether; anesthetize.",
                    "vi": "Chịu khói của ête; gây mê."
                },
                {
                    "en": "To etherify.",
                    "vi": "Để kiểm chứng."
                },
                {
                    "en": "To anesthetize (a patient) with ether fumes.",
                    "vi": "Để gây mê (bệnh nhân) bằng khói ete."
                },
                {
                    "en": "To subject to the fumes of ether; anesthetize.",
                    "vi": "Chịu khói của ête; gây mê."
                },
                {
                    "en": "To convert into ether.",
                    "vi": "Để chuyển đổi thành ether."
                },
                {
                    "en": "To render insensible by means of ether, as by inhalation.",
                    "vi": "Để tạo ra sự vô cảm bằng ether, cũng như bằng cách hít thở."
                }
            ]
        }
    ],
