        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To set free by removing bands or braces.",
                    "vi": "Để giải phóng bằng cách tháo băng hoặc nẹp."
                },
                {
                    "en": "To release from tension; relax.",
                    "vi": "Để giải phóng khỏi căng thẳng; thư giãn."
                },
                {
                    "en": "To make slack; weaken.",
                    "vi": "Để làm cho chùng xuống; làm suy yếu."
                },
                {
                    "en": "To free from braces or bands.",
                    "vi": "Để không bị mắc cài hoặc dây đeo."
                },
                {
                    "en": "To loosen; relax.",
                    "vi": "Nới lỏng; thư giãn."
                },
                {
                    "en": "To make feeble.",
                    "vi": "Để làm cho yếu ớt."
                },
                {
                    "en": "To undo, unfasten; to relax, loosen.",
                    "vi": "Để hoàn tác, tháo gỡ; để thư giãn, thả lỏng."
                }
            ]
        }
    ],
