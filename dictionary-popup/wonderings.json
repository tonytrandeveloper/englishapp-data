            "meaning": [
                {
                    "en": "The mental activity by which one wonders; a query, puzzlement, etc.",
                    "vi": "Hoạt động tinh thần mà người ta tự hỏi; một truy vấn, phân vân, v.v."
                }
            ]
        },
