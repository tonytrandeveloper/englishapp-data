            "meaning": [
                {
                    "en": "Feeling or showing wonder.",
                    "vi": "Cảm thấy hoặc tỏ ra ngạc nhiên."
                },
                {
                    "en": "Feeling or expressing awe, admiration, amazement, or surprise.",
                    "vi": "Cảm thấy hoặc bày tỏ sự kinh ngạc, ngưỡng mộ, ngạc nhiên hoặc ngạc nhiên."
                },
                {
                    "en": "The definition of wondering is a feeling of questioning or curiosity.",
                    "vi": "Định nghĩa của băn khoăn là cảm giác thắc mắc hoặc tò mò."
                }
            ]
        },
        {
