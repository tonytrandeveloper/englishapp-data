    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The quality or condition of being topsy-turvy.",
                    "vi": "Chất lượng hoặc tình trạng rối loạn nhịp tim."
                },
                {
                    "en": "A topsy-turvy condition; inverted state.",
                    "vi": "Một tình trạng rối loạn nhịp tim; trạng thái đảo ngược."
                },
                {
                    "en": "A state of confusion.",
                    "vi": "Một trạng thái bối rối."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Confused or disordered.",
                    "vi": "Lẫn lộn hoặc mất trật tự."
                },
                {
                    "en": "The definition of topsy-turvy is upside down or not in order.",
                    "vi": "Định nghĩa của topsy-turvy là lộn ngược hoặc không theo thứ tự."
                },
                {
                    "en": "Backwards or upside-down; disorderly; chaotic.",
                    "vi": "Lùi lại hoặc lộn ngược; mất trật tự; hỗn loạn."
                },
                {
                    "en": "(idiomatic) Alternative spelling of topsy-turvy.",
                    "vi": "(thành ngữ) Cách viết thay thế của topsy-turvy."
                },
                {
                    "en": "Turned or positioned upside down; inverted.",
                    "vi": "Bị lật hoặc lộn ngược vị trí; đảo ngược."
                }
            ]
        },
        {
            "pos": "adverb",
            "meaning": [
                {
                    "en": "Upside down; in a reversed condition.",
                    "vi": "Lộn ngược; trong một điều kiện bị đảo ngược."
                },
                {
                    "en": "In or into a state of utter disorder or confusion.",
                    "vi": "Đang hoặc rơi vào trạng thái hoàn toàn rối loạn hoặc nhầm lẫn."
                },
                {
                    "en": "In confusion or disorder.",
                    "vi": "Đang bối rối hoặc rối loạn."
                },
                {
                    "en": "Backwards or upside-down; disorderly; chaotically.",
                    "vi": "Lùi lại hoặc lộn ngược; mất trật tự; hỗn loạn."
                },
                {
                    "en": "With the top downward and the bottom up; upside-down.",
                    "vi": "Với từ trên xuống và từ dưới lên; lộn ngược."
                }
            ]
        }
