        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Shuffling is the act of dragging the feet across the floor, or the act of mixing something by changing the order of its parts.",
                    "vi": "Xáo trộn là hành động kéo bàn chân trên sàn hoặc trộn một thứ gì đó bằng cách thay đổi thứ tự của các bộ phận của nó."
                },
                {
                    "en": "Action of the verb to shuffle.",
                    "vi": "Hành động của động từ xáo trộn."
                },
                {
                    "en": "The noise created by something moving about.",
                    "vi": "Tiếng ồn được tạo ra bởi một thứ gì đó đang di chuyển."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of shuffle.",
                    "vi": "Hiện tại phân từ xáo trộn."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Moving with a dragging, scraping step.",
                    "vi": "Di chuyển với một bước kéo, cạo."
                },
                {
                    "en": "Evasive.",
                    "vi": "Lảng tránh."
                }
            ]
        }
