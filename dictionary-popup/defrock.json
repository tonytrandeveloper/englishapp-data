    "phonetics": {
        "uk": "ˌdiːˈfrɒk",
        "us": "defrock"
    },
    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To strip of priestly privileges and functions.",
                    "vi": "Để tước bỏ các đặc quyền và chức năng của linh mục."
                },
                {
                    "en": "To deprive of the right to practice a profession.",
                    "vi": "Tước quyền hành nghề."
                },
                {
                    "en": "To deprive of an honorary position.",
                    "vi": "Tước chức vụ danh dự."
                },
                {
                    "en": "To revoke the rank or function of (a priest or minister)",
                    "vi": "Thu hồi cấp bậc hoặc chức năng của (một linh mục hoặc bộ trưởng)"
                },
                {
                    "en": "(literally) To divest of a frock.",
                    "vi": "(theo nghĩa đen) Để thoái vốn khỏi một chiếc váy yếm."
                },
                {
                    "en": "(figuratively) To formally remove the rights and authority of a member of the clergy.",
                    "vi": "(nghĩa bóng) Để chính thức tước bỏ quyền hạn và thẩm quyền của một thành viên trong hàng giáo phẩm."
                }
            ]
        }
    ],
    "meaning_vi": [
        "(tôn giáo) bắt bỏ áo thầy tu"
    ],
