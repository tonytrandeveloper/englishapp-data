    "phonetics": {
        "uk": "ˈmɪstɪɪst",
        "us": "ˈmɪstɪɪst"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Consisting of or marked by mist.",
                    "vi": "Bao gồm hoặc được đánh dấu bằng sương mù."
                },
                {
                    "en": "Of, or having the nature of, mist.",
                    "vi": "Của, hoặc có bản chất của, sương mù."
                },
                {
                    "en": "Obscured or clouded by or as if by mist.",
                    "vi": "Bị che khuất hoặc bị che khuất bởi hoặc như thể bị sương mù."
                },
                {
                    "en": "Characterized by or covered with mist.",
                    "vi": "Được đặc trưng bởi hoặc được bao phủ bởi sương mù."
                },
                {
                    "en": "Vague; hazy.",
                    "vi": "Mơ hồ; mơ hồ."
                },
                {
                    "en": "Full of tender emotion; sentimental.",
                    "vi": "Đầy cảm xúc dịu dàng; đa cảm."
                },
                {
                    "en": "Blurred or dimmed, as by mist; indistinct.",
                    "vi": "Mờ hoặc mờ, như sương mù; không rõ ràng."
                },
                {
                    "en": "Obscure or vague.",
                    "vi": "Ít người biết đến hoặc mơ hồ."
                },
                {
                    "en": "With mist; foggy.",
                    "vi": "Có sương mù; sương mù."
                },
                {
                    "en": "(figuratively) With tears in the eyes.",
                    "vi": "(nghĩa bóng) Mắt ngấn lệ."
                }
            ]
        },
        {
            "pos": "pronoun",
            "meaning": [
                {
                    "en": "A female given name from the adjective \"misty\", reasonably popular in the 1970s and the 1980s.",
                    "vi": "Một tên phụ nữ được đặt từ tính từ \"\"Misty\"\", khá phổ biến trong những năm 1970 và 1980."
                }
            ]
        }
    ],
    "meaning_vi": [
