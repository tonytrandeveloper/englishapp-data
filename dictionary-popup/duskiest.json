    "phonetics": {
        "uk": "ˈdʌskɪɪst",
        "us": "duskiest"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having low diffused light; dim or shadowy.",
                    "vi": "Có ánh sáng khuếch tán thấp; mờ hoặc bóng tối."
                },
                {
                    "en": "Rather dark in color.",
                    "vi": "Có màu tối hơn."
                },
                {
                    "en": "(dated) Dark-skinned.",
                    "vi": "(ngày tháng) Da ngăm đen."
                },
                {
                    "en": "The definition of dusky is something dim or darkish in color.",
                    "vi": "Định nghĩa của dusky là thứ gì đó có màu mờ hoặc hơi tối."
                },
                {
                    "en": "Somewhat dark in color; esp., swarthy.",
                    "vi": "Màu hơi tối; đặc biệt., swarthy."
                },
                {
                    "en": "Lacking light; dim; shadowy.",
                    "vi": "Thiếu ánh sáng; lờ mờ; vong linh."
                },
                {
                    "en": "Gloomy; melancholy.",
                    "vi": "ám; sầu muộn."
                },
                {
                    "en": "Dimly lit, as at dusk (evening).",
                    "vi": "Ánh sáng lờ mờ, như lúc chạng vạng (buổi tối)."
                },
                {
                    "en": "A shade of color that is rather dark.",
                    "vi": "Một bóng màu khá tối."
                },
                {
                    "en": "Ashen, greyish skin coloration.",
                    "vi": "Màu da xám tro."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A dusky shark.",
                    "vi": "Một con cá mập đen."
                },
                {
                    "en": "A dusky dolphin.",
                    "vi": "Một chú cá heo đen."
                }
            ]
        }
    ],
    "meaning_vi": [
        "tối, mờ tối",
        "tối màu"
    ],
