                    "vi": "Tinh thần cao; huyên náo."
                },
                {
                    "en": "Bold and boisterous; tomboyish.",
                    "vi": "Táo bạo và huyên náo; hơi cá tính."
                },
                {
                    "en": "Like a hoyden: high-spirited and boisterous; saucy, tomboyish.",
                    "vi": "Giống như một hoyden: cao ngạo và huyên náo; saucy, tomboyish."
                }
