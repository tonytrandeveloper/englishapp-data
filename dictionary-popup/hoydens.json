            "meaning": [
                {
                    "en": "A high-spirited, boisterous, or saucy girl.",
                    "vi": "Một cô gái có tinh thần cao, náo nhiệt, hay sa đọa."
                },
                {
                    "en": "A bold, boisterous girl; tomboy.",
                    "vi": "Một cô gái táo bạo, huênh hoang; tomboy."
                },
                {
                    "en": "(archaic) A rude, uncultured or rowdy girl or woman.",
                    "vi": "(cổ xưa) Một cô gái hoặc phụ nữ thô lỗ, vô văn hóa hoặc om sòm."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
