            "meaning": [
                {
                    "en": "Injuring or capable of injuring the feelings; caustic.",
                    "vi": "Gây thương tích hoặc có khả năng làm tổn thương cảm giác; xút."
                },
                {
                    "en": "Causing a stinging sensation; nipping.",
                    "vi": "Gây ra cảm giác châm chích; sự ăn mòn."
                },
                {
                    "en": "Of or relating to insects and certain other animals that wound the skin with a sting, mouthparts, or fangs.",
                    "vi": "Của hoặc liên quan đến côn trùng và một số động vật khác làm vết thương trên da bằng vết đốt, mụn rộp miệng hoặc nanh."
                },
                {
                    "en": "Cutting; sharp.",
                    "vi": "Cắt gọt; nhọn."
                },
                {
                    "en": "Sarcastic; caustic.",
                    "vi": "Châm biếm; xút."
                },
                {
                    "en": "Relating to an animal or animals capable of biting, especially an insect.",
                    "vi": "Liên quan đến động vật hoặc các động vật có khả năng cắn, đặc biệt là côn trùng."
                },
                {
                    "en": "Causing a stinging sensation.",
                    "vi": "Gây cảm giác châm chích."
                },
                {
                    "en": "Cutting or incisive.",
                    "vi": "Cắt hoặc rạch."
                },
                {
                    "en": "Tending to bite.",
                    "vi": "Có xu hướng cắn."
                }
            ]
        },
        {
