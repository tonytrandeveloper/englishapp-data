    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To gather together; assemble.",
                    "vi": "Tập hợp lại với nhau; tập hợp."
                },
                {
                    "en": "To meet another, especially by accident.",
                    "vi": "Gặp gỡ người khác, đặc biệt là tình cờ."
                },
                {
                    "en": "To come together; meet; assemble.",
                    "vi": "Để đến với nhau; gặp; tập hợp."
                },
                {
                    "en": "To meet by chance; encounter.",
                    "vi": "Tình cờ gặp nhau; bắt gặp."
                },
                {
                    "en": "To associate or have friendly social relations (with)",
                    "vi": "Để liên kết hoặc có các mối quan hệ xã hội thân thiện (với)"
                },
                {
                    "en": "(intransitive) To assemble or gather together in one place, to gather up; to congregate.",
                    "vi": "(intransitive) Để tập hợp hoặc tập hợp lại với nhau tại một nơi, để tập hợp lại; để tụ họp."
                }
            ]
        }
    ],
    "meaning_vi": [
        "tụ họp, hội họp",
        "giao dịch, giao thiệp, hay đi lại gặp gỡ; làm thân",
        "(từ Mỹ,nghĩa Mỹ) tình cờ gặp"
