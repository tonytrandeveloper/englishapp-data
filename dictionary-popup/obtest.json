    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To supplicate; entreat.",
                    "vi": "Cầu khẩn; sự rủ rê."
                },
                {
                    "en": "To obtest is to beg.",
                    "vi": "Để có được là để cầu xin."
                },
                {
                    "en": "To beg for; beseech; supplicate.",
                    "vi": "Để cầu xin; van xin; van xin."
                },
                {
                    "en": "To call to witness.",
                    "vi": "Để gọi để chứng kiến."
                },
                {
                    "en": "(archaic, intransitive) To implore, beseech, plead, beg.",
                    "vi": "(cổ xưa, không rõ ràng) Để cầu xin, van nài, cầu xin, cầu xin."
                },
                {
                    "en": "(archaic, intransitive) To call on a witness (often God) to confirm that something is true.",
                    "vi": "(cổ xưa, không rõ ràng) Để kêu gọi một nhân chứng (thường là Chúa) xác nhận rằng điều gì đó là sự thật."
                }
            ]
        }
    ],
    "meaning_vi": [
        "(từ cổ,nghĩa cổ) khẩn khoản, khẩn cầu",
        "mời ra để làm chứng",
        "(từ cổ,nghĩa cổ) phản đối"
