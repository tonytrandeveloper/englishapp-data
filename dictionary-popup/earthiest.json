    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Of, consisting of, or resembling earth.",
                    "vi": "Của, bao gồm, hoặc tương tự như trái đất."
                },
                {
                    "en": "Of or characteristic of this world; worldly.",
                    "vi": "Của hoặc đặc trưng của thế giới này; thế gian."
                },
                {
                    "en": "Crude or off-color; indecent.",
                    "vi": "Màu thô hoặc nhạt màu; không đứng đắn."
                },
                {
                    "en": "Hearty or uninhibited; natural.",
                    "vi": "Thịnh soạn hoặc không bị cấm đoán; tự nhiên."
                },
                {
                    "en": "Unadorned and simple in style.",
                    "vi": "Không trang trí và đơn giản trong phong cách."
                },
                {
                    "en": "Of or like earth or soil.",
                    "vi": "Của hoặc giống như đất hoặc đất."
                },
                {
                    "en": "(archaic) Worldly.",
                    "vi": "(cổ xưa) Thế gian."
                },
                {
                    "en": "Coarse; unrefined.",
                    "vi": "Thô; không tinh chế."
                },
                {
                    "en": "Simple and natural; hearty.",
                    "vi": "Đơn giản và tự nhiên; thịnh soạn."
                },
                {
                    "en": "Resembling dirt or soil (i.e. earth).",
                    "vi": "Có vẻ như đất hoặc đất (tức là đất)."
                },
                {
                    "en": "Down to earth, un-artificed, natural.",
                    "vi": "Xuống đất, không công chứng, tự nhiên."
                },
                {
                    "en": "Like or resembling the earth or of the earth.",
                    "vi": "Giống hoặc giống với trái đất hoặc của trái đất."
                },
                {
                    "en": "Covered with earth (mud, dirt).",
                    "vi": "Được bao phủ bởi đất (bùn, đất)."
                }
            ]
        }
    ],
