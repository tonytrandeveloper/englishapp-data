        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Large and heavy in a dignified and stately way.",
                    "vi": "Lớn và nặng một cách trang nghiêm và trang nghiêm."
                },
                {
                    "en": "(archaic) Stately or dignified.",
                    "vi": "(cổ xưa) Trang nghiêm hoặc trang nghiêm."
                },
                {
                    "en": "Stout; corpulent.",
                    "vi": "Bia đen; thân thiện."
                },
                {
                    "en": "Having a round, stout body.",
                    "vi": "Có thân hình tròn trịa, mập mạp."
                },
                {
                    "en": "The definition of portly is someone who is stout or has a large, heavy body.",
                    "vi": "Định nghĩa về người mập mạp là người mập mạp hoặc có thân hình to lớn, nặng nề."
                },
                {
                    "en": "(now rare) Having a dignified bearing; handsome, imposing. [from 15th c.]",
                    "vi": "(xưa nay hiếm) Có đàng hoàng; đẹp trai, đường bệ. [từ ngày 15 c.]"
                },
                {
                    "en": "Fat; overweight. [from 15th c.]",
                    "vi": "Mập mạp; thừa cân. [từ ngày 15 c.]"
                }
            ]
        }
