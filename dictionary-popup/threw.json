    "sentences": [
        {
            "en": "He threw her a sharp look over his shoulder.",
            "vi": "Anh ném cho cô một cái nhìn sắc bén qua vai."
        },
        {
            "en": "She threw the towel on the counter.",
            "vi": "Cô ném chiếc khăn lên quầy."
        },
        {
            "en": "You're the one who threw the ring at me.",
            "vi": "Bạn là người đã ném chiếc nhẫn vào tôi."
        },
        {
            "en": "I gave her a spoon, which she threw on the floor.",
            "vi": "Tôi đưa cho cô ấy một cái thìa, cô ấy ném xuống sàn."
        },
        {
            "en": "She paused, sucking in a deep breath, and then threw her hands in the air in defeat.",
            "vi": "Cô dừng lại, hít một hơi thật sâu, rồi tung hai tay lên trời trong thất bại."
        },
        {
            "en": "He threw open the door and walked away.",
            "vi": "Anh mở tung cánh cửa và bước đi."
        },
        {
            "en": "He threw her on the bed again.",
            "vi": "Anh lại ném cô lên giường."
        },
        {
            "en": "At last, however, the sea, as if weary of its new toy, threw me back on the shore, and in another instant I was clasped in my teacher's arms.",
            "vi": "Tuy nhiên, cuối cùng, biển, như thể mệt mỏi với món đồ chơi mới của nó, đã ném tôi trở lại bờ biển, và trong một khoảnh khắc khác, tôi bị ôm chặt trong vòng tay của giáo viên."
        },
        {
            "en": "She threw the pillow over her head, drawing the light blanket up against her chin.",
            "vi": "Cô ném cái gối lên đầu, kéo tấm chăn nhẹ lên trên cằm."
        },
        {
            "en": "You threw me out with nowhere to go after the man who was meant to be my husband was killed.",
            "vi": "Bạn đã ném tôi ra không còn nơi nào để đi sau khi người đàn ông được cho là chồng tôi bị giết."
        }
    ]
