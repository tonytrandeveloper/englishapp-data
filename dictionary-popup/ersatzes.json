    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Not genuine; fake.",
                    "vi": "Không chính hãng; đồ giả."
                },
                {
                    "en": "Being a usually inferior imitation or substitute; artificial.",
                    "vi": "Thường là bắt chước hoặc thay thế kém hơn; nhân tạo."
                },
                {
                    "en": "The definition of ersatz is a substitute or synthetic.",
                    "vi": "Định nghĩa của ersatz là một chất thay thế hoặc tổng hợp."
                },
                {
                    "en": "Made in imitation; artificial, especially of an inferior quality.",
                    "vi": "Làm giả; nhân tạo, đặc biệt là chất lượng kém hơn."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Substitute or synthetic.",
                    "vi": "Thay thế hoặc tổng hợp."
                },
                {
                    "en": "Ersatz is defined as an artificial substance that replaces something genuine.",
                    "vi": "Ersatz được định nghĩa là một chất nhân tạo thay thế một thứ gì đó chính hãng."
                },
                {
                    "en": "Something made in imitation; an effigy or substitute.",
                    "vi": "Một cái gì đó được làm theo kiểu bắt chước; một hình nộm hoặc vật thay thế."
                }
            ]
        }
    ],
