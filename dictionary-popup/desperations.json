    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The state of being desperate.",
                    "vi": "Tình trạng tuyệt vọng."
                },
                {
                    "en": "Recklessness resulting from despair.",
                    "vi": "Sự liều lĩnh do tuyệt vọng."
                },
                {
                    "en": "The condition of being desperate.",
                    "vi": "Tình trạng tuyệt vọng."
                },
                {
                    "en": "Recklessness arising from despair.",
                    "vi": "Sự liều lĩnh phát sinh từ sự tuyệt vọng."
                },
                {
                    "en": "Desperation is defined as a loss of hope, or a great need that can make you act irrationally.",
                    "vi": "Tuyệt vọng được định nghĩa là mất hy vọng hoặc một nhu cầu lớn có thể khiến bạn hành động phi lý trí."
                },
                {
                    "en": "The act of despairing or becoming desperate; a giving up of hope.",
                    "vi": "Hành động tuyệt vọng hoặc trở nên tuyệt vọng; từ bỏ hy vọng."
                },
                {
                    "en": "A state of despair, or utter hopeless; abandonment of hope; extreme recklessness; reckless fury.",
                    "vi": "Một trạng thái tuyệt vọng, hoặc hoàn toàn tuyệt vọng; từ bỏ hy vọng; cực kỳ liều lĩnh; sự giận dữ liều lĩnh."
                }
            ]
        }
    ],
