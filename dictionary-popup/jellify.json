            "meaning": [
                {
                    "en": "To become or make into jelly.",
                    "vi": "Để trở thành hoặc làm thành thạch."
                },
                {
                    "en": "(rare) To change into jelly.",
                    "vi": "(hiếm) Để đổi thành thạch."
                },
                {
                    "en": "(dated, intransitive) To form a jelly; to gel.",
                    "vi": "(niên đại, không rõ ràng) Để tạo thành thạch; để tạo gel."
                },
                {
                    "en": "To make into a jelly.",
                    "vi": "Để làm thành một loại thạch."
                }
            ]
        }
    ],
