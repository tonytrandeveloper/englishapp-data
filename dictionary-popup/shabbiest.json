    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Beggarly; unworthy.",
                    "vi": "Cầu kỳ; không xứng đáng."
                },
                {
                    "en": "The definition of shabby is something that appears run-down or worn-out.",
                    "vi": "Định nghĩa của tồi tàn là một thứ gì đó có vẻ như đã cạn kiệt hoặc cũ nát."
                },
                {
                    "en": "Torn or worn; poor; mean; ragged.",
                    "vi": "Rách hoặc mòn; nghèo; bần tiện; rách rưới."
                },
                {
                    "en": "Wearing threadbare clothing.",
                    "vi": "Mặc quần áo sợi chỉ."
                },
                {
                    "en": "Showing signs of wear and tear; threadbare or worn-out.",
                    "vi": "Có dấu hiệu hao mòn; sợi chỉ hoặc mòn."
                },
                {
                    "en": "Dilapidated or deteriorated in condition, especially through neglect; seedy.",
                    "vi": "Tình trạng hư hỏng hoặc xấu đi, đặc biệt là do bỏ bê; nhiều hạt."
                },
                {
                    "en": "Despicable; mean.",
                    "vi": "Đáng khinh; bần tiện."
                },
                {
                    "en": "Not generous or just; unfair.",
                    "vi": "Không hào phóng hoặc công bằng; không công bằng."
                },
                {
                    "en": "Of mediocre or substandard quality.",
                    "vi": "Chất lượng tầm thường hoặc kém chất lượng."
                },
                {
                    "en": "Disgraceful; shameful.",
                    "vi": "Nhục nhã; đáng xấu hổ."
                },
                {
                    "en": "Showing much wear; ragged; threadbare.",
                    "vi": "Cho thấy nhiều mặc; rách rưới; sợi chỉ."
                },
                {
                    "en": "Wearing such clothing; seedy.",
                    "vi": "Mặc quần áo như vậy; nhiều hạt."
                },
                {
                    "en": "Clothed with ragged, much worn, or soiled garments.",
                    "vi": "Mặc quần áo rách rưới, sờn rách nhiều hoặc bẩn."
                },
                {
                    "en": "Mean; paltry; despicable.",
                    "vi": "Bần tiện; không đáng kể; đáng khinh."
                },
                {
                    "en": "Part or all of this entry has been imported from the 1913 edition of Webster's Dictionary, which is now free of copyright and hence in the public domain. The imported definitions may be significantly out of date, and any more recent senses may be completely missing.",
                    "vi": "Một phần hoặc toàn bộ mục này đã được nhập từ ấn bản năm 1913 của Từ điển Webster, hiện không có bản quyền và do đó thuộc phạm vi công cộng. Các định nghĩa đã nhập có thể đã lỗi thời đáng kể và bất kỳ giác quan nào gần đây hơn có thể bị thiếu hoàn toàn."
                },
                {
                    "en": "Shabby means unfair or low-quality.",
                    "vi": "Tồi tàn có nghĩa là không công bằng hoặc chất lượng thấp."
                },
                {
                    "en": "Run-down; dilapidated; deteriorated.",
                    "vi": "Chạy xuống; đổ nát; xấu đi."
                }
            ]
        }
    ],
