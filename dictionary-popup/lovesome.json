            "meaning": [
                {
                    "en": "(chiefly literary) Lovely, lovable, etc.",
                    "vi": "(chủ yếu là văn học) Đáng yêu, đáng yêu, v.v."
                },
                {
                    "en": "Worthy of love; having qualities that inspire love; lovable.",
                    "vi": "Đáng yêu; có phẩm chất khơi gợi tình yêu; đáng yêu."
                },
                {
                    "en": "Lovable on account of beauty; lovely; beautiful; winsome.",
                    "vi": "Đáng yêu vì vẻ đẹp; đẹp; xinh đẹp; hấp dẫn."
                },
                {
                    "en": "Loving; manifesting love or affection; affectionate; friendly.",
                    "vi": "Thương; biểu lộ tình yêu hoặc tình cảm; tình cảm; thân thiện."
                },
                {
                    "en": "Amorous; romantic.",
                    "vi": "Ham mê; lãng mạn."
                }
            ]
        }
