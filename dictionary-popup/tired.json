    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Fatigued, worn-out, or weary.",
                    "vi": "Mệt mỏi, mòn mỏi hoặc mệt mỏi."
                },
                {
                    "en": "Stale; hackneyed.",
                    "vi": "Cũ; hackneyed."
                },
                {
                    "en": "The definition of tired is being bored with something, or something that has become stale or being fatigued and in need of rest.",
                    "vi": "Định nghĩa của mệt mỏi là chán một thứ gì đó, hoặc một thứ gì đó đã trở nên cũ nát hoặc mệt mỏi và cần được nghỉ ngơi."
                },
                {
                    "en": "In need of some rest or sleep.",
                    "vi": "Cần nghỉ ngơi hoặc ngủ một chút."
                },
                {
                    "en": "Fed up, annoyed, irritated, sick of.",
                    "vi": "Chán nản, khó chịu, cáu kỉnh, phát ngán."
                },
                {
                    "en": "Overused; hackneyed.",
                    "vi": "Lạm dụng; hackneyed."
                },
                {
                    "en": "Exhausted of strength or energy; fatigued.",
                    "vi": "Kiệt sức hoặc năng lượng; mệt mỏi."
                },
                {
                    "en": "Impatient; bored.",
                    "vi": "Nóng nảy; chán."
                },
                {
                    "en": "Overused, cliché.",
                    "vi": "Sử dụng quá mức, sáo rỗng."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Simple past tense and past participle of tire.",
                    "vi": "Quá khứ đơn và quá khứ phân từ của lốp xe."
                }
            ]
        }
    ],
