    "sentences": [
        {
            "en": "Katie hid a smile.",
            "vi": "Katie giấu một nụ cười."
        },
        {
            "en": "She hid a smile at the look on Linda's face.",
            "vi": "Cô ấy giấu một nụ cười trước vẻ mặt của Linda."
        },
        {
            "en": "This morning I hid a cracker.",
            "vi": "Sáng nay tôi đã giấu một chiếc bánh quy giòn."
        },
        {
            "en": "She hid the dagger in a pocket and watched.",
            "vi": "Cô giấu con dao găm trong túi và quan sát."
        },
        {
            "en": "Pierre hid his face, from which a faint smile forgot to fade though his features now expressed horror and fear.",
            "vi": "Pierre giấu mặt đi, từ đó một nụ cười nhạt nhòa không quên vụt tắt mặc dù những nét mặt của anh giờ thể hiện sự kinh hoàng và sợ hãi."
        },
        {
            "en": "I think Shipton hid in the next room—perhaps in the closet.",
            "vi": "Tôi nghĩ Shipton trốn trong phòng bên cạnh — có lẽ trong tủ quần áo."
        },
        {
            "en": "I came here and hid out, Jared explained.",
            "vi": "Tôi đến đây và trốn ra ngoài, Jared giải thích."
        },
        {
            "en": "He hid a smile as Rainy turned to him.",
            "vi": "Anh ấy giấu một nụ cười khi Rainy quay sang anh ấy."
        },
        {
            "en": "Grasso no longer hid the knife he carried in his right hand as they moved nearly out of range to a dark, windowless van.",
            "vi": "Grasso không còn giấu con dao mà anh ta mang trên tay phải khi họ di chuyển gần ra khỏi phạm vi đến một chiếc xe tải tối màu, không cửa sổ."
        },
        {
            "en": "He walked out again, and she tossed the fish and hid the rope, straightening just as he reappeared.",
            "vi": "Anh lại bước ra ngoài, cô quăng con cá và giấu sợi dây, duỗi thẳng ngay khi anh xuất hiện trở lại."
        }
    ]
