    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having a body temperature that remains relatively constant, independent of and usually higher than that of the surroundings.",
                    "vi": "Có nhiệt độ cơ thể tương đối ổn định, không phụ thuộc và thường cao hơn nhiệt độ của môi trường xung quanh."
                },
                {
                    "en": "Having or characterized by an eager, lively, or passionate temperament; ardent; fervent.",
                    "vi": "Có hoặc được đặc trưng bởi tính khí háo hức, sôi nổi hoặc đam mê; hăng hái; nhiệt thành."
                },
                {
                    "en": "Alternative spelling of warm-blooded.",
                    "vi": "Cách viết khác của máu nóng."
                }
            ]
        }
    ],
