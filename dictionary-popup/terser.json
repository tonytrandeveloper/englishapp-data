    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Brief and to the point; effectively concise.",
                    "vi": "Ngắn gọn và đến điểm; ngắn gọn một cách hiệu quả."
                },
                {
                    "en": "Free of superfluous words; concise in a polished, smooth way; succinct.",
                    "vi": "Miễn phí những từ thừa; súc tích một cách trau chuốt, mượt mà; cô đọng."
                },
                {
                    "en": "Brief or concise to the point of rudeness; curt.",
                    "vi": "Ngắn gọn hoặc xúc tích đến mức thô lỗ; cộc lốc."
                },
                {
                    "en": "The definition of terse is language that is brief and to the point.",
                    "vi": "Định nghĩa của terse là ngôn ngữ ngắn gọn và đi vào trọng tâm."
                },
                {
                    "en": "(of speech or style) Brief, concise, to the point.",
                    "vi": "(của lời nói hoặc văn phong) Ngắn gọn, súc tích, đi vào trọng tâm."
                },
                {
                    "en": "Abruptly or brusquely short.",
                    "vi": "Ngắn đột ngột hoặc đột ngột."
                }
            ]
        }
    ],
    "meaning_vi": [
        "ngắn gọn; súc tích (văn)"
