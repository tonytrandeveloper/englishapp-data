            "pos": "noun",
            "meaning": [
                {
                    "en": "A criminal practice or act.",
                    "vi": "Một hành vi hoặc thực hành tội phạm."
                },
                {
                    "en": "The state, quality, or fact of being criminal.",
                    "vi": "Trạng thái, chất lượng hoặc thực tế là tội phạm."
                },
                {
                    "en": "A criminal action.",
                    "vi": "Một hành động tội phạm."
                },
                {
                    "en": "The definition of criminality is the state of being illegal.",
                    "vi": "Định nghĩa của tội phạm là tình trạng bất hợp pháp."
                },
                {
                    "en": "The quality, state, or fact of being criminal.",
                    "vi": "Chất lượng, trạng thái hoặc thực tế là tội phạm."
                },
                {
                    "en": "The state, practice, or quality of being a criminal.",
                    "vi": "Trạng thái, hành vi hoặc phẩm chất của việc trở thành tội phạm."
                },
                {
                    "en": "The act or series of acts that constitute a crime.",
                    "vi": "Hành vi hoặc một loạt các hành vi cấu thành tội phạm."
                },
                {
                    "en": "(uncountable) The state of being criminal.",
                    "vi": "(không đếm được) Tình trạng tội phạm."
                },
                {
                    "en": "(countable) A criminal act.",
                    "vi": "(đếm được) Một hành vi phạm tội."
                }
            ]
        }
    ],
