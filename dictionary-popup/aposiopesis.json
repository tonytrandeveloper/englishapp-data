    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A sudden breaking off of a thought in the middle of a sentence, as though the speaker were unwilling or unable to continue.",
                    "vi": "Đột ngột ngắt một ý nghĩ ở giữa câu, như thể người nói không muốn hoặc không thể tiếp tục."
                },
                {
                    "en": "A sudden breaking off of a thought in the middle of a sentence as if one were unable or unwilling to continue (Ex.: the horrors I saw there—but I dare not tell them)",
                    "vi": "Đột ngột ngắt một ý nghĩ ở giữa câu như thể một người không thể hoặc không muốn tiếp tục (Ví dụ: điều kinh hoàng tôi đã thấy ở đó — nhưng tôi không dám nói với họ)"
                },
                {
                    "en": "(rhetoric) An abrupt breaking-off in speech.",
                    "vi": "(hùng biện) Một sự ngắt quãng đột ngột trong bài phát biểu."
                }
            ]
        }
    ],
    "meaning_vi": [
        "sự ngừng ở giữa câu, sự ngừng bất chợt (trong khi nói)"
