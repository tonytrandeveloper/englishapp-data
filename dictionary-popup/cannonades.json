        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To attack or fire at with artillery.",
                    "vi": "Để tấn công hoặc bắn bằng pháo binh."
                },
                {
                    "en": "To assault with heavy artillery fire.",
                    "vi": "Để tấn công bằng hỏa lực pháo binh hạng nặng."
                },
                {
                    "en": "To deliver heavy artillery fire.",
                    "vi": "Để cung cấp hỏa lực pháo binh hạng nặng."
                },
                {
                    "en": "To fire artillery.",
                    "vi": "Để bắn pháo."
                },
                {
                    "en": "To discharge artillery fire.",
                    "vi": "Để xả đạn pháo."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "An extended, usually heavy discharge of artillery.",
                    "vi": "Một đợt xả pháo kéo dài, thường là hạng nặng."
                },
                {
                    "en": "A harsh verbal or physical attack.",
                    "vi": "Một cuộc tấn công thô bạo bằng lời nói hoặc thể xác."
                },
                {
                    "en": "A continuous firing of artillery.",
                    "vi": "Một tràng pháo liên tục."
                },
                {
                    "en": "Firing artillery in a large amount for a length of time .",
                    "vi": "Bắn pháo với số lượng lớn trong một thời gian dài."
                },
                {
                    "en": "(figuratively) A loud noise like a cannonade; a booming.",
                    "vi": "(nghĩa bóng) Tiếng ồn ào như tiếng pháo; một sự bùng nổ."
                }
            ]
        }
    ],
