    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Filled with dreams.",
                    "vi": "Tràn ngập ước mơ."
                },
                {
                    "en": "Soothing and serene.",
                    "vi": "Nhẹ nhàng và thanh thản."
                },
                {
                    "en": "Fond of daydreaming; given to reverie; visionary; impractical.",
                    "vi": "Thích mơ mộng; trao cho sự tôn kính; nhìn xa trông rộng; không thực tế."
                },
                {
                    "en": "Like something in a dream; not sharply defined; misty, vague, etc.",
                    "vi": "Giống như một cái gì đó trong một giấc mơ; không được xác định rõ ràng; mù mờ, mơ hồ, v.v."
                },
                {
                    "en": "Having a soft, soothing quality.",
                    "vi": "Có chất lượng mềm mại, nhẹ nhàng."
                },
                {
                    "en": "(slang) Excellent, wonderful, delightful, etc.",
                    "vi": "(tiếng lóng) Tuyệt vời, tuyệt vời, thú vị, v.v."
                },
                {
                    "en": "As in a dream; resembling a dream.",
                    "vi": "Như trong một giấc mơ; giống như một giấc mơ."
                },
                {
                    "en": "(colloquial) Sexy; handsome; attractive.",
                    "vi": "(thông tục) Gợi cảm; đẹp; hấp dẫn."
                },
                {
                    "en": "Having a pleasant or romantic atmosphere.",
                    "vi": "Có bầu không khí dễ chịu hoặc lãng mạn."
                },
                {
                    "en": "Resembling a dream; ethereal or vague.",
                    "vi": "Giống như một giấc mơ; thanh tao hoặc mơ hồ."
                },
                {
                    "en": "Given to daydreams or reverie.",
                    "vi": "Dành cho sự mơ mộng hoặc mơ mộng."
                },
                {
                    "en": "(informal) Inspiring delight; wonderful.",
                    "vi": "(không chính thức) Niềm vui đầy cảm hứng; tuyệt vời."
                }
            ]
        }
    ],
    "meaning_vi": [
