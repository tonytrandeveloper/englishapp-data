    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Sullen; gloomy; forbidding.",
                    "vi": "Hờn dỗi; ảm đạm; cấm đoán."
                },
                {
                    "en": "(scot.) Hard; stern; severe.",
                    "vi": "(scot.) Khó; đuôi tàu; dữ dội."
                },
                {
                    "en": "(scot.) Obstinate.",
                    "vi": "(scot.) Ám ảnh."
                },
                {
                    "en": "The definition of dour is stern, severe or gloomy.",
                    "vi": "Định nghĩa của dour là nghiêm khắc, nghiêm trọng hoặc u ám."
                },
                {
                    "en": "Marked by sternness or harshness; forbidding.",
                    "vi": "Được đánh dấu bởi sự nghiêm khắc hoặc khắc nghiệt; cấm đoán."
                },
                {
                    "en": "Silently ill-humored; gloomy.",
                    "vi": "Âm thầm xấu số; ảm đạm."
                },
                {
                    "en": "Sternly obstinate; unyielding.",
                    "vi": "Cố chấp nghiêm khắc; không khuất phục."
                },
                {
                    "en": "Stern, harsh and forbidding.",
                    "vi": "Nghiêm khắc, hà khắc và cấm đoán."
                },
                {
                    "en": "Unyielding and obstinate.",
                    "vi": "Bất khuất và cố chấp."
                },
                {
                    "en": "Expressing gloom or melancholy; sullenly unhappy.",
                    "vi": "Thể hiện sự u ám hoặc sầu muộn; ủ rũ không vui."
                }
            ]
        }
    ],
