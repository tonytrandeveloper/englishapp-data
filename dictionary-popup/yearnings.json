    "defines": [
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A persistent, often melancholy desire; a longing.",
                    "vi": "Một mong muốn dai dẳng, thường sầu muộn; một khao khát."
                },
                {
                    "en": "Deep or anxious longing, desire, etc.",
                    "vi": "Những khao khát, ước muốn sâu sắc hay lo lắng, v.v."
                },
                {
                    "en": "Yearning is a deep, and sometimes sad, desire.",
                    "vi": "Khao khát là một ước muốn sâu sắc, và đôi khi buồn."
                },
                {
                    "en": "A wistful or melancholy longing.",
                    "vi": "Một khao khát bâng khuâng hay sầu muộn."
                },
                {
                    "en": "(archaic) Rennet.",
                    "vi": "(cổ xưa) Rennet."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of yearn.",
                    "vi": "Hiện tại phân từ của khao khát."
                }
            ]
        }
    ],
