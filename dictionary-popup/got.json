    "sentences": [
        {
            "en": "I was so excited that I couldn't sleep, so I got up and dressed.",
            "vi": "Tôi phấn khích đến mức không ngủ được nên bật dậy mặc quần áo."
        },
        {
            "en": "But I thought when people got married...",
            "vi": "Nhưng tôi nghĩ khi người ta kết hôn ..."
        },
        {
            "en": "I just got a call from the doctor.",
            "vi": "Tôi vừa nhận được cuộc gọi từ bác sĩ."
        },
        {
            "en": "When she got to the room, Alex was sitting on the love seat reading a newspaper.",
            "vi": "Khi cô về đến phòng, Alex đang ngồi trên ghế tình yêu đọc báo."
        },
        {
            "en": "Lisa got up every morning and fixed breakfast.",
            "vi": "Lisa dậy mỗi sáng và chuẩn bị bữa sáng."
        },
        {
            "en": "Considering her own feelings about Alex, and the fact that he was a lot like his father, it wasn't hard to imagine that his mother never got over Señor Medena.",
            "vi": "Xem xét cảm nhận của riêng cô ấy về Alex, và thực tế rằng anh ấy rất giống cha mình, không khó để tưởng tượng rằng mẹ anh ấy không bao giờ vượt qua được Señor Medena."
        },
        {
            "en": "Destiny got well and came home.",
            "vi": "Vận mệnh đã ổn và về đến nhà."
        },
        {
            "en": "Ours must have got the best of it.",
            "vi": "Của chúng tôi phải có những gì tốt nhất của nó."
        },
        {
            "en": "This is a nice scrape you've got me into, isn't it?",
            "vi": "Đây là một câu chuyện tuyệt vời mà anh đã khiến tôi phải hứng thú, phải không?"
        },
        {
            "en": "Pierre got up and, having told them to harness and overtake him, went on foot through the town.",
            "vi": "Pierre đứng dậy và bảo họ kéo và vượt qua anh ta, đi bộ qua thị trấn."
        }
    ]
