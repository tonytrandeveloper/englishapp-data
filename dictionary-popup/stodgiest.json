    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Dull; tedious; uninteresting.",
                    "vi": "Đần độn; tẻ nhạt; không thú vị."
                },
                {
                    "en": "Indigestible and starchy; heavy.",
                    "vi": "Khó tiêu và giàu tinh bột; nặng."
                },
                {
                    "en": "Solidly built; stocky.",
                    "vi": "Xây dựng vững chắc; chắc nịch."
                },
                {
                    "en": "Dull, unimaginative, and commonplace.",
                    "vi": "Buồn tẻ, không thể tưởng tượng và phổ biến."
                },
                {
                    "en": "Old-fashioned and stuffy.",
                    "vi": "Cổ điển và ngột ngạt."
                },
                {
                    "en": "Heavy and unpalatable.",
                    "vi": "Nặng và không ngon."
                },
                {
                    "en": "Heavily built; bulky and slow in movement.",
                    "vi": "Được xây dựng nặng nề; cồng kềnh và di chuyển chậm."
                },
                {
                    "en": "Drab, unfashionable, or unattractive.",
                    "vi": "Buồn tẻ, không hợp thời trang hoặc kém hấp dẫn."
                },
                {
                    "en": "Stubbornly old-fashioned; narrow and conventional.",
                    "vi": "Cứng cỏi cổ hủ; hẹp và quy ước."
                },
                {
                    "en": "(of food) Having a thick, semi-solid consistency; glutinous; heavy on the stomach.",
                    "vi": "(thực phẩm) Có độ đặc, bán rắn; nếp cẩm; nặng bụng."
                },
                {
                    "en": "Dull, old-fashioned.",
                    "vi": "Buồn tẻ, cổ hủ."
                }
            ]
        }
    ],
    "meaning_vi": [
