        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "The quality of being virulent, or very poisonous, noxious, malignant, etc.",
                    "vi": "Chất lượng độc hại, hoặc rất độc, độc hại, ác tính, v.v."
                },
                {
                    "en": "Bitter animosity; venom; rancor.",
                    "vi": "Thù hận cay đắng; nọc độc; chủ trại."
                },
                {
                    "en": "The relative infectiousness of a microorganism causing disease.",
                    "vi": "Khả năng lây nhiễm tương đối của vi sinh vật gây bệnh."
                },
                {
                    "en": "The state of being virulent.",
                    "vi": "Trạng thái độc lực."
                },
                {
                    "en": "A measure of how virulent a thing is.",
                    "vi": "Một thước đo mức độ độc hại của một thứ."
                }
            ]
        }
    ],
