    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Having much flesh; fat; plump.",
                    "vi": "Có nhiều thịt; mập mạp; đầy đặn."
                },
                {
                    "en": "Having a juicy or pulpy texture.",
                    "vi": "Có một kết cấu ngon ngọt hoặc mềm."
                },
                {
                    "en": "Fleshly; carnal.",
                    "vi": "Xác thịt; xác thịt."
                },
                {
                    "en": "Relating to, consisting of, or resembling flesh.",
                    "vi": "Liên quan đến, bao gồm hoặc giống với thịt."
                },
                {
                    "en": "Having abundant flesh.",
                    "vi": "Có thịt dồi dào."
                },
                {
                    "en": "Having a firm pulp, as some fruits.",
                    "vi": "Có cùi chắc như một số loại trái cây."
                },
                {
                    "en": "Of, related to, or resembling flesh.",
                    "vi": "Của, liên quan đến, hoặc giống với thịt."
                },
                {
                    "en": "(of a person) Having considerable flesh.",
                    "vi": "(của một người) Có da thịt đáng kể."
                },
                {
                    "en": "Of or like flesh.",
                    "vi": "Của hoặc giống như xác thịt."
                }
            ]
        }
    ],
    "meaning_vi": [
        "béo; có nhiều thịt, nạc",
