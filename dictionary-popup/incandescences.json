        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "(physics) The emission of visible light by a hot body.",
                    "vi": "(vật lý) Sự phát ra ánh sáng nhìn thấy của một vật nóng."
                },
                {
                    "en": "The emission of visible light by a hot object.",
                    "vi": "Sự phát ra ánh sáng khả kiến của một vật nóng."
                },
                {
                    "en": "The light so emitted.",
                    "vi": "Ánh sáng vì vậy phát ra."
                },
                {
                    "en": "(by extension) Great emotion, especially anger.",
                    "vi": "(mở rộng) Cảm xúc lớn, đặc biệt là tức giận."
                },
                {
                    "en": "The light emitted by an incandescent object.",
                    "vi": "Ánh sáng do một vật nóng sáng phát ra."
                },
                {
                    "en": "A high degree of emotion, intensity, or brilliance.",
                    "vi": "Một mức độ cao của cảm xúc, cường độ hoặc rực rỡ."
                }
            ]
        }
