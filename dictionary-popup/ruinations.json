            "meaning": [
                {
                    "en": "The act of ruining or the condition of being ruined.",
                    "vi": "Hành động hủy hoại hoặc tình trạng bị hủy hoại."
                },
                {
                    "en": "Anything that ruins or causes ruin.",
                    "vi": "Bất cứ điều gì làm hỏng hoặc gây ra sự hủy hoại."
                },
                {
                    "en": "A cause of ruin.",
                    "vi": "Một nguyên nhân của sự đổ nát."
                },
                {
                    "en": "A ruining or being ruined.",
                    "vi": "Một sự hủy hoại hoặc bị hủy hoại."
                },
                {
                    "en": "The state of being ruined, a state of devastation or destruction.",
                    "vi": "Tình trạng bị đổ nát, tình trạng bị tàn phá hoặc bị hủy hoại."
                },
                {
                    "en": "The act of ruining or wrecking.",
                    "vi": "Hành động phá hủy hoặc phá hủy."
                },
                {
                    "en": "The cause of being ruined, destroyed or lost.",
                    "vi": "Nguyên nhân do bị đổ nát, hủy hoại, mất mát."
                },
                {
                    "en": "A loss of reputation.",
                    "vi": "Mất danh tiếng."
                }
            ]
        }
