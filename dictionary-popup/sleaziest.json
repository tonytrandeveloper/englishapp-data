    "phonetics": {
        "uk": "ˈsliːzɪɪst",
        "us": "ˈslizɪɪst"
    },
    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Flimsy or thin in texture or substance; lacking firmness.",
                    "vi": "Mỏng hoặc mỏng về kết cấu hoặc chất; thiếu độ rắn chắc."
                },
                {
                    "en": "(informal) Shoddy, shabby, cheap, vulgar, etc.",
                    "vi": "(không chính thức) Kém, tồi tàn, rẻ tiền, thô tục, v.v."
                },
                {
                    "en": "Made of low-quality materials; cheap or shoddy.",
                    "vi": "Làm bằng vật liệu chất lượng thấp; rẻ hoặc kém chất lượng."
                },
                {
                    "en": "The definition of sleazy is shabby, a low morals person or a flimsy texture.",
                    "vi": "Định nghĩa của nhếch nhác là tồi tàn, một người đạo đức thấp hoặc một kết cấu mỏng manh."
                },
                {
                    "en": "Thin and loosely woven; flimsy.",
                    "vi": "Mỏng và dệt lỏng lẻo; mỏng manh."
                },
                {
                    "en": "Shabby, dirty, and vulgar; tawdry.",
                    "vi": "Tồi tàn, bẩn thỉu và thô tục; sự chế nhạo."
                },
                {
                    "en": "Dishonest or corrupt; disreputable.",
                    "vi": "Không trung thực hoặc tham nhũng; đáng chê trách."
                },
                {
                    "en": "Marked by low quality; inferior; inadequate.",
                    "vi": "Được đánh dấu bởi chất lượng thấp; kém cỏi; không thỏa đáng."
                },
                {
                    "en": "Dishonorable; base; vulgar; raunchy; sordid.",
                    "vi": "Đê tiện; cơ sở; thô tục; giòn; hôi thối."
                }
            ]
        }
    ],
    "meaning_vi": [
        "mỏng (vải)",
        "(thông tục) nhếch nhác, lôi thôi lếch thếch"
