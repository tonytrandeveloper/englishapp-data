                },
                {
                    "en": "(dial.) Stocky or plump.",
                    "vi": "(mặt số.) Cứng cáp hoặc đầy đặn."
                },
                {
                    "en": "Fat or puffed out in the cheeks.",
                    "vi": "Béo hoặc phồng má."
                },
                {
