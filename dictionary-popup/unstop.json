    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To remove a stopper from.",
                    "vi": "Để loại bỏ một nút từ."
                },
                {
                    "en": "To remove an obstruction from; open.",
                    "vi": "Để loại bỏ một vật cản từ; mở."
                },
                {
                    "en": "(music) To pull out the stops of (a pipe organ).",
                    "vi": "(âm nhạc) Để kéo ra các điểm dừng của (đàn ống)."
                },
                {
                    "en": "To remove the stopper from.",
                    "vi": "Để tháo nút khỏi."
                },
                {
                    "en": "To clear (a pipe, etc.) of a stoppage or obstruction; open.",
                    "vi": "Để thông (đường ống, v.v.) tắc nghẽn hoặc tắc nghẽn; mở."
                },
                {
                    "en": "To remove a stoppage; to clear a blockage.",
                    "vi": "Để loại bỏ một điểm dừng; để thông tắc nghẽn."
                },
                {
                    "en": "To unplug or uncork a container.",
                    "vi": "Để rút phích cắm hoặc mở hộp đựng."
                }
            ]
        }
    ],
    "meaning_vi": [
        "làm cho không bị trở ngại, khai thông",
        "mở nút, tháo nút (chai)"
