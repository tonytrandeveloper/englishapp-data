    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Designed and made to sell without concern for quality; cheap.",
                    "vi": "Được thiết kế và sản xuất để bán mà không cần quan tâm đến chất lượng; rẻ."
                },
                {
                    "en": "Made merely to sell; cheap and flashy.",
                    "vi": "Được tạo ra chỉ để bán; rẻ tiền và hào nhoáng."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "A cheap item.",
                    "vi": "Một mặt hàng rẻ tiền."
                },
                {
                    "en": "A cheap item designed to attract purchasers of other goods.",
                    "vi": "Một mặt hàng giá rẻ được thiết kế để thu hút người mua các mặt hàng khác."
                },
                {
                    "en": "A catchpenny commodity.",
                    "vi": "Một món hàng hấp dẫn."
                }
            ]
        }
    ],
