    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Full of sorrow; rueful.",
                    "vi": "Đầy sầu khổ; đáng tiếc."
                },
                {
                    "en": "Causing sorrow or pity.",
                    "vi": "Gây ra nỗi buồn hoặc sự thương hại."
                },
                {
                    "en": "(now rare) Full of ruth; feeling, showing, or arousing pity or sorrow.",
                    "vi": "(nay hiếm) Đầy ruth; cảm thấy, thể hiện hoặc khơi dậy sự thương hại hoặc buồn bã."
                },
                {
                    "en": "Full of sorrow; sorrowful; woeful; rueful.",
                    "vi": "Đầy sầu khổ; sầu thảm; không may; đáng tiếc."
                },
                {
                    "en": "Causing pity; piteous.",
                    "vi": "Gây thương nhớ; ngoan cố."
                },
                {
                    "en": "Full of ruth or pity; merciful; compassionate.",
                    "vi": "Đầy tàn nhẫn hoặc thương hại; nhân hậu; thương xót."
                }
            ]
        }
    ],
    "meaning_vi": [
