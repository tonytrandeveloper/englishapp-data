    "defines": [
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "On fire; ablaze.",
                    "vi": "Cháy; bốc cháy."
                },
                {
                    "en": "(informal) Used as an intensive.",
                    "vi": "(không chính thức) Được sử dụng như một chuyên sâu."
                },
                {
                    "en": "Resembling a flame in brilliance, color, or form.",
                    "vi": "Giống ngọn lửa về độ rực rỡ, màu sắc hoặc hình thức."
                },
                {
                    "en": "Intense; ardent.",
                    "vi": "Mãnh liệt; hăng hái."
                },
                {
                    "en": "Burning with flames; blazing.",
                    "vi": "Đốt với ngọn lửa; rực rỡ."
                },
                {
                    "en": "Like a flame in brilliance or heat.",
                    "vi": "Giống như ngọn lửa rực rỡ hoặc rực rỡ."
                },
                {
                    "en": "Intensely emotional; ardent; passionate.",
                    "vi": "Cảm xúc mãnh liệt; hăng hái; say đắm."
                },
                {
                    "en": "Startling or flagrant.",
                    "vi": "Giật mình hoặc trắng trợn."
                },
                {
                    "en": "Flamboyantly effeminate.",
                    "vi": "Lộng lẫy một cách ẻo lả."
                },
                {
                    "en": "On fire with visible flames.",
                    "vi": "Đang cháy với ngọn lửa có thể nhìn thấy."
                },
                {
                    "en": "(colloquial) Extremely obvious; visibly evident. Typically of a homosexual male.",
                    "vi": "(thông tục) Cực kỳ hiển nhiên; hiển nhiên rõ ràng. Điển hình là một nam đồng tính luyến ái."
                },
                {
                    "en": "(UK, colloquial) Damned, bloody.",
                    "vi": "(Anh, thông tục) Chết tiệt, đẫm máu."
                }
            ]
        },
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "Present participle of flame.",
                    "vi": "Hiện tại phân từ của ngọn lửa."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "Sterilization by holding an object in a hot flame.",
                    "vi": "Tiệt trùng bằng cách hơ một vật trên ngọn lửa nóng."
                },
                {
                    "en": "(Internet slang) Vitriolic criticism.",
                    "vi": "(Tiếng lóng trên Internet) Phê bình Vitriolic."
                }
            ]
        }
