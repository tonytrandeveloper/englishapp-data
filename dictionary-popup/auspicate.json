    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To begin or inaugurate with a ceremony intended to bring good luck.",
                    "vi": "Để bắt đầu hoặc khánh thành với một buổi lễ nhằm mang lại may mắn."
                },
                {
                    "en": "To foreshow; to foretoken.",
                    "vi": "Để biết trước; được báo trước."
                },
                {
                    "en": "To give a favorable turn to in commencing; to inaugurate; -- a sense derived from the Roman practice of taking the auspicium, or inspection of birds, before undertaking any important business.",
                    "vi": "Để tạo ra một bước ngoặt thuận lợi khi bắt đầu; Để khánh thành; - một ý thức bắt nguồn từ tập quán La Mã về việc kiểm tra chim, hay kiểm tra chim, trước khi thực hiện bất kỳ công việc quan trọng nào."
                }
            ]
        },
        {
            "pos": "adjective",
            "meaning": [
                {
                    "en": "Auspicious.",
                    "vi": "Tốt lành."
                }
            ]
        }
    ],
    "meaning_vi": [
        "bắt đầu, khai trương (để lấy may cho công việc...)",
        "báo điềm"
