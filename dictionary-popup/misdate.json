    "defines": [
        {
            "pos": "verb",
            "meaning": [
                {
                    "en": "To put a wrong date on (a document, letter, etc.) or assign a wrong date to (an event); date incorrectly.",
                    "vi": "Đặt sai ngày trên (tài liệu, thư, v.v.) hoặc ấn định sai ngày cho (một sự kiện); ngày không chính xác."
                },
                {
                    "en": "To date (a document or event, for example) inaccurately.",
                    "vi": "Đến nay (một tài liệu hoặc sự kiện chẳng hạn) không chính xác."
                },
                {
                    "en": "To date incorrectly; to mark with the wrong date.",
                    "vi": "Đến ngày không chính xác; để đánh dấu với ngày sai."
                }
            ]
        },
        {
            "pos": "noun",
            "meaning": [
                {
                    "en": "An inaccurate date.",
                    "vi": "Một ngày không chính xác."
                },
                {
                    "en": "A wrong date.",
                    "vi": "Một ngày sai."
                },
